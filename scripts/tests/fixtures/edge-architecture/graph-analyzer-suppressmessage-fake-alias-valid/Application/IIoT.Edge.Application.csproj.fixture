<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsEdgeArchitectureGraphFixture>true</IsEdgeArchitectureGraphFixture>
    <EdgeArchitectureFixtureRepositoryRoot>$(MSBuildThisFileDirectory)..</EdgeArchitectureFixtureRepositoryRoot>
    <EdgeArchitectureFixtureSolutionPath>$(MSBuildThisFileDirectory)..\EdgeArchitecture.Valid.slnx</EdgeArchitectureFixtureSolutionPath>
  </PropertyGroup>
</Project>
