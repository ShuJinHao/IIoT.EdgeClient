<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><IsTestProject>true</IsTestProject>
    <IsEdgeArchitectureGraphFixture>true</IsEdgeArchitectureGraphFixture>
    <EdgeArchitectureFixtureRepositoryRoot>$(MSBuildThisFileDirectory)..\..\..</EdgeArchitectureFixtureRepositoryRoot>
    <EdgeArchitectureFixtureSolutionPath>$(MSBuildThisFileDirectory)..\..\..\EdgeArchitecture.Invalid.slnx</EdgeArchitectureFixtureSolutionPath>
    <TestKind>Aggregate</TestKind><TestRuntime>Pure</TestRuntime><TestRuntimeDependencies>ControlledConcurrency</TestRuntimeDependencies><TestRunnerMode>Parallel</TestRunnerMode><TestCadence>PR</TestCadence><TestCapability>Domain.Aggregates</TestCapability><TestRisk>P0</TestRisk><TestConcern>Reliability</TestConcern><TestProfile>Simulation</TestProfile><TestOwner>Edge.Domain</TestOwner><TestRuleId>EDGE-DOMAIN-001</TestRuleId><TestRequired>true</TestRequired>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Testing/IIoT.Edge.Testing.Core/IIoT.Edge.Testing.Core.csproj" /></ItemGroup>
</Project>
