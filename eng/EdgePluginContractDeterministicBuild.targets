<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Authority builds import this file after Microsoft C# and Avalonia targets.
    Avalonia 12.0.4 otherwise writes the physical MSBuildProjectDirectory into
    embedded portable-PDB document names. Keep the upstream target behavior, but
    give the XAML compiler the same per-project virtual root in every worktree.
  -->
  <Target Name="EdgePluginContractDeterministicBuildImported" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_EdgeContractProjectRelativeDirectory>$([MSBuild]::MakeRelative('$(_EdgeContractRepositoryRoot)', '$(MSBuildProjectDirectory)'))</_EdgeContractProjectRelativeDirectory>
      <_EdgeContractProjectRelativeDirectoryNormalized>$([System.String]::Copy('$(_EdgeContractProjectRelativeDirectory)').Replace('\', '/'))</_EdgeContractProjectRelativeDirectoryNormalized>
      <_EdgeContractVirtualProjectDirectory>$([System.String]::Concat('/_/', '$(_EdgeContractProjectRelativeDirectoryNormalized)'))</_EdgeContractVirtualProjectDirectory>
    </PropertyGroup>
    <Error
      Condition="'$(_EdgeContractAuthorityBuild)' != 'true'"
      Text="EDGE-SPLIT-LEDGER-001 deterministic build targets require the exact authority-only marker." />
    <Error
      Condition="'$(_EdgeContractRepositoryRoot)' == ''"
      Text="EDGE-SPLIT-LEDGER-001 authority build repository root is missing." />
    <Error
      Condition="'$(_EdgeContractProjectRelativeDirectoryNormalized)' == '..' OR $([System.String]::Copy('$(_EdgeContractProjectRelativeDirectoryNormalized)').StartsWith('../')) OR $([System.IO.Path]::IsPathRooted('$(_EdgeContractProjectRelativeDirectoryNormalized)'))"
      Text="EDGE-SPLIT-LEDGER-001 authority build project escapes the repository root." />
    <Message
      Importance="Low"
      Text="EDGE-SPLIT-AUTHORITY-DETERMINISTIC-BUILD|project=$(_EdgeContractProjectRelativeDirectoryNormalized)|virtual=$(_EdgeContractVirtualProjectDirectory)" />
  </Target>

  <Target
    Name="CompileAvaloniaXaml"
    DependsOnTargets="EdgePluginContractDeterministicBuildImported;$(CompileAvaloniaXamlDependsOn)"
    Condition="'@(AvaloniaResource)@(AvaloniaXaml)' != '' AND $(DesignTimeBuild) != true AND $(EnableAvaloniaXamlCompilation) != false">
    <PropertyGroup>
      <AvaloniaXamlIlVerifyIl Condition="'$(AvaloniaXamlIlVerifyIl)' == ''">false</AvaloniaXamlIlVerifyIl>
      <AvaloniaXamlIlDebuggerLaunch Condition="'$(AvaloniaXamlIlDebuggerLaunch)' == ''">false</AvaloniaXamlIlDebuggerLaunch>
      <AvaloniaXamlVerboseExceptions Condition="'$(AvaloniaXamlVerboseExceptions)' == ''">false</AvaloniaXamlVerboseExceptions>
      <AvaloniaXamlCreateSourceInfo Condition="'$(AvaloniaXamlCreateSourceInfo)' == '' AND '$(Configuration)' == 'Debug'">true</AvaloniaXamlCreateSourceInfo>
      <AvaloniaXamlCreateSourceInfo Condition="'$(AvaloniaXamlCreateSourceInfo)' == '' AND '$(Configuration)' != 'Debug'">false</AvaloniaXamlCreateSourceInfo>
    </PropertyGroup>
    <ItemGroup>
      <IntermediateAssembly Update="*" AvaloniaCompileOutput="%(FullPath)" />
      <_DebugSymbolsIntermediatePath Update="*" AvaloniaCompileOutput="%(FullPath)" />
      <IntermediateRefAssembly Update="*" AvaloniaCompileOutput="%(FullPath)" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)/Avalonia/references"
      Lines="@(ReferencePathWithRefAssemblies)"
      Overwrite="true" />
    <CompileAvaloniaXamlTask
      AssemblyFile="@(IntermediateAssembly)"
      References="@(ReferencePathWithRefAssemblies)"
      RefAssemblyFile="@(IntermediateRefAssembly)"
      ProjectDirectory="$(_EdgeContractVirtualProjectDirectory)"
      VerifyIl="$(AvaloniaXamlIlVerifyIl)"
      ReportImportance="$(AvaloniaXamlReportImportance)"
      AssemblyOriginatorKeyFile="$(AssemblyOriginatorKeyFile)"
      SignAssembly="$(SignAssembly)"
      DelaySign="$(DelaySign)"
      SkipXamlCompilation="$(_AvaloniaSkipXamlCompilation)"
      DebuggerLaunch="$(AvaloniaXamlIlDebuggerLaunch)"
      CreateSourceInfo="$(AvaloniaXamlCreateSourceInfo)"
      DefaultCompileBindings="$(AvaloniaUseCompiledBindingsByDefault)"
      VerboseExceptions="$(AvaloniaXamlVerboseExceptions)"
      AnalyzerConfigFiles="@(EditorConfigFiles)" />
  </Target>
</Project>
