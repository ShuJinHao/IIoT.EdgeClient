{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iiot.local/schemas/edge-plugin-contract-formal-validation-result.schema.json",
  "title": "Edge plugin contract formal validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleId",
    "mode",
    "formal",
    "passed",
    "completedUtc",
    "formalFinalHead",
    "formalFinalTree",
    "implementationHead",
    "implementationTree",
    "ledgerPath",
    "ledgerSha256",
    "receiptPath",
    "receiptSha256",
    "publicKeySha256",
    "authorityCount",
    "replayCount",
    "descriptorPidBoundToDirectChild",
    "descriptorStartBoundToDirectChild",
    "fastConsumerRequireAuthorityReceipt",
    "fastConsumerRequireFormalAuthorityReceipt",
    "postStateStable",
    "cleanupComplete"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ruleId": { "const": "EDGE-SPLIT-LEDGER-001" },
    "mode": { "const": "formal-clean" },
    "formal": { "const": true },
    "passed": { "const": true },
    "completedUtc": { "$ref": "#/$defs/utcTimestamp" },
    "formalFinalHead": { "$ref": "#/$defs/gitObject" },
    "formalFinalTree": { "$ref": "#/$defs/gitObject" },
    "implementationHead": { "$ref": "#/$defs/gitObject" },
    "implementationTree": { "$ref": "#/$defs/gitObject" },
    "ledgerPath": { "const": "eng/baselines/edge-plugin-contract-ledger.json" },
    "ledgerSha256": { "$ref": "#/$defs/sha256" },
    "receiptPath": { "$ref": "#/$defs/artifactPath" },
    "receiptSha256": { "$ref": "#/$defs/sha256" },
    "publicKeySha256": { "$ref": "#/$defs/sha256" },
    "authorityCount": { "const": 1 },
    "replayCount": { "const": 1 },
    "descriptorPidBoundToDirectChild": { "const": true },
    "descriptorStartBoundToDirectChild": { "const": true },
    "fastConsumerRequireAuthorityReceipt": { "const": true },
    "fastConsumerRequireFormalAuthorityReceipt": { "const": true },
    "postStateStable": { "const": true },
    "cleanupComplete": { "const": true }
  },
  "$defs": {
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\.artifacts/(?!\\.\\.(?:/|$))(?!.*(?:/)\\.\\.(?:/|$))[^\\\\]+$"
    }
  }
}
