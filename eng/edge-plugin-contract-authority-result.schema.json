{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iiot.local/schemas/edge-plugin-contract-authority-result.schema.json",
  "title": "Edge plugin contract independent authority result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleId",
    "ledgerSha256",
    "ledgerPayloadSha256",
    "analyzedInputsSha256",
    "authorityCodeSha256",
    "factGroups"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ruleId": { "const": "EDGE-SPLIT-LEDGER-001" },
    "ledgerSha256": { "$ref": "#/$defs/sha256" },
    "ledgerPayloadSha256": { "$ref": "#/$defs/sha256" },
    "analyzedInputsSha256": { "$ref": "#/$defs/sha256" },
    "authorityCodeSha256": { "$ref": "#/$defs/sha256" },
    "factGroups": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "authority"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]{1,63}$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "authority": { "enum": ["independent-recompute", "validated-authority-input", "validated-cross-field"] }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
