{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iiot.local/schemas/edge-plugin-contract-authority-descriptor.schema.json",
  "title": "Edge plugin contract authority coordinator descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "challengeBase64",
    "coordinatorPid",
    "processStartUtc",
    "sourceRepositoryRoot",
    "authorityRepositoryRoot",
    "authorityHead",
    "authorityTree",
    "formalFinalHead",
    "formalFinalTree",
    "sourceBaseHead",
    "sourceBaseTree",
    "sourceDirtyManifestSha256",
    "ephemeralSnapshotHead",
    "ephemeralSnapshotTree",
    "implementationHead",
    "implementationTree",
    "receiptPath",
    "receiptSha256",
    "publicKeySpkiBase64",
    "publicKeySha256",
    "authorityCount",
    "replayCount",
    "authorityElapsedMilliseconds",
    "replayElapsedMilliseconds",
    "totalElapsedMilliseconds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/runId" },
    "challengeBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
    "coordinatorPid": { "type": "integer", "minimum": 1 },
    "processStartUtc": { "$ref": "#/$defs/utcTimestamp" },
    "sourceRepositoryRoot": { "$ref": "#/$defs/absolutePath" },
    "authorityRepositoryRoot": { "$ref": "#/$defs/absolutePath" },
    "authorityHead": { "$ref": "#/$defs/gitObject" },
    "authorityTree": { "$ref": "#/$defs/gitObject" },
    "formalFinalHead": { "$ref": "#/$defs/gitObjectOrEmpty" },
    "formalFinalTree": { "$ref": "#/$defs/gitObjectOrEmpty" },
    "sourceBaseHead": { "$ref": "#/$defs/gitObject" },
    "sourceBaseTree": { "$ref": "#/$defs/gitObject" },
    "sourceDirtyManifestSha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
    "ephemeralSnapshotHead": { "$ref": "#/$defs/gitObjectOrEmpty" },
    "ephemeralSnapshotTree": { "$ref": "#/$defs/gitObjectOrEmpty" },
    "implementationHead": { "$ref": "#/$defs/gitObject" },
    "implementationTree": { "$ref": "#/$defs/gitObject" },
    "receiptPath": { "$ref": "#/$defs/repositoryPath" },
    "receiptSha256": { "$ref": "#/$defs/sha256" },
    "publicKeySpkiBase64": { "type": "string", "minLength": 80, "maxLength": 256, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "publicKeySha256": { "$ref": "#/$defs/sha256" },
    "authorityCount": { "const": 1 },
    "replayCount": { "const": 1 },
    "authorityElapsedMilliseconds": { "type": "integer", "minimum": 0 },
    "replayElapsedMilliseconds": { "type": "integer", "minimum": 0 },
    "totalElapsedMilliseconds": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gitObjectOrEmpty": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 2048 }
  }
}
