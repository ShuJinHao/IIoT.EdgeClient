{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iiot.local/schemas/edge-plugin-contract-authority-receipt.schema.json",
  "title": "Edge plugin contract authority signed receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "signatureAlgorithm", "payload", "signatureBase64"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "signatureAlgorithm": { "const": "ECDSA-P256-SHA256-IEEE-P1363" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "formal",
        "runId",
        "challengeBase64",
        "issuedUtc",
        "expiresUtc",
        "sourceRepositoryRoot",
        "authorityRepositoryRoot",
        "authorityHead",
        "authorityTree",
        "formalFinalHead",
        "formalFinalTree",
        "sourceBaseHead",
        "sourceBaseTree",
        "sourceDirtyManifestSha256",
        "ephemeralSnapshotHead",
        "ephemeralSnapshotTree",
        "implementationHead",
        "implementationTree",
        "ledgerPath",
        "ledgerSha256",
        "ledgerPayloadSha256",
        "analyzedInputsSha256",
        "authorityCodeSha256",
        "publicKeySha256",
        "authorityCount",
        "replayCount",
        "factGroups"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "enum": ["formal-clean", "development-snapshot"] },
        "formal": { "type": "boolean" },
        "runId": { "$ref": "#/$defs/runId" },
        "challengeBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" },
        "issuedUtc": { "$ref": "#/$defs/utcTimestamp" },
        "expiresUtc": { "$ref": "#/$defs/utcTimestamp" },
        "sourceRepositoryRoot": { "$ref": "#/$defs/absolutePath" },
        "authorityRepositoryRoot": { "$ref": "#/$defs/absolutePath" },
        "authorityHead": { "$ref": "#/$defs/gitObject" },
        "authorityTree": { "$ref": "#/$defs/gitObject" },
        "formalFinalHead": { "$ref": "#/$defs/gitObjectOrEmpty" },
        "formalFinalTree": { "$ref": "#/$defs/gitObjectOrEmpty" },
        "sourceBaseHead": { "$ref": "#/$defs/gitObject" },
        "sourceBaseTree": { "$ref": "#/$defs/gitObject" },
        "sourceDirtyManifestSha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "ephemeralSnapshotHead": { "$ref": "#/$defs/gitObjectOrEmpty" },
        "ephemeralSnapshotTree": { "$ref": "#/$defs/gitObjectOrEmpty" },
        "implementationHead": { "$ref": "#/$defs/gitObject" },
        "implementationTree": { "$ref": "#/$defs/gitObject" },
        "ledgerPath": { "$ref": "#/$defs/repositoryPath" },
        "ledgerSha256": { "$ref": "#/$defs/sha256" },
        "ledgerPayloadSha256": { "$ref": "#/$defs/sha256" },
        "analyzedInputsSha256": { "$ref": "#/$defs/sha256" },
        "authorityCodeSha256": { "$ref": "#/$defs/sha256" },
        "publicKeySha256": { "$ref": "#/$defs/sha256" },
        "authorityCount": { "const": 1 },
        "replayCount": { "const": 1 },
        "factGroups": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "authority"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]{1,63}$" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "authority": { "enum": ["independent-recompute", "validated-authority-input", "validated-cross-field"] }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "formal-clean" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "formal": { "const": true },
              "formalFinalHead": { "$ref": "#/$defs/gitObject" },
              "formalFinalTree": { "$ref": "#/$defs/gitObject" },
              "sourceDirtyManifestSha256": { "const": "" },
              "ephemeralSnapshotHead": { "const": "" },
              "ephemeralSnapshotTree": { "const": "" }
            }
          },
          "else": {
            "properties": {
              "formal": { "const": false },
              "formalFinalHead": { "const": "" },
              "formalFinalTree": { "const": "" },
              "sourceDirtyManifestSha256": { "$ref": "#/$defs/sha256" },
              "ephemeralSnapshotHead": { "$ref": "#/$defs/gitObject" },
              "ephemeralSnapshotTree": { "$ref": "#/$defs/gitObject" }
            }
          }
        }
      ]
    },
    "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gitObjectOrEmpty": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "absolutePath": { "type": "string", "minLength": 1, "maxLength": 2048 }
  }
}
