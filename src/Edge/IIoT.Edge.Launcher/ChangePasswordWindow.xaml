<Window x:Class="IIoT.Edge.Launcher.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="修改本地密码"
        Width="440"
        Height="520"
        MinWidth="420"
        MinHeight="500"
        Background="#101417"
        Foreground="#F7FAFC"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/IIoT.Edge.Launcher;component/Themes/LauncherTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="1"
            Padding="28"
            Background="{StaticResource Launcher.Bg.Surface}"
            BorderBrush="{StaticResource Launcher.Border}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <Border HorizontalAlignment="Left"
                        Style="{StaticResource LauncherStatusChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Width="18"
                                                 Height="18"
                                                 Foreground="#5EEAD4"
                                                 Kind="ShieldKeyOutline" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource Launcher.Text.Secondary}"
                                   Text="本地管理员" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,22,0,0"
                           Style="{StaticResource LauncherSectionTitleStyle}"
                           Text="修改本地密码" />
                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource LauncherBodyStyle}"
                           Text="修改后请使用新密码重新登录 Launcher。"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="0,28,0,0">
                <TextBox x:Name="UserNameInput"
                         Margin="0,0,0,18"
                         materialDesign:HintAssist.FloatingScale="0.8"
                         materialDesign:HintAssist.Hint="账号"
                         Style="{StaticResource LauncherHintTextBoxStyle}" />

                <PasswordBox x:Name="OldPasswordInput"
                             Margin="0,0,0,18"
                             materialDesign:HintAssist.FloatingScale="0.8"
                             materialDesign:HintAssist.Hint="旧密码"
                             Style="{StaticResource LauncherHintPasswordBoxStyle}" />

                <PasswordBox x:Name="NewPasswordInput"
                             Margin="0,0,0,18"
                             materialDesign:HintAssist.FloatingScale="0.8"
                             materialDesign:HintAssist.Hint="新密码"
                             Style="{StaticResource LauncherHintPasswordBoxStyle}" />

                <PasswordBox x:Name="ConfirmPasswordInput"
                             Margin="0,0,0,14"
                             materialDesign:HintAssist.FloatingScale="0.8"
                             materialDesign:HintAssist.Hint="确认新密码"
                             Style="{StaticResource LauncherHintPasswordBoxStyle}" />

                <TextBlock x:Name="DialogErrorText"
                           FontSize="12"
                           Foreground="{StaticResource Launcher.Text.Error}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="取消"
                        Click="CancelButton_Click"
                        Style="{StaticResource LauncherGhostButtonStyle}" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="2"
                        Content="确认修改"
                        Click="ConfirmButton_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource LauncherPrimaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
