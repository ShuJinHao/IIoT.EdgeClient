<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">
    <sys:String x:Key="Launcher_WindowTitle">IIoT Edge Launcher</sys:String>
    <sys:String x:Key="Launcher_HeaderBrand">IIoT Edge Launcher</sys:String>
    <sys:String x:Key="Launcher_ToolTip_Minimize">Minimize</sys:String>
    <sys:String x:Key="Launcher_ToolTip_ToggleWindowState">Maximize / restore</sys:String>
    <sys:String x:Key="Launcher_ToolTip_Close">Close</sys:String>
    <sys:String x:Key="Launcher_ToolTip_SwitchLanguage">Switch to Chinese</sys:String>
    <sys:String x:Key="Launcher_Language_ToggleTarget">中</sys:String>
    <sys:String x:Key="Launcher_Startup_ErrorTitle">Startup failed</sys:String>
    <sys:String x:Key="Launcher_Startup_ErrorFormat">Local launcher initialization failed: {0}</sys:String>

    <sys:String x:Key="Launcher_Login_Badge">Local login</sys:String>
    <sys:String x:Key="Launcher_Login_Title">Sign in before selecting a process</sys:String>
    <sys:String x:Key="Launcher_Login_Description">This account is only for the local launcher and is not shared with cloud employee login. After login, select the process client to start.</sys:String>
    <sys:String x:Key="Launcher_Login_UserNamePlaceholder">Account</sys:String>
    <sys:String x:Key="Launcher_Login_PasswordPlaceholder">Password</sys:String>
    <sys:String x:Key="Launcher_Button_Login">Sign in and select process</sys:String>
    <sys:String x:Key="Launcher_Button_ChangePassword">Change local password</sys:String>
    <sys:String x:Key="Launcher_Login_BoundaryNote">Launcher only handles local login, reads the profile list, and starts Shell.</sys:String>

    <sys:String x:Key="Launcher_Hero_VersionLabel">Software version</sys:String>
    <sys:String x:Key="Launcher_Hero_Title">Standard process launcher</sys:String>
    <sys:String x:Key="Launcher_Hero_Description">Launcher handles local site login and process switching. The real HMI client is still hosted by IIoT.Edge.Shell.exe.</sys:String>
    <sys:String x:Key="Launcher_Hero_PlatformLabel">Platform role</sys:String>
    <sys:String x:Key="Launcher_Hero_ArchitectureLabel">Runtime architecture</sys:String>
    <sys:String x:Key="Launcher_Hero_MaintainerLabel">Maintenance</sys:String>
    <sys:String x:Key="Launcher_Hero_SupportNote">Supports one main client, isolated profiles, and plugin-based process extension.</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowLogin">Local login</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowProfile">Select profile</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowShell">Start Shell</sys:String>

    <sys:String x:Key="Launcher_Selection_Title">Select the process client to start</sys:String>
    <sys:String x:Key="Launcher_Selection_Description">Process cards only start the corresponding client. Version checks and updates are handled in the update panel below.</sys:String>
    <sys:String x:Key="Launcher_Selection_SearchPlaceholder">Search process, profile, or card id</sys:String>
    <sys:String x:Key="Launcher_Button_LaunchProfile">Start process</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_Title">Current process versions</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_Description">Only the host and plugin versions for the current process are shown. Update actions only run through the real local update flow.</sys:String>
