    <sys:String x:Key="Launcher_VersionManagement_ConfirmDeprecatedMessage">Target version {2} for {0} is marked deprecated. Current version is {1}. If confirmed, the selected version will still be applied. Site data and configuration will not be cleared.</sys:String>
