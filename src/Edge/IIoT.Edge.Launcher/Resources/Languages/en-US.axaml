<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">
    <sys:String x:Key="Launcher_WindowTitle">IIoT Edge Launcher</sys:String>
    <sys:String x:Key="Launcher_HeaderBrand">IIoT Edge Launcher</sys:String>
    <sys:String x:Key="Launcher_ToolTip_Minimize">Minimize</sys:String>
    <sys:String x:Key="Launcher_ToolTip_ToggleWindowState">Maximize / restore</sys:String>
    <sys:String x:Key="Launcher_ToolTip_Close">Close</sys:String>
    <sys:String x:Key="Launcher_ToolTip_SwitchLanguage">Switch to Chinese</sys:String>
    <sys:String x:Key="Launcher_Language_ToggleTarget">中</sys:String>
    <sys:String x:Key="Launcher_Startup_ErrorTitle">Startup failed</sys:String>
    <sys:String x:Key="Launcher_Startup_ErrorFormat">Local launcher initialization failed: {0}</sys:String>

    <sys:String x:Key="Launcher_Login_Badge">Local login</sys:String>
    <sys:String x:Key="Launcher_Login_Title">Sign in before selecting a process</sys:String>
    <sys:String x:Key="Launcher_Login_Description">This account is only for the local launcher and is not shared with cloud employee login. After login, select the process client to start.</sys:String>
    <sys:String x:Key="Launcher_Login_UserNamePlaceholder">Account</sys:String>
    <sys:String x:Key="Launcher_Login_PasswordPlaceholder">Password</sys:String>
    <sys:String x:Key="Launcher_Button_Login">Sign in and select process</sys:String>
    <sys:String x:Key="Launcher_Button_ChangePassword">Change local password</sys:String>
    <sys:String x:Key="Launcher_Login_BoundaryNote">Launcher only handles local login, reads the profile list, and starts Shell.</sys:String>

    <sys:String x:Key="Launcher_Hero_VersionLabel">Software version</sys:String>
    <sys:String x:Key="Launcher_Hero_Title">Standard process launcher</sys:String>
    <sys:String x:Key="Launcher_Hero_Description">Launcher handles local site login and process switching. The real HMI client is still hosted by IIoT.Edge.Shell.exe.</sys:String>
    <sys:String x:Key="Launcher_Hero_PlatformLabel">Platform role</sys:String>
    <sys:String x:Key="Launcher_Hero_ArchitectureLabel">Runtime architecture</sys:String>
    <sys:String x:Key="Launcher_Hero_MaintainerLabel">Maintenance</sys:String>
    <sys:String x:Key="Launcher_Hero_SupportNote">Supports one main client, isolated profiles, and plugin-based process extension.</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowLogin">Local login</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowProfile">Select profile</sys:String>
    <sys:String x:Key="Launcher_Hero_FlowShell">Start Shell</sys:String>

    <sys:String x:Key="Launcher_Selection_Title">Select the process client to start</sys:String>
    <sys:String x:Key="Launcher_Selection_Description">Process cards only start the corresponding client. Version checks and updates are handled in the update panel below.</sys:String>
    <sys:String x:Key="Launcher_Selection_SearchPlaceholder">Search process, profile, or card id</sys:String>
    <sys:String x:Key="Launcher_Button_LaunchProfile">Start process</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_Title">Update check</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_Description">Check client host and process plugin versions here. The system only checks status automatically; it never downloads, installs, or restarts automatically.</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_HostTitle">Client host</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_PluginTitle">Process plugins</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_MachineLevel">Machine</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_ProcessLevel">Process</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_ButtonRefresh">Check again</sys:String>
    <sys:String x:Key="Launcher_UpdateCenter_ButtonHostUpdate">Update host</sys:String>
    <sys:String x:Key="Launcher_Profile_PluginLabel">Plugin</sys:String>
    <sys:String x:Key="Launcher_Profile_DataLabel">Data</sys:String>
    <sys:String x:Key="Launcher_Profile_PluginMissing">Plugin manifest missing</sys:String>
    <sys:String x:Key="Launcher_Profile_DataMissing">Data path missing</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusChecking">Checking</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusLatest">Latest</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusUpdateAvailable">Update available</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusRunning">Running</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusUnregistered">Unregistered</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusOffline">Offline</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_StatusUpdating">Updating</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionChecking">Checking</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionLaunch">Start process</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionRunning">Already running</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionContactAdmin">Contact admin</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionLaunchOffline">Start process</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_ActionWorking">Working</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailChecking">Checking this process card update state. No download or install will start automatically.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailLatest">This process client is ready to start with the current version.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUpdateBoth">Host and {0} process plugins need updates. The system will handle them after confirmation.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUpdatePlugins">{0} process plugins need updates. The system will install them and start after confirmation.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUpdateHost">The client host needs an update. The system will update and restart after confirmation.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUnregistered">Device is not registered. Contact an administrator.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailOffline">Updates cannot be checked right now. The local version can still be started.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailIncompatible">The plugin is not compatible with the current host version. Contact an administrator.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailRunning">A process client is already running, so updates are disabled.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUpdating">Processing update. Do not close Launcher.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailApplyingHost">Host update has started. Launcher will restart.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailUpdateFailed">Update failed. Check details or contact an administrator.</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_DetailsHeader">Details</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_TechnicalHostFormat">Host version: {0}, cloud host: {1}</sys:String>
    <sys:String x:Key="Launcher_ProfileCard_TechnicalHostUpdateFormat">Host update: {0} → {1}</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_CurrentVersionLabel">Current</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_LatestVersionLabel">Latest</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_SizeLabel">Size</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_ButtonInstall">Install</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_ButtonUpdate">Update</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_ButtonNoAction">No action</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_NotInstalled">Not installed</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusNotInstalled">Not installed</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusUpdateAvailable">Update available</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusLatest">Latest</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusInstalledNewer">Local newer</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusIncompatible">Incompatible</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_Plugin_StatusUnknown">Unknown</sys:String>

    <sys:String x:Key="Launcher_ChangePassword_WindowTitle">Change local password</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_Badge">Local administrator</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_Title">Change local password</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_Description">Use the new password to sign in to Launcher again.</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_OldPasswordPlaceholder">Old password</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_NewPasswordPlaceholder">New password</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_ConfirmPasswordPlaceholder">Confirm new password</sys:String>
    <sys:String x:Key="Launcher_Button_Cancel">Cancel</sys:String>
    <sys:String x:Key="Launcher_Button_ConfirmChange">Confirm change</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_UserNameRequired">Account is required.</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_OldPasswordRequired">Old password is required.</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_NewPasswordRequired">New password is required.</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_NewPasswordMinLength">New password must be at least 6 characters.</sys:String>
    <sys:String x:Key="Launcher_ChangePassword_ConfirmMismatch">The two new passwords do not match.</sys:String>

    <sys:String x:Key="Launcher_Status_Initial">Please sign in with a local account first.</sys:String>
    <sys:String x:Key="Launcher_Status_ValidatingLogin">Validating local account...</sys:String>
    <sys:String x:Key="Launcher_Status_LoginRetry">Fix the account information and try again.</sys:String>
    <sys:String x:Key="Launcher_Status_SelectProfile">Select the process client to start.</sys:String>
    <sys:String x:Key="Launcher_Status_ProfileLoadFailed">Local login passed, but the process list failed to load.</sys:String>
    <sys:String x:Key="Launcher_Status_ChangingPassword">Changing local password...</sys:String>
    <sys:String x:Key="Launcher_Status_PasswordRetry">Fix the password information and try again.</sys:String>
    <sys:String x:Key="Launcher_Status_PasswordChanged">Local password changed. Use the new password to sign in.</sys:String>
    <sys:String x:Key="Launcher_Status_PasswordChangeFailed">Local password change failed.</sys:String>
    <sys:String x:Key="Launcher_Status_LaunchSucceededFormat">Started {0}, MachineProfile = {1}.</sys:String>
    <sys:String x:Key="Launcher_Status_LaunchFailedFormat">Failed to start {0}.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusInitial">Updates have not been checked.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusChecking">Checking for updates...</sys:String>
    <sys:String x:Key="Launcher_Update_StatusNotConfigured">Update source is not configured.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusNotInstalled">This is not an installed build, so auto-update is unavailable.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusNoUpdate">Already on latest version: {0}</sys:String>
    <sys:String x:Key="Launcher_Update_StatusAvailable">New version available: {0}</sys:String>
    <sys:String x:Key="Launcher_Update_StatusPendingRestart">Update downloaded and waiting for restart: {0}</sys:String>
    <sys:String x:Key="Launcher_Update_StatusShellRunning">A process client is still running, so update is paused.</sys:String>
    <sys:String x:Key="Launcher_Update_ShellRunningDetail">Close the running process client before downloading and restarting for update.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusDownloading">Downloading update...</sys:String>
    <sys:String x:Key="Launcher_Update_StatusApplying">Applying update and restarting...</sys:String>
    <sys:String x:Key="Launcher_Update_StatusCanceled">Update operation was canceled.</sys:String>
    <sys:String x:Key="Launcher_Update_StatusFailed">Update check or apply failed.</sys:String>
    <sys:String x:Key="Launcher_Update_ErrorUnknown">Unknown update error.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusInitial">Process update state has not been checked.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusChecking">Checking process update state for {0}...</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusReady">Host {0}, latest host {1}, {2} plugins.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusNotConfigured">CloudApi or catalog paths are not configured.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusBootstrapFailed">Cloud bootstrap failed, so plugin catalog cannot be read.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusCatalogFailed">Failed to fetch cloud plugin catalog.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusInstalling">Installing or updating plugin: {0}</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusInstalled">Installed plugins: {0}</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusShellRunning">A process client is running, so plugins cannot be replaced.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_ShellRunningDetail">Close the running Shell before installing or updating plugins.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusNoProfile">Open plugin updates from a profile card first.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusCanceled">Plugin update operation was canceled.</sys:String>
    <sys:String x:Key="Launcher_ClientRelease_StatusFailed">Plugin check or install failed.</sys:String>
    <sys:String x:Key="Launcher_Error_LoginFailed">Local login failed.</sys:String>
    <sys:String x:Key="Launcher_Error_UserNameRequired">Enter an account.</sys:String>
    <sys:String x:Key="Launcher_Error_PasswordRequired">Enter a password.</sys:String>
    <sys:String x:Key="Launcher_Error_AccountConfigurationUnavailable">Local account configuration is unavailable. Check the account file under the app data directory.</sys:String>
    <sys:String x:Key="Launcher_Error_AccountDisabledOrMissing">The local account does not exist or is disabled.</sys:String>
    <sys:String x:Key="Launcher_Error_InvalidCredentials">The account or password is incorrect.</sys:String>
    <sys:String x:Key="Launcher_Error_NewPasswordRequired">New password is required.</sys:String>
    <sys:String x:Key="Launcher_Error_NewPasswordMinLength">New password must be at least 6 characters.</sys:String>
    <sys:String x:Key="Launcher_Error_OldPasswordInvalid">Old password verification failed.</sys:String>
    <sys:String x:Key="Launcher_Welcome_Anonymous">Not signed in</sys:String>
    <sys:String x:Key="Launcher_Welcome_Format">Signed in: {0}</sys:String>
    <sys:String x:Key="Launcher_ProfileSummary_Zero">0 processes</sys:String>
    <sys:String x:Key="Launcher_ProfileSummary_AllFormat">{0} processes</sys:String>
    <sys:String x:Key="Launcher_ProfileSummary_FilteredFormat">Showing {0} / {1} processes</sys:String>
    <sys:String x:Key="Launcher_Meta_Platform">Local login / plugin loading</sys:String>
    <sys:String x:Key="Launcher_Meta_Maintainer">Edge Platform Team</sys:String>
    <sys:String x:Key="Launcher_Meta_Architecture">Launcher / Shell / Profile</sys:String>
</ResourceDictionary>
