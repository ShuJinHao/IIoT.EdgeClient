<Window
    x:Class="IIoT.Edge.Launcher.ChangePasswordWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="修改本地密码"
    Width="440"
    Height="520"
    MinWidth="420"
    MinHeight="500"
    Background="Transparent"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner">
    <Border
        Padding="{DynamicResource Edge.Thickness.24}"
        Background="{DynamicResource Launcher.Bg.Surface}"
        BorderBrush="{DynamicResource Launcher.Border}"
        BorderThickness="1"
        CornerRadius="{DynamicResource Edge.CornerRadius.Large}"
        PointerPressed="TitleBar_PointerPressed">
        <Grid>
            <Button
                Margin="0,-8,-8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Classes="launcher-window-button"
                Click="CloseWindowButton_Click"
                ToolTip.Tip="关闭">
                <PathIcon Width="18" Height="18" Data="{StaticResource Launcher.Icon.Close}" />
            </Button>

            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="10">
                    <Border Classes="launcher-chip" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon
                                Width="18"
                                Height="18"
                                Data="{StaticResource Launcher.Icon.Key}"
                                Foreground="{DynamicResource Launcher.Accent.Light}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource Launcher.Text.Secondary}"
                                Text="本地管理员" />
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="launcher-title" Text="修改本地密码" />
                    <TextBlock
                        Classes="launcher-body"
                        Text="修改后请使用新密码重新登录 Launcher。" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="14">
                    <TextBox
                        x:Name="UserNameInput"
                        Classes="launcher-input"
                        PlaceholderText="账号" />
                    <TextBox
                        x:Name="OldPasswordInput"
                        Classes="launcher-input"
                        PasswordChar="●"
                        PlaceholderText="旧密码" />
                    <TextBox
                        x:Name="NewPasswordInput"
                        Classes="launcher-input"
                        PasswordChar="●"
                        PlaceholderText="新密码" />
                    <TextBox
                        x:Name="ConfirmPasswordInput"
                        Classes="launcher-input"
                        PasswordChar="●"
                        PlaceholderText="确认新密码" />

                    <TextBlock
                        x:Name="DialogErrorText"
                        FontSize="12"
                        Foreground="{DynamicResource Launcher.Text.Error}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,24,0,0" ColumnDefinitions="*,12,*">
                    <Button
                        Grid.Column="0"
                        Classes="launcher-ghost"
                        Click="CancelButton_Click">
                        <TextBlock Text="取消" />
                    </Button>
                    <Button
                        x:Name="ConfirmButton"
                        Grid.Column="2"
                        Classes="launcher-primary"
                        Click="ConfirmButton_Click"
                        IsEnabled="{Binding !IsBusy}">
                        <TextBlock Text="确认修改" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
