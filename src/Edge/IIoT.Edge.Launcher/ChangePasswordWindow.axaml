<Window
    x:Class="IIoT.Edge.Launcher.ChangePasswordWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Title="{DynamicResource Launcher_ChangePassword_WindowTitle}"
    Width="440"
    Height="520"
    MinWidth="420"
    MinHeight="500"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner">
    <edge:EdgeCard
        Margin="1"
        CardBorderThickness="1"
        CardCornerRadius="{DynamicResource Edge.CornerRadius.Card}"
        CardPadding="{DynamicResource Edge.Thickness.24}"
        Elevation="Float"
        PointerPressed="TitleBar_PointerPressed"
        Surface="Card">
        <Grid>
            <edge:EdgeWindowButton
                Classes="soft-window-action"
                Margin="0,-8,-8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseWindowButton_Click"
                Kind="Close"
                ToolTip.Tip="{DynamicResource Launcher_ToolTip_Close}">
                <TextBlock
                    Classes="edge-window-symbol"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=edge:EdgeWindowButton}}"
                    Text="✕" />
            </edge:EdgeWindowButton>

            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="10">
                    <Border
                        Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource Edge.Brush.Surface.Wash}"
                        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon
                                Width="18"
                                Height="18"
                                Data="{StaticResource Edge.Icon.Key}"
                                Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                Text="{DynamicResource Launcher_ChangePassword_Badge}" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        FontFamily="{DynamicResource Edge.FontFamily.Display}"
                        FontSize="{DynamicResource Edge.FontSize.Display}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                        Text="{DynamicResource Launcher_ChangePassword_Title}" />
                    <TextBlock
                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                        Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                        Text="{DynamicResource Launcher_ChangePassword_Description}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    Spacing="14">
                    <edge:EdgeLoginInput
                        x:Name="UserNameInput"
                        HorizontalAlignment="Stretch"
                        Width="NaN"
                        PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                    <edge:EdgeLoginInput
                        x:Name="OldPasswordInput"
                        HorizontalAlignment="Stretch"
                        Width="NaN"
                        PasswordChar="●"
                        PlaceholderText="{DynamicResource Launcher_ChangePassword_OldPasswordPlaceholder}" />
                    <edge:EdgeLoginInput
                        x:Name="NewPasswordInput"
                        HorizontalAlignment="Stretch"
                        Width="NaN"
                        PasswordChar="●"
                        PlaceholderText="{DynamicResource Launcher_ChangePassword_NewPasswordPlaceholder}" />
                    <edge:EdgeLoginInput
                        x:Name="ConfirmPasswordInput"
                        HorizontalAlignment="Stretch"
                        Width="NaN"
                        PasswordChar="●"
                        PlaceholderText="{DynamicResource Launcher_ChangePassword_ConfirmPasswordPlaceholder}" />

                    <TextBlock
                        x:Name="DialogErrorText"
                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                        Foreground="{DynamicResource Edge.Brush.Status.Error}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    Grid.Row="2"
                    Margin="0,24,0,0"
                    ColumnDefinitions="*,12,*">
                    <Button
                        Grid.Column="0"
                        Classes="edge-soft-button"
                        Click="CancelButton_Click"
                        HorizontalContentAlignment="Center"
                        MinHeight="38"
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource Launcher_Button_Cancel}" />
                    <Button
                        x:Name="ConfirmButton"
                        Grid.Column="2"
                        Classes="edge-primary-button"
                        Click="ConfirmButton_Click"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{Binding !IsBusy}"
                        MinHeight="38"
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource Launcher_Button_ConfirmChange}" />
                </Grid>
            </Grid>
        </Grid>
    </edge:EdgeCard>
</Window>
