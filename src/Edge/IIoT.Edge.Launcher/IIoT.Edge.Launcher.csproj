<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BaseOutputPath>..\..\..\..\publish\</BaseOutputPath>
    <OutputPath>..\..\..\..\publish\$(Configuration)\launcher\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>..\Assets\icon.ico</ApplicationIcon>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</RepoRoot>
    <RuntimeLayoutSyncProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Tools/IIoT.Edge.RuntimeLayoutSync/IIoT.Edge.RuntimeLayoutSync.csproj'))</RuntimeLayoutSyncProject>
    <RuntimeLayoutSyncAssembly>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../Tools/IIoT.Edge.RuntimeLayoutSync/bin/$(Configuration)/net10.0/IIoT.Edge.RuntimeLayoutSync.dll'))</RuntimeLayoutSyncAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IIoT.Edge.Shell\IIoT.Edge.Shell.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Application\IIoT.Edge.Application\IIoT.Edge.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\IIoT.Edge.Infrastructure.Update\IIoT.Edge.Infrastructure.Update.csproj" />
    <ProjectReference Include="..\..\Shared\IIoT.Edge.SharedKernel\IIoT.Edge.SharedKernel.csproj" />
    <PackageReference Include="IIoT.Edge.UI.Shared" />
  </ItemGroup>

  <ItemGroup>
    <None Update="launcher.accounts.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="launcher.update.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="launcher.profiles.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="Assets\Profiles\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncLauncherLocalRuntimeLayout"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipEdgeRuntimeLayoutSync)' != 'true'">
    <MSBuild Projects="$(RuntimeLayoutSyncProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <Exec Command="dotnet &quot;$(RuntimeLayoutSyncAssembly)&quot; --configuration &quot;$(Configuration)&quot; --repo-root &quot;$(RepoRoot)&quot; --manifest-path &quot;scripts/edge-runtime.publish.json&quot; --launcher-profile-catalog-path &quot;src/Edge/IIoT.Edge.Launcher/launcher.profiles.json&quot; --layout-root &quot;$(TargetDir)..&quot; --launcher-runtime-root &quot;$(TargetDir).&quot; --shell-runtime-root &quot;$(TargetDir)../host/.&quot;"
          WorkingDirectory="$(RepoRoot)" />
  </Target>

</Project>
