<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BaseOutputPath>..\..\..\..\publish\</BaseOutputPath>
    <OutputPath>..\..\..\..\publish\$(Configuration)\launcher\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <SyncEdgeRuntimeScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\scripts\SyncEdgeLocalRuntime.ps1'))</SyncEdgeRuntimeScript>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IIoT.Edge.Shell\IIoT.Edge.Shell.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Shared\IIoT.Edge.UI.Shared\IIoT.Edge.UI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="launcher.accounts.json" Condition="Exists('launcher.accounts.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="launcher.accounts.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="launcher.profiles.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="Assets\Profiles\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="SyncLauncherLocalRuntimeLayout"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipEdgeRuntimeLayoutSync)' != 'true'">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(SyncEdgeRuntimeScript)&quot; -Configuration &quot;$(Configuration)&quot; -LayoutRoot &quot;$(TargetDir)..\.&quot; -LauncherRuntimeRoot &quot;$(TargetDir).&quot; -ShellRuntimeRoot &quot;$(TargetDir)..\shell\.&quot;"
          WorkingDirectory="$(RepoRoot)" />
  </Target>

</Project>
