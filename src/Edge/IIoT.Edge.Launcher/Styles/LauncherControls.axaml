<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.launcher-surface">
        <Setter Property="Background" Value="{DynamicResource Launcher.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Edge.Thickness.Border.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Large}" />
    </Style>

    <Style Selector="Border.launcher-chip">
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.Chip.Comfortable}" />
        <Setter Property="Background" Value="{DynamicResource Launcher.Bg.Chip}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Edge.Thickness.Border.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
    </Style>

    <Style Selector="TextBlock.launcher-title">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Display}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}" />
    </Style>

    <Style Selector="TextBlock.launcher-body">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBox.launcher-input">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.12}" />
        <Setter Property="Background" Value="{DynamicResource Launcher.Bg.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Edge.Thickness.Border.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
    </Style>

    <Style Selector="Button.launcher-primary">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.12}" />
        <Setter Property="Background" Value="{DynamicResource Launcher.Accent.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
    </Style>

    <Style Selector="Button.launcher-ghost">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.12}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Edge.Thickness.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
    </Style>

    <Style Selector="Button.launcher-window-button">
        <Setter Property="Width" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Height" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.Zero}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Launcher.Text.Secondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Small}" />
    </Style>
</Styles>
