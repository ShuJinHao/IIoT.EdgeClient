<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="Launcher.Bg.Window" Color="{StaticResource Edge.Color.Gray100}" />
        <SolidColorBrush x:Key="Launcher.Bg.Surface" Color="{StaticResource Edge.Color.White}" />
        <SolidColorBrush x:Key="Launcher.Bg.SurfaceAlt" Color="{StaticResource Edge.Color.Gray50}" />
        <SolidColorBrush x:Key="Launcher.Bg.Chip" Color="{StaticResource Edge.Color.Lime100}" />
        <SolidColorBrush x:Key="Launcher.Border" Color="{StaticResource Edge.Color.Gray300}" />
        <SolidColorBrush x:Key="Launcher.Text.Primary" Color="{StaticResource Edge.Color.Gray900}" />
        <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="{StaticResource Edge.Color.Gray700}" />
        <SolidColorBrush x:Key="Launcher.Text.Muted" Color="{StaticResource Edge.Color.Gray500}" />
        <SolidColorBrush x:Key="Launcher.Text.Error" Color="{StaticResource Edge.Color.Red500}" />
        <SolidColorBrush x:Key="Launcher.Accent.Default" Color="{StaticResource Edge.Color.Lime500}" />
        <SolidColorBrush x:Key="Launcher.Accent.Light" Color="{StaticResource Edge.Color.Lime500}" />
        <SolidColorBrush x:Key="Launcher.Text.OnAccent" Color="{StaticResource Edge.Color.Gray900}" />
        <SolidColorBrush x:Key="Launcher.Text.OnProfileAccent" Color="{StaticResource Edge.Color.White}" />
        <SolidColorBrush x:Key="Launcher.Bg.ProfileIcon" Color="{StaticResource Edge.Color.White}" Opacity="0.76" />

        <LinearGradientBrush x:Key="Launcher.WindowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{StaticResource Edge.Color.Gray100}" Offset="0" />
            <GradientStop Color="{StaticResource Edge.Color.Gray50}" Offset="0.52" />
            <GradientStop Color="{StaticResource Edge.Color.White}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Launcher.HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="{StaticResource Edge.Color.White}" Offset="0" />
            <GradientStop Color="{StaticResource Edge.Color.Lime100}" Offset="0.58" />
            <GradientStop Color="{StaticResource Edge.Color.Gray50}" Offset="1" />
        </LinearGradientBrush>
    </Styles.Resources>
</Styles>
