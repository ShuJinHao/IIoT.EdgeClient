<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:IIoT.Edge.UI.Shared.Converters;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme
            BaseTheme="Dark"
            PrimaryColor="BlueGrey"
            SecondaryColor="Teal" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Launcher.Bg.Window" Color="#101417" />
    <SolidColorBrush x:Key="Launcher.Bg.Surface" Color="#161C20" />
    <SolidColorBrush x:Key="Launcher.Bg.SurfaceAlt" Color="#1C2328" />
    <SolidColorBrush x:Key="Launcher.Bg.Chip" Color="#20282E" />
    <SolidColorBrush x:Key="Launcher.Border" Color="#2F3940" />
    <SolidColorBrush x:Key="Launcher.Text.Primary" Color="#F7FAFC" />
    <SolidColorBrush x:Key="Launcher.Text.Secondary" Color="#A9B4BE" />
    <SolidColorBrush x:Key="Launcher.Text.Muted" Color="#7D8A96" />
    <SolidColorBrush x:Key="Launcher.Text.Error" Color="#F87171" />
    <SolidColorBrush x:Key="Launcher.Accent.Default" Color="#0F766E" />

    <LinearGradientBrush x:Key="Launcher.WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0C1013" Offset="0" />
        <GradientStop Color="#131A1E" Offset="0.5" />
        <GradientStop Color="#0E1419" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Launcher.HeroOverlay" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6141A1F" Offset="0" />
        <GradientStop Color="#B8141A1F" Offset="0.45" />
        <GradientStop Color="#F012171B" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="LauncherSurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Launcher.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <Style x:Key="LauncherPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
    </Style>

    <Style x:Key="LauncherSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
    </Style>

    <Style x:Key="LauncherBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Secondary}" />
    </Style>

    <Style x:Key="LauncherHintTextBoxStyle"
           BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}"
           TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
        <Setter Property="CaretBrush" Value="#5EEAD4" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="LauncherHintPasswordBoxStyle"
           BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}"
           TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
        <Setter Property="CaretBrush" Value="#5EEAD4" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="LauncherSearchTextBoxStyle"
           BasedOn="{StaticResource MaterialDesignOutlinedTextBox}"
           TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
        <Setter Property="CaretBrush" Value="#5EEAD4" />
        <Setter Property="Background" Value="{StaticResource Launcher.Bg.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="LauncherPrimaryButtonStyle"
           BasedOn="{StaticResource MaterialDesignRaisedButton}"
           TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="{StaticResource Launcher.Accent.Default}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Accent.Default}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
    </Style>

    <Style x:Key="LauncherGhostButtonStyle"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}"
           TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Secondary}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
    </Style>

    <Style x:Key="LauncherWindowCommandButtonStyle"
           BasedOn="{StaticResource MaterialDesignFlatButton}"
           TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Secondary}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
    </Style>

    <Style x:Key="LauncherStatusChipStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="{StaticResource Launcher.Bg.Chip}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <Style x:Key="LauncherProfileCardStyle" TargetType="materialDesign:Card">
        <Setter Property="Width" Value="286" />
        <Setter Property="Margin" Value="12,0,12,24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource Launcher.Bg.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Launcher.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
        <Setter Property="UniformCornerRadius" Value="20" />
    </Style>

    <Style x:Key="LauncherProfileInfoChipStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource Launcher.Bg.Chip}" />
        <Setter Property="BorderBrush" Value="{StaticResource Launcher.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="LauncherMetricCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="BorderBrush" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="0,0,14,14" />
    </Style>

    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
</ResourceDictionary>
