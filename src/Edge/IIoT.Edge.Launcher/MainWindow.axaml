<Window
    x:Class="IIoT.Edge.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Title="{DynamicResource Launcher_WindowTitle}"
    Width="1280"
    Height="760"
    MinWidth="1100"
    MinHeight="700"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="0"
        Background="{DynamicResource Edge.Brush.App.Container}"
        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
        BorderThickness="1"
        BoxShadow="{DynamicResource Edge.Shadow.App}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource Edge.CornerRadius.Stage}">
        <Grid RowDefinitions="44,*">
            <Border
                Grid.Row="0"
                Background="{DynamicResource Edge.Brush.App.Container}"
                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <edge:EdgeHeaderBrand Title="{DynamicResource Launcher_HeaderBrand}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <edge:EdgeActionButton
                            Content="{Binding LanguageToggleText}"
                            Icon="{StaticResource Edge.Icon.Language}"
                            Kind="Ghost"
                            Role="Language"
                            Click="ToggleLanguageButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_SwitchLanguage}" />
                        <edge:EdgeWindowButton
                            Action="Minimize"
                            Click="MinimizeWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Minimize}" />
                        <edge:EdgeWindowButton
                            Action="MaximizeRestore"
                            Click="ToggleWindowStateButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_ToggleWindowState}" />
                        <edge:EdgeWindowButton
                            Action="Close"
                            Click="CloseWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="{DynamicResource Edge.Thickness.32}">
                <Grid x:Name="LoginPageRoot" ColumnDefinitions="380,24,*">
                    <edge:EdgeCard
                        Grid.Column="0"
                        CardBorderThickness="1"
                        CardPadding="{DynamicResource Edge.Thickness.32}"
                        Elevation="Card"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Spacing="12">
                                <Border
                                    Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                    BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon
                                            Width="18"
                                            Height="18"
                                            Data="{StaticResource Edge.Icon.Shield}"
                                            Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                                            Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                            Text="{DynamicResource Launcher_Login_Badge}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                    FontSize="{DynamicResource Edge.FontSize.Display}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{DynamicResource Launcher_Login_Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{DynamicResource Launcher_Login_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Spacing="14">
                                <edge:EdgeTextBox
                                    x:Name="UserNameTextBox"
                                    Classes="edge-text-box dialog-input"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                                <edge:EdgeTextBox
                                    x:Name="PasswordInput"
                                    Classes="edge-text-box dialog-input"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PasswordChar="●"
                                    PlaceholderText="{DynamicResource Launcher_Login_PasswordPlaceholder}" />

                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Status.Error}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />

                                <edge:EdgeActionButton
                                    Click="LoginButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Primary"
                                    MinHeight="42"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_Login}" />

                                <edge:EdgeActionButton
                                    Click="ChangePasswordButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Secondary"
                                    MinHeight="38"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_ChangePassword}" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <PathIcon
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Data="{StaticResource Edge.Icon.Info}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                        Text="{DynamicResource Launcher_Login_BoundaryNote}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Column="2"
                        Classes="launcher-hero-card"
                        MinHeight="470"
                        VerticalAlignment="Center">
                        <Grid>
                            <Border Classes="launcher-hero-background" />
                            <Grid
                                Classes="launcher-hero-shell"
                                RowDefinitions="Auto,Auto,Auto">
                                <StackPanel
                                    Classes="launcher-hero-top"
                                    Orientation="Horizontal">
                                    <Border Classes="launcher-hero-icon-frame">
                                        <PathIcon
                                            Classes="launcher-hero-icon"
                                            Data="{StaticResource Edge.Icon.Launch}" />
                                    </Border>
                                    <edge:EdgeCard Classes="launcher-info-tile launcher-version-tile">
                                        <StackPanel Classes="launcher-info-tile-content">
                                            <TextBlock
                                                Classes="launcher-info-tile-label"
                                                Text="{DynamicResource Launcher_Hero_VersionLabel}" />
                                            <TextBlock
                                                Classes="launcher-info-tile-value"
                                                Text="{Binding AppVersionText}" />
                                        </StackPanel>
                                    </edge:EdgeCard>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Classes="launcher-hero-main">
                                    <TextBlock
                                        Classes="launcher-hero-title"
                                        Text="{DynamicResource Launcher_Hero_Title}"
                                        TextWrapping="Wrap" />
                                    <Grid
                                        Classes="launcher-hero-info-grid"
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="14">
                                        <edge:EdgeCard
                                            Grid.Column="0"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_PlatformLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding PlatformMetaText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="1"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_ArchitectureLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding ArchitectureText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="2"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_MaintainerLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding MaintainerText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Classes="launcher-hero-flow"
                                    Orientation="Horizontal">
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowLogin}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowProfile}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowShell}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </edge:EdgeCard>
                </Grid>

                <Grid
                    x:Name="SelectionPageRoot"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,*,Auto">
                    <edge:EdgeCard
                        CardBorderThickness="1"
                        CardPadding="20"
                        Surface="Card">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource Edge.Brush.Accent.Primary}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Large}">
                                <PathIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Edge.Icon.Dashboard}"
                                    Foreground="{DynamicResource Edge.Brush.Text.OnAccent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Spacing="4">
                                <TextBlock
                                    FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                    FontSize="{DynamicResource Edge.FontSize.Title24}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{DynamicResource Launcher_Selection_Title}" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{DynamicResource Launcher_Selection_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource Edge.Icon.User}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Body}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding WelcomeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Row="1"
                        Margin="0,14,0,14"
                        CardBorderThickness="1"
                        CardPadding="14"
                        Surface="Card">
                        <Grid ColumnDefinitions="320,16,Auto,*">
                            <edge:EdgeTextBox
                                Grid.Column="0"
                                Classes="edge-text-box search-input"
                                Width="320"
                                Text="{Binding ProfileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Launcher_Selection_SearchPlaceholder}" />
                            <Border
                                Grid.Column="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource Edge.Icon.Search}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                        Text="{Binding ProfileSummaryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeScrollHost
                        Grid.Row="2"
                        Margin="0,0,0,14"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeCard
                                        Classes="launcher-process-card"
                                        Width="360"
                                        Margin="0,0,16,16"
                                        ToolTip.Tip="{Binding ProfileId}">
                                        <Grid
                                            Classes="launcher-process-layout"
                                            RowDefinitions="Auto,*,Auto">
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12">
                                                <Border
                                                    Grid.Column="0"
                                                    Classes="launcher-process-icon-frame">
                                                    <Border Classes="launcher-process-icon-inner">
                                                        <PathIcon
                                                            Classes="launcher-process-icon"
                                                            Data="{Binding IconKind, Converter={StaticResource Edge.Converter.ProfileIconPath}}" />
                                                    </Border>
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Classes="launcher-process-title-stack">
                                                    <TextBlock
                                                        Classes="launcher-process-title"
                                                        Text="{Binding DisplayName}" />
                                                    <edge:EdgeStatusChip
                                                        HorizontalAlignment="Left"
                                                        Status="Default"
                                                        Text="{Binding MachineProfile}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel
                                                Grid.Row="1"
                                                Classes="launcher-process-paths">
                                                <Border Classes="launcher-process-path-row">
                                                    <Grid
                                                        ColumnDefinitions="42,*"
                                                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_Profile_PluginLabel}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding PluginDisplayPath}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="launcher-process-path-row">
                                                    <Grid
                                                        ColumnDefinitions="42,*"
                                                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_Profile_DataLabel}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding DataDisplayPath}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <edge:EdgeActionButton
                                                Grid.Row="2"
                                                Click="LaunchProfileButton_Click"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Kind="Primary"
                                                MinHeight="40"
                                                VerticalContentAlignment="Center"
                                                Content="{DynamicResource Launcher_Button_LaunchProfile}" />
                                        </Grid>
                                    </edge:EdgeCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </edge:EdgeScrollHost>

                    <edge:EdgeCard
                        Grid.Row="3"
                        CardBorderThickness="1"
                        CardPadding="14"
                        Surface="Card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Top"
                                    Data="{StaticResource Edge.Icon.Info}"
                                    Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="{DynamicResource Edge.FontSize.Body}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                Foreground="{DynamicResource Edge.Brush.Status.Error}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </edge:EdgeCard>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
