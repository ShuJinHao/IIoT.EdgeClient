<Window
    x:Class="IIoT.Edge.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:IIoT.Edge.Launcher.Converters"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Title="{DynamicResource Launcher_WindowTitle}"
    Width="1280"
    Height="760"
    MinWidth="1100"
    MinHeight="700"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ProfileIconPathConverter x:Key="ProfileIconPathConverter" />
    </Window.Resources>

    <Border
        Margin="0"
        Background="{DynamicResource Edge.Brush.App.Container}"
        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
        BorderThickness="1"
        BoxShadow="{DynamicResource Edge.Shadow.App}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource Edge.CornerRadius.Stage}">
        <Grid RowDefinitions="44,*">
            <Border
                Grid.Row="0"
                Background="{DynamicResource Edge.Brush.App.Container}"
                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <edge:EdgeHeaderBrand Title="{DynamicResource Launcher_HeaderBrand}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <edge:EdgeActionButton
                            Kind="Language"
                            Click="ToggleLanguageButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_SwitchLanguage}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="5">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Classes="edge-language-icon"
                                    Data="{StaticResource Edge.Icon.Language}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{Binding LanguageToggleText}" />
                            </StackPanel>
                        </edge:EdgeActionButton>
                        <edge:EdgeWindowButton
                            Classes="soft-window-action"
                            Click="MinimizeWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Minimize}">
                            <TextBlock
                                Classes="edge-window-symbol"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=edge:EdgeWindowButton}}"
                                Text="─" />
                        </edge:EdgeWindowButton>
                        <edge:EdgeWindowButton
                            Classes="soft-window-action"
                            Click="ToggleWindowStateButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_ToggleWindowState}">
                            <TextBlock
                                Classes="edge-window-symbol"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=edge:EdgeWindowButton}}"
                                Text="☐" />
                        </edge:EdgeWindowButton>
                        <edge:EdgeWindowButton
                            Classes="soft-window-action"
                            Click="CloseWindowButton_Click"
                            Kind="Close"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Close}">
                            <TextBlock
                                Classes="edge-window-symbol"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=edge:EdgeWindowButton}}"
                                Text="✕" />
                        </edge:EdgeWindowButton>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="{DynamicResource Edge.Thickness.32}">
                <Grid x:Name="LoginPageRoot" ColumnDefinitions="380,24,*">
                    <edge:EdgeCard
                        Grid.Column="0"
                        CardBorderThickness="1"
                        CardPadding="{DynamicResource Edge.Thickness.32}"
                        Elevation="Card"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Spacing="12">
                                <Border
                                    Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                    BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon
                                            Width="18"
                                            Height="18"
                                            Data="{StaticResource Edge.Icon.Shield}"
                                            Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                                            Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                            Text="{DynamicResource Launcher_Login_Badge}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                    FontSize="{DynamicResource Edge.FontSize.Display}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{DynamicResource Launcher_Login_Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{DynamicResource Launcher_Login_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Spacing="14">
                                <edge:EdgeLoginInput
                                    x:Name="UserNameTextBox"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                                <edge:EdgeLoginInput
                                    x:Name="PasswordInput"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PasswordChar="●"
                                    PlaceholderText="{DynamicResource Launcher_Login_PasswordPlaceholder}" />

                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Status.Error}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />

                                <edge:EdgeActionButton
                                    Click="LoginButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Primary"
                                    MinHeight="42"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_Login}" />

                                <edge:EdgeActionButton
                                    Click="ChangePasswordButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Soft"
                                    MinHeight="38"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_ChangePassword}" />
                            </StackPanel>

                            <Border
                                Grid.Row="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <PathIcon
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Data="{StaticResource Edge.Icon.Info}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                        Text="{DynamicResource Launcher_Login_BoundaryNote}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeFeatureHeroCard
                        Grid.Column="2"
                        MinHeight="470"
                        VerticalAlignment="Center"
                        Title="{DynamicResource Launcher_Hero_Title}"
                        VersionLabel="{DynamicResource Launcher_Hero_VersionLabel}"
                        VersionText="{Binding AppVersionText}">
                        <edge:EdgeFeatureHeroCard.Icon>
                            <PathIcon
                                Width="32"
                                Height="32"
                                Data="{StaticResource Edge.Icon.Launch}"
                                Foreground="{DynamicResource Edge.Brush.Text.OnAccent}" />
                        </edge:EdgeFeatureHeroCard.Icon>
                        <edge:EdgeFeatureHeroCard.InfoContent>
                            <Grid Width="620" ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                <edge:EdgeInfoTile
                                    Grid.Column="0"
                                    Label="{DynamicResource Launcher_Hero_PlatformLabel}"
                                    Value="{Binding PlatformMetaText}" />
                                <edge:EdgeInfoTile
                                    Grid.Column="1"
                                    Label="{DynamicResource Launcher_Hero_ArchitectureLabel}"
                                    Value="{Binding ArchitectureText}" />
                                <edge:EdgeInfoTile
                                    Grid.Column="2"
                                    Label="{DynamicResource Launcher_Hero_MaintainerLabel}"
                                    Value="{Binding MaintainerText}" />
                            </Grid>
                        </edge:EdgeFeatureHeroCard.InfoContent>
                        <edge:EdgeFeatureHeroCard.FlowContent>
                            <StackPanel Width="620" Orientation="Horizontal" Spacing="10">
                                <edge:EdgeStatusChip
                                    Status="Default"
                                    Text="{DynamicResource Launcher_Hero_FlowLogin}" />
                                <edge:EdgeStatusChip
                                    Status="Default"
                                    Text="{DynamicResource Launcher_Hero_FlowProfile}" />
                                <edge:EdgeStatusChip
                                    Status="Default"
                                    Text="{DynamicResource Launcher_Hero_FlowShell}" />
                            </StackPanel>
                        </edge:EdgeFeatureHeroCard.FlowContent>
                    </edge:EdgeFeatureHeroCard>
                </Grid>

                <Grid
                    x:Name="SelectionPageRoot"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,*,Auto">
                    <edge:EdgeCard
                        CardBorderThickness="1"
                        CardPadding="20"
                        Surface="Card">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border
                                Width="48"
                                Height="48"
                                Background="{DynamicResource Edge.Brush.Accent.Primary}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Large}">
                                <PathIcon
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource Edge.Icon.Dashboard}"
                                    Foreground="{DynamicResource Edge.Brush.Text.OnAccent}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Spacing="4">
                                <TextBlock
                                    FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{DynamicResource Launcher_Selection_Title}" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{DynamicResource Launcher_Selection_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource Edge.Icon.User}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Body}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding WelcomeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Row="1"
                        Margin="0,14,0,14"
                        CardBorderThickness="1"
                        CardPadding="14"
                        Surface="Card">
                        <Grid ColumnDefinitions="320,16,Auto,*">
                            <edge:EdgeLoginInput
                                Grid.Column="0"
                                Width="320"
                                Text="{Binding ProfileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Launcher_Selection_SearchPlaceholder}" />
                            <Border
                                Grid.Column="2"
                                Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource Edge.Icon.Search}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                        Text="{Binding ProfileSummaryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <ScrollViewer
                        Grid.Row="2"
                        Margin="0,0,0,14"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeProcessCard
                                        Width="360"
                                        Margin="0,0,16,16"
                                        DataLabel="{DynamicResource Launcher_Profile_DataLabel}"
                                        DataPath="{Binding DataDisplayPath}"
                                        Detail="{Binding ProfileId}"
                                        PluginLabel="{DynamicResource Launcher_Profile_PluginLabel}"
                                        PluginPath="{Binding PluginDisplayPath}"
                                        Title="{Binding DisplayName}"
                                        Subtitle="{Binding MachineProfile}">
                                        <edge:EdgeProcessCard.Icon>
                                            <PathIcon
                                                Width="22"
                                                Height="22"
                                                Data="{Binding IconKind, Converter={StaticResource ProfileIconPathConverter}}"
                                                Foreground="{DynamicResource Edge.Brush.Text.Primary}" />
                                        </edge:EdgeProcessCard.Icon>
                                        <edge:EdgeProcessCard.ActionContent>
                                            <edge:EdgeActionButton
                                                Click="LaunchProfileButton_Click"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Kind="Primary"
                                                MinHeight="40"
                                                VerticalContentAlignment="Center"
                                                Content="{DynamicResource Launcher_Button_LaunchProfile}" />
                                        </edge:EdgeProcessCard.ActionContent>
                                    </edge:EdgeProcessCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <edge:EdgeCard
                        Grid.Row="3"
                        CardBorderThickness="1"
                        CardPadding="14"
                        Surface="Card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Top"
                                    Data="{StaticResource Edge.Icon.Info}"
                                    Foreground="{DynamicResource Edge.Brush.Accent.Primary}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="{DynamicResource Edge.FontSize.Body}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                Foreground="{DynamicResource Edge.Brush.Status.Error}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </edge:EdgeCard>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
