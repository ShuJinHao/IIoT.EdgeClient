<Window
    x:Class="IIoT.Edge.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Title="{DynamicResource Launcher_WindowTitle}"
    Width="1280"
    Height="760"
    MinWidth="1100"
    MinHeight="700"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="0"
        Background="{DynamicResource Edge.Brush.App.Container}"
        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
        BorderThickness="1"
        BoxShadow="{DynamicResource Edge.Shadow.App}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource Edge.CornerRadius.Stage}">
        <Grid RowDefinitions="44,*">
            <Border
                Grid.Row="0"
                Background="{DynamicResource Edge.Brush.App.Container}"
                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <edge:EdgeHeaderBrand Title="{DynamicResource Launcher_HeaderBrand}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <edge:EdgeActionButton
                            Content="{Binding LanguageToggleText}"
                            Icon="{StaticResource Edge.Icon.Language}"
                            Kind="Ghost"
                            Role="Language"
                            Click="ToggleLanguageButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_SwitchLanguage}" />
                        <edge:EdgeWindowButton
                            Action="Minimize"
                            Click="MinimizeWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Minimize}" />
                        <edge:EdgeWindowButton
                            Action="MaximizeRestore"
                            Click="ToggleWindowStateButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_ToggleWindowState}" />
                        <edge:EdgeWindowButton
                            Action="Close"
                            Click="CloseWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="{DynamicResource Edge.Thickness.32}">
                <Grid x:Name="LoginPageRoot" ColumnDefinitions="380,24,*">
                    <edge:EdgeCard
                        Grid.Column="0"
                        Elevation="Card"
                        PaddingMode="Spacious"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Spacing="12">
                                <Border Classes="launcher-badge">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon
                                            Classes="launcher-badge-icon"
                                            Data="{StaticResource Edge.Icon.Shield}" />
                                        <TextBlock
                                            Classes="launcher-badge-text"
                                            Text="{DynamicResource Launcher_Login_Badge}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Classes="launcher-login-title"
                                    Text="{DynamicResource Launcher_Login_Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="launcher-panel-description"
                                    Text="{DynamicResource Launcher_Login_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Spacing="14">
                                <edge:EdgeTextBox
                                    x:Name="UserNameTextBox"
                                    Classes="edge-text-box dialog-input"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                                <edge:EdgeTextBox
                                    x:Name="PasswordInput"
                                    Classes="edge-text-box dialog-input"
                                    HorizontalAlignment="Stretch"
                                    Width="NaN"
                                    PasswordChar="●"
                                    PlaceholderText="{DynamicResource Launcher_Login_PasswordPlaceholder}" />

                                <TextBlock
                                    Classes="launcher-inline-error"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="launcher-inline-status"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />

                                <edge:EdgeActionButton
                                    Click="LoginButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Primary"
                                    MinHeight="44"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_Login}" />

                                <edge:EdgeActionButton
                                    Click="ChangePasswordButton_Click"
                                    HorizontalContentAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding !IsBusy}"
                                    Kind="Secondary"
                                    MinHeight="44"
                                    VerticalContentAlignment="Center"
                                    Content="{DynamicResource Launcher_Button_ChangePassword}" />
                            </StackPanel>

                            <edge:EdgeNoticeBar
                                Grid.Row="2"
                                Status="Info">
                                <edge:EdgeNoticeBar.Icon>
                                    <PathIcon
                                        Classes="launcher-notice-icon"
                                        Data="{StaticResource Edge.Icon.Info}" />
                                </edge:EdgeNoticeBar.Icon>
                                <TextBlock
                                    Classes="edge-notice-message"
                                    Text="{DynamicResource Launcher_Login_BoundaryNote}"
                                    TextWrapping="Wrap" />
                            </edge:EdgeNoticeBar>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Column="2"
                        Classes="launcher-hero-card"
                        MinHeight="470"
                        VerticalAlignment="Center">
                        <Grid>
                            <Border Classes="launcher-hero-background" />
                            <Grid
                                Classes="launcher-hero-shell"
                                RowDefinitions="Auto,Auto,Auto">
                                <StackPanel
                                    Classes="launcher-hero-top"
                                    Orientation="Horizontal">
                                    <Border Classes="launcher-hero-icon-frame">
                                        <PathIcon
                                            Classes="launcher-hero-icon"
                                            Data="{StaticResource Edge.Icon.Launch}" />
                                    </Border>
                                    <edge:EdgeCard Classes="launcher-info-tile launcher-version-tile">
                                        <StackPanel Classes="launcher-info-tile-content">
                                            <TextBlock
                                                Classes="launcher-info-tile-label"
                                                Text="{DynamicResource Launcher_Hero_VersionLabel}" />
                                            <TextBlock
                                                Classes="launcher-info-tile-value"
                                                Text="{Binding AppVersionText}" />
                                        </StackPanel>
                                    </edge:EdgeCard>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Classes="launcher-hero-main">
                                    <TextBlock
                                        Classes="launcher-hero-title"
                                        Text="{DynamicResource Launcher_Hero_Title}"
                                        TextWrapping="Wrap" />
                                    <Grid
                                        Classes="launcher-hero-info-grid"
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="14">
                                        <edge:EdgeCard
                                            Grid.Column="0"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_PlatformLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding PlatformMetaText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="1"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_ArchitectureLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding ArchitectureText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="2"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_MaintainerLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding MaintainerText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Classes="launcher-hero-flow"
                                    Orientation="Horizontal">
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowLogin}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowProfile}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowShell}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </edge:EdgeCard>
                </Grid>

                <Grid
                    x:Name="SelectionPageRoot"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <edge:EdgeCard
                        PaddingMode="Normal"
                        Surface="Card">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="launcher-selection-icon-frame">
                                <PathIcon
                                    Classes="launcher-selection-icon"
                                    Data="{StaticResource Edge.Icon.Dashboard}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                Spacing="4">
                                <TextBlock
                                    Classes="launcher-selection-title"
                                    Text="{DynamicResource Launcher_Selection_Title}" />
                                <TextBlock
                                    Classes="launcher-panel-description"
                                    Text="{DynamicResource Launcher_Selection_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Classes="launcher-chip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Classes="launcher-chip-icon"
                                        Data="{StaticResource Edge.Icon.User}" />
                                    <TextBlock
                                        Classes="launcher-chip-text"
                                        Text="{Binding WelcomeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Row="1"
                        Margin="0,14,0,14"
                        PaddingMode="Compact"
                        Surface="Card">
                        <Grid ColumnDefinitions="320,16,Auto,*">
                            <edge:EdgeTextBox
                                Grid.Column="0"
                                Classes="edge-text-box search-input"
                                Width="320"
                                Text="{Binding ProfileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Launcher_Selection_SearchPlaceholder}" />
                            <Border
                                Grid.Column="2"
                                Classes="launcher-chip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Classes="launcher-chip-icon compact"
                                        Data="{StaticResource Edge.Icon.Search}" />
                                    <TextBlock
                                        Classes="launcher-chip-text subtle"
                                        Text="{Binding ProfileSummaryText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        x:Name="ClientReleasePanelRoot"
                        Grid.Row="2"
                        Margin="0,0,0,14"
                        IsVisible="{Binding IsClientReleasePanelVisible}"
                        PaddingMode="Compact"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Classes="launcher-selection-title"
                                        Text="{DynamicResource Launcher_ClientRelease_Title}" />
                                    <TextBlock
                                        Classes="launcher-panel-description"
                                        Text="{DynamicResource Launcher_ClientRelease_Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    MinWidth="300"
                                    Spacing="6">
                                    <TextBlock
                                        Classes="launcher-status-message"
                                        HorizontalAlignment="Right"
                                        Text="{Binding ClientReleaseStatusMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="launcher-inline-status"
                                        HorizontalAlignment="Right"
                                        MaxWidth="360"
                                        Text="{Binding ClientReleaseDetailText}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        x:Name="ClientReleaseProgressBar"
                                        Height="4"
                                        IsVisible="{Binding IsClientReleaseProgressVisible}"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding ClientReleaseProgress}" />
                                </StackPanel>
                            </Grid>

                            <edge:EdgeScrollHost
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalScrollBarVisibility="Disabled"
                                MaxHeight="220"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ClientPlugins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <edge:EdgeCard
                                                Classes="launcher-process-card"
                                                Width="330"
                                                Margin="0,0,12,12">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                Classes="launcher-process-title"
                                                                Text="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Classes="launcher-process-path-value"
                                                                Text="{Binding ModuleId}" />
                                                        </StackPanel>
                                                        <edge:EdgeStatusChip
                                                            Grid.Column="1"
                                                            Status="{Binding StatusKind}"
                                                            Text="{Binding StatusText}" />
                                                    </Grid>

                                                    <Grid
                                                        Grid.Row="1"
                                                        ColumnDefinitions="Auto,*,Auto,*,Auto,*"
                                                        ColumnSpacing="8">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_ClientRelease_CurrentVersionLabel}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding CurrentVersion}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_ClientRelease_LatestVersionLabel}" />
                                                        <TextBlock
                                                            Grid.Column="3"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding LatestVersion}" />
                                                        <TextBlock
                                                            Grid.Column="4"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_ClientRelease_SizeLabel}" />
                                                        <TextBlock
                                                            Grid.Column="5"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding PackageSizeText}" />
                                                    </Grid>

                                                    <Grid
                                                        Grid.Row="2"
                                                        ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="10">
                                                        <TextBlock
                                                            Classes="launcher-inline-status"
                                                            Text="{Binding DetailText}"
                                                            TextWrapping="Wrap" />
                                                        <edge:EdgeActionButton
                                                            Grid.Column="1"
                                                            Click="InstallPluginButton_Click"
                                                            Content="{Binding ActionText}"
                                                            Icon="{StaticResource Edge.Icon.Sync}"
                                                            IsEnabled="{Binding CanInstallOrUpdate}"
                                                            Kind="Secondary"
                                                            Size="Compact" />
                                                    </Grid>
                                                </Grid>
                                            </edge:EdgeCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </edge:EdgeScrollHost>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeScrollHost
                        Grid.Row="3"
                        Margin="0,0,0,14"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeCard
                                        Classes="launcher-process-card"
                                        Width="360"
                                        Margin="0,0,16,16"
                                        ToolTip.Tip="{Binding ProfileId}">
                                        <Grid
                                            Classes="launcher-process-layout"
                                            RowDefinitions="Auto,*,Auto">
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12">
                                                <Border
                                                    Grid.Column="0"
                                                    Classes="launcher-process-icon-frame">
                                                    <Border Classes="launcher-process-icon-inner">
                                                        <PathIcon
                                                            Classes="launcher-process-icon"
                                                            Data="{Binding IconKind, Converter={StaticResource Edge.Converter.ProfileIconPath}}" />
                                                    </Border>
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Classes="launcher-process-title-stack">
                                                    <TextBlock
                                                        Classes="launcher-process-title"
                                                        Text="{Binding DisplayName}" />
                                                    <edge:EdgeStatusChip
                                                        HorizontalAlignment="Left"
                                                        Status="Default"
                                                        Text="{Binding MachineProfile}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel
                                                Grid.Row="1"
                                                Classes="launcher-process-paths">
                                                <Border Classes="launcher-process-path-row">
                                                    <Grid
                                                        ColumnDefinitions="42,*"
                                                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_Profile_PluginLabel}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding PluginDisplayPath}" />
                                                    </Grid>
                                                </Border>
                                                <Border Classes="launcher-process-path-row">
                                                    <Grid
                                                        ColumnDefinitions="42,*"
                                                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Classes="launcher-process-path-label"
                                                            Text="{DynamicResource Launcher_Profile_DataLabel}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Classes="launcher-process-path-value"
                                                            Text="{Binding DataDisplayPath}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <Grid
                                                Grid.Row="2"
                                                ColumnDefinitions="*,8,*">
                                                <edge:EdgeActionButton
                                                    Click="ManageProfilePluginsButton_Click"
                                                    HorizontalContentAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{Binding $parent[Window].DataContext.CanCheckClientReleases}"
                                                    Kind="Secondary"
                                                    MinHeight="44"
                                                    VerticalContentAlignment="Center"
                                                    Content="{DynamicResource Launcher_Button_CheckPluginCatalog}" />
                                                <edge:EdgeActionButton
                                                    Grid.Column="2"
                                                    Click="LaunchProfileButton_Click"
                                                    HorizontalContentAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    Kind="Primary"
                                                    MinHeight="44"
                                                    VerticalContentAlignment="Center"
                                                    Content="{DynamicResource Launcher_Button_LaunchProfile}" />
                                            </Grid>
                                        </Grid>
                                    </edge:EdgeCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </edge:EdgeScrollHost>

                    <edge:EdgeCard
                        Grid.Row="4"
                        PaddingMode="Compact"
                        Surface="Card">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <PathIcon
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        Classes="launcher-notice-icon"
                                        Data="{StaticResource Edge.Icon.Info}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Classes="launcher-status-message"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    Classes="launcher-error-message"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                MinWidth="330"
                                Spacing="8">
                                <TextBlock
                                    Classes="launcher-status-message"
                                    HorizontalAlignment="Right"
                                    Text="{Binding UpdateStatusMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="launcher-inline-status"
                                    HorizontalAlignment="Right"
                                    MaxWidth="360"
                                    Text="{Binding UpdateDetailText}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    x:Name="UpdateProgressBar"
                                    Height="4"
                                    IsVisible="{Binding IsUpdateProgressVisible}"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding UpdateProgress}" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <edge:EdgeActionButton
                                        x:Name="CheckUpdatesButton"
                                        Click="CheckUpdatesButton_Click"
                                        Content="{DynamicResource Launcher_Button_CheckUpdates}"
                                        Icon="{StaticResource Edge.Icon.Refresh}"
                                        IsEnabled="{Binding CanCheckUpdates}"
                                        Kind="Secondary"
                                        Size="Compact" />
                                    <edge:EdgeActionButton
                                        x:Name="ApplyUpdateButton"
                                        Click="ApplyUpdateButton_Click"
                                        Content="{DynamicResource Launcher_Button_ApplyUpdate}"
                                        Icon="{StaticResource Edge.Icon.Sync}"
                                        IsEnabled="{Binding CanApplyUpdate}"
                                        Kind="Primary"
                                        Size="Compact" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </edge:EdgeCard>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
