<Window
    x:Class="IIoT.Edge.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Icon="avares://IIoT.Edge.UI.Shared/Assets/images/icon.ico"
    Title="{DynamicResource Launcher_WindowTitle}"
    Width="1280"
    Height="760"
    MinWidth="1100"
    MinHeight="700"
    Background="Transparent"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="0"
        Background="{DynamicResource Edge.Brush.App.Container}"
        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
        BorderThickness="1"
        BoxShadow="{DynamicResource Edge.Shadow.App}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource Edge.CornerRadius.Stage}">
        <Grid RowDefinitions="44,*">
            <Border
                Grid.Row="0"
                Background="{DynamicResource Edge.Brush.App.Container}"
                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="*,Auto">
                    <edge:EdgeHeaderBrand Title="{DynamicResource Launcher_HeaderBrand}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <edge:EdgeActionButton
                            Content="{Binding LanguageToggleText}"
                            Icon="{StaticResource Edge.Icon.Language}"
                            Kind="Ghost"
                            Role="Language"
                            Click="ToggleLanguageButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_SwitchLanguage}" />
                        <edge:EdgeWindowButton
                            Action="Minimize"
                            Click="MinimizeWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Minimize}" />
                        <edge:EdgeWindowButton
                            Action="MaximizeRestore"
                            Click="ToggleWindowStateButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_ToggleWindowState}" />
                        <edge:EdgeWindowButton
                            Action="Close"
                            Click="CloseWindowButton_Click"
                            ToolTip.Tip="{DynamicResource Launcher_ToolTip_Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="{DynamicResource Edge.Thickness.32}">
                <Grid x:Name="LoginPageRoot" ColumnDefinitions="380,24,*">
                    <edge:EdgeCard
                        Grid.Column="0"
                        Elevation="Card"
                        PaddingMode="Spacious"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                            <StackPanel Spacing="12">
                                <Border Classes="launcher-badge">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon
                                            Classes="launcher-badge-icon"
                                            Data="{StaticResource Edge.Icon.Shield}" />
                                        <TextBlock
                                            Classes="launcher-badge-text"
                                            Text="{DynamicResource Launcher_Login_Badge}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Classes="launcher-login-title"
                                    Text="{DynamicResource Launcher_Login_Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Classes="launcher-panel-description"
                                    Text="{DynamicResource Launcher_Login_Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <StackPanel
                                    x:Name="LoginFormPanel"
                                    IsVisible="{Binding IsLoginMode}"
                                    VerticalAlignment="Center"
                                    Spacing="14">
                                    <edge:EdgeTextBox
                                        x:Name="UserNameTextBox"
                                        Classes="edge-text-box dialog-input"
                                        HorizontalAlignment="Stretch"
                                        Width="NaN"
                                        PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                                    <edge:EdgeTextBox
                                        x:Name="PasswordInput"
                                        Classes="edge-text-box dialog-input"
                                        HorizontalAlignment="Stretch"
                                        Width="NaN"
                                        PasswordChar="●"
                                        PlaceholderText="{DynamicResource Launcher_Login_PasswordPlaceholder}" />

                                    <TextBlock
                                        Classes="launcher-inline-error"
                                        Text="{Binding ErrorMessage}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="launcher-inline-status"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap" />

                                    <edge:EdgeActionButton
                                        Click="LoginButton_Click"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding !IsBusy}"
                                        Kind="Primary"
                                        MinHeight="44"
                                        VerticalContentAlignment="Center"
                                        Content="{DynamicResource Launcher_Button_Login}" />

                                    <edge:EdgeActionButton
                                        Click="ChangePasswordButton_Click"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding !IsBusy}"
                                        Kind="Secondary"
                                        MinHeight="44"
                                        VerticalContentAlignment="Center"
                                        Content="{DynamicResource Launcher_Button_ChangePassword}" />
                                </StackPanel>

                                <Grid
                                    x:Name="AccountSetupPanel"
                                    IsVisible="{Binding AccountSetupRequired}"
                                    RowDefinitions="*,Auto"
                                    RowSpacing="12">
                                    <edge:EdgeScrollHost
                                        x:Name="AccountSetupFieldsScrollHost"
                                        Grid.Row="0"
                                        Variant="Panel"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="12">
                                            <TextBlock
                                                Classes="launcher-panel-title"
                                                Text="{DynamicResource Launcher_AccountSetup_Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Classes="launcher-panel-description"
                                                Text="{DynamicResource Launcher_AccountSetup_Description}"
                                                TextWrapping="Wrap" />
                                            <edge:EdgeTextBox
                                                x:Name="AccountSetupUserNameTextBox"
                                                Classes="edge-text-box dialog-input"
                                                HorizontalAlignment="Stretch"
                                                Width="NaN"
                                                Text="{Binding AccountSetupUserName, Mode=TwoWay}"
                                                PlaceholderText="{DynamicResource Launcher_Login_UserNamePlaceholder}" />
                                            <edge:EdgeTextBox
                                                x:Name="AccountSetupDisplayNameTextBox"
                                                Classes="edge-text-box dialog-input"
                                                HorizontalAlignment="Stretch"
                                                Width="NaN"
                                                Text="{Binding AccountSetupDisplayName, Mode=TwoWay}"
                                                PlaceholderText="{DynamicResource Launcher_AccountSetup_DisplayNamePlaceholder}" />
                                            <edge:EdgeTextBox
                                                x:Name="AccountSetupPasswordInput"
                                                Classes="edge-text-box dialog-input"
                                                HorizontalAlignment="Stretch"
                                                Width="NaN"
                                                PasswordChar="●"
                                                PlaceholderText="{DynamicResource Launcher_AccountSetup_NewPasswordPlaceholder}" />
                                            <edge:EdgeTextBox
                                                x:Name="AccountSetupConfirmPasswordInput"
                                                Classes="edge-text-box dialog-input"
                                                HorizontalAlignment="Stretch"
                                                Width="NaN"
                                                PasswordChar="●"
                                                PlaceholderText="{DynamicResource Launcher_AccountSetup_ConfirmPasswordPlaceholder}" />

                                            <TextBlock
                                                Classes="launcher-inline-error"
                                                Text="{Binding ErrorMessage}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Classes="launcher-inline-status"
                                                Text="{Binding StatusMessage}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </edge:EdgeScrollHost>

                                    <edge:EdgeActionButton
                                        x:Name="InitializeAccountButton"
                                        Grid.Row="1"
                                        Click="InitializeAccountButton_Click"
                                        HorizontalContentAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{Binding !IsBusy}"
                                        Kind="Primary"
                                        MinHeight="44"
                                        VerticalContentAlignment="Center"
                                        Content="{DynamicResource Launcher_Button_InitializeAccount}" />
                                </Grid>

                                <StackPanel
                                    x:Name="AccountCatalogCorruptPanel"
                                    IsVisible="{Binding AccountCatalogCorrupt}"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                                    <TextBlock
                                        Classes="launcher-panel-title"
                                        Text="{DynamicResource Launcher_AccountCatalogCorrupt_Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="launcher-panel-description"
                                        Text="{DynamicResource Launcher_AccountCatalogCorrupt_Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="launcher-inline-error"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <edge:EdgeNoticeBar
                                x:Name="LoginBoundaryNotice"
                                Grid.Row="2"
                                Status="Info">
                                <edge:EdgeNoticeBar.Icon>
                                    <PathIcon
                                        Classes="launcher-notice-icon"
                                        Data="{StaticResource Edge.Icon.Info}" />
                                </edge:EdgeNoticeBar.Icon>
                                <TextBlock
                                    Classes="edge-notice-message"
                                    Text="{DynamicResource Launcher_Login_BoundaryNote}"
                                    TextWrapping="Wrap" />
                            </edge:EdgeNoticeBar>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        Grid.Column="2"
                        Classes="launcher-hero-card"
                        MinHeight="470"
                        VerticalAlignment="Center">
                        <Grid>
                            <Border Classes="launcher-hero-background" />
                            <Grid
                                Classes="launcher-hero-shell"
                                RowDefinitions="Auto,Auto,Auto">
                                <StackPanel
                                    Classes="launcher-hero-top"
                                    Orientation="Horizontal">
                                    <Border Classes="launcher-hero-icon-frame">
                                        <PathIcon
                                            Classes="launcher-hero-icon"
                                            Data="{StaticResource Edge.Icon.Launch}" />
                                    </Border>
                                    <edge:EdgeCard Classes="launcher-info-tile launcher-version-tile">
                                        <StackPanel Classes="launcher-info-tile-content">
                                            <TextBlock
                                                Classes="launcher-info-tile-label"
                                                Text="{DynamicResource Launcher_Hero_VersionLabel}" />
                                            <TextBlock
                                                Classes="launcher-info-tile-value"
                                                Text="{Binding AppVersionText}" />
                                        </StackPanel>
                                    </edge:EdgeCard>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Classes="launcher-hero-main">
                                    <TextBlock
                                        Classes="launcher-hero-title"
                                        Text="{DynamicResource Launcher_Hero_Title}"
                                        TextWrapping="Wrap" />
                                    <Grid
                                        Classes="launcher-hero-info-grid"
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="14">
                                        <edge:EdgeCard
                                            Grid.Column="0"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_PlatformLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding PlatformMetaText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="1"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_ArchitectureLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding ArchitectureText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                        <edge:EdgeCard
                                            Grid.Column="2"
                                            Classes="launcher-info-tile">
                                            <StackPanel Classes="launcher-info-tile-content">
                                                <TextBlock
                                                    Classes="launcher-info-tile-label"
                                                    Text="{DynamicResource Launcher_Hero_MaintainerLabel}" />
                                                <TextBlock
                                                    Classes="launcher-info-tile-value"
                                                    Text="{Binding MaintainerText}" />
                                            </StackPanel>
                                        </edge:EdgeCard>
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Classes="launcher-hero-flow"
                                    Orientation="Horizontal">
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowLogin}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowProfile}" />
                                    <edge:EdgeStatusChip
                                        Status="Default"
                                        Text="{DynamicResource Launcher_Hero_FlowShell}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </edge:EdgeCard>
                </Grid>

                <Grid
                    x:Name="SelectionPageRoot"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,*"
                    RowSpacing="14">
                    <edge:EdgeCard
                        PaddingMode="Compact"
                        Surface="Card">
                        <Grid ColumnDefinitions="320,16,Auto,*">
                            <edge:EdgeTextBox
                                Grid.Column="0"
                                Classes="edge-text-box search-input"
                                Width="320"
                                Text="{Binding ProfileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{DynamicResource Launcher_Selection_SearchPlaceholder}" />
                            <Border
                                Grid.Column="2"
                                Classes="launcher-chip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Classes="launcher-chip-icon compact"
                                        Data="{StaticResource Edge.Icon.Search}" />
                                    <TextBlock
                                        Classes="launcher-chip-text subtle"
                                        Text="{Binding ProfileSummaryText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Classes="launcher-chip">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Classes="launcher-chip-icon compact"
                                        Data="{StaticResource Edge.Icon.User}" />
                                    <TextBlock
                                        Classes="launcher-chip-text"
                                        Text="{Binding WelcomeText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeCard
                        x:Name="UpdateCenterPanelRoot"
                        Grid.Row="1"
                        PaddingMode="Compact"
                        Surface="Card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <edge:EdgeSectionHeader
                                    Title="{DynamicResource Launcher_UpdateCenter_Title}"
                                    Subtitle="{DynamicResource Launcher_UpdateCenter_Description}" />
                                <edge:EdgeActionButton
                                    x:Name="RefreshUpdateCenterButton"
                                    Grid.Column="1"
                                    Click="RefreshUpdateCenterButton_Click"
                                    Content="{DynamicResource Launcher_UpdateCenter_ButtonRefresh}"
                                    Icon="{StaticResource Edge.Icon.Refresh}"
                                    IsEnabled="{Binding ClientReleasePanel.CanCheckReleases}"
                                    Kind="Secondary"
                                    Size="Compact" />
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Classes="launcher-inline-status"
                                Text="{Binding ClientReleasePanel.StatusMessage}"
                                TextWrapping="Wrap" />
                            <edge:EdgeProgressBar
                                x:Name="ClientReleaseProgressBar"
                                Grid.Row="2"
                                IsVisible="{Binding ClientReleasePanel.IsProgressVisible}"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding ClientReleasePanel.Progress}" />
                            <TextBlock
                                Grid.Row="3"
                                Classes="launcher-inline-status"
                                Text="{Binding ClientReleasePanel.DetailText}"
                                TextWrapping="Wrap" />

                            <edge:EdgeDataGrid
                                x:Name="UpdateCenterRowsGrid"
                                Grid.Row="4"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding UpdateRows}"
                                ViewportMaxHeight="150">
                                <edge:EdgeDataGrid.Columns>
                                        <edge:EdgeTemplateColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnComponent}"
                                            MinWidth="150"
                                            Width="2*">
                                            <edge:EdgeTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Classes="launcher-chip-text"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </edge:EdgeTemplateColumn.CellTemplate>
                                        </edge:EdgeTemplateColumn>
                                        <edge:EdgeTemplateColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnType}"
                                            MinWidth="78"
                                            Width="92">
                                            <edge:EdgeTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <edge:EdgeStatusChip
                                                        VerticalAlignment="Center"
                                                        Status="Info"
                                                        Text="{Binding ComponentKindText}" />
                                                </DataTemplate>
                                            </edge:EdgeTemplateColumn.CellTemplate>
                                        </edge:EdgeTemplateColumn>
                                        <edge:EdgeTextColumn
                                            Binding="{Binding CurrentVersion}"
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnCurrentVersion}"
                                            IsReadOnly="True"
                                            MinWidth="90"
                                            Width="100" />
                                        <edge:EdgeTextColumn
                                            Binding="{Binding TargetVersion}"
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnLatestVersion}"
                                            IsReadOnly="True"
                                            MinWidth="90"
                                            Width="100" />
                                        <edge:EdgeTemplateColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnStatus}"
                                            MinWidth="96"
                                            Width="112">
                                            <edge:EdgeTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <edge:EdgeStatusChip
                                                        VerticalAlignment="Center"
                                                        Status="{Binding StatusKind}"
                                                        Text="{Binding StatusText}" />
                                                </DataTemplate>
                                            </edge:EdgeTemplateColumn.CellTemplate>
                                        </edge:EdgeTemplateColumn>
                                        <edge:EdgeTextColumn
                                            Binding="{Binding PublishedAtText}"
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnPublishedAt}"
                                            IsReadOnly="True"
                                            MinWidth="120"
                                            Width="138" />
                                        <edge:EdgeTextColumn
                                            Binding="{Binding PackageSizeDisplayText}"
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnSize}"
                                            IsReadOnly="True"
                                            MinWidth="72"
                                            Width="86" />
                                        <edge:EdgeTemplateColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnReleaseNotes}"
                                            MinWidth="130"
                                            Width="2*">
                                            <edge:EdgeTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="launcher-chip-text subtle"
                                                            MaxLines="2"
                                                            Text="{Binding ReleaseNotesText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <edge:EdgeActionButton
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Click="OpenReleaseNotesButton_Click"
                                                            Content="{DynamicResource Launcher_UpdateCenter_ButtonViewReleaseNotes}"
                                                            Icon="{StaticResource Edge.Icon.Info}"
                                                            Kind="Ghost"
                                                            Role="Cell"
                                                            Size="Compact" />
                                                    </Grid>
                                                </DataTemplate>
                                            </edge:EdgeTemplateColumn.CellTemplate>
                                        </edge:EdgeTemplateColumn>
                                        <edge:EdgeActionColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnAction}"
                                            MinWidth="104"
                                            Width="118">
                                            <edge:EdgeActionColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <edge:EdgeActionButton
                                                            VerticalAlignment="Center"
                                                            Click="InstallPluginUpdateButton_Click"
                                                            Content="{Binding ActionText}"
                                                            Icon="{StaticResource Edge.Icon.Sync}"
                                                            IsVisible="{Binding CanInstallOrUpdate}"
                                                            Kind="Secondary"
                                                            Size="Compact" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="launcher-chip-text subtle"
                                                            IsVisible="{Binding HasNoInstallOrUpdate}"
                                                            Text="{Binding ActionText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </edge:EdgeActionColumn.CellTemplate>
                                        </edge:EdgeActionColumn>
                                        <edge:EdgeActionColumn
                                            Header="{DynamicResource Launcher_UpdateCenter_ColumnHistory}"
                                            MinWidth="104"
                                            Width="118">
                                            <edge:EdgeActionColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <edge:EdgeActionButton
                                                            VerticalAlignment="Center"
                                                            Click="OpenRowVersionHistoryButton_Click"
                                                            Content="{Binding HistoryActionText}"
                                                            Icon="{StaticResource Edge.Icon.Calendar}"
                                                            IsVisible="{Binding HasVersionHistory}"
                                                            Kind="Secondary"
                                                            Size="Compact" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Classes="launcher-chip-text subtle"
                                                            IsVisible="{Binding HasNoVersionHistory}"
                                                            Text="{Binding EmptyHistoryText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </edge:EdgeActionColumn.CellTemplate>
                                        </edge:EdgeActionColumn>
                                </edge:EdgeDataGrid.Columns>
                            </edge:EdgeDataGrid>
                        </Grid>
                    </edge:EdgeCard>

                    <edge:EdgeScrollHost
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeCard
                                        Classes="launcher-process-card"
                                        Width="360"
                                        Margin="0,0,16,16"
                                        ToolTip.Tip="{Binding ProfileId}">
                                        <Grid
                                            Classes="launcher-process-layout"
                                            RowDefinitions="Auto,*,Auto">
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12">
                                                <Border
                                                    Grid.Column="0"
                                                    Classes="launcher-process-icon-frame">
                                                    <Border Classes="launcher-process-icon-inner">
                                                        <PathIcon
                                                            Classes="launcher-process-icon"
                                                            Data="{Binding IconKind, Converter={StaticResource Edge.Converter.ProfileIconPath}}" />
                                                    </Border>
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Classes="launcher-process-title"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}" />
                                            </Grid>

                                            <Grid
                                                Grid.Row="2"
                                                ColumnDefinitions="*">
                                                <edge:EdgeActionButton
                                                    Classes="launcher-brand-action"
                                                    Click="LaunchProfileButton_Click"
                                                    HorizontalContentAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="{Binding IsPrimaryActionEnabled}"
                                                    Kind="Primary"
                                                    MinHeight="44"
                                                    VerticalContentAlignment="Center"
                                                    Content="{DynamicResource Launcher_Button_LaunchProfile}" />
                                            </Grid>
                                        </Grid>
                                    </edge:EdgeCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </edge:EdgeScrollHost>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
