<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">
    <sys:String x:Key="Shell_AppTitle">IIoT 边缘客户端</sys:String>
    <sys:String x:Key="Shell_MainWorkspace">主工作区</sys:String>
    <sys:String x:Key="Shell_EquipmentInfo">设备信息</sys:String>
    <sys:String x:Key="Shell_SystemLog">系统日志</sys:String>
</ResourceDictionary>
