<Window
    x:Class="IIoT.Edge.Shell.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellViews="clr-namespace:IIoT.Edge.Presentation.Shell.Views;assembly=IIoT.Edge.Presentation.Shell"
    Title="{Binding AppTitle}"
    Width="1280"
    Height="768"
    MinWidth="1280"
    MinHeight="720"
    Background="{DynamicResource Edge.Background.App}"
    ExtendClientAreaToDecorationsHint="True"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen">
    <Border
        Margin="{DynamicResource Edge.Thickness.Frame}"
        Background="{DynamicResource Edge.Surface.Main}"
        BorderBrush="{DynamicResource Edge.Border.Subtle}"
        BorderThickness="{DynamicResource Edge.Thickness.Border.Subtle}"
        CornerRadius="{DynamicResource Edge.CornerRadius.Large}">
        <Grid ColumnDefinitions="64,*,320" RowDefinitions="64,*,34">
            <ContentControl
                x:Name="NavigationRailHost"
                Grid.RowSpan="3" />
            <shellViews:ShellHeaderView
                Grid.Column="1"
                Grid.ColumnSpan="2"
                DataContext="{Binding}" />
            <ContentControl
                x:Name="NavigationContentHost"
                Grid.Row="1"
                Grid.Column="1"
                ClipToBounds="True"
                ZIndex="0" />
            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Margin="{DynamicResource Edge.Thickness.RightRail}"
                RowDefinitions="*,Auto,*"
                ZIndex="2">
                <ContentControl x:Name="EquipmentPanelHost" />
                <Border
                    Grid.Row="1"
                    Height="{DynamicResource Edge.Size.PanelGap}" />
                <ContentControl
                    x:Name="LogPanelHost"
                    Grid.Row="2" />
            </Grid>
            <shellViews:ShellFooterView
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                DataContext="{Binding}" />
        </Grid>
    </Border>
</Window>
