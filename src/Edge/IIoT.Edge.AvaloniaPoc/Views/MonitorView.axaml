<UserControl
    x:Class="IIoT.Edge.AvaloniaPoc.Views.MonitorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowDefinitions="Auto,Auto,*" Margin="14" RowSpacing="14">
    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Poc_Tab_Monitor}" />

    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Padding="14" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" Foreground="#E2E8F0" Text="{DynamicResource Poc_Monitor_DayShift}" />
          <UniformGrid Columns="4">
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Total}" />
              <TextBlock FontSize="24" Foreground="#F8FAFC" Text="{Binding DayTotal}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Good}" />
              <TextBlock FontSize="24" Foreground="#86EFAC" Text="{Binding DayGood}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Bad}" />
              <TextBlock FontSize="24" Foreground="#FDA4AF" Text="{Binding DayBad}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Yield}" />
              <TextBlock FontSize="24" Foreground="#93C5FD" Text="{Binding DayYield}" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Padding="14" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" Foreground="#E2E8F0" Text="{DynamicResource Poc_Monitor_NightShift}" />
          <UniformGrid Columns="4">
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Total}" />
              <TextBlock FontSize="24" Foreground="#F8FAFC" Text="{Binding NightTotal}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Good}" />
              <TextBlock FontSize="24" Foreground="#86EFAC" Text="{Binding NightGood}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Bad}" />
              <TextBlock FontSize="24" Foreground="#FDA4AF" Text="{Binding NightBad}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Foreground="#94A3B8" Text="{DynamicResource Poc_Monitor_Yield}" />
              <TextBlock FontSize="24" Foreground="#93C5FD" Text="{Binding NightYield}" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="12" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <TextBlock FontWeight="SemiBold" Foreground="#E2E8F0" Text="{DynamicResource Poc_Monitor_GridTitle}" />
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="True"
            Background="#0F172A"
            BorderBrush="#263244"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding Rows}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
