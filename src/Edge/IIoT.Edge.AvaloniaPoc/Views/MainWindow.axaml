<suki:SukiWindow
    x:Class="IIoT.Edge.AvaloniaPoc.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:IIoT.Edge.AvaloniaPoc.Converters"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:models="clr-namespace:IIoT.Edge.AvaloniaPoc.Models"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    Width="1360"
    Height="860"
    MinWidth="1100"
    MinHeight="720"
    Title="{DynamicResource Poc_App_Title}"
    Background="#0F172A"
    CanFullScreen="True"
    RootCornerRadius="8"
    ShowTitlebarBackground="True">

  <suki:SukiWindow.Resources>
    <converters:StatusBrushConverter x:Key="StatusBrushConverter" />
  </suki:SukiWindow.Resources>

  <suki:SukiWindow.DataTemplates>
    <DataTemplate DataType="{x:Type models:PocDockable}">
      <ContentControl Content="{Binding Content}" />
    </DataTemplate>
  </suki:SukiWindow.DataTemplates>

  <dialogHost:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True">
    <dialogHost:DialogHost.DialogContent>
      <Border Width="360" Padding="22" Background="#1E293B" CornerRadius="8">
        <StackPanel Spacing="14">
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Poc_Dialog_Title}" />
          <TextBlock Foreground="#CBD5E1" Text="{DynamicResource Poc_Dialog_Message}" TextWrapping="Wrap" />
          <Button HorizontalAlignment="Right" Command="{Binding CloseDialogCommand}" Content="{DynamicResource Poc_Action_Close}" />
        </StackPanel>
      </Border>
    </dialogHost:DialogHost.DialogContent>

    <Grid RowDefinitions="64,*" Background="#0F172A">
      <Border Grid.Row="0" Background="#111827" BorderBrush="#263244" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="260,*,Auto" Margin="18,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Poc_Header_Process}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8" Text="{DynamicResource Poc_Header_Device}" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
            <Border Padding="10,5" Background="#172554" CornerRadius="6">
              <TextBlock Foreground="#BFDBFE" Text="Avalonia 12 + SukiUI" />
            </Border>
            <Border Padding="10,5" Background="#422006" CornerRadius="6">
              <TextBlock Foreground="#FDE68A" Text="SkiaSharp preview 例外已记录" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" Text="{Binding CultureName}" />
            <Button Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageToggleText}" />
            <Button Command="{Binding OpenDialogCommand}" Content="{DynamicResource Poc_Action_Dialog}" />
          </StackPanel>
        </Grid>
      </Border>

      <dock:DockControl
          Grid.Row="1"
          AutoCreateDataTemplates="True"
          Factory="{Binding DockFactory}"
          InitializeFactory="True"
          InitializeLayout="True"
          IsDockingEnabled="True"
          Layout="{Binding DockLayout}" />
    </Grid>
  </dialogHost:DialogHost>
</suki:SukiWindow>
