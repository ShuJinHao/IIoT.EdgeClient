<UserControl
    x:Class="IIoT.Edge.AvaloniaPoc.Views.LogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border Margin="10" Padding="10" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8">
    <ListBox Background="#0F172A" BorderThickness="0" ItemsSource="{Binding Entries}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Margin="4" FontSize="12" Foreground="#CBD5E1" Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Border>
</UserControl>
