<UserControl
    x:Class="IIoT.Edge.AvaloniaPoc.Views.EquipmentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.AvaloniaPoc.Localization">

  <Border Margin="10" Padding="10" Background="#111827" BorderBrush="#263244" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
      <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Poc_Equipment_Title}" />
      <DataGrid
          Grid.Row="1"
          AutoGenerateColumns="False"
          Background="#0F172A"
          BorderBrush="#263244"
          GridLinesVisibility="Horizontal"
          IsReadOnly="True"
          ItemsSource="{Binding Rows}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="70" loc:LocalizedDataGrid.HeaderResourceKey="Poc_Column_Status">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Ellipse
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    Fill="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="*" Binding="{Binding Name}" loc:LocalizedDataGrid.HeaderResourceKey="Poc_Column_Name" />
          <DataGridTextColumn Width="95" Binding="{Binding Connection}" loc:LocalizedDataGrid.HeaderResourceKey="Poc_Column_Connection" />
          <DataGridTextColumn Width="110" Binding="{Binding CurrentValue}" loc:LocalizedDataGrid.HeaderResourceKey="Poc_Column_Value" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>
