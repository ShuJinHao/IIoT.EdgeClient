<Application
    x:Class="IIoT.Edge.AvaloniaPoc.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
    RequestedThemeVariant="Dark">

  <Application.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://SukiUI.Dock/Index.axaml" />
    <suki:SukiTheme ThemeColor="Blue" Locale="zh-CN" />
    <dialogHost:DialogHostStyles />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <x:String x:Key="Poc_App_Title">边缘客户端 Avalonia PoC</x:String>
      <x:String x:Key="Poc_Header_Process">工序运行看板</x:String>
      <x:String x:Key="Poc_Header_Device">设备：压装一线-01</x:String>
      <x:String x:Key="Poc_Action_Language">EN</x:String>
      <x:String x:Key="Poc_Action_Dialog">打开弹窗</x:String>
      <x:String x:Key="Poc_Dialog_Title">确认操作</x:String>
      <x:String x:Key="Poc_Dialog_Message">这是 Avalonia DialogHost 迁移验证弹窗。</x:String>
      <x:String x:Key="Poc_Action_Close">关闭</x:String>
      <x:String x:Key="Poc_Tab_Monitor">生产监控</x:String>
      <x:String x:Key="Poc_Tab_IO">IO 调试</x:String>
      <x:String x:Key="Poc_Tool_Equipment">设备面板</x:String>
      <x:String x:Key="Poc_Tool_Log">运行日志</x:String>
      <x:String x:Key="Poc_Monitor_DayShift">白班</x:String>
      <x:String x:Key="Poc_Monitor_NightShift">夜班</x:String>
      <x:String x:Key="Poc_Monitor_Total">总数</x:String>
      <x:String x:Key="Poc_Monitor_Good">良品</x:String>
      <x:String x:Key="Poc_Monitor_Bad">不良</x:String>
      <x:String x:Key="Poc_Monitor_Yield">良率</x:String>
      <x:String x:Key="Poc_Monitor_GridTitle">实时过程数据</x:String>
      <x:String x:Key="Poc_IO_Title">IO 读写矩阵</x:String>
      <x:String x:Key="Poc_Column_Signal">PLC 信号</x:String>
      <x:String x:Key="Poc_Column_Address">地址</x:String>
      <x:String x:Key="Poc_Column_CurrentReply">当前应答</x:String>
      <x:String x:Key="Poc_Column_Write">写入操作</x:String>
      <x:String x:Key="Poc_Button_Write">写入</x:String>
      <x:String x:Key="Poc_Equipment_Title">设备状态</x:String>
      <x:String x:Key="Poc_Column_Status">状态</x:String>
      <x:String x:Key="Poc_Column_Name">名称</x:String>
      <x:String x:Key="Poc_Column_Connection">连接</x:String>
      <x:String x:Key="Poc_Column_Value">当前值</x:String>
    </ResourceDictionary>
  </Application.Resources>
</Application>
