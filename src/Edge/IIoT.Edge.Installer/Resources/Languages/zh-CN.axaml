<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">
    <sys:String x:Key="Installer_WindowTitle">IIoT Edge 客户端安装</sys:String>
    <sys:String x:Key="Installer_ProductName">IIoT Edge 客户端</sys:String>
    <sys:String x:Key="Installer_ProductSubtitle">工业物联网边缘计算客户端</sys:String>
    <sys:String x:Key="Installer_Button_QuickInstall">一键安装</sys:String>
    <sys:String x:Key="Installer_Button_CustomInstall">自定义安装</sys:String>
    <sys:String x:Key="Installer_DefaultPathPrefix">默认安装到 </sys:String>
    <sys:String x:Key="Installer_Custom_Title">自定义安装</sys:String>
    <sys:String x:Key="Installer_Custom_Subtitle">选择安装位置和其他选项</sys:String>
    <sys:String x:Key="Installer_Field_InstallDirectory">安装目录</sys:String>
    <sys:String x:Key="Installer_Button_Browse">浏览...</sys:String>
    <sys:String x:Key="Installer_Field_InstallOptions">安装选项</sys:String>
    <sys:String x:Key="Installer_Option_DesktopShortcut">创建桌面快捷方式</sys:String>
    <sys:String x:Key="Installer_Button_Back">返回</sys:String>
    <sys:String x:Key="Installer_Button_StartInstall">开始安装</sys:String>
    <sys:String x:Key="Installer_Installing_Title">正在安装</sys:String>
    <sys:String x:Key="Installer_Installing_Subtitle">请耐心等待，安装即将完成...</sys:String>
    <sys:String x:Key="Installer_Progress_Preparing">正在准备...</sys:String>
    <sys:String x:Key="Installer_Complete_Title">安装完成</sys:String>
    <sys:String x:Key="Installer_Button_Finish">完成</sys:String>
    <sys:String x:Key="Installer_Button_Launch">启动客户端</sys:String>
    <sys:String x:Key="Installer_Error_Title">安装失败</sys:String>
    <sys:String x:Key="Installer_Button_Close">关闭</sys:String>
    <sys:String x:Key="Installer_Button_Retry">重试</sys:String>
    <sys:String x:Key="Installer_FolderPicker_Title">选择安装目录</sys:String>
    <sys:String x:Key="Installer_Complete_MessageFormat">已安装到 {0}</sys:String>
    <sys:String x:Key="Installer_Progress_ReadPackage">正在读取安装包...</sys:String>
    <sys:String x:Key="Installer_Error_SelfPath">无法定位安装器自身路径。</sys:String>
    <sys:String x:Key="Installer_Error_EmptyShell">这是空的安装器外壳，请从云端“客户端下载中心”获取带配置的安装包。</sys:String>
    <sys:String x:Key="Installer_Progress_ExtractPackage">正在解压安装包...</sys:String>
    <sys:String x:Key="Installer_Progress_InstallCore">正在安装核心组件...</sys:String>
    <sys:String x:Key="Installer_Error_MissingVelopackSetup">安装包缺少 Velopack Setup.exe，已停止安装。请重新从云端客户端下载中心生成安装包。</sys:String>
    <sys:String x:Key="Installer_Error_CoreInstallerExitFormat">核心安装器退出码：{0}</sys:String>
    <sys:String x:Key="Installer_Progress_WriteConfig">正在写入配置文件...</sys:String>
    <sys:String x:Key="Installer_Error_BootstrapCopyFormat">首装绑定文件落位失败：{0}</sys:String>
    <sys:String x:Key="Installer_Progress_CreateShortcut">正在创建桌面快捷方式...</sys:String>
    <sys:String x:Key="Installer_Progress_Complete">安装完成</sys:String>
    <sys:String x:Key="Installer_Progress_Install">正在安装...</sys:String>
    <sys:String x:Key="Installer_Result_Complete">安装完成。</sys:String>
    <sys:String x:Key="Installer_Error_Canceled">安装已取消。</sys:String>
    <sys:String x:Key="Installer_Error_InstallFailedFormat">安装失败：{0}</sys:String>
    <sys:String x:Key="Installer_ShortcutName">IIoT Edge 客户端</sys:String>
</ResourceDictionary>
