<Application
    x:Class="IIoT.Edge.AvaloniaShell.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
    RequestedThemeVariant="Dark">

  <Application.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://SukiUI.Dock/Index.axaml" />
    <suki:SukiTheme ThemeColor="Blue" Locale="zh-CN" />
    <dialogHost:DialogHostStyles />
  </Application.Styles>
</Application>
