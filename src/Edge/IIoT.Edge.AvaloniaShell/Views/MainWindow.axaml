<suki:SukiWindow
    x:Class="IIoT.Edge.AvaloniaShell.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:IIoT.Edge.AvaloniaShell.Converters"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    xmlns:docking="clr-namespace:IIoT.Edge.UI.Avalonia.Docking;assembly=IIoT.Edge.UI.Avalonia"
    xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    Width="1360"
    Height="860"
    MinWidth="1100"
    MinHeight="720"
    Title="{DynamicResource Shell_App_Title}"
    Background="#0F172A"
    CanFullScreen="True"
    RootCornerRadius="8"
    ShowTitlebarBackground="True">

  <suki:SukiWindow.Resources>
    <converters:StatusBrushConverter x:Key="StatusBrushConverter" />
  </suki:SukiWindow.Resources>

  <suki:SukiWindow.DataTemplates>
    <DataTemplate DataType="{x:Type docking:AvaloniaDockable}">
      <ContentControl Content="{Binding Content}" />
    </DataTemplate>
  </suki:SukiWindow.DataTemplates>

  <dialogHost:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="True">
    <dialogHost:DialogHost.DialogContent>
      <Border Width="360" Padding="22" Background="#1E293B" CornerRadius="8">
        <StackPanel Spacing="14">
          <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding DialogTitle}" />
          <TextBlock Foreground="#CBD5E1" Text="{Binding DialogMessage}" TextWrapping="Wrap" />
          <Button HorizontalAlignment="Right" Command="{Binding CloseDialogCommand}" Content="{DynamicResource Shell_Action_Close}" />
        </StackPanel>
      </Border>
    </dialogHost:DialogHost.DialogContent>

    <Grid RowDefinitions="64,*,30" Background="#0F172A">
      <Border Grid.Row="0" Background="#111827" BorderBrush="#263244" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="260,*,Auto" Margin="18,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Shell_Header_Process}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#94A3B8" Text="{DynamicResource Shell_Header_Device}" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
            <Border Padding="10,5" Background="#172554" CornerRadius="6">
              <TextBlock Foreground="#BFDBFE" Text="{DynamicResource Shell_Badge_Migration}" />
            </Border>
            <Border Padding="10,5" Background="#422006" CornerRadius="6">
              <TextBlock Foreground="#FDE68A" Text="{DynamicResource Shell_Badge_SampleData}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" Text="{Binding CultureName}" />
            <Button Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageToggleText}" />
            <Button Command="{Binding OpenDialogCommand}" Content="{DynamicResource Shell_Action_Dialog}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="220,*">
        <Border Background="#0B1120" BorderBrush="#263244" BorderThickness="0,0,1,0" Padding="12">
          <ItemsControl ItemsSource="{Binding MenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Margin="0,0,0,8"
                    Command="{Binding NavigateCommand}"
                    Content="{Binding Title}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <dock:DockControl
            Grid.Column="1"
            AutoCreateDataTemplates="True"
            Factory="{Binding DockFactory}"
            InitializeFactory="True"
            InitializeLayout="True"
            IsDockingEnabled="True"
            Layout="{Binding DockLayout}" />
      </Grid>

      <Border Grid.Row="2" Background="#111827" BorderBrush="#263244" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto" Margin="14,0">
          <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Text="{DynamicResource Shell_Footer_Status}" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Text="{Binding CultureName}" />
        </Grid>
      </Border>
    </Grid>
  </dialogHost:DialogHost>
</suki:SukiWindow>
