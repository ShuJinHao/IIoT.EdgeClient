<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IIoT.Edge.AvaloniaShell.Views.StartupErrorWindow"
    Width="460"
    Height="220"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="AvaloniaShell 启动失败">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="12">
      <TextBlock Text="AvaloniaShell 启动失败"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding}"
                 TextWrapping="Wrap" />
    </StackPanel>
    <Button Grid.Row="1"
            HorizontalAlignment="Right"
            MinWidth="96"
            Content="关闭"
            Click="CloseButton_Click" />
  </Grid>
</Window>

