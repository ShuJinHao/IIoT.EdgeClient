<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IIoT.Edge.AvaloniaShell.Views.StartupErrorWindow"
    Width="640"
    Height="360"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="{DynamicResource Shell_StartupError_Title}">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="10">
      <TextBlock Text="{DynamicResource Shell_StartupError_Title}"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource Shell_StartupError_Details}" FontWeight="SemiBold" />
      <TextBox Text="{Binding Message}"
               AcceptsReturn="True"
               IsReadOnly="True"
               MinHeight="72"
               TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource Shell_StartupError_DiagnosticsSummary}" FontWeight="SemiBold" />
      <TextBox Text="{Binding DiagnosticsSummary}"
               IsReadOnly="True"
               TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource Shell_StartupError_DiagnosticsLogPath}" FontWeight="SemiBold" />
      <TextBox Text="{Binding DiagnosticsLogPath}"
               IsReadOnly="True"
               TextWrapping="Wrap" />
    </StackPanel>
    <Button Grid.Row="1"
            HorizontalAlignment="Right"
            MinWidth="96"
            Content="{DynamicResource Shell_Action_Close}"
            Click="CloseButton_Click" />
  </Grid>
</Window>
