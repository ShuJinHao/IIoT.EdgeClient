<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IIoT.Edge.AvaloniaShell.Views.StartupErrorWindow"
    Width="640"
    Height="360"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="AvaloniaShell 启动失败">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Spacing="10">
      <TextBlock Text="AvaloniaShell 启动失败"
                 FontSize="20"
                 FontWeight="SemiBold" />
      <TextBlock Text="错误详情" FontWeight="SemiBold" />
      <TextBox Text="{Binding Message}"
               AcceptsReturn="True"
               IsReadOnly="True"
               MinHeight="72"
               TextWrapping="Wrap" />
      <TextBlock Text="启动诊断摘要" FontWeight="SemiBold" />
      <TextBox Text="{Binding DiagnosticsSummary}"
               IsReadOnly="True"
               TextWrapping="Wrap" />
      <TextBlock Text="诊断日志路径" FontWeight="SemiBold" />
      <TextBox Text="{Binding DiagnosticsLogPath}"
               IsReadOnly="True"
               TextWrapping="Wrap" />
    </StackPanel>
    <Button Grid.Row="1"
            HorizontalAlignment="Right"
            MinWidth="96"
            Content="关闭"
            Click="CloseButton_Click" />
  </Grid>
</Window>
