<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <x:Double x:Key="Space.1">4</x:Double>
    <x:Double x:Key="Space.2">8</x:Double>
    <x:Double x:Key="Space.3">12</x:Double>
    <x:Double x:Key="Space.4">16</x:Double>
    <x:Double x:Key="Space.5">24</x:Double>
    <x:Double x:Key="Space.6">32</x:Double>
    <x:Double x:Key="Space.7">48</x:Double>

    <CornerRadius x:Key="Radius.Sm">8</CornerRadius>
    <CornerRadius x:Key="Radius.Md">14</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">22</CornerRadius>
    <CornerRadius x:Key="Radius.Xl">28</CornerRadius>

    <BoxShadows x:Key="Shadow.Subtle">0 1 2 0 #0F000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Elevated">0 2 4 0 #14000000, 0 8 16 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Floating">0 8 16 0 #1F000000, 0 16 32 0 #29000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Modal">0 16 24 0 #29000000, 0 32 48 0 #33000000</BoxShadows>

    <x:TimeSpan x:Key="Duration.Fast">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="Duration.Normal">0:0:0.2</x:TimeSpan>
  </Styles.Resources>
</Styles>
