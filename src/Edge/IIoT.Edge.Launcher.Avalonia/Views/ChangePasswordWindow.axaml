<Window
    x:Class="IIoT.Edge.Launcher.Avalonia.Views.ChangePasswordWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Width="480"
    Height="620"
    MinWidth="460"
    MinHeight="600"
    Title="{DynamicResource Launcher_ChangePassword_Title}"
    Background="{DynamicResource Launcher.Bg.Surface}"
    CanResize="False"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner">

  <Grid>
    <Border Height="48"
            VerticalAlignment="Top"
            Background="Transparent"
            PointerPressed="TitleBar_PointerPressed"
            ZIndex="10">
      <Button Classes="launcher-window-command close"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,8,14,0"
              Click="CancelButton_Click"
              ToolTip.Tip="{DynamicResource Launcher_Action_Close}">
        <icons:MaterialIcon Width="18"
                            Height="18"
                            Foreground="{DynamicResource Launcher.Text.Secondary}"
                            Kind="Close" />
      </Button>
    </Border>

    <Border Margin="24,52,24,24"
            Classes="launcher-shell">
      <Border Margin="0"
              Classes="launcher-card">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="{DynamicResource Space.5}">
          <StackPanel Spacing="{DynamicResource Space.2}">
            <TextBlock Classes="launcher-section-title"
                       Text="{DynamicResource Launcher_ChangePassword_Title}" />
            <TextBlock Classes="launcher-subtitle"
                       Text="{DynamicResource Launcher_ChangePassword_Subtitle}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="1"
                      VerticalAlignment="Center"
                      Spacing="{DynamicResource Space.4}">
            <StackPanel Spacing="{DynamicResource Space.2}">
              <TextBlock Classes="launcher-label"
                         Text="{DynamicResource Launcher_ChangePassword_Account}" />
              <TextBox x:Name="UserNameInput"
                       Height="46"
                       PlaceholderText="{DynamicResource Launcher_Login_AccountPlaceholder}" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource Space.2}">
              <TextBlock Classes="launcher-label"
                         Text="{DynamicResource Launcher_ChangePassword_OldPassword}" />
              <TextBox x:Name="OldPasswordInput"
                       Height="46"
                       PlaceholderText="{DynamicResource Launcher_ChangePassword_OldPlaceholder}"
                       PasswordChar="*" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource Space.2}">
              <TextBlock Classes="launcher-label"
                         Text="{DynamicResource Launcher_ChangePassword_NewPassword}" />
              <TextBox x:Name="NewPasswordInput"
                       Height="46"
                       PlaceholderText="{DynamicResource Launcher_ChangePassword_NewPlaceholder}"
                       PasswordChar="*" />
            </StackPanel>

            <StackPanel Spacing="{DynamicResource Space.2}">
              <TextBlock Classes="launcher-label"
                         Text="{DynamicResource Launcher_ChangePassword_ConfirmPassword}" />
              <TextBox x:Name="ConfirmPasswordInput"
                       Height="46"
                       PlaceholderText="{DynamicResource Launcher_ChangePassword_ConfirmPlaceholder}"
                       PasswordChar="*" />
            </StackPanel>

            <TextBlock x:Name="DialogErrorText"
                       Classes="launcher-body"
                       Foreground="{DynamicResource Launcher.Text.Error}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="2"
                ColumnDefinitions="*,12,*">
            <Button Grid.Column="0"
                    Classes="launcher-ghost"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"
                    Content="{DynamicResource Launcher_ChangePassword_Cancel}" />
            <Button Grid.Column="2"
                    Classes="launcher-primary"
                    HorizontalAlignment="Stretch"
                    Click="ConfirmButton_Click"
                    Content="{DynamicResource Launcher_ChangePassword_Submit}" />
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
