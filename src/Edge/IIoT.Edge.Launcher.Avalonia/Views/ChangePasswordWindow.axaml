<Window
    x:Class="IIoT.Edge.Launcher.Avalonia.Views.ChangePasswordWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="500"
    MinWidth="400"
    MinHeight="480"
    Title="修改本地密码"
    Background="#0F172A"
    CanResize="False">

  <Border Margin="22"
          Padding="24"
          Background="#111827"
          BorderBrush="#334155"
          BorderThickness="1"
          CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="10">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#F8FAFC"
                   Text="修改本地密码" />
        <TextBlock Foreground="#CBD5E1"
                   Text="修改后请使用新密码重新登录 Launcher。"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12">
        <TextBox x:Name="UserNameInput" PlaceholderText="账号" />
        <TextBox x:Name="OldPasswordInput" PlaceholderText="旧密码" PasswordChar="*" />
        <TextBox x:Name="NewPasswordInput" PlaceholderText="新密码" PasswordChar="*" />
        <TextBox x:Name="ConfirmPasswordInput" PlaceholderText="确认新密码" PasswordChar="*" />
        <TextBlock x:Name="DialogErrorText"
                   Foreground="#FCA5A5"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
        <Button Grid.Column="0" Click="CancelButton_Click" Content="取消" />
        <Button Grid.Column="2" Click="ConfirmButton_Click" Content="确认修改" />
      </Grid>
    </Grid>
  </Border>
</Window>
