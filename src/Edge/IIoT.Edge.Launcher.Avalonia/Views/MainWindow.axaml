<Window
    x:Class="IIoT.Edge.Launcher.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:viewModels="clr-namespace:IIoT.Edge.Launcher.ViewModels;assembly=IIoT.Edge.Launcher.Avalonia"
    xmlns:views="clr-namespace:IIoT.Edge.Launcher.Avalonia.Views"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    Title="{DynamicResource Launcher_Window_Title}"
    CanResize="True"
    WindowDecorations="None"
    Background="{DynamicResource Launcher.Bg.Surface}">

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type viewModels:LauncherLoginViewModel}">
      <views:LauncherLoginView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:LauncherProfileViewModel}">
      <views:LauncherProfileView />
    </DataTemplate>
  </Window.DataTemplates>

  <Border Classes="launcher-shell" ClipToBounds="True" PointerPressed="DragSurface_PointerPressed" DoubleTapped="DragSurface_DoubleTapped">
    <Grid ColumnDefinitions="300,*">
      <Border Grid.Column="0" Classes="launcher-brand-panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="18"
                      Margin="0,22,0,0"
                      HorizontalAlignment="Center">
            <Border Width="54"
                    Height="54"
                    CornerRadius="18"
                    Background="{DynamicResource Launcher.Text.Primary}"
                    BoxShadow="{DynamicResource Shadow.Elevated}">
              <icons:MaterialIcon Width="30"
                                  Height="30"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource Launcher.Accent.Default}"
                                  Kind="Factory" />
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Classes="launcher-page-title"
                         TextAlignment="Center"
                         Text="{DynamicResource Launcher_Brand_Title}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="launcher-body"
                         TextAlignment="Center"
                         Text="{DynamicResource Launcher_Brand_Subtitle}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
              <Border Classes="launcher-chip">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Launcher.Accent.Text}"
                           Text="{DynamicResource Launcher_Status_Local}" />
              </Border>
              <Border Classes="launcher-chip">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Launcher.Text.Secondary}"
                           Text="{DynamicResource Launcher_Status_Ready}" />
              </Border>
            </StackPanel>

            <Border Classes="launcher-steps-card compact" Margin="0,10,0,0">
              <StackPanel Spacing="12">
                <TextBlock Classes="launcher-section-title"
                           Text="{DynamicResource Launcher_Steps_Title}" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                  <Border Classes="launcher-step-dot active" />
                  <TextBlock Grid.Column="1"
                             Classes="launcher-body"
                             Text="{DynamicResource Launcher_Step_Account}" />
                  <Border Grid.Row="1" Classes="launcher-step-dot" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Classes="launcher-body"
                             Text="{DynamicResource Launcher_Step_Profile}" />
                  <Border Grid.Row="2" Classes="launcher-step-dot" />
                  <TextBlock Grid.Row="2"
                             Grid.Column="1"
                             Classes="launcher-body"
                             Text="{DynamicResource Launcher_Step_Launch}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Foreground="{DynamicResource Launcher.Text.Muted}"
                       Text="{Binding PlatformMetaText}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{DynamicResource Launcher.Text.Muted}"
                       Text="{Binding ArchitectureText}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{DynamicResource Launcher.Text.Muted}"
                       Text="{Binding MaintainerText}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource Launcher.Text.Muted}"
                       Text="{Binding AppVersionText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1"
            Background="{DynamicResource Launcher.Bg.Panel}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0"
                Height="62"
                Margin="28,18,28,0"
                ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="launcher-section-title"
                         Text="{DynamicResource Launcher_Workbench_Title}" />
              <TextBlock Classes="launcher-caption"
                         Text="{DynamicResource Launcher_Workbench_Subtitle}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
              <Button Classes="launcher-window-command"
                      Click="MinimizeWindowButton_Click"
                      ToolTip.Tip="{DynamicResource Launcher_Action_Minimize}">
                <icons:MaterialIcon Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource Launcher.Text.Secondary}"
                                    Kind="WindowMinimize" />
              </Button>
              <Button Classes="launcher-window-command"
                      Click="ToggleWindowStateButton_Click"
                      ToolTip.Tip="{DynamicResource Launcher_Action_MaximizeRestore}">
                <icons:MaterialIcon Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource Launcher.Text.Secondary}"
                                    Kind="WindowMaximize" />
              </Button>
              <Button Classes="launcher-window-command close"
                      Click="CloseWindowButton_Click"
                      ToolTip.Tip="{DynamicResource Launcher_Action_Close}">
                <icons:MaterialIcon Width="18"
                                    Height="18"
                                    Foreground="{DynamicResource Launcher.Text.Secondary}"
                                    Kind="Close" />
              </Button>
            </StackPanel>
          </Grid>

          <TransitioningContentControl Grid.Row="1"
                                       Margin="28,10,28,28"
                                       Content="{Binding CurrentView}">
            <TransitioningContentControl.PageTransition>
              <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
