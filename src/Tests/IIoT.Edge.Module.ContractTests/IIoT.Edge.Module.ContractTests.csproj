<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Edge\IIoT.Edge.Host.Bootstrap\IIoT.Edge.Host.Bootstrap.csproj" />
    <ProjectReference Include="..\..\Modules\IIoT.Edge.Module.DieCutting.Shared\IIoT.Edge.Module.DieCutting.Shared.csproj" />
    <ProjectReference Include="..\..\Modules\IIoT.Edge.Module.DieCuttingAnode\IIoT.Edge.Module.DieCuttingAnode.csproj" />
    <ProjectReference Include="..\..\Modules\IIoT.Edge.Module.DieCuttingCathode\IIoT.Edge.Module.DieCuttingCathode.csproj" />
    <ProjectReference Include="..\..\Modules\IIoT.Edge.Module.Homogenization\IIoT.Edge.Module.Homogenization.csproj" />
    <ProjectReference Include="..\..\Modules\IIoT.Edge.Module.Sdk\IIoT.Edge.Module.Sdk.csproj" />
    <ProjectReference Include="..\..\Application\IIoT.Edge.Application\IIoT.Edge.Application.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EdgeTestForceEmptyPluginArtifacts)' != 'true'">
    <PluginModuleProject Include="..\..\Modules\**\*.csproj" Exclude="..\..\Modules\IIoT.Edge.Module.Sdk\IIoT.Edge.Module.Sdk.csproj" />
  </ItemGroup>

  <Target Name="ResolvePluginModuleArtifacts">
    <MSBuild Projects="@(PluginModuleProject)" Targets="GetPluginArtifacts" BuildInParallel="false" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="PluginModuleArtifact" />
    </MSBuild>
  </Target>

  <Target Name="CopyPluginModulesToTestOutput" AfterTargets="Build" DependsOnTargets="ResolvePluginModuleArtifacts">
    <Error Condition="'@(PluginModuleArtifact)' == ''" Text="EDGE-TEST-GOV-001-PLUGIN-STAGING no plugin module artifacts were resolved for the contract-test runtime layout." />
    <RemoveDir Directories="$(TargetDir)Modules" />
    <Copy SourceFiles="@(PluginModuleArtifact)" DestinationFiles="@(PluginModuleArtifact -> '$(TargetDir)Modules\%(ModuleId)\%(ArtifactRelativePath)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
