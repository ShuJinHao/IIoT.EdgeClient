<UserControl
    x:Class="IIoT.Edge.UI.Shared.Avalonia.Views.EmptyStateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views">
    <Border Classes="edge-empty-state">
        <StackPanel Classes="edge-empty-state-inline">
            <TextBlock
                Classes="edge-empty-state-title"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=views:EmptyStateView}}" />
            <TextBlock
                Classes="edge-empty-state-message"
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType=views:EmptyStateView}}"
                ToolTip.Tip="{Binding Message, RelativeSource={RelativeSource AncestorType=views:EmptyStateView}}" />
        </StackPanel>
    </Border>
</UserControl>
