<UserControl
    x:Class="IIoT.Edge.UI.Shared.Avalonia.Views.EmptyStateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views">
    <Border
        Padding="20"
        Background="{DynamicResource Edge.Surface.Panel}"
        BorderBrush="{DynamicResource Edge.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Edge.Text.Primary}"
                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=views:EmptyStateView}}" />
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource Edge.Text.Muted}"
                Text="{Binding Message, RelativeSource={RelativeSource AncestorType=views:EmptyStateView}}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
