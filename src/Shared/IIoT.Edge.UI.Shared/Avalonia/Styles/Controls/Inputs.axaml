<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
        xmlns:views="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <!-- 共享文本输入控件 EdgeTextBox：统一表单输入观感（带边框、米白底、聚焦高亮、禁用半透明） -->
    <Style Selector="TextBox.edge-text-box">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <!-- 去掉 Fluent 默认的聚焦装饰矩形，聚焦观感完全由下方 /template/ Border 接管 -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--
        接管 Fluent TextBox 内部边框 PART_BorderElement（模板内唯一 Border）。
        Fluent 默认会在 :pointerover / :focus 时给该 Border 套系统强调色蓝边 + 白底，绕过 TemplateBinding；
        这里照搬登录框 edge-login-input-editor 已验证的 /template/ Border 写法，常态/悬停=米白底+细边，聚焦=米绿细边，取代系统蓝。
    -->
    <Style Selector="TextBox.edge-text-box /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.edge-text-box:focus /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.edge-text-box.dialog-input">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.search-input">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- 内联扁平变体：嵌入表格单元格使用，全透明融入单元格（修掉图④白底蓝框） -->
    <Style Selector="TextBox.edge-text-box.flat">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:focus">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- flat 的 /template/ 覆盖放在标准态之后，依文档顺序对 flat 实例胜出，三态皆透明无边 -->
    <Style Selector="TextBox.edge-text-box.flat /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:focus /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:disabled">
        <Setter Property="Opacity" Value="0.66" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#PART_PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#DropDownBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBoxItem /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:dropdownopen">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:focus /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:dropdownopen /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Button.edge-filter-date-button">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Button.edge-filter-date-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Button.edge-filter-date-button:pressed">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ PathIcon">
        <Setter Property="Data" Value="{StaticResource Edge.Icon.Calendar}" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Border#PART_PopupBorder">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date /template/ Border#DropDownBorder">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar">
        <Setter Property="Width" Value="294" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarItem">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarItem /template/ Grid">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarItem /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarItem /template/ Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarItem /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:today">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:today /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:selected:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:inactive">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="Opacity" Value="0.44" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:inactive /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:inactive /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:inactive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarDayButton:blackout">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="Opacity" Value="0.34" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton">
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:selected /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Calendar.edge-filter-calendar CalendarButton:inactive">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    x:Name="PART_EdgeCheckBoxRoot"
                    MinHeight="18"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                    <Border
                        x:Name="PART_EdgeCheckBoxGlyph"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Edge.Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Edge.CornerRadius.Small}">
                        <Viewbox
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding IsChecked}">
                            <Path
                                Data="{StaticResource Edge.Icon.CheckSmall}"
                                Fill="Transparent"
                                Stroke="{DynamicResource Edge.Brush.Text.Secondary}"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                StrokeThickness="1.35" />
                        </Viewbox>
                    </Border>
                    <ContentPresenter
                        x:Name="PART_EdgeCheckBoxContent"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="CheckBox.boolean">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="16" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ Grid#PART_EdgeCheckBoxRoot">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ ContentPresenter#PART_EdgeCheckBoxContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
    </Style>

    <Style Selector="controls|EdgeCard.parameter-panel TextBlock.edge-parameter-title">
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="controls|EdgeCard.parameter-panel TextBlock.edge-parameter-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="controls|EdgeFieldRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_EdgeFieldRowRoot"
                    MinHeight="32"
                    Padding="10,4"
                    Background="{DynamicResource Edge.Brush.Surface.Card}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <Grid
                        x:Name="PART_EdgeFieldRowGrid"
                        ColumnDefinitions="180,*"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                        <StackPanel
                            x:Name="PART_EdgeFieldRowLabelHost"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Label}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{TemplateBinding Label}" />
                            <TextBlock
                                Classes="edge-field-description"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                LineHeight="13.5"
                                MaxLines="2"
                                Text="{TemplateBinding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTip.Tip="{TemplateBinding Description}" />
                        </StackPanel>

                        <ContentPresenter
                            x:Name="PART_EdgeFieldRowValueHost"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding ValueContent}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeFieldRow TextBlock.edge-field-description">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.has-description TextBlock.edge-field-description">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.boolean /template/ Border#PART_EdgeFieldRowRoot">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.boolean /template/ ContentPresenter#PART_EdgeFieldRowValueHost">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.dialog-form">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    MinHeight="48"
                    Padding="9,5"
                    Background="{DynamicResource Edge.Brush.Surface.Card}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                        <StackPanel Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Label}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{TemplateBinding Label}" />
                            <TextBlock
                                Classes="edge-field-description"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                LineHeight="13.5"
                                MaxLines="2"
                                Text="{TemplateBinding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTip.Tip="{TemplateBinding Description}" />
                        </StackPanel>

                        <ContentPresenter
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding ValueContent}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
