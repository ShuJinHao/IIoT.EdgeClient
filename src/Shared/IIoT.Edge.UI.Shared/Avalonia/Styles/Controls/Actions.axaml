<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
        xmlns:views="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
    </Style>

    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.edge-soft-button">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
    </Style>

    <Style Selector="Button.edge-soft-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Button.edge-primary-button">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.edge-primary-button:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="Button.edge-icon">
        <Setter Property="Width" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Height" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.Zero}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
    </Style>

    <Style Selector="controls|EdgeWindowButton">
        <Setter Property="Width" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Height" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Padding" Value="{DynamicResource Edge.Thickness.Zero}" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Circle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeWindowButton.window-normal:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Header.WindowButtonHover}" />
    </Style>

    <Style Selector="controls|EdgeWindowButton.window-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Header.WindowButtonCloseHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Header.WindowButtonCloseForeground}" />
    </Style>

    <Style Selector="controls|EdgeWindowButton.soft-window-action">
        <Setter Property="Width" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Height" Value="{DynamicResource Edge.Size.HeaderIconButton}" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="TextBlock.edge-window-symbol">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="controls|EdgeActionButton">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="IconSize" Value="14" />
        <Setter Property="IconStrokeThickness" Value="1.55" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    ClipToBounds="True"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <StackPanel
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Path
                            Width="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Icon}"
                            Fill="Transparent"
                            IsVisible="{TemplateBinding HasLeadingIcon}"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            StrokeThickness="{TemplateBinding IconStrokeThickness}"
                            Stretch="Uniform" />
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            IsVisible="{TemplateBinding HasContent}" />
                        <Path
                            Width="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            VerticalAlignment="Center"
                            Data="{TemplateBinding Icon}"
                            Fill="Transparent"
                            IsVisible="{TemplateBinding HasTrailingIcon}"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            StrokeThickness="{TemplateBinding IconStrokeThickness}"
                            Stretch="Uniform" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeActionButton:pressed">
        <Setter Property="RenderTransform">
            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
        </Setter>
    </Style>

    <Style Selector="controls|EdgeActionButton:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.primary">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.primary:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="controls|EdgeActionButton.secondary">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemHover}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.danger">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Status.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Status.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.danger:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-language">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Language.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Language.Border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="15" />
        <Setter Property="IconStrokeThickness" Value="1.6" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-language:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Language.Hover}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-nav">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Circle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="IconStrokeThickness" Value="2.1" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <!-- 导航选中态使用深色中性块，把绿色保留给运行/健康状态语义。 -->
    <Style Selector="controls|EdgeActionButton.role-nav.selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Sidebar.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.OnDark.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-nav.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Sidebar.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.OnDark.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.size-compact">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="IconSize" Value="13" />
        <Setter Property="IconStrokeThickness" Value="1.5" />
    </Style>

    <Style Selector="controls|EdgeActionButton.size-icon">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IconSize" Value="14" />
        <Setter Property="IconStrokeThickness" Value="1.5" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-language.size-icon">
        <Setter Property="IconSize" Value="15" />
        <Setter Property="IconStrokeThickness" Value="1.6" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-nav.size-icon">
        <Setter Property="IconSize" Value="18" />
        <Setter Property="IconStrokeThickness" Value="2.1" />
    </Style>

    <!--
        表格单元格按钮角色 role-cell：紧凑 + 柔和描边，弱化重色实心填充，贴合 ~34px 行高。
        定义在 .primary/.danger/.size-* 之后，依文档顺序覆盖它们的填充与尺寸；页面只需设置 Role="Cell"。
    -->
    <Style Selector="controls|EdgeActionButton.role-cell">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Small}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="IconStrokeThickness" Value="1.45" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-cell:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <!-- 删除等危险动作：保留红色语义，但改为红色描边而非红色实心 -->
    <Style Selector="controls|EdgeActionButton.role-cell.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Status.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-cell.danger:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.WindowButton.CloseHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeActionToolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{DynamicResource Edge.Size.Spacing8}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.ghost">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="IconStrokeThickness" Value="1.4" />
    </Style>

    <Style Selector="controls|EdgeActionButton.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-right-rail">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="IconStrokeThickness" Value="1.45" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-right-rail.plan-action">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="11.5" />
        <Setter Property="IconStrokeThickness" Value="1.35" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-right-rail.plan-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-right-rail.log-clear">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="0" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-right-rail.log-clear:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <!--
        禁用态统一收口。基础 :disabled 定义在 Kind 样式之前，按文档顺序会被
        .primary/.danger 的实心填充覆盖，导致“按钮已禁用但仍满红/满黑”的假可点状态。
        此处放在所有 Kind/Role 样式之后，保证任何按钮禁用时都回落到中性弱化外观；
        危险动作禁用时同样不允许保留红色实心或红色描边。
    -->
    <Style Selector="controls|EdgeActionButton.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.secondary:disabled">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.ghost:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.danger:disabled">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.role-cell.danger:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>
</Styles>
