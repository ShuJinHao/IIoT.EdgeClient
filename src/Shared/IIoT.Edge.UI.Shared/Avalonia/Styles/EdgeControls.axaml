    </Style>

    <Style Selector="controls|EdgeActionButton.nav">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Circle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="IconStrokeThickness" Value="2.1" />
    </Style>

    <Style Selector="controls|EdgeActionButton.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <!-- 选中态：柔和米绿色块 + 深色图标，取代原先突兀的近黑实心圆 -->
    <Style Selector="controls|EdgeActionButton.nav.selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Sidebar.Selected}" />
