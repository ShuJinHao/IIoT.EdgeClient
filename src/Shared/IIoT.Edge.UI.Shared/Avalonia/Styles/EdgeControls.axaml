    <Style Selector="controls|EdgeActionButton.nav.size-icon">
        <Setter Property="IconSize" Value="18" />
        <Setter Property="IconStrokeThickness" Value="2.1" />
    </Style>

    <!--
        表格单元格内按钮变体 .cell：紧凑 + 柔和描边，弱化重色实心填充，贴合 ~34px 行高。
        定义在 .primary/.danger/.size-* 之后，依文档顺序覆盖它们的填充与尺寸；页面只需追加 Classes="cell"。
    -->
    <Style Selector="controls|EdgeActionButton.cell">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Small}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="IconSize" Value="11.5" />
        <Setter Property="IconStrokeThickness" Value="1.4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.cell:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <!-- 删除等危险动作：保留红色语义，但改为红色描边而非红色实心 -->
    <Style Selector="controls|EdgeActionButton.cell.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Status.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.cell.danger:pointerover">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.WindowButton.CloseHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.ghost">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="IconStrokeThickness" Value="1.4" />
    </Style>

    <Style Selector="controls|EdgeActionButton.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.right-rail">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="IconSize" Value="12" />
        <Setter Property="IconStrokeThickness" Value="1.45" />
    </Style>

    <Style Selector="controls|EdgeActionButton.right-rail.plan-action">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="IconSize" Value="10" />
        <Setter Property="IconStrokeThickness" Value="1.25" />
    </Style>

    <Style Selector="controls|EdgeActionButton.right-rail.plan-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemHover}" />
    </Style>

    <Style Selector="controls|EdgeActionButton.right-rail.log-clear">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="0" />
    </Style>

    <Style Selector="controls|EdgeActionButton.right-rail.log-clear:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="TextBlock.edge-nav-title">
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="TextBlock.edge-nav-title.selected">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.edge-nav-title.disabled">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Status.Offline}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <!-- 共享文本输入控件 EdgeTextBox：统一表单输入观感（带边框、米白底、聚焦高亮、禁用半透明） -->
    <Style Selector="TextBox.edge-text-box">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <!-- 去掉 Fluent 默认的聚焦装饰矩形，聚焦观感完全由下方 /template/ Border 接管 -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!--
        接管 Fluent TextBox 内部边框 PART_BorderElement（模板内唯一 Border）。
        Fluent 默认会在 :pointerover / :focus 时给该 Border 套系统强调色蓝边 + 白底，绕过 TemplateBinding；
        这里照搬登录框 edge-login-input-editor 已验证的 /template/ Border 写法，常态/悬停=米白底+细边，聚焦=米绿细边，取代系统蓝。
    -->
    <Style Selector="TextBox.edge-text-box /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="TextBox.edge-text-box:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.edge-text-box:focus /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- 内联扁平变体：嵌入表格单元格使用，全透明融入单元格（修掉图④白底蓝框） -->
    <Style Selector="TextBox.edge-text-box.flat">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:focus">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- flat 的 /template/ 覆盖放在标准态之后，依文档顺序对 flat 实例胜出，三态皆透明无边 -->
    <Style Selector="TextBox.edge-text-box.flat /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-text-box.flat:focus /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="controls|EdgeLoginInput">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Width" Value="360" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_Root"
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="14,0"
                    Background="{DynamicResource Edge.Brush.Surface.Card}"
                    BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <TextBox
                        x:Name="PART_Input"
                        Classes="edge-login-input-editor"
                        VerticalAlignment="Center"
                        PasswordChar="{Binding PasswordChar, RelativeSource={RelativeSource TemplatedParent}}"
                        PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource TemplatedParent}}"
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeLoginInput:focus-within /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Header.ChipBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Header.ChipBorder}" />
    </Style>

    <Style Selector="TextBox.edge-login-input-editor">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="TextBox.edge-login-input-editor:focus">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-login-input-editor /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="TextBox.edge-login-input-editor:focus /template/ Border">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Medium}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:disabled">
        <Setter Property="Opacity" Value="0.66" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#PART_PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo /template/ Border#DropDownBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBox.edge-filter-combo:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource Edge.Shadow.Float}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBoxItem /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
    </Style>

    <Style Selector="CalendarDatePicker.edge-filter-date:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Focus}" />
    </Style>

    <Style Selector="Button.edge-tool-button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="86" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="Button.edge-tool-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="Button.edge-tool-button.primary">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
    </Style>

    <Style Selector="Button.edge-tool-button.primary:pointerover">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="TabControl">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
    </Style>

    <Style Selector="TabControl.edge-tabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing4}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <Border
                        HorizontalAlignment="Left"
                        Padding="4"
                        Background="{DynamicResource Edge.Brush.Segmented.Background}"
                        CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>

                    <ContentPresenter
                        Name="PART_SelectedContentHost"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Content="{TemplateBinding SelectedContent}"
                        ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.edge-tabs TabItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemForeground}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.BodyStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    MinHeight="{TemplateBinding MinHeight}"
                    MinWidth="{TemplateBinding MinWidth}"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Header}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabControl.edge-tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="TabControl.edge-tabs TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host.variant-page">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host.variant-dialog">
        <Setter Property="MaxHeight" Value="180" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host.variant-panel">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="999">
                    <Track
                        Name="PART_Track"
                        Maximum="{TemplateBinding Maximum}"
                        Minimum="{TemplateBinding Minimum}"
                        Orientation="{TemplateBinding Orientation}"
                        Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb
                                MinWidth="0"
                                MinHeight="0"
                                Background="{DynamicResource Edge.Brush.Scrollbar.Thumb}"
                                Opacity="0.32">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="999" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host ScrollBar:pointerover Thumb">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="ScrollViewer.edge-scroll-host ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Body}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                    x:Name="PART_EdgeCheckBoxRoot"
                    MinHeight="18"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                    <Border
                        x:Name="PART_EdgeCheckBoxGlyph"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Edge.Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Edge.CornerRadius.Small}">
                        <Viewbox
                            Width="8"
                            Height="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding IsChecked}">
                            <Path
                                Data="M 2,4.3 L 3.6,5.9 L 6.8,2.4"
                                Fill="Transparent"
                                Stroke="{DynamicResource Edge.Brush.Text.Secondary}"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                StrokeThickness="1.35" />
                        </Viewbox>
                    </Border>
                    <ContentPresenter
                        x:Name="PART_EdgeCheckBoxContent"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>

    <Style Selector="CheckBox.boolean">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="16" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ Grid#PART_EdgeCheckBoxRoot">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ Border#PART_EdgeCheckBoxGlyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="CheckBox.boolean /template/ ContentPresenter#PART_EdgeCheckBoxContent">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox:disabled">
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
    </Style>

    <Style Selector="controls|EdgeLogList">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard Surface="Card" PaddingMode="Compact" Elevation="Card">
                    <Grid RowDefinitions="Auto,22,*" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Title}" />

                            <controls:EdgeActionButton
                                Grid.Column="1"
                                Classes="ghost right-rail log-clear"
                                Content="{TemplateBinding ClearText}"
                                MinWidth="44"
                                Command="{TemplateBinding ClearCommand}"
                                Kind="Soft"
                                Size="Compact" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource Edge.Brush.Surface.Wash}"
                            CornerRadius="{DynamicResource Edge.CornerRadius.Control}"
                            Padding="8,0">
                            <Grid ColumnDefinitions="54,92,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding TimeHeader}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding LevelHeader}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding MessageHeader}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" MinHeight="300">
                            <StackPanel Classes="edge-data-panel-content">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        ItemTemplate="{TemplateBinding ItemTemplate}"
                                        ItemsSource="{TemplateBinding ItemsSource}" />
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel
                                IsVisible="{TemplateBinding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="220"
                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{TemplateBinding EmptyTitle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding EmptyMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeLogListItem">
        <Setter Property="Template">
            <ControlTemplate>
                    <Border
                    MinHeight="26"
                    Padding="8,4"
                    BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="54,92,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                        <TextBlock
                            VerticalAlignment="Top"
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                            Text="{TemplateBinding TimeText}" />

                        <Grid
                            Grid.Column="1"
                            ClipToBounds="True"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="{DynamicResource Edge.Size.Spacing6}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch">
                            <controls:EdgeStatusDot
                                VerticalAlignment="Center"
                                Size="6"
                                Status="{TemplateBinding Status}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                MaxLines="1"
                                Text="{TemplateBinding LevelText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{TemplateBinding LevelText}" />
                        </Grid>

                        <TextBlock
                            Grid.Column="2"
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            LineHeight="14.5"
                            MaxLines="{TemplateBinding MaxMessageLines}"
                            Text="{TemplateBinding Message}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTip.Tip="{TemplateBinding Message}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="DataGrid.edge-grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="RowBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
    </Style>

    <Style Selector="DataGrid.production-grid">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="RowBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
    </Style>

    <Style Selector="DataGrid.edge-grid DataGridRow:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-grid DataGridCell:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-grid DataGridRow:selected DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Edge.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="DataGridBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid
                        ClipToBounds="True"
                        ColumnDefinitions="Auto,*,Auto"
                        RowDefinitions="Auto,*,Auto">
                        <Border
                            x:Name="PART_EdgeColumnHeaderBackground"
                            Grid.Row="0"
                            Grid.Column="1"
                            Height="{TemplateBinding ColumnHeaderHeight}"
                            Background="{DynamicResource Edge.Brush.Table.HeaderBackground}"
                            CornerRadius="{DynamicResource Edge.CornerRadius.Control}"
                            IsHitTestVisible="False" />
                        <DataGridColumnHeader
                            Name="PART_TopLeftCornerHeader"
                            Theme="{StaticResource DataGridTopLeftColumnHeader}" />
                        <DataGridColumnHeadersPresenter
                            Name="PART_ColumnHeadersPresenter"
                            Grid.Row="0"
                            Grid.Column="1" />
                        <Rectangle
                            Name="PART_ColumnHeadersAndRowsSeparator"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Height="1"
                            VerticalAlignment="Bottom"
                            Fill="Transparent" />

                        <DataGridRowsPresenter
                            Name="PART_RowsPresenter"
                            Grid.Row="1"
                            Grid.Column="1"
                            ClipToBounds="True"
                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                            <DataGridRowsPresenter.GestureRecognizers>
                                <ScrollGestureRecognizer
                                    CanHorizontallyScroll="True"
                                    CanVerticallyScroll="True"
                                    IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_RowsPresenter}" />
                            </DataGridRowsPresenter.GestureRecognizers>
                        </DataGridRowsPresenter>
                        <Rectangle
                            Name="PART_BottomRightCorner"
                            Grid.Row="2"
                            Grid.Column="2"
                            Fill="Transparent" />
                        <ScrollBar
                            Name="PART_VerticalScrollbar"
                            Classes="edge-data-grid-scrollbar"
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="4,2,0,2"
                            Width="6"
                            Orientation="Vertical" />

                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            ColumnDefinitions="Auto,*"
                            Height="{Binding HorizontalScrollBarReserveHeight, RelativeSource={RelativeSource TemplatedParent}}"
                            IsVisible="{Binding IsVisible, ElementName=PART_HorizontalScrollbar}"
                            ClipToBounds="True">
                            <Rectangle Name="PART_FrozenColumnScrollBarSpacer" />
                            <ScrollBar
                                Name="PART_HorizontalScrollbar"
                                Classes="edge-data-grid-scrollbar"
                                Grid.Column="1"
                                Height="3"
                                Margin="0,0,0,1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal" />
                        </Grid>
                        <Border
                            x:Name="PART_DisabledVisualElement"
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource DataGridDisabledVisualElementBackground}"
                            CornerRadius="{DynamicResource Edge.CornerRadius.Control}"
                            IsHitTestVisible="False"
                            IsVisible="{Binding !$parent[DataGrid].IsEnabled}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="DataGrid.edge-data-grid ScrollBar.edge-data-grid-scrollbar">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Scrollbar.Track}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="0"
                    Background="{TemplateBinding Background}"
                    CornerRadius="999">
                    <Track
                        Name="PART_Track"
                        Maximum="{TemplateBinding Maximum}"
                        Minimum="{TemplateBinding Minimum}"
                        Orientation="{TemplateBinding Orientation}"
                        Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton
                                Width="0"
                                Height="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb
                                MinWidth="0"
                                MinHeight="0"
                                Background="{DynamicResource Edge.Brush.Scrollbar.Thumb}"
                                Opacity="0.18">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="999" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="DataGrid.edge-data-grid ScrollBar.edge-data-grid-scrollbar:pointerover Thumb">
        <Setter Property="Opacity" Value="0.42" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid ScrollBar.edge-data-grid-scrollbar:horizontal">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 仅沿滚动轴给拇指一个最小可抓取长度；横向高度由独立底栏控制，避免越界盖住内容 -->
    <Style Selector="DataGrid.edge-data-grid ScrollBar.edge-data-grid-scrollbar:vertical /template/ Thumb">
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid ScrollBar.edge-data-grid-scrollbar:horizontal /template/ Thumb">
        <Setter Property="MinWidth" Value="28" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-compact">
        <Setter Property="ColumnHeaderHeight" Value="30" />
        <Setter Property="RowHeight" Value="30" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-normal">
        <Setter Property="ColumnHeaderHeight" Value="36" />
        <Setter Property="RowHeight" Value="36" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-diagnostic">
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="RowHeight" Value="34" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AreSeparatorsVisible" Value="False" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="HeaderBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid
                        Name="PART_ColumnHeaderRoot"
                        Background="Transparent"
                        ColumnDefinitions="*,Auto">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Thumb
                            Name="PART_LeftHeaderGripper"
                            Width="0"
                            HorizontalAlignment="Left"
                            IsVisible="False" />
                        <Thumb
                            Name="PART_RightHeaderGripper"
                            Grid.Column="1"
                            Width="12"
                            HorizontalAlignment="Right"
                            Cursor="SizeWestEast"
                            IsVisible="True">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="Transparent">
                                        <Border
                                            x:Name="ResizeGripLine"
                                            Width="1"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,8"
                                            Background="{DynamicResource Edge.Brush.Border.Subtle}"
                                            Opacity="0.28" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader:pressed /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Edge.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader /template/ Thumb#PART_LeftHeaderGripper">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridColumnHeader:pointerover /template/ Thumb#PART_RightHeaderGripper /template/ Border#ResizeGripLine">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Border.Focus}" />
        <Setter Property="Opacity" Value="0.62" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 自定义模板：去掉 Fluent 默认单元格的 CurrencyVisual/FocusVisual 矩形，消除选中黑框 -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="CellBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-compact DataGridCell">
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-normal DataGridCell">
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid.density-diagnostic DataGridCell">
        <Setter Property="Padding" Value="9,0" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell TextBlock">
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell.edge-action-cell">
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell.edge-check-cell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell.edge-template-cell TextBlock">
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridRow:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Table.RowHover}" />
        <Setter Property="Opacity" Value="0.16" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridRow:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Table.SelectedBackground}" />
        <Setter Property="Opacity" Value="0.22" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell:selected">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridRow:selected DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Table.SelectedForeground}" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell:focus">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid DataGridCell:current">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="DataGrid.edge-data-grid:empty-columns /template/ Border#PART_EdgeColumnHeaderBackground">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeCard">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardCornerRadius" Value="{DynamicResource Edge.CornerRadius.Card}" />
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Card.Default}" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding CardPadding}"
                    Background="{TemplateBinding CardBackground}"
                    BorderBrush="{TemplateBinding CardBorderBrush}"
                    BorderThickness="{TemplateBinding CardBorderThickness}"
                    BoxShadow="{TemplateBinding CardShadow}"
                    CornerRadius="{TemplateBinding CardCornerRadius}">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <ContentPresenter Content="{TemplateBinding Header}" />
                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" />
                        <ContentPresenter Grid.Row="2" Content="{TemplateBinding Footer}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeCard.elevation-flat">
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
    </Style>

    <Style Selector="controls|EdgeCard.elevation-card">
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.Soft}" />
    </Style>

    <Style Selector="controls|EdgeCard.elevation-float">
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.Float}" />
    </Style>

    <Style Selector="controls|EdgeCard.surface-card">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CardBorderThickness" Value="0" />
    </Style>

    <Style Selector="controls|EdgeCard.surface-wash">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
    </Style>

    <Style Selector="controls|EdgeCard.surface-raised">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Raised}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.Soft}" />
    </Style>

    <Style Selector="controls|EdgeCard.surface-accent">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Highlight}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
    </Style>

    <Style Selector="controls|EdgeCard.surface-transparent">
        <Setter Property="CardBackground" Value="Transparent" />
        <Setter Property="CardBorderBrush" Value="Transparent" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
    </Style>

    <Style Selector="controls|EdgeCard.padding-none">
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Surface.None}" />
    </Style>

    <Style Selector="controls|EdgeCard.padding-compact">
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Surface.Compact}" />
    </Style>

    <Style Selector="controls|EdgeCard.padding-normal">
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Surface.Normal}" />
    </Style>

    <Style Selector="controls|EdgeCard.padding-spacious">
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Surface.Spacious}" />
    </Style>

    <Style Selector="controls|EdgeCard.emphasis">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.Surface.Subtle}" />
        <Setter Property="CardBorderBrush" Value="{DynamicResource Edge.Brush.Accent.Primary}" />
    </Style>

    <Style Selector="controls|EdgeStatusDot">
        <Setter Property="Size" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Info}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Width="{TemplateBinding Size}"
                    Height="{TemplateBinding Size}"
                    Background="{TemplateBinding Fill}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Circle}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeStatusDot.default">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Offline}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.running">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Running}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.idle">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Idle}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.stopped">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Stopped}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.offline">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Offline}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.info">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Info}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.cache">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Cache}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.warning">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Warning}" />
    </Style>
    <Style Selector="controls|EdgeStatusDot.error">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeStatusChip">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Surface.Panel}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="ChipPadding" Value="{DynamicResource Edge.Thickness.Chip}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding ChipPadding}"
                    Background="{TemplateBinding Fill}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                    <TextBlock
                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                        FontWeight="SemiBold"
                        Foreground="{TemplateBinding TextBrush}"
                        Text="{TemplateBinding Text}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeStatusChip.default">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Surface.Panel}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.running">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Running}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnAccent}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.idle">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Idle}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.stopped">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Stopped}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.offline">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Offline}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.info">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.cache">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Cache}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.warning">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Warning}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>
    <Style Selector="controls|EdgeStatusChip.error">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Status.Error}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.OnDanger}" />
    </Style>

    <Style Selector="controls|EdgeInfoTile">
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    MinWidth="{TemplateBinding MinWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    HorizontalAlignment="Stretch"
                    CardBorderThickness="1"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Card}"
                    CardPadding="12,8"
                    Elevation="Card"
                    Surface="Raised">
                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing4}">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Accent.Primary}"
                            Text="{TemplateBinding Label}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Body}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            MaxLines="2"
                            Text="{TemplateBinding Value}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeFeatureHeroCard">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    CardBorderThickness="1"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Stage}"
                    CardPadding="{DynamicResource Edge.Thickness.Zero}"
                    ClipToBounds="True"
                    Elevation="Card"
                    Surface="Card">
                    <Grid>
                        <Border CornerRadius="{DynamicResource Edge.CornerRadius.Stage}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="{StaticResource Edge.Color.Ivory50}" Offset="0" />
                                    <GradientStop Color="{StaticResource Edge.Color.CardWarm}" Offset="0.48" />
                                    <GradientStop Color="{StaticResource Edge.Color.WashWarm}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid
                            Margin="32,24"
                            MinWidth="560"
                            MaxWidth="720"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="{DynamicResource Edge.Brush.Accent.Primary}"
                                    CornerRadius="{DynamicResource Edge.CornerRadius.Large}">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Icon}" />
                                </Border>
                                <controls:EdgeInfoTile
                                    MinWidth="180"
                                    Label="{TemplateBinding VersionLabel}"
                                    Value="{TemplateBinding VersionText}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Row="1"
                                Spacing="14">
                                <TextBlock
                                    FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{TemplateBinding Title}"
                                    TextWrapping="Wrap" />
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding InfoContent}" />
                            </StackPanel>

                            <ContentPresenter
                                Grid.Row="2"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding FlowContent}" />
                        </Grid>
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeProcessCard">
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="MinHeight" Value="232" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    CardBorderThickness="1"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Stage}"
                    CardPadding="16"
                    ClipToBounds="True"
                    Elevation="Card"
                    Surface="Card">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                Grid.Column="0"
                                Width="52"
                                Height="52"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Edge.Brush.Accent.Primary}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Circle}">
                                <Border
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Edge.Brush.Surface.Card}"
                                    CornerRadius="{DynamicResource Edge.CornerRadius.Circle}">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Icon}" />
                                </Border>
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    MaxLines="1"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <controls:EdgeStatusChip
                                    HorizontalAlignment="Left"
                                    Status="Default"
                                    Text="{TemplateBinding Subtitle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource Edge.Size.Spacing8}">
                            <Border
                                Padding="10,8"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                <Grid ColumnDefinitions="42,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}"
                                        MaxLines="1"
                                        Text="{TemplateBinding PluginLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        MaxLines="1"
                                        Text="{TemplateBinding PluginPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <Border
                                Padding="10,8"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                <Grid ColumnDefinitions="42,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Accent.Primary}"
                                        MaxLines="1"
                                        Text="{TemplateBinding DataLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        MaxLines="1"
                                        Text="{TemplateBinding DataPath}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <ContentPresenter
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Content="{TemplateBinding ActionContent}" />
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeSectionHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                    <TextBlock
                        FontSize="{DynamicResource Edge.FontSize.Section}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                        Text="{TemplateBinding Title}" />
                    <ContentPresenter Grid.Column="1" Grid.RowSpan="2" Content="{TemplateBinding ActionContent}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                        Text="{TemplateBinding Subtitle}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeKpiCard">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard Surface="Card" PaddingMode="Compact" Elevation="Card">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            Text="{TemplateBinding Title}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                FontSize="{DynamicResource Edge.FontSize.Title}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Value}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                Text="{TemplateBinding Unit}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            Text="{TemplateBinding TrendText}" />
                    </StackPanel>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeMetricCard">
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard Surface="Card" PaddingMode="Compact" Elevation="Flat">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing6}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                            <StackPanel Spacing="{DynamicResource Edge.Size.Spacing2}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{DynamicResource Edge.Size.Spacing6}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{TemplateBinding Title}" />
                                    <controls:EdgeStatusDot
                                        VerticalAlignment="Center"
                                        Status="{TemplateBinding Status}" />
                                </StackPanel>
                            </StackPanel>
                            <Border
                                Classes="metric-icon"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Background="{DynamicResource Edge.Brush.Surface.Highlight}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Circle}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}" />
                            </Border>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource Edge.Size.Spacing6}">
                            <TextBlock
                                FontFamily="{DynamicResource Edge.FontFamily.Display}"
                                FontSize="{DynamicResource Edge.FontSize.Title}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Value}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                Text="{TemplateBinding Unit}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="2"
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeMetricCard.no-icon Border.metric-icon">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeSummaryCard">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard Surface="Card" PaddingMode="Compact" Elevation="Flat">
                    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            Text="{TemplateBinding Title}" />
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{TemplateBinding ItemsSource}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        MinHeight="40"
                                        Padding="12,8"
                                        Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                        CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                Text="{Binding Label}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                Text="{Binding Value}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeParameterPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    CardBorderThickness="0"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Card}"
                    CardPadding="10,6"
                    Elevation="Card"
                    PaddingMode="None"
                    Surface="Raised">
                    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                        <StackPanel Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Classes="edge-parameter-subtitle"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                Text="{TemplateBinding Subtitle}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ContentPresenter
                            Grid.Row="1"
                            Content="{TemplateBinding Content}" />
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeParameterPanel TextBlock.edge-parameter-subtitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeParameterPanel.has-subtitle TextBlock.edge-parameter-subtitle">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeFieldRow">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_EdgeFieldRowRoot"
                    MinHeight="34"
                    Padding="10,4"
                    Background="{DynamicResource Edge.Brush.Surface.Card}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <Grid
                        x:Name="PART_EdgeFieldRowGrid"
                        ColumnDefinitions="168,*"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Label}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{TemplateBinding Label}" />
                            <TextBlock
                                Classes="edge-field-description"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                LineHeight="14"
                                MaxLines="2"
                                Text="{TemplateBinding Description}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTip.Tip="{TemplateBinding Description}" />
                        </StackPanel>

                        <ContentPresenter
                            x:Name="PART_EdgeFieldRowValueHost"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding ValueContent}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeFieldRow TextBlock.edge-field-description">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.has-description TextBlock.edge-field-description">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.boolean /template/ Border#PART_EdgeFieldRowRoot">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style Selector="controls|EdgeFieldRow.boolean /template/ ContentPresenter#PART_EdgeFieldRowValueHost">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    CardBorderThickness="0"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Card}"
                    CardPadding="14,10"
                    Elevation="Card"
                    PaddingMode="None"
                    Surface="Raised">
                    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing6}">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            Text="{TemplateBinding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Row="1"
                            Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                Classes="edge-status-summary-primary"
                                FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding PrimaryText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="edge-status-summary-secondary"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                Text="{TemplateBinding SecondaryText}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Classes="edge-status-summary-tertiary"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                                Text="{TemplateBinding TertiaryText}"
                                TextWrapping="Wrap" />
                            <Border
                                Classes="edge-status-summary-footer"
                                Padding="10,6"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding FooterText}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard TextBlock.edge-status-summary-primary">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard.has-primary TextBlock.edge-status-summary-primary">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard TextBlock.edge-status-summary-secondary">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard.has-secondary TextBlock.edge-status-summary-secondary">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard TextBlock.edge-status-summary-tertiary">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard.has-tertiary TextBlock.edge-status-summary-tertiary">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard Border.edge-status-summary-footer">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeStatusSummaryCard.has-footer Border.edge-status-summary-footer">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeStatusPill">
        <Setter Property="Fill" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Offline}" />
        <Setter Property="TextBrush" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                    Background="{TemplateBinding Fill}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Pill}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{DynamicResource Edge.Size.Spacing6}">
                        <Border
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding DotFill}"
                            CornerRadius="{DynamicResource Edge.CornerRadius.Circle}" />
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            FontWeight="SemiBold"
                            Foreground="{TemplateBinding TextBrush}"
                            Text="{TemplateBinding Text}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeStatusPill.running">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Running}" />
    </Style>

    <Style Selector="controls|EdgeStatusPill.idle">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Idle}" />
    </Style>

    <Style Selector="controls|EdgeStatusPill.stopped">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Stopped}" />
    </Style>

    <Style Selector="controls|EdgeStatusPill.info">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Info}" />
    </Style>

    <Style Selector="controls|EdgeStatusPill.warning">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Warning}" />
    </Style>

    <Style Selector="controls|EdgeStatusPill.error">
        <Setter Property="DotFill" Value="{DynamicResource Edge.Brush.Status.Error}" />
    </Style>

    <Style Selector="controls|EdgeSegmentedNav">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing4}" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeSegmentedNav ListBoxItem">
        <Setter Property="Width" Value="96" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemForeground}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeSegmentedNav ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemHover}" />
    </Style>

    <Style Selector="controls|EdgeSegmentedNav ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
    </Style>

    <Style Selector="controls|EdgeListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="controls|EdgeListBox ListBoxItem">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeListBox ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Primary}" />
    </Style>

    <Style Selector="controls|EdgeListBox ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Segmented.ItemSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Segmented.ItemSelectedForeground}" />
    </Style>

    <Style Selector="controls|EdgeTablePanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    Classes="edge-table-panel-card"
                    CardCornerRadius="{DynamicResource Edge.CornerRadius.Card}"
                    ClipToBounds="True"
                    Elevation="Card"
                    VerticalAlignment="Top"
                    PaddingMode="Compact"
                    Surface="Card">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <Grid
                            Grid.Row="0"
                            MinHeight="32"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{TemplateBinding Title}" />
                                <TextBlock
                                    Classes="edge-table-subtitle"
                                    Margin="0,4,0,0"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding Subtitle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ContentPresenter
                                Grid.Column="1"
                                Classes="edge-table-actions"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding ActionContent}" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            Classes="edge-table-toolbar"
                            Margin="0,6,0,0"
                            ColumnDefinitions="*">
                            <ContentPresenter
                                Classes="edge-table-filter"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding FilterContent}" />
                        </Grid>

                        <ContentPresenter
                            Grid.Row="2"
                            Classes="edge-table-status"
                            Margin="0,4,0,0"
                            Content="{TemplateBinding StatusContent}" />

                        <Grid
                            Grid.Row="3"
                            Classes="edge-table-content-host"
                            MinHeight="{TemplateBinding ContentMinHeight}">
                            <ContentPresenter
                                Classes="edge-table-content"
                                Content="{TemplateBinding Content}" />

                            <Border
                                Classes="edge-table-error"
                                Padding="{DynamicResource Edge.Thickness.Card.Compact}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Body}"
                                    Foreground="{DynamicResource Edge.Brush.Status.Error}"
                                    Text="{TemplateBinding ErrorMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Border>

                            <StackPanel
                                Classes="edge-table-empty"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{TemplateBinding EmptyTitle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding EmptyMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ContentPresenter
                            Grid.Row="4"
                            HorizontalAlignment="Stretch"
                            Content="{TemplateBinding FooterContent}" />
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeTablePanel ContentPresenter.edge-table-content">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="controls|EdgeTablePanel controls|EdgeCard.edge-table-panel-card">
        <Setter Property="CardPadding" Value="16,12" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="controls|EdgeTablePanel Grid.edge-table-content-host">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.actions-only">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.actions-only Grid.edge-table-content-host">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.actions-only controls|EdgeCard.edge-table-panel-card">
        <Setter Property="CardPadding" Value="12" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.density-compact Grid.edge-table-content-host">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.density-compact controls|EdgeCard.edge-table-panel-card">
        <Setter Property="CardPadding" Value="12" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.density-diagnostic Grid.edge-table-content-host">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style Selector="controls|EdgeTablePanel ContentPresenter.edge-table-status">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.has-status ContentPresenter.edge-table-status">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel Grid.edge-table-toolbar">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.has-filter Grid.edge-table-toolbar">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel ContentPresenter.edge-table-actions">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.has-actions ContentPresenter.edge-table-actions">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel TextBlock.edge-table-subtitle">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.has-subtitle TextBlock.edge-table-subtitle">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.surface-transparent controls|EdgeCard.edge-table-panel-card">
        <Setter Property="CardBackground" Value="{DynamicResource Edge.Brush.App.Container}" />
        <Setter Property="CardBorderBrush" Value="Transparent" />
        <Setter Property="CardBorderThickness" Value="0" />
        <Setter Property="CardPadding" Value="{DynamicResource Edge.Thickness.Zero}" />
        <Setter Property="CardShadow" Value="{DynamicResource Edge.Shadow.None}" />
    </Style>

    <Style Selector="controls|EdgeTablePanel Border.edge-table-error">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel StackPanel.edge-table-empty">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel:error ContentPresenter.edge-table-content">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel:error Border.edge-table-error">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel:error StackPanel.edge-table-empty">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel:empty ContentPresenter.edge-table-content">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeTablePanel:empty StackPanel.edge-table-empty">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.empty-content-visible:empty ContentPresenter.edge-table-content">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeTablePanel.empty-content-visible:empty StackPanel.edge-table-empty">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeDataPanel">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard Surface="Card" PaddingMode="Compact" Elevation="Flat">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing8}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Title}" />
                            <ContentPresenter
                                Grid.Column="1"
                                Content="{TemplateBinding ActionContent}" />
                        </Grid>

                        <ContentPresenter
                            Grid.Row="1"
                            Content="{TemplateBinding HeaderContent}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}" />

                        <Grid Grid.Row="2">
                            <StackPanel Classes="edge-data-panel-content">
                                <ContentPresenter Content="{TemplateBinding Content}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        ItemTemplate="{TemplateBinding ItemTemplate}"
                                        ItemsSource="{TemplateBinding ItemsSource}" />
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel
                                IsVisible="{TemplateBinding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="300"
                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{TemplateBinding EmptyTitle}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{TemplateBinding EmptyMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeDataPanel:empty StackPanel.edge-data-panel-content">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeReportFilterBar">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:EdgeCard
                    Elevation="Flat"
                    MinHeight="56"
                    PaddingMode="Compact"
                    Surface="Card">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                        RowDefinitions="Auto">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding LeadingContent}" />
                        <ContentPresenter
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding FilterContent}" />
                        <ContentPresenter
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding ActionContent}" />
                    </Grid>
                </controls:EdgeCard>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeMetricStrip">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeNoticeBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="14,10"
                    Background="{DynamicResource Edge.Brush.Surface.Wash}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
                        <ContentPresenter
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding ActionContent}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeNoticeBar.running Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Highlight}" />
    </Style>

    <Style Selector="controls|EdgeNoticeBar.idle Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeNoticeBar.info Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeNoticeBar.cache Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeNoticeBar.warning Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeNoticeBar.error Border">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.WindowButton.CloseHover}" />
    </Style>

    <Style Selector="controls|EdgeBarLineChart">
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="TrackBrush" Value="{DynamicResource Edge.Brush.Surface.Card}" />
        <Setter Property="GridLineBrush" Value="{DynamicResource Edge.Brush.Border.Subtle}" />
        <Setter Property="AxisTextBrush" Value="{DynamicResource Edge.Brush.Text.Muted}" />
        <Setter Property="LegendTextBrush" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="DefaultBarBrush" Value="{DynamicResource Edge.Brush.Chart.Accent}" />
        <Setter Property="DefaultLineBrush" Value="{DynamicResource Edge.Brush.Chart.Secondary}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ClipToBounds="True">
                    <ContentPresenter
                        Classes="edge-chart-empty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding EmptyContent}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeBarLineChart ContentPresenter.edge-chart-empty">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="controls|EdgeBarLineChart:empty ContentPresenter.edge-chart-empty">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem">
        <Setter Property="ItemBackground" Value="{DynamicResource Edge.Brush.Surface.Panel}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    x:Name="PART_EdgeStatusListItemRoot"
                    Padding="{DynamicResource Edge.Thickness.12}"
                    Background="{TemplateBinding ItemBackground}"
                    CornerRadius="{DynamicResource Edge.CornerRadius.Medium}">
                        <Grid x:Name="PART_EdgeStatusListItemGrid" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                            <controls:EdgeStatusDot
                                VerticalAlignment="Center"
                                Status="{TemplateBinding Status}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{TemplateBinding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                IsVisible="{TemplateBinding HasDescription}"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                IsVisible="{TemplateBinding HasDetail}"
                                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                Text="{TemplateBinding Detail}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="{DynamicResource Edge.Size.Spacing6}">
                            <controls:EdgeStatusChip
                                HorizontalAlignment="Right"
                                IsVisible="{TemplateBinding HasStatusText}"
                                Status="{TemplateBinding Status}"
                                Text="{TemplateBinding StatusText}" />
                            <ContentPresenter
                                IsVisible="{TemplateBinding HasActionContent}"
                                Content="{TemplateBinding ActionContent}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|EdgeStatusListItem:pointerover">
        <Setter Property="ItemBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.compact">
        <Setter Property="ItemBackground" Value="{DynamicResource Edge.Brush.Surface.Card}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.compact /template/ Border#PART_EdgeStatusListItemRoot">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.compact /template/ Grid#PART_EdgeStatusListItemGrid">
        <Setter Property="ColumnSpacing" Value="{DynamicResource Edge.Size.Spacing8}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.right-rail /template/ Border#PART_EdgeStatusListItemRoot">
        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.compact.right-rail /template/ Border#PART_EdgeStatusListItemRoot">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.right-rail controls|EdgeStatusChip">
        <Setter Property="ChipPadding" Value="8,1" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.strip">
        <Setter Property="ItemBackground" Value="{DynamicResource Edge.Brush.Surface.Wash}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.strip /template/ Border#PART_EdgeStatusListItemRoot">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Control}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.strip /template/ Grid#PART_EdgeStatusListItemGrid">
        <Setter Property="ColumnSpacing" Value="{DynamicResource Edge.Size.Spacing8}" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.strip controls|EdgeStatusDot">
        <Setter Property="Size" Value="6" />
    </Style>

    <Style Selector="controls|EdgeStatusListItem.strip controls|EdgeStatusChip">
        <Setter Property="ChipPadding" Value="8,0" />
    </Style>
</Styles>
