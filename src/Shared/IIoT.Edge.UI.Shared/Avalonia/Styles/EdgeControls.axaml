        <Setter Property="Background" Value="{DynamicResource Edge.Brush.Language.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Edge.Brush.Language.Border}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Edge.CornerRadius.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource Edge.Brush.Text.Secondary}" />
        <Setter Property="IconSize" Value="15" />
        <Setter Property="IconStrokeThickness" Value="1.6" />
