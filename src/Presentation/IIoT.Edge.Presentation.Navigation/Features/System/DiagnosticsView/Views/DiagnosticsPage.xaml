<UserControl x:Class="IIoT.Edge.Presentation.Navigation.Features.DiagnosticsView.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="{DynamicResource Navigation_Menu_CoreDiagnostics}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,16,0,0"
                           Text="{Binding DiscoveredModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding EnabledModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ActivatedModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ConfigurationProfileSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding LastUpdatedSummary}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_CloudSync}" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudGateSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudRuntimeSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudResultSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudPendingSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudCapacitySummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudPersistenceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastAttemptSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastSuccessSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastFailureSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_MesSync}" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding MesRuntimeSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesPendingSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesCapacitySummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesPersistenceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastAttemptSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastSuccessSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastFailureSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_Context}" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <TextBlock Text="{Binding ContextPersistenceSummary}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_Startup}" />
                <TextBlock Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_PluginLifecycle}" />
                <DataGrid ItemsSource="{Binding PluginStates}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_ModuleId}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleId" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_DisplayName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DisplayName" Binding="{Binding DisplayName}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Process}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Process" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Version}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Version" Binding="{Binding Version}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_State}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_State" Binding="{Binding State}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Message}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_Modules}" />
                <DataGrid ItemsSource="{Binding ModuleRegistrations}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_ModuleId}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleId" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Process}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Process" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Assembly}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Assembly" Binding="{Binding AssemblyName}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_Enabled}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Enabled" Binding="{Binding IsEnabled}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_CellData}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_CellData" Binding="{Binding HasCellDataRegistration}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_Runtime}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Runtime" Binding="{Binding HasRuntimeFactory}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_CloudUpload}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_CloudUpload" Binding="{Binding HasCloudUploader}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_MesUpload}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_MesUpload" Binding="{Binding HasMesUploader}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_HardwareProfile}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_HardwareProfile" Binding="{Binding HasHardwareProfile}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_DeviceBinding}" />
                <DataGrid ItemsSource="{Binding DeviceBindings}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Device}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Device" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_ModuleId}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleId" Binding="{Binding ModuleId}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_ModuleExists}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleExists" Binding="{Binding ModuleExists}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_ModuleEnabled}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleEnabled" Binding="{Binding ModuleEnabled}" />
                        <DataGridCheckBoxColumn Header="{DynamicResource Navigation_Column_HasIo}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_HasIo" Binding="{Binding HasIoMappings}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_Issues}" />
                <DataGrid ItemsSource="{Binding Issues}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Code}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Code" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_ModuleId}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ModuleId" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Device}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Device" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Message}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Navigation_Diagnostics_MesUpload}" />
                <DataGrid ItemsSource="{Binding MesUploadDiagnostics}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_Process}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Process" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_LastResult}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_LastResult" Binding="{Binding LastResult}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_LastAttempt}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_LastAttempt" Binding="{Binding LastAttemptAt}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_LastSuccess}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_LastSuccess" Binding="{Binding LastSuccessAt}" />
                        <DataGridTextColumn Header="{DynamicResource Navigation_Column_FailureReason}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_FailureReason" Binding="{Binding LastFailureReason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
