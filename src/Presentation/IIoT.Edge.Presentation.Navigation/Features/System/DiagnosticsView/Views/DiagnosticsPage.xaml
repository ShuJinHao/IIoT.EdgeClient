<UserControl x:Class="IIoT.Edge.Presentation.Navigation.Features.DiagnosticsView.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="系统诊断"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,16,0,0"
                           Text="{Binding DiscoveredModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding EnabledModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ActivatedModulesSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ConfigurationProfileSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding LastUpdatedSummary}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="云端同步诊断" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudGateSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudRuntimeSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudResultSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudPendingSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudCapacitySummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudPersistenceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastAttemptSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastSuccessSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding CloudLastFailureSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="MES同步诊断" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding MesRuntimeSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesPendingSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesCapacitySummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesPersistenceSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastAttemptSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastSuccessSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding MesLastFailureSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="生产上下文诊断" />
                <Border Margin="0,0,0,16"
                        Padding="12"
                        Background="#18181B"
                        CornerRadius="6">
                    <TextBlock Text="{Binding ContextPersistenceSummary}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="启动诊断" />
                <TextBlock Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="插件生命周期" />
                <DataGrid ItemsSource="{Binding PluginStates}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="模块ID" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" />
                        <DataGridTextColumn Header="工序" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="版本" Binding="{Binding Version}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" />
                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="模块注册" />
                <DataGrid ItemsSource="{Binding ModuleRegistrations}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="模块ID" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="工序" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="程序集" Binding="{Binding AssemblyName}" />
                        <DataGridCheckBoxColumn Header="已启用" Binding="{Binding IsEnabled}" />
                        <DataGridCheckBoxColumn Header="产品数据" Binding="{Binding HasCellDataRegistration}" />
                        <DataGridCheckBoxColumn Header="运行时" Binding="{Binding HasRuntimeFactory}" />
                        <DataGridCheckBoxColumn Header="云端上传" Binding="{Binding HasCloudUploader}" />
                        <DataGridCheckBoxColumn Header="MES上传" Binding="{Binding HasMesUploader}" />
                        <DataGridCheckBoxColumn Header="硬件模板" Binding="{Binding HasHardwareProfile}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="设备绑定" />
                <DataGrid ItemsSource="{Binding DeviceBindings}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="模块ID" Binding="{Binding ModuleId}" />
                        <DataGridCheckBoxColumn Header="模块存在" Binding="{Binding ModuleExists}" />
                        <DataGridCheckBoxColumn Header="模块启用" Binding="{Binding ModuleEnabled}" />
                        <DataGridCheckBoxColumn Header="已配置IO" Binding="{Binding HasIoMappings}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,8,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="问题列表" />
                <DataGrid ItemsSource="{Binding Issues}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编码" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="模块ID" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" />
                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,24,0,8"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="MES上传诊断" />
                <DataGrid ItemsSource="{Binding MesUploadDiagnostics}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工序" Binding="{Binding ProcessType}" />
                        <DataGridTextColumn Header="最近结果" Binding="{Binding LastResult}" />
                        <DataGridTextColumn Header="最近尝试" Binding="{Binding LastAttemptAt}" />
                        <DataGridTextColumn Header="最近成功" Binding="{Binding LastSuccessAt}" />
                        <DataGridTextColumn Header="失败原因" Binding="{Binding LastFailureReason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
