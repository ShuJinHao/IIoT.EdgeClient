<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.DiagnosticsView.DiagnosticsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,*">
        <controls:EdgeCard
            Margin="20,10,30,0"
            HorizontalAlignment="Left"
            Height="44"
            Elevation="Flat"
            PaddingMode="None"
            Surface="Wash">
            <controls:EdgeSegmentedNav
                ItemCommand="{Binding SelectTabCommand}"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                SelectionMode="Single">
                <controls:EdgeSegmentedNav.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </controls:EdgeSegmentedNav.ItemsPanel>
                <controls:EdgeSegmentedNav.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            Text="{Binding Title}" />
                    </DataTemplate>
                </controls:EdgeSegmentedNav.ItemTemplate>
            </controls:EdgeSegmentedNav>
        </controls:EdgeCard>

        <controls:EdgeScrollHost
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,20" Spacing="16">
                <StackPanel IsVisible="{Binding IsSyncOpsTabSelected}" Spacing="16">
                    <controls:EdgeCard PaddingMode="Compact">
                        <controls:EdgeCard.Header>
                            <controls:EdgeSectionHeader
                                Title="{DynamicResource Navigation_Diagnostics_SyncStatusTable}"
                                Subtitle="{DynamicResource Navigation_Diagnostics_SyncStatusSubtitle}" />
                        </controls:EdgeCard.Header>
                        <ItemsControl ItemsSource="{Binding SyncChannels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing8}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:EdgeStatusListItem
                                        Classes="strip"
                                        Description="{Binding Pending}"
                                        Detail="{Binding DetailText}"
                                        Status="{Binding VisualStatus}"
                                        StatusText="{Binding Status}"
                                        Title="{Binding Channel}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:EdgeCard>

                    <controls:EdgeTablePanel
                        Title="{DynamicResource Navigation_Diagnostics_MesUpload}"
                        IsEmpty="{Binding !MesUploadDiagnostics.Count}"
                        EmptyTitle="{DynamicResource Navigation_Diagnostics_NoMesUploadDiagnostics}"
                        EmptyMessage="{DynamicResource Navigation_Diagnostics_NoMesUploadDiagnosticsMessage}">
                        <controls:EdgeDataGrid
                            Density="Compact"
                            AutoGenerateColumns="False"
                            CanUserSortColumns="False"
                            ItemsSource="{Binding MesUploadDiagnostics}">
                            <controls:EdgeDataGrid.Columns>
                                <controls:EdgeTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" MinWidth="150" Width="150" />
                                <controls:EdgeTextColumn Binding="{Binding LastResult}" Header="{DynamicResource Navigation_Column_LastResult}" MinWidth="150" Width="150" />
                                <controls:EdgeTextColumn Binding="{Binding LastAttemptAt}" Header="{DynamicResource Navigation_Column_LastAttempt}" MinWidth="160" Width="160" />
                                <controls:EdgeTextColumn Binding="{Binding LastSuccessAt}" Header="{DynamicResource Navigation_Column_LastSuccess}" MinWidth="160" Width="160" />
                                <controls:EdgeTextColumn Binding="{Binding LastFailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" MinWidth="300" Width="2*" />
                            </controls:EdgeDataGrid.Columns>
                        </controls:EdgeDataGrid>
                    </controls:EdgeTablePanel>

                    <controls:EdgeTablePanel
                        Title="{DynamicResource Navigation_Diagnostics_CloudDeadLetters}"
                        IsEmpty="{Binding !CloudDeadLetters.Count}"
                        EmptyTitle="{DynamicResource Navigation_Diagnostics_NoDeadLetters}"
                        EmptyMessage="{DynamicResource Navigation_Diagnostics_NoDeadLettersMessage}">
                        <controls:EdgeTablePanel.ActionContent>
                            <controls:EdgeNoticeBar IsVisible="{Binding !CanOperateDeadLetters}">
                                <controls:EdgeNoticeBar.Content>
                                    <TextBlock
                                        Classes="edge-notice-message"
                                        Text="{DynamicResource Navigation_Diagnostics_AdminOnlyNotice}" />
                                </controls:EdgeNoticeBar.Content>
                            </controls:EdgeNoticeBar>
                        </controls:EdgeTablePanel.ActionContent>
                        <controls:EdgeDataGrid
                            Density="Compact"
                            AutoGenerateColumns="False"
                            CanUserSortColumns="False"
                            ItemsSource="{Binding CloudDeadLetters}">
                            <controls:EdgeDataGrid.Columns>
                                <controls:EdgeTextColumn Binding="{Binding Id}" Header="{DynamicResource Navigation_Column_Id}" MinWidth="70" Width="70" />
                                <controls:EdgeTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" MinWidth="130" Width="130" />
                                <controls:EdgeTextColumn Binding="{Binding FailureStage}" Header="{DynamicResource Navigation_Column_Stage}" MinWidth="130" Width="130" />
                                <controls:EdgeTextColumn Binding="{Binding FailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" MinWidth="300" Width="2*" />
                                <controls:EdgeTextColumn Binding="{Binding CreatedAt}" Header="{DynamicResource Navigation_Column_Time}" MinWidth="150" Width="150" />
                                <controls:EdgeActionColumn Header="{DynamicResource Navigation_Column_Action}" MinWidth="170" Width="170">
                                    <controls:EdgeActionColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                Margin="4,0">
                                                <controls:EdgeActionButton
                                                    Command="{Binding $parent[UserControl].DataContext.RequeueDeadLetterCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Navigation_Button_Requeue}"
                                                    Icon="{StaticResource Edge.Icon.Sync}"
                                                    Kind="Primary"
                                                    Role="Cell"
                                                    Size="Compact" />
                                                <controls:EdgeActionButton
                                                    Command="{Binding $parent[UserControl].DataContext.DeleteDeadLetterCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Navigation_Button_Delete}"
                                                    Icon="{StaticResource Edge.Icon.Delete}"
                                                    Kind="Danger"
                                                    Role="Cell"
                                                    Size="Compact" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:EdgeActionColumn.CellTemplate>
                                </controls:EdgeActionColumn>
                            </controls:EdgeDataGrid.Columns>
                        </controls:EdgeDataGrid>
                    </controls:EdgeTablePanel>

                    <controls:EdgeTablePanel
                        Title="{DynamicResource Navigation_Diagnostics_MesDeadLetters}"
                        IsEmpty="{Binding !MesDeadLetters.Count}"
                        EmptyTitle="{DynamicResource Navigation_Diagnostics_NoDeadLetters}"
                        EmptyMessage="{DynamicResource Navigation_Diagnostics_NoDeadLettersMessage}">
                        <controls:EdgeTablePanel.ActionContent>
                            <controls:EdgeNoticeBar IsVisible="{Binding !CanOperateDeadLetters}">
                                <controls:EdgeNoticeBar.Content>
                                    <TextBlock
                                        Classes="edge-notice-message"
                                        Text="{DynamicResource Navigation_Diagnostics_AdminOnlyNotice}" />
                                </controls:EdgeNoticeBar.Content>
                            </controls:EdgeNoticeBar>
                        </controls:EdgeTablePanel.ActionContent>
                        <controls:EdgeDataGrid
                            Density="Compact"
                            AutoGenerateColumns="False"
                            CanUserSortColumns="False"
                            ItemsSource="{Binding MesDeadLetters}">
                            <controls:EdgeDataGrid.Columns>
                                <controls:EdgeTextColumn Binding="{Binding Id}" Header="{DynamicResource Navigation_Column_Id}" MinWidth="70" Width="70" />
                                <controls:EdgeTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" MinWidth="130" Width="130" />
                                <controls:EdgeTextColumn Binding="{Binding FailureStage}" Header="{DynamicResource Navigation_Column_Stage}" MinWidth="130" Width="130" />
                                <controls:EdgeTextColumn Binding="{Binding FailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" MinWidth="300" Width="2*" />
                                <controls:EdgeTextColumn Binding="{Binding CreatedAt}" Header="{DynamicResource Navigation_Column_Time}" MinWidth="150" Width="150" />
                                <controls:EdgeActionColumn Header="{DynamicResource Navigation_Column_Action}" MinWidth="170" Width="170">
                                    <controls:EdgeActionColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                Margin="4,0">
                                                <controls:EdgeActionButton
                                                    Command="{Binding $parent[UserControl].DataContext.RequeueDeadLetterCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Navigation_Button_Requeue}"
                                                    Icon="{StaticResource Edge.Icon.Sync}"
                                                    Kind="Primary"
                                                    Role="Cell"
                                                    Size="Compact" />
                                                <controls:EdgeActionButton
                                                    Command="{Binding $parent[UserControl].DataContext.DeleteDeadLetterCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Navigation_Button_Delete}"
                                                    Icon="{StaticResource Edge.Icon.Delete}"
                                                    Kind="Danger"
                                                    Role="Cell"
                                                    Size="Compact" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:EdgeActionColumn.CellTemplate>
                                </controls:EdgeActionColumn>
                            </controls:EdgeDataGrid.Columns>
                        </controls:EdgeDataGrid>
                    </controls:EdgeTablePanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsStartupTabSelected}" Spacing="16">
                    <controls:EdgeCard IsVisible="{Binding IsStartupHealthy}" PaddingMode="Compact">
                        <controls:EdgeStatusListItem
                            Classes="strip"
                            Description="{DynamicResource Navigation_Diagnostics_StartupSelfCheckOkMessage}"
                            Status="Running"
                            StatusText="{DynamicResource Navigation_Diagnostics_StartupOk}"
                            Title="{DynamicResource Navigation_Diagnostics_StartupSelfCheckOk}" />
                    </controls:EdgeCard>

                    <controls:EdgeCard
                        IsVisible="{Binding HasStartupIssues}"
                        PaddingMode="None">
                        <StackPanel Margin="14,12" Spacing="{DynamicResource Edge.Size.Spacing4}">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Section}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{DynamicResource Navigation_Diagnostics_Issues}" />
                                <controls:EdgeStatusChip
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ChipPadding="8,0"
                                    ShowDot="False"
                                    Status="Default"
                                    Text="{Binding TotalIssueCount}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,7">
                                            <Grid
                                                ColumnDefinitions="Auto,*"
                                                ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                                                HorizontalAlignment="Stretch"
                                                MinHeight="50">
                                                <Grid VerticalAlignment="Center">
                                                    <Border
                                                        Classes="edge-issue-rail error"
                                                        IsVisible="{Binding IsError}" />
                                                    <Border
                                                        Classes="edge-issue-rail warning"
                                                        IsVisible="{Binding IsWarning}" />
                                                </Grid>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="{DynamicResource Edge.Size.Spacing4}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                        <TextBlock
                                                            FontSize="{DynamicResource Edge.FontSize.Body}"
                                                            FontWeight="Medium"
                                                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                            LineHeight="20"
                                                            Text="{Binding Message}"
                                                            TextTrimming="None"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                            IsVisible="{Binding HasDuplicateCount}"
                                                            Text="{Binding DuplicateBadgeText}" />
                                                    </Grid>
                                                    <TextBlock
                                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                        LineHeight="16"
                                                        Text="{Binding IssueSubtitle}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:EdgeCard>

                    <controls:EdgeCard PaddingMode="Compact">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing16}">
                            <controls:EdgeSectionHeader Title="{DynamicResource Navigation_Diagnostics_Context}" />
                            <StackPanel
                                Grid.Column="1"
                                MinWidth="120"
                                VerticalAlignment="Center"
                                Spacing="{DynamicResource Edge.Size.Spacing2}">
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                    Text="{DynamicResource Navigation_Diagnostics_ContextCorruptCount}" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.Title}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{Binding ContextCorruptFileCount}" />
                            </StackPanel>
                            <controls:EdgeStatusListItem
                                Grid.Column="2"
                                MinWidth="260"
                                Classes="strip"
                                Description="{Binding ContextLastCorruptDetectedAt}"
                                Status="{Binding ContextPersistenceVisualStatus}"
                                StatusText="{DynamicResource Navigation_Diagnostics_FileCountUnit}"
                                Title="{DynamicResource Navigation_Diagnostics_ContextLastCorrupt}" />
                        </Grid>
                    </controls:EdgeCard>

                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing8}">
                        <controls:EdgeSectionHeader
                            Title="{DynamicResource Navigation_Diagnostics_ConfigLabel}"
                            Subtitle="{Binding LastUpdatedSummary}" />
                        <Grid
                            ColumnDefinitions="1.05*,1.15*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                            RowSpacing="{DynamicResource Edge.Size.Spacing12}">
                            <Border
                                MinHeight="82"
                                Padding="{DynamicResource Edge.Thickness.12}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Medium}">
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_Diagnostics_ConfigEnvironment}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding ConfigurationEnvironment}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                MinHeight="82"
                                Padding="{DynamicResource Edge.Thickness.12}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Medium}">
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing4}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_Diagnostics_ConfigMachineProfile}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding ConfigurationMachineProfile}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{Binding ConfigurationMachineProfileState}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                MinHeight="82"
                                Padding="{DynamicResource Edge.Thickness.12}"
                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                BorderBrush="{DynamicResource Edge.Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Edge.CornerRadius.Medium}">
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_Diagnostics_ConfigRuntimeDataRoot}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding ConfigurationRuntimeDataRoot}"
                                        TextWrapping="Wrap"
                                        ToolTip.Tip="{Binding ConfigurationRuntimeDataRoot}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </controls:EdgeScrollHost>
    </Grid>
</UserControl>
