<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.DiagnosticsView.DiagnosticsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Edge.Text.Primary}"
                    Text="{DynamicResource Navigation_Menu_CoreDiagnostics}" />
                <TextBlock
                    Foreground="{DynamicResource Edge.Text.Muted}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding DiscoveredModulesSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding EnabledModulesSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding ActivatedModulesSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding ConfigurationProfileSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding LastUpdatedSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_CloudSync}" />
            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding DeviceSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudGateSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudRuntimeSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudResultSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudPendingSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudCapacitySummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding CloudPersistenceSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding CloudLastAttemptSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding CloudLastSuccessSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding CloudLastFailureSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_DeadLetters}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_CloudDeadLetters}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding CloudDeadLetters}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" />
                    <DataGridTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailedTarget}" Header="{DynamicResource Navigation_Column_Target}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailureStage}" Header="{DynamicResource Navigation_Column_Stage}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Source}" Header="{DynamicResource Navigation_Column_Source}" Width="*" />
                    <DataGridTextColumn Binding="{Binding CreatedAt}" Header="{DynamicResource Navigation_Column_CreatedAt}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" Width="2*" />
                    <DataGridTemplateColumn Header="{DynamicResource Navigation_Column_Action}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Padding="10,4"
                                        Command="{Binding $parent[UserControl].DataContext.RequeueDeadLetterCommand}"
                                        CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Navigation_Button_Requeue}" />
                                    </Button>
                                    <Button
                                        Padding="10,4"
                                        Command="{Binding $parent[UserControl].DataContext.DeleteDeadLetterCommand}"
                                        CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Navigation_Button_Delete}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_MesDeadLetters}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding MesDeadLetters}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80" />
                    <DataGridTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailedTarget}" Header="{DynamicResource Navigation_Column_Target}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailureStage}" Header="{DynamicResource Navigation_Column_Stage}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Source}" Header="{DynamicResource Navigation_Column_Source}" Width="*" />
                    <DataGridTextColumn Binding="{Binding CreatedAt}" Header="{DynamicResource Navigation_Column_CreatedAt}" Width="*" />
                    <DataGridTextColumn Binding="{Binding FailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" Width="2*" />
                    <DataGridTemplateColumn Header="{DynamicResource Navigation_Column_Action}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        Padding="10,4"
                                        Command="{Binding $parent[UserControl].DataContext.RequeueDeadLetterCommand}"
                                        CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Navigation_Button_Requeue}" />
                                    </Button>
                                    <Button
                                        Padding="10,4"
                                        Command="{Binding $parent[UserControl].DataContext.DeleteDeadLetterCommand}"
                                        CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Navigation_Button_Delete}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_MesSync}" />
            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding MesRuntimeSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding MesPendingSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding MesCapacitySummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding MesPersistenceSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding MesLastAttemptSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding MesLastSuccessSummary}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding MesLastFailureSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_Context}" />
            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding ContextPersistenceSummary}" TextWrapping="Wrap" />
            </Border>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_Startup}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_PluginLifecycle}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding PluginStates}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ModuleId}" Header="{DynamicResource Navigation_Column_ModuleId}" Width="*" />
                    <DataGridTextColumn Binding="{Binding DisplayName}" Header="{DynamicResource Navigation_Column_DisplayName}" Width="*" />
                    <DataGridTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Version}" Header="{DynamicResource Navigation_Column_Version}" Width="*" />
                    <DataGridTextColumn Binding="{Binding State}" Header="{DynamicResource Navigation_Column_State}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Message}" Header="{DynamicResource Navigation_Column_Message}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_Modules}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ModuleRegistrations}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ModuleId}" Header="{DynamicResource Navigation_Column_ModuleId}" Width="*" />
                    <DataGridTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" Width="*" />
                    <DataGridTextColumn Binding="{Binding AssemblyName}" Header="{DynamicResource Navigation_Column_Assembly}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="{DynamicResource Navigation_Column_Enabled}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasCellDataRegistration}" Header="{DynamicResource Navigation_Column_CellData}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasRuntimeFactory}" Header="{DynamicResource Navigation_Column_Runtime}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasCloudUploader}" Header="{DynamicResource Navigation_Column_CloudUpload}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasMesUploader}" Header="{DynamicResource Navigation_Column_MesUpload}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasHardwareProfile}" Header="{DynamicResource Navigation_Column_HardwareProfile}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_DeviceBinding}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding DeviceBindings}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding DeviceName}" Header="{DynamicResource Navigation_Column_Device}" Width="*" />
                    <DataGridTextColumn Binding="{Binding ModuleId}" Header="{DynamicResource Navigation_Column_ModuleId}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding ModuleExists}" Header="{DynamicResource Navigation_Column_ModuleExists}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding ModuleEnabled}" Header="{DynamicResource Navigation_Column_ModuleEnabled}" Width="*" />
                    <DataGridCheckBoxColumn Binding="{Binding HasIoMappings}" Header="{DynamicResource Navigation_Column_HasIo}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_Issues}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Issues}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Code}" Header="{DynamicResource Navigation_Column_Code}" Width="*" />
                    <DataGridTextColumn Binding="{Binding ModuleId}" Header="{DynamicResource Navigation_Column_ModuleId}" Width="*" />
                    <DataGridTextColumn Binding="{Binding DeviceName}" Header="{DynamicResource Navigation_Column_Device}" Width="*" />
                    <DataGridTextColumn Binding="{Binding Message}" Header="{DynamicResource Navigation_Column_Message}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Diagnostics_MesUpload}" />
            <DataGrid
                Classes="edge-grid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding MesUploadDiagnostics}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding ProcessType}" Header="{DynamicResource Navigation_Column_Process}" Width="*" />
                    <DataGridTextColumn Binding="{Binding LastResult}" Header="{DynamicResource Navigation_Column_LastResult}" Width="*" />
                    <DataGridTextColumn Binding="{Binding LastAttemptAt}" Header="{DynamicResource Navigation_Column_LastAttempt}" Width="*" />
                    <DataGridTextColumn Binding="{Binding LastSuccessAt}" Header="{DynamicResource Navigation_Column_LastSuccess}" Width="*" />
                    <DataGridTextColumn Binding="{Binding LastFailureReason}" Header="{DynamicResource Navigation_Column_FailureReason}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
