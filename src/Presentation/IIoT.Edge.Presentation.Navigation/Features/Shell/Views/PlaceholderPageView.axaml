<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Shell.PlaceholderPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared"
    xmlns:views="clr-namespace:IIoT.Edge.Presentation.Navigation.Features.Shell">
    <Grid Margin="{DynamicResource Edge.Thickness.20}">
        <sharedViews:EmptyStateView
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Message="{Binding Description, RelativeSource={RelativeSource AncestorType=views:PlaceholderPageView}}"
            Title="{Binding Title, RelativeSource={RelativeSource AncestorType=views:PlaceholderPageView}}" />
    </Grid>
</UserControl>
