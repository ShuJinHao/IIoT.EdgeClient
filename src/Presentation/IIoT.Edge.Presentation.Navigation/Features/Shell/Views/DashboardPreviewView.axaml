<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Shell.DashboardPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <Grid Margin="12,4,18,8" RowDefinitions="Auto,220,*" RowSpacing="8">
        <Grid>
            <StackPanel Spacing="2">
                <TextBlock
                    Classes="edge-dashboard-preview-title"
                    Text="{DynamicResource Navigation_DashboardPreview_Title}" />
                <TextBlock
                    Classes="edge-dashboard-preview-subtitle"
                    Text="{DynamicResource Navigation_DashboardPreview_Subtitle}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.08*,0.82*,0.72*"
            ColumnSpacing="12">
            <edge:EdgeMetricCard
                Description="{Binding RecentHourDescription}"
                Icon="{StaticResource Edge.Icon.Dashboard}"
                MinHeight="0"
                Status="Info"
                Title="{DynamicResource Navigation_DashboardPreview_RecentHourOutput}"
                Unit="{DynamicResource Navigation_DashboardPreview_UnitPiece}"
                Value="{Binding RecentHourOutput}" />

            <edge:EdgeCard
                Grid.Column="1"
                Classes="summary"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card"
                MinHeight="0"
                >
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                    <TextBlock
                        Classes="edge-summary-card-title"
                        Text="{DynamicResource Navigation_DashboardPreview_RecipeAndPlc}" />
                    <ItemsControl
                        Grid.Row="1"
                        Classes="edge-summary-card-items"
                        ItemsSource="{Binding ProductionSummaryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="edge-summary-card-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                        <TextBlock
                                            Classes="edge-summary-card-label"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="edge-summary-card-value"
                                            Text="{Binding Value}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="2"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card">
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="*,*"
                    ColumnSpacing="10"
                    RowSpacing="10">
                    <Grid>
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_DeviceLinks}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding DeviceLinksStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding ConnectedDevices}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_PlcAverageLatency}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding PlcLatencyStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding PlcLatencyText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_Mes}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding MesStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding MesStateText}" />
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                IsVisible="{Binding HasMesProbeText}"
                                Text="{Binding MesProbeText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_Cloud}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding CloudStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding CloudStateText}" />
                            <TextBlock
                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                IsVisible="{Binding HasCloudProbeText}"
                                Text="{Binding CloudProbeText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="1.85*,*"
            ColumnSpacing="12">
            <edge:EdgeCard
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{DynamicResource Navigation_DashboardPreview_AlertSummary}" />
                    <Border Classes="edge-dashboard-alert-header">
                        <Grid ColumnDefinitions="58,58,*" ColumnSpacing="10">
                            <TextBlock
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertTime}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertLevel}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertMessage}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Classes="edge-dashboard-data-panel-body">
                        <edge:EdgeScrollHost
                            IsVisible="{Binding !IsAlertEmpty}"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AlertItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="edge-dashboard-alert-row">
                                            <Grid ColumnDefinitions="58,58,*" ColumnSpacing="10">
                                                <TextBlock
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding Time}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Classes="edge-dashboard-alert-level">
                                                    <edge:EdgeStatusDot Status="{Binding Status}" />
                                                    <TextBlock
                                                        Classes="edge-dashboard-alert-level-text"
                                                        Text="{Binding Level}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Classes="edge-dashboard-alert-message"
                                                    Text="{Binding Message}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </edge:EdgeScrollHost>
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsAlertEmpty}"
                            Message="{DynamicResource Navigation_DashboardPreview_NoAlertSource}"
                            Title="{DynamicResource Navigation_DashboardPreview_NoAlertTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="1"
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{Binding UploadHealthTitle}" />
                    <Grid Grid.Row="1" Classes="edge-dashboard-data-panel-body">
                        <StackPanel
                            IsVisible="{Binding IsUploadHealthBodyVisible}"
                            Spacing="{DynamicResource Edge.Size.Spacing12}"
                            VerticalAlignment="Top">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                <edge:EdgeStatusDot
                                    VerticalAlignment="Center"
                                    Status="{Binding UploadHealthStatus}" />
                                <TextBlock
                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                    Text="{Binding UploadHealthStatusText}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding UploadChannelItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{DynamicResource Edge.Size.Spacing8}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            MinWidth="132"
                                            Padding="10,8"
                                            Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                            CornerRadius="{DynamicResource Edge.CornerRadius.Control}">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                    <edge:EdgeStatusDot
                                                        VerticalAlignment="Center"
                                                        Status="{Binding Status}" />
                                                    <TextBlock
                                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                    Text="{Binding StateText}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                    IsVisible="{Binding HasDetailText}"
                                                    Text="{Binding DetailText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ItemsControl
                                                    Grid.Row="3"
                                                    IsVisible="{Binding HasMetrics}"
                                                    ItemsSource="{Binding Metrics}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="{DynamicResource Edge.Size.Spacing2}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                                <TextBlock
                                                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                                    Text="{Binding Label}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                                    Text="{Binding Value}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding UploadHealthSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal"
                                            Spacing="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Width="28"
                                            Height="8"
                                            ToolTip.Tip="{Binding Label}">
                                            <Border
                                                Background="{DynamicResource Edge.Brush.Status.Running}"
                                                CornerRadius="{DynamicResource Edge.CornerRadius.Badge}"
                                                IsVisible="{Binding IsSuccess}" />
                                            <Border
                                                Background="{DynamicResource Edge.Brush.Status.Error}"
                                                CornerRadius="{DynamicResource Edge.CornerRadius.Badge}"
                                                IsVisible="{Binding IsFailure}" />
                                            <Border
                                                Background="{DynamicResource Edge.Brush.Surface.Wash}"
                                                CornerRadius="{DynamicResource Edge.CornerRadius.Badge}"
                                                IsVisible="{Binding IsNeutral}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing4}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_DashboardPreview_LastUploadSuccess}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding LastUploadSuccessText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{DynamicResource Edge.Size.Spacing4}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_DashboardPreview_LastUploadFailure}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding LastUploadFailureText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="{DynamicResource Edge.Size.Spacing4}">
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_DashboardPreview_DeadLetters}" />
                                    <TextBlock
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{Binding UploadDeadLetterText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsUploadHealthEmpty}"
                            Message="{Binding UploadHealthEmptyMessage}"
                            Title="{Binding UploadHealthEmptyTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>
    </Grid>
</UserControl>
