<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Shell.DashboardPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <Grid Margin="12,4,18,8" RowDefinitions="Auto,220,*" RowSpacing="8">
        <Grid>
            <StackPanel Spacing="2">
                <TextBlock
                    Classes="edge-dashboard-preview-title"
                    Text="{DynamicResource Navigation_DashboardPreview_Title}" />
                <TextBlock
                    Classes="edge-dashboard-preview-subtitle"
                    Text="{DynamicResource Navigation_DashboardPreview_Subtitle}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.08*,0.82*,0.72*"
            ColumnSpacing="12">
            <edge:EdgeMetricCard
                Description="{Binding RecentHourDescription}"
                Icon="{StaticResource Edge.Icon.Dashboard}"
                MinHeight="0"
                Status="Info"
                Title="{DynamicResource Navigation_DashboardPreview_RecentHourOutput}"
                Unit="{DynamicResource Navigation_DashboardPreview_UnitPiece}"
                Value="{Binding RecentHourOutput}" />

            <edge:EdgeCard
                Grid.Column="1"
                Classes="summary"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card"
                MinHeight="0"
                >
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                    <TextBlock
                        Classes="edge-summary-card-title"
                        Text="{DynamicResource Navigation_DashboardPreview_RecipeAndPlc}" />
                    <ItemsControl
                        Grid.Row="1"
                        Classes="edge-summary-card-items"
                        ItemsSource="{Binding ProductionSummaryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="edge-summary-card-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                        <TextBlock
                                            Classes="edge-summary-card-label"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="edge-summary-card-value"
                                            Text="{Binding Value}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="2"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card">
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="*,*"
                    ColumnSpacing="10"
                    RowSpacing="10">
                    <Grid>
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_DeviceLinks}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding DeviceLinksStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding ConnectedDevices}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_PlcAverageLatency}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding PlcLatencyStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding PlcLatencyText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_Mes}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding MesStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding MesStateText}" />
                            <TextBlock
                                Classes="edge-dashboard-mini-detail"
                                IsVisible="{Binding HasMesProbeText}"
                                Text="{Binding MesProbeText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_Cloud}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="{Binding CloudStatus}" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding CloudStateText}" />
                            <TextBlock
                                Classes="edge-dashboard-mini-detail"
                                IsVisible="{Binding HasCloudProbeText}"
                                Text="{Binding CloudProbeText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="1.85*,*"
            ColumnSpacing="12">
            <edge:EdgeCard
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{DynamicResource Navigation_DashboardPreview_PlcStatusTableTitle}" />
                    <Border Classes="edge-dashboard-alert-header">
                        <Grid ColumnDefinitions="82,90,66,*,78,78,52" ColumnSpacing="8">
                            <TextBlock
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcDevice}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcState}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcLatency}" />
                            <TextBlock
                                Grid.Column="3"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcLastError}" />
                            <TextBlock
                                Grid.Column="4"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcLastConnected}" />
                            <TextBlock
                                Grid.Column="5"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcLastFailure}" />
                            <TextBlock
                                Grid.Column="6"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_PlcDetails}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Classes="edge-dashboard-data-panel-body">
                        <edge:EdgeScrollHost
                            IsVisible="{Binding !IsPlcStatusTableEmpty}"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PlcStatusTableItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Classes="edge-dashboard-alert-row"
                                            MinHeight="34">
                                            <Grid ColumnDefinitions="82,90,66,*,78,78,52" ColumnSpacing="8">
                                                <TextBlock
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding DeviceName}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Classes="edge-dashboard-alert-level">
                                                    <edge:EdgeStatusDot Status="{Binding Status}" />
                                                    <TextBlock
                                                        Classes="edge-dashboard-alert-level-text"
                                                        Text="{Binding StateText}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding LatencyText}" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Classes="edge-dashboard-alert-message"
                                                    MaxLines="1"
                                                    Text="{Binding LastError}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding LastErrorDetail}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding LastConnectedText}" />
                                                <TextBlock
                                                    Grid.Column="5"
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding LastFailureText}" />
                                                <edge:EdgeActionButton
                                                    Grid.Column="6"
                                                    Command="{Binding DataContext.ShowPlcStatusDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Navigation_DashboardPreview_PlcDetails}"
                                                    IsEnabled="{Binding HasLastErrorDetail}"
                                                    Kind="Ghost"
                                                    Role="Cell"
                                                    Size="Compact"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </edge:EdgeScrollHost>
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsPlcStatusTableEmpty}"
                            Message="{DynamicResource Navigation_DashboardPreview_NoPlcStatusSource}"
                            Title="{DynamicResource Navigation_DashboardPreview_NoPlcStatusTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="1"
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{Binding UploadHealthTitle}" />
                    <Grid Grid.Row="1" Classes="edge-dashboard-data-panel-body">
                        <StackPanel
                            IsVisible="{Binding IsUploadHealthBodyVisible}"
                            Spacing="{DynamicResource Edge.Size.Spacing12}"
                            VerticalAlignment="Top">
                            <edge:EdgeStatusListItem
                                Classes="compact strip"
                                Status="{Binding UploadHealthStatus}"
                                Title="{Binding UploadHealthStatusText}" />

                            <ItemsControl ItemsSource="{Binding UploadChannelItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{DynamicResource Edge.Size.Spacing8}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <edge:EdgeCard
                                            MinWidth="132"
                                            Classes="summary"
                                            Elevation="Flat"
                                            PaddingMode="Compact"
                                            Surface="Wash">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                    <edge:EdgeStatusDot
                                                        VerticalAlignment="Center"
                                                        Status="{Binding Status}" />
                                                    <TextBlock
                                                        Classes="edge-summary-card-title"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Classes="edge-summary-card-value"
                                                    Text="{Binding StateText}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Classes="edge-summary-card-label"
                                                    IsVisible="{Binding HasDetailText}"
                                                    Text="{Binding DetailText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ItemsControl
                                                    Grid.Row="3"
                                                    IsVisible="{Binding HasMetrics}"
                                                    ItemsSource="{Binding Metrics}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="{DynamicResource Edge.Size.Spacing2}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="edge-summary-card-row">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                                                    <TextBlock
                                                                        Classes="edge-summary-card-label"
                                                                        Text="{Binding Label}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Classes="edge-summary-card-value"
                                                                        Text="{Binding Value}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </edge:EdgeCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <edge:EdgeStatusSegmentBar ItemsSource="{Binding UploadHealthSegments}" />

                            <edge:EdgeCard
                                Classes="summary"
                                Elevation="Flat"
                                PaddingMode="None"
                                Surface="Transparent">
                                <ItemsControl ItemsSource="{Binding UploadHealthSummaryItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="{DynamicResource Edge.Size.Spacing12}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinWidth="96"
                                                Classes="edge-summary-card-row">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                                                    <TextBlock
                                                        Classes="edge-summary-card-label"
                                                        Text="{Binding Label}" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Classes="edge-summary-card-value"
                                                        Text="{Binding Value}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </edge:EdgeCard>
                        </StackPanel>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsUploadHealthEmpty}"
                            Message="{Binding UploadHealthEmptyMessage}"
                            Title="{Binding UploadHealthEmptyTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>
        <Border
            Grid.RowSpan="3"
            Classes="edge-dialog-overlay"
            IsVisible="{Binding IsPlcStatusDetailOpen}">
            <edge:EdgeDialogChrome
                Classes="inline-dialog"
                CloseCommand="{Binding ClosePlcStatusDetailCommand}"
                CloseTopLevelOnClose="False"
                HorizontalAlignment="Center"
                MaxWidth="620"
                MinWidth="460"
                Title="{DynamicResource Navigation_DashboardPreview_PlcDetailTitle}"
                VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing8}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                        <TextBlock
                            Classes="edge-summary-card-label"
                            Text="{DynamicResource Navigation_DashboardPreview_PlcDevice}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="edge-summary-card-value"
                            Text="{Binding SelectedPlcStatusDetail.DeviceName}" />
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                        <TextBlock
                            Classes="edge-summary-card-label"
                            Text="{DynamicResource Navigation_DashboardPreview_PlcState}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="edge-summary-card-value"
                            Text="{Binding SelectedPlcStatusDetail.StateText}" />
                    </Grid>
                    <Grid
                        Grid.Row="2"
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                        <TextBlock
                            Classes="edge-summary-card-label"
                            Text="{DynamicResource Navigation_DashboardPreview_PlcLastFailure}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="edge-summary-card-value"
                            Text="{Binding SelectedPlcStatusDetail.LastFailureText}" />
                    </Grid>
                    <edge:EdgeScrollHost
                        Grid.Row="3"
                        MaxHeight="220"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Text="{Binding SelectedPlcStatusDetail.LastErrorDetail}"
                            TextWrapping="Wrap" />
                    </edge:EdgeScrollHost>
                </Grid>
                <edge:EdgeDialogChrome.FooterContent>
                    <StackPanel Classes="edge-dialog-actions">
                        <edge:EdgeActionButton
                            Command="{Binding ClosePlcStatusDetailCommand}"
                            Content="{DynamicResource Navigation_DashboardPreview_Close}"
                            Kind="Secondary"
                            Size="Compact" />
                    </StackPanel>
                </edge:EdgeDialogChrome.FooterContent>
            </edge:EdgeDialogChrome>
        </Border>
    </Grid>
</UserControl>
