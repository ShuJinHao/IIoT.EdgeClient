<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Shell.DashboardPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <Grid Margin="12,4,18,8" RowDefinitions="Auto,220,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock
                    Classes="edge-dashboard-preview-title"
                    Text="{DynamicResource Navigation_DashboardPreview_Title}" />
                <TextBlock
                    Classes="edge-dashboard-preview-subtitle"
                    Text="{DynamicResource Navigation_DashboardPreview_Subtitle}" />
            </StackPanel>

            <edge:EdgeStatusChip
                Grid.Column="1"
                VerticalAlignment="Center"
                ChipPadding="{DynamicResource Edge.Thickness.Chip.Comfortable}"
                ShowDot="True"
                Status="Info"
                Text="{Binding CurrentBatch, FallbackValue=—, TargetNullValue=—}" />
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="1.08*,0.82*,0.72*"
            ColumnSpacing="12">
            <edge:EdgeMetricCard
                Description="{DynamicResource Navigation_DashboardPreview_FromCapacitySnapshot}"
                Icon="{StaticResource Edge.Icon.Dashboard}"
                MinHeight="0"
                Status="Info"
                Title="{DynamicResource Navigation_DashboardPreview_OutputOverview}"
                Unit="{DynamicResource Navigation_DashboardPreview_UnitPiece}"
                Value="{Binding TodayOutput}" />

            <edge:EdgeCard
                Grid.Column="1"
                Classes="summary"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card"
                MinHeight="0"
                >
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                    <TextBlock
                        Classes="edge-summary-card-title"
                        Text="{DynamicResource Navigation_DashboardPreview_TaskSummary}" />
                    <ItemsControl
                        Grid.Row="1"
                        Classes="edge-summary-card-items"
                        ItemsSource="{Binding ProductionSummaryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="edge-summary-card-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                        <TextBlock
                                            Classes="edge-summary-card-label"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="edge-summary-card-value"
                                            Text="{Binding Value}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="2"
                Elevation="Flat"
                PaddingMode="Compact"
                Surface="Card">
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="*,*"
                    ColumnSpacing="10"
                    RowSpacing="10">
                    <Grid>
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_DeviceLinks}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="Info" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding ConnectedDevices}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_Yield}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="Running" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding TodayYield}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_OkCount}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="Info" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding OkCount}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">
                        <StackPanel Classes="edge-dashboard-mini-block">
                            <StackPanel Classes="edge-dashboard-mini-label-row">
                                <TextBlock
                                    Classes="edge-dashboard-mini-label"
                                    Text="{DynamicResource Navigation_DashboardPreview_NgCount}" />
                                <edge:EdgeStatusDot VerticalAlignment="Center" Status="Warning" />
                            </StackPanel>
                            <TextBlock
                                Classes="edge-dashboard-mini-value"
                                Text="{Binding NgCount}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="1.85*,*"
            ColumnSpacing="12">
            <edge:EdgeCard
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{DynamicResource Navigation_DashboardPreview_AlertSummary}" />
                    <Border Classes="edge-dashboard-alert-header">
                        <Grid ColumnDefinitions="58,58,*" ColumnSpacing="10">
                            <TextBlock
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertTime}" />
                            <TextBlock
                                Grid.Column="1"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertLevel}" />
                            <TextBlock
                                Grid.Column="2"
                                Classes="edge-dashboard-alert-header-text"
                                Text="{DynamicResource Navigation_DashboardPreview_AlertMessage}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Classes="edge-dashboard-data-panel-body">
                        <edge:EdgeScrollHost
                            IsVisible="{Binding !IsAlertEmpty}"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AlertItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="edge-dashboard-alert-row">
                                            <Grid ColumnDefinitions="58,58,*" ColumnSpacing="10">
                                                <TextBlock
                                                    Classes="edge-dashboard-alert-time"
                                                    Text="{Binding Time}" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Classes="edge-dashboard-alert-level">
                                                    <edge:EdgeStatusDot Status="{Binding Status}" />
                                                    <TextBlock
                                                        Classes="edge-dashboard-alert-level-text"
                                                        Text="{Binding Level}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Classes="edge-dashboard-alert-message"
                                                    Text="{Binding Message}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </edge:EdgeScrollHost>
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsAlertEmpty}"
                            Message="{DynamicResource Navigation_DashboardPreview_NoAlertSource}"
                            Title="{DynamicResource Navigation_DashboardPreview_NoAlertTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>

            <edge:EdgeCard
                Grid.Column="1"
                Classes="dashboard-data-panel"
                MinHeight="0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock
                        Classes="edge-dashboard-data-panel-title"
                        Text="{DynamicResource Navigation_DashboardPreview_Trend}" />
                    <Grid Grid.Row="1" Classes="edge-dashboard-data-panel-body">
                        <ItemsControl
                            IsVisible="{Binding !IsTrendEmpty}"
                            ItemsSource="{Binding TrendPoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="2,0"
                                        RowDefinitions="*,Auto"
                                        RowSpacing="2">
                                        <Border
                                            Grid.Row="0"
                                            Height="{Binding BarHeight}"
                                            Classes="edge-dashboard-trend-bar" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Classes="edge-dashboard-trend-label"
                                            Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsTrendEmpty}"
                            Message="{DynamicResource Navigation_DashboardPreview_NoTrendSource}"
                            Title="{DynamicResource Navigation_DashboardPreview_NoTrendTitle}" />
                    </Grid>
                </Grid>
            </edge:EdgeCard>
        </Grid>
    </Grid>
</UserControl>
