<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.IOView.IOViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="IoDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="IoDataGridRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#202024" />
                    <Setter Property="Foreground" Value="#E4E4E7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IoDataGridCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#E4E4E7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <sharedViews:PageActionShell>
        <sharedViews:PageActionShell.HeaderContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Medium"
                    Foreground="#E4E4E7"
                    Text="{Binding ViewTitle}" />

                <ComboBox
                    Grid.Column="1"
                    materialDesign:HintAssist.Hint="{DynamicResource Navigation_Hint_SelectDevice}"
                    DisplayMemberPath="DeviceName"
                    FontSize="13"
                    Foreground="#E4E4E7"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                <StackPanel
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse Width="10" Height="10">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="#A1A1AA">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Navigation_Status_NoDevice}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedDevice}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Navigation_Status_Disconnected}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Navigation_Status_Connected}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </sharedViews:PageActionShell.HeaderContent>

        <ScrollViewer Margin="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border
                    Margin="0,0,0,14"
                    Background="#1E1E1E"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasInteractionRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#E4E4E7"
                                Text="{DynamicResource Navigation_Title_SignalInteraction}" />
                        </Border>

                        <DataGrid
                            Grid.Row="1"
                            Margin="12"
                            AlternatingRowBackground="#232326"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CellStyle="{StaticResource IoDataGridCellStyle}"
                            ColumnHeaderStyle="{StaticResource IoDataGridHeaderStyle}"
                            Foreground="#E4E4E7"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="#333"
                            ItemsSource="{Binding InteractionRows}"
                            RowBackground="#1E1E1E"
                            RowStyle="{StaticResource IoDataGridRowStyle}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="110" Binding="{Binding GroupName}" Header="{DynamicResource Navigation_Column_InteractionItem}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_InteractionItem" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="2.2*" Header="{DynamicResource Navigation_Column_PlcSignal}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_PlcSignal">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="#E4E4E7"
                                                FontWeight="SemiBold"
                                                Text="{Binding PlcAddressSummary}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding PlcSignalToolTip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="74" Binding="{Binding PlcValueText}" Header="{DynamicResource Navigation_Column_PlcValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_PlcValue" IsReadOnly="True" />
                                <DataGridTemplateColumn Width="2.4*" Header="{DynamicResource Navigation_Column_CurrentReply}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_CurrentReply">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="#E4E4E7"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding HostReplyAddressText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding HostReplyToolTip}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FACC15"
                                                    Text="{Binding HostReplyValueText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding HostReplyToolTip}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="148" Header="{DynamicResource Navigation_Column_PendingWriteOperation}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_PendingWriteOperation">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Width="68"
                                                    Height="24"
                                                    Margin="0"
                                                    MinWidth="0"
                                                    Padding="6,0"
                                                    HorizontalContentAlignment="Right"
                                                    VerticalContentAlignment="Center"
                                                    Background="#111827"
                                                    BorderBrush="#3F3F46"
                                                    Foreground="#E4E4E7"
                                                    IsEnabled="{Binding CanWrite}"
                                                    Text="{Binding WriteValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Width="52"
                                                    Height="24"
                                                    MinWidth="0"
                                                    Padding="0"
                                                    Background="#123A37"
                                                    BorderBrush="#0F766E"
                                                    BorderThickness="1"
                                                    Command="{Binding WriteCommand}"
                                                    HorizontalContentAlignment="Center"
                                                    IsEnabled="{Binding CanWrite}"
                                                    Style="{StaticResource MaterialDesignFlatButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="13" Height="13" VerticalAlignment="Center" Foreground="#CCFBF1" Kind="Send" />
                                                        <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#CCFBF1" Text="{DynamicResource Navigation_Button_Write}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding DataSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Medium"
                                            Foreground="#E4E4E7"
                                            Text="{Binding Title}" />
                                    </Border>

                                    <DataGrid
                                        Grid.Row="1"
                                        Margin="12"
                                        AlternatingRowBackground="#232326"
                                        AutoGenerateColumns="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        CellStyle="{StaticResource IoDataGridCellStyle}"
                                        ColumnHeaderStyle="{StaticResource IoDataGridHeaderStyle}"
                                        Foreground="#E4E4E7"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        HorizontalGridLinesBrush="#333"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Signals}"
                                        RowBackground="#1E1E1E"
                                        RowStyle="{StaticResource IoDataGridRowStyle}"
                                        SelectionMode="Single"
                                        SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="2*" Binding="{Binding Label}" Header="{DynamicResource Navigation_Column_SignalName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_SignalName" />
                                            <DataGridTextColumn Width="140" Binding="{Binding DisplayRole}" Header="{DynamicResource Navigation_Column_DisplayRole}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DisplayRole" />
                                            <DataGridTextColumn Width="120" Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Address" />
                                            <DataGridTextColumn Width="90" Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Type" />
                                            <DataGridTextColumn Width="70" Binding="{Binding LengthText}" Header="{DynamicResource Navigation_Column_Length}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Length" />
                                            <DataGridTextColumn Width="2*" Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_CurrentValue" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding ArraySections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,14"
                                Background="#1E1E1E"
                                BorderBrush="#333"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Foreground="#E4E4E7"
                                                Text="{Binding Title}" />
                                            <Button
                                                Grid.Column="1"
                                                Height="26"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                Background="#3F3F46"
                                                BorderThickness="0"
                                                Command="{Binding ToggleExpandedCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}">
                                                <TextBlock FontSize="12" Foreground="#E4E4E7" Text="{Binding ToggleText}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="12,10,12,8"
                                        FontSize="12"
                                        Foreground="#FACC15"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />

                                    <Border
                                        Grid.Row="2"
                                        Margin="12,0,12,12"
                                        Padding="0"
                                        Background="#18181B"
                                        BorderBrush="#303036"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <DockPanel Background="#27272A" LastChildFill="False">
                                                    <Border Width="72" Padding="10,8" BorderBrush="#333" BorderThickness="0,0,1,1">
                                                        <TextBlock FontSize="12" Foreground="#D4D4D8" Text="{DynamicResource Navigation_Column_Index}" />
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Columns}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="130" Padding="10,8" BorderBrush="#333" BorderThickness="0,0,1,1">
                                                                    <TextBlock FontSize="12" Foreground="#D4D4D8" Text="{Binding MatrixColumnTitle}" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel LastChildFill="False">
                                                                <Border Width="72" Padding="10,7" BorderBrush="#333" BorderThickness="0,0,1,1">
                                                                    <TextBlock FontSize="12" Foreground="#A1A1AA" Text="{Binding Index}" />
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Values}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Width="130" Padding="10,7" BorderBrush="#333" BorderThickness="0,0,1,1">
                                                                                <TextBlock FontSize="12" Foreground="#FACC15" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="4,24,0,0"
                    FontSize="13"
                    Foreground="#A1A1AA"
                    Text="{DynamicResource Navigation_Empty_IoMappings}"
                    Visibility="{Binding HasNoSignals, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </sharedViews:PageActionShell>
</UserControl>
