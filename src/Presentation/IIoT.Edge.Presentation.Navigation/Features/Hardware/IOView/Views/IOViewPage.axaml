<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.IOView.IOViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <edge:EdgeSectionHeader
                        Title="{Binding ViewTitle}"
                        Subtitle="{Binding ConnectionStateText}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Classes="edge-text-page-caption"
                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        Classes="edge-text-page-caption"
                        VerticalAlignment="Center">
                        <Run Text="{DynamicResource Navigation_DeviceSelection_CurrentDevicePrefix}" />
                        <Run Text="{Binding SelectedDeviceDisplayName}" />
                    </TextBlock>
                    <edge:EdgeActionToolbar>
                        <edge:EdgeActionButton
                            Command="{Binding RefreshDevicesCommand}"
                            Content="{DynamicResource Navigation_Button_Refresh}"
                            Icon="{StaticResource Edge.Icon.Refresh}"
                            Kind="Primary"
                            Size="Compact" />
                    </edge:EdgeActionToolbar>
                </StackPanel>
            </Grid>

            <sharedViews:EmptyStateView
                Grid.Row="1"
                IsVisible="{Binding ShouldShowDeviceSelectionPrompt}"
                Message="{DynamicResource Navigation_DeviceSelection_SelectFromRightMessage}"
                Title="{DynamicResource Navigation_Hint_SelectDevice}" />

            <edge:EdgeTabControl
                Grid.Row="2"
                IsVisible="{Binding HasSelectedDevice}"
                Variant="Secondary">
                <TabItem Header="{DynamicResource Navigation_IoMapping_TabInteraction}">
                    <Grid RowDefinitions="*">
                        <edge:EdgeTablePanel
                            Classes="fill"
                            IsVisible="{Binding HasInteractionRows}"
                            Title="{DynamicResource Navigation_Title_IoInteractionGroup}">
                            <edge:EdgeTablePanel.HeaderMetaContent>
                                <TextBlock Classes="edge-table-count">
                                    <Run Text="{DynamicResource Navigation_Table_TotalPrefix}" />
                                    <Run Text="{Binding InteractionRows.Count}" />
                                    <Run Text="{DynamicResource Navigation_Table_TotalSuffix}" />
                                </TextBlock>
                            </edge:EdgeTablePanel.HeaderMetaContent>
                            <edge:EdgeDataGrid
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="False"
                                HeadersVisibility="Column"
                                IsReadOnly="False"
                                ViewportMaxHeight="0"
                                ItemsSource="{Binding InteractionRows}">
                                <edge:EdgeDataGrid.Columns>
                                    <edge:EdgeTextColumn Binding="{Binding BusinessGroup}" Header="{DynamicResource Navigation_Column_InteractionItem}" IsReadOnly="True" MinWidth="90" Width="110" />
                                    <edge:EdgeTextColumn Binding="{Binding PlcAddressSummary}" Header="{DynamicResource Navigation_Column_PlcSignal}" IsReadOnly="True" MinWidth="140" Width="2*" />
                                    <edge:EdgeTextColumn Binding="{Binding PlcValueText}" Header="{DynamicResource Navigation_Column_PlcValue}" IsReadOnly="True" MinWidth="70" Width="70" />
                                    <edge:EdgeTextColumn Binding="{Binding HostReplyAddressText}" Header="{DynamicResource Navigation_Column_CurrentReply}" IsReadOnly="True" MinWidth="140" Width="2*" />
                                    <edge:EdgeTextColumn Binding="{Binding HostReplyValueText}" Header="{DynamicResource Navigation_Column_CurrentValue}" IsReadOnly="True" MinWidth="80" Width="80" />
                                    <edge:EdgeActionColumn Header="{DynamicResource Navigation_Column_PendingWriteOperation}" MinWidth="150" Width="150">
                                        <edge:EdgeActionColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,6,Auto">
                                                    <edge:EdgeTextBox
                                                        Classes="flat"
                                                        MinWidth="60"
                                                        HorizontalContentAlignment="Right"
                                                        IsEnabled="{Binding CanWrite}"
                                                        Text="{Binding WriteValue, Mode=TwoWay}" />
                                                    <edge:EdgeActionButton
                                                        Grid.Column="2"
                                                        Command="{Binding WriteCommand}"
                                                        Content="{DynamicResource Navigation_Button_Write}"
                                                        Icon="{StaticResource Edge.Icon.Write}"
                                                        IsEnabled="{Binding CanWrite}"
                                                        Kind="Primary"
                                                        Role="Cell"
                                                        Size="Compact" />
                                                </Grid>
                                            </DataTemplate>
                                        </edge:EdgeActionColumn.CellTemplate>
                                    </edge:EdgeActionColumn>
                                </edge:EdgeDataGrid.Columns>
                            </edge:EdgeDataGrid>
                        </edge:EdgeTablePanel>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding !HasInteractionRows}"
                            Message="{DynamicResource Navigation_Empty_IoInteractionRows}"
                            Title="{DynamicResource Navigation_IoMapping_TabInteraction}" />
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Navigation_IoMapping_TabSingleRead}">
                    <edge:EdgeScrollHost Variant="Panel">
                    <Grid>
                        <ItemsControl
                            IsVisible="{Binding HasSingleReadSections}"
                            ItemsSource="{Binding SingleReadSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeTablePanel
                                        Margin="0,0,0,14"
                                        Title="{Binding DisplayTitle}">
                                        <edge:EdgeTablePanel.HeaderMetaContent>
                                            <TextBlock Classes="edge-table-count">
                                                <Run Text="{DynamicResource Navigation_Table_TotalPrefix}" />
                                                <Run Text="{Binding Signals.Count}" />
                                                <Run Text="{DynamicResource Navigation_Table_TotalSuffix}" />
                                            </TextBlock>
                                        </edge:EdgeTablePanel.HeaderMetaContent>
                                        <edge:EdgeTablePanel.ActionContent>
                                            <edge:EdgeActionToolbar>
                                                <edge:EdgeActionButton
                                                    Command="{Binding DataContext.ManualReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Content="{DynamicResource Navigation_Button_ReadIoData}"
                                                    Icon="{StaticResource Edge.Icon.Read}"
                                                    IsVisible="{Binding CanManualRead}"
                                                    Kind="Primary"
                                                    Size="Compact" />
                                            </edge:EdgeActionToolbar>
                                        </edge:EdgeTablePanel.ActionContent>
                                        <edge:EdgeDataGrid
                                            AutoGenerateColumns="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeColumns="True"
                                            CanUserSortColumns="False"
                                            IsReadOnly="True"
                                            ViewportMaxHeight="0"
                                            ItemsSource="{Binding Signals}">
                                            <edge:EdgeDataGrid.Columns>
                                                <edge:EdgeTextColumn Binding="{Binding MatrixColumnTitle}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="180" Width="2*" />
                                                <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" MinWidth="120" Width="120" />
                                                <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                                                <edge:EdgeTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" MinWidth="100" Width="100" />
                                                <edge:EdgeTextColumn Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" MinWidth="120" Width="*" />
                                            </edge:EdgeDataGrid.Columns>
                                        </edge:EdgeDataGrid>
                                    </edge:EdgeTablePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding !HasSingleReadSections}"
                            Message="{DynamicResource Navigation_Empty_IoSingleReadSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabSingleRead}" />
                    </Grid>
                    </edge:EdgeScrollHost>
                </TabItem>

                <TabItem Header="{DynamicResource Navigation_IoMapping_TabContinuousRead}">
                    <edge:EdgeScrollHost Variant="Panel">
                    <Grid>
                        <ItemsControl
                            IsVisible="{Binding HasContinuousReadSections}"
                            ItemsSource="{Binding ContinuousReadSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeTablePanel
                                        Margin="0,0,0,14"
                                        Title="{Binding DisplayTitle}">
                                        <edge:EdgeTablePanel.HeaderMetaContent>
                                            <TextBlock Classes="edge-table-count">
                                                <Run Text="{DynamicResource Navigation_Table_TotalPrefix}" />
                                                <Run Text="{Binding Signals.Count}" />
                                                <Run Text="{DynamicResource Navigation_Table_TotalSuffix}" />
                                            </TextBlock>
                                        </edge:EdgeTablePanel.HeaderMetaContent>
                                        <edge:EdgeTablePanel.ActionContent>
                                            <edge:EdgeActionToolbar>
                                                <edge:EdgeActionButton
                                                    Command="{Binding DataContext.ManualReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Content="{DynamicResource Navigation_Button_ReadIoData}"
                                                    Icon="{StaticResource Edge.Icon.Read}"
                                                    IsVisible="{Binding CanManualRead}"
                                                    Kind="Primary"
                                                    Size="Compact" />
                                            </edge:EdgeActionToolbar>
                                        </edge:EdgeTablePanel.ActionContent>
                                        <edge:EdgeDataGrid
                                            AutoGenerateColumns="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeColumns="True"
                                            CanUserSortColumns="False"
                                            IsReadOnly="True"
                                            ViewportMaxHeight="0"
                                            ItemsSource="{Binding Signals}">
                                            <edge:EdgeDataGrid.Columns>
                                                <edge:EdgeTextColumn Binding="{Binding MatrixColumnTitle}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="180" Width="2*" />
                                                <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" MinWidth="120" Width="120" />
                                                <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                                                <edge:EdgeTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" MinWidth="100" Width="100" />
                                                <edge:EdgeTextColumn Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" MinWidth="120" Width="*" />
                                            </edge:EdgeDataGrid.Columns>
                                        </edge:EdgeDataGrid>
                                    </edge:EdgeTablePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding !HasContinuousReadSections}"
                            Message="{DynamicResource Navigation_Empty_IoContinuousReadSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabContinuousRead}" />
                    </Grid>
                    </edge:EdgeScrollHost>
                </TabItem>

                <TabItem Header="{DynamicResource Navigation_IoMapping_TabSingleWrite}">
                    <edge:EdgeScrollHost Variant="Panel">
                    <Grid>
                        <ItemsControl
                            IsVisible="{Binding HasSingleWriteSections}"
                            ItemsSource="{Binding SingleWriteSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeTablePanel
                                        Margin="0,0,0,14"
                                        Title="{Binding DisplayTitle}">
                                        <edge:EdgeTablePanel.HeaderMetaContent>
                                            <TextBlock Classes="edge-table-count">
                                                <Run Text="{DynamicResource Navigation_Table_TotalPrefix}" />
                                                <Run Text="{Binding Signals.Count}" />
                                                <Run Text="{DynamicResource Navigation_Table_TotalSuffix}" />
                                            </TextBlock>
                                        </edge:EdgeTablePanel.HeaderMetaContent>
                                        <edge:EdgeDataGrid
                                            AutoGenerateColumns="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeColumns="True"
                                            CanUserSortColumns="False"
                                            IsReadOnly="True"
                                            ViewportMaxHeight="0"
                                            ItemsSource="{Binding Signals}">
                                            <edge:EdgeDataGrid.Columns>
                                                <edge:EdgeTextColumn Binding="{Binding MatrixColumnTitle}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="180" Width="2*" />
                                                <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" MinWidth="120" Width="120" />
                                                <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                                                <edge:EdgeTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" MinWidth="100" Width="100" />
                                                <edge:EdgeTextColumn Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" MinWidth="120" Width="*" />
                                            </edge:EdgeDataGrid.Columns>
                                        </edge:EdgeDataGrid>
                                    </edge:EdgeTablePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding !HasSingleWriteSections}"
                            Message="{DynamicResource Navigation_Empty_IoSingleWriteSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabSingleWrite}" />
                    </Grid>
                    </edge:EdgeScrollHost>
                </TabItem>

                <TabItem Header="{DynamicResource Navigation_IoMapping_TabContinuousWrite}">
                    <edge:EdgeScrollHost Variant="Panel">
                    <Grid>
                        <ItemsControl
                            IsVisible="{Binding HasContinuousWriteSections}"
                            ItemsSource="{Binding ContinuousWriteSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <edge:EdgeTablePanel
                                        Margin="0,0,0,14"
                                        Title="{Binding DisplayTitle}">
                                        <edge:EdgeTablePanel.HeaderMetaContent>
                                            <TextBlock Classes="edge-table-count">
                                                <Run Text="{DynamicResource Navigation_Table_TotalPrefix}" />
                                                <Run Text="{Binding Signals.Count}" />
                                                <Run Text="{DynamicResource Navigation_Table_TotalSuffix}" />
                                            </TextBlock>
                                        </edge:EdgeTablePanel.HeaderMetaContent>
                                        <edge:EdgeDataGrid
                                            AutoGenerateColumns="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeColumns="True"
                                            CanUserSortColumns="False"
                                            IsReadOnly="True"
                                            ViewportMaxHeight="0"
                                            ItemsSource="{Binding Signals}">
                                            <edge:EdgeDataGrid.Columns>
                                                <edge:EdgeTextColumn Binding="{Binding MatrixColumnTitle}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="180" Width="2*" />
                                                <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" MinWidth="120" Width="120" />
                                                <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                                                <edge:EdgeTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" MinWidth="100" Width="100" />
                                                <edge:EdgeTextColumn Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" MinWidth="120" Width="*" />
                                            </edge:EdgeDataGrid.Columns>
                                        </edge:EdgeDataGrid>
                                    </edge:EdgeTablePanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <sharedViews:EmptyStateView
                            IsVisible="{Binding !HasContinuousWriteSections}"
                            Message="{DynamicResource Navigation_Empty_IoContinuousWriteSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabContinuousWrite}" />
                    </Grid>
                    </edge:EdgeScrollHost>
                </TabItem>
            </edge:EdgeTabControl>
    </Grid>
</UserControl>
