<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.IOView.IOViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:Avalonia.Controls"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:ioview="clr-namespace:IIoT.Edge.Presentation.Navigation.Features.Hardware.IOView"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                        Text="{Binding ViewTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            Text="{Binding ConnectionStateText}" />
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Caption}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Top">
                    <ComboBox
                        Width="260"
                        ItemsSource="{Binding Devices}"
                        PlaceholderText="{DynamicResource Navigation_Hint_SelectDevice}"
                        SelectedItem="{Binding SelectedDevice}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeviceName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <edge:EdgeToolButton Command="{Binding RefreshDevicesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="M5,12 A7,7 0 0 1 17,7 L19,7 L19,3 M19,7 L15,7 M19,12 A7,7 0 0 1 7,17 L5,17 L5,21 M5,17 L9,17" />
                            <TextBlock Text="{DynamicResource Navigation_Button_Refresh}" />
                        </StackPanel>
                    </edge:EdgeToolButton>
                </StackPanel>
            </Grid>

            <edge:EdgeTablePanel
                IsVisible="{Binding HasInteractionRows}"
                Title="{DynamicResource Navigation_Title_IoInteractionGroup}">
                <edge:EdgeDataGrid
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding InteractionRows}">
                    <edge:EdgeDataGrid.Columns>
                        <dg:DataGridTextColumn Binding="{Binding BusinessGroup}" Header="{DynamicResource Navigation_Column_InteractionItem}" IsReadOnly="True" MinWidth="130" Width="130" />
                        <dg:DataGridTextColumn Binding="{Binding PlcAddressSummary}" Header="{DynamicResource Navigation_Column_PlcSignal}" IsReadOnly="True" MinWidth="220" Width="2*" />
                        <dg:DataGridTextColumn Binding="{Binding PlcValueText}" Header="{DynamicResource Navigation_Column_PlcValue}" IsReadOnly="True" MinWidth="90" Width="90" />
                        <dg:DataGridTextColumn Binding="{Binding HostReplyAddressText}" Header="{DynamicResource Navigation_Column_CurrentReply}" IsReadOnly="True" MinWidth="220" Width="2*" />
                        <dg:DataGridTextColumn Binding="{Binding HostReplyValueText}" Header="{DynamicResource Navigation_Column_CurrentValue}" IsReadOnly="True" MinWidth="100" Width="100" />
                        <dg:DataGridTemplateColumn Header="{DynamicResource Navigation_Column_PendingWriteOperation}" MinWidth="180" Width="180">
                            <dg:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,6,Auto">
                                            <TextBox
                                                MinWidth="60"
                                                MinHeight="28"
                                                Padding="6,3"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Right"
                                                IsEnabled="{Binding CanWrite}"
                                                Text="{Binding WriteValue, Mode=TwoWay}" />
                                            <edge:EdgeToolButton
                                                Grid.Column="2"
                                                MinWidth="50"
                                                MinHeight="28"
                                                Padding="10,0"
                                                Command="{Binding WriteCommand}"
                                                IsEnabled="{Binding CanWrite}">
                                                <TextBlock Text="{DynamicResource Navigation_Button_Write}" />
                                            </edge:EdgeToolButton>
                                        </Grid>
                                    </DataTemplate>
                            </dg:DataGridTemplateColumn.CellTemplate>
                        </dg:DataGridTemplateColumn>
                    </edge:EdgeDataGrid.Columns>
                </edge:EdgeDataGrid>
            </edge:EdgeTablePanel>

            <ItemsControl ItemsSource="{Binding DataSections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <edge:EdgeTablePanel
                            Margin="0,0,0,14"
                            Title="{Binding Title}">
                            <edge:EdgeTablePanel.ActionContent>
                                <edge:EdgeToolButton
                                    Command="{Binding DataContext.ManualReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsVisible="{Binding CanManualRead}">
                                    <TextBlock Text="{DynamicResource Navigation_Button_ReadIoData}" />
                                </edge:EdgeToolButton>
                            </edge:EdgeTablePanel.ActionContent>
                            <edge:EdgeDataGrid
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Signals}">
                                <edge:EdgeDataGrid.Columns>
                                    <dg:DataGridTextColumn Binding="{Binding SignalName}" Header="{DynamicResource Navigation_Column_SignalName}" MinWidth="220" Width="2*" />
                                    <dg:DataGridTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_Address}" MinWidth="120" Width="120" />
                                    <dg:DataGridTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_Type}" MinWidth="100" Width="100" />
                                    <dg:DataGridTextColumn Binding="{Binding LengthText}" Header="{DynamicResource Navigation_Column_Length}" MinWidth="80" Width="80" />
                                    <dg:DataGridTextColumn Binding="{Binding PreviewValue}" Header="{DynamicResource Navigation_Column_CurrentValue}" MinWidth="160" Width="*" />
                                </edge:EdgeDataGrid.Columns>
                            </edge:EdgeDataGrid>
                        </edge:EdgeTablePanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding ArraySections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <edge:EdgeTablePanel
                            Margin="0,0,0,14"
                            Subtitle="{Binding Summary}"
                            Title="{Binding Title}">
                            <edge:EdgeTablePanel.ActionContent>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <edge:EdgeToolButton
                                        Command="{Binding DataContext.ManualReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        IsVisible="{Binding CanManualRead}">
                                        <TextBlock Text="{DynamicResource Navigation_Button_ReadIoData}" />
                                    </edge:EdgeToolButton>
                                    <edge:EdgeToolButton Command="{Binding ToggleExpandedCommand}">
                                        <TextBlock Text="{Binding ToggleText}" />
                                    </edge:EdgeToolButton>
                                </StackPanel>
                            </edge:EdgeTablePanel.ActionContent>
                            <edge:EdgeDataGrid
                                ioview:DataTableBindingBehavior.SourceTable="{Binding MatrixTable}"
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                CanUserSortColumns="False"
                                IsReadOnly="True"
                                IsVisible="{Binding IsExpanded}" />
                        </edge:EdgeTablePanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <sharedViews:EmptyStateView
                IsVisible="{Binding HasNoSignals}"
                Message="{DynamicResource Navigation_Empty_IoMappings}"
                Title="{DynamicResource Navigation_Title_IoInteractionGroup}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
