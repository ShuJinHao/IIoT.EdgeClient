<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.PlcTaskBindingView.PlcTaskBindingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">
        <edge:EdgeSectionHeader
            Grid.Row="0"
            Title="{Binding ViewTitle}"
            Subtitle="{Binding StatusMessage}">
            <edge:EdgeSectionHeader.ActionContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing10}">
                    <TextBlock
                        Classes="edge-text-page-caption"
                        VerticalAlignment="Center">
                        <Run Text="{DynamicResource Navigation_DeviceSelection_CurrentDevicePrefix}" />
                        <Run Text="{Binding SelectedDeviceDisplayName}" />
                    </TextBlock>
                    <edge:EdgeActionToolbar>
                        <edge:EdgeActionButton
                            Command="{Binding RefreshCommand}"
                            Content="{DynamicResource Navigation_Button_Refresh}"
                            Icon="{StaticResource Edge.Icon.Refresh}"
                            Kind="Primary"
                            Size="Compact" />
                        <edge:EdgeActionButton
                            Command="{Binding SaveCommand}"
                            Content="{DynamicResource Navigation_Button_Save}"
                            Icon="{StaticResource Edge.Icon.Save}"
                            Kind="Primary"
                            Size="Compact" />
                    </edge:EdgeActionToolbar>
                </StackPanel>
            </edge:EdgeSectionHeader.ActionContent>
        </edge:EdgeSectionHeader>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            Spacing="12">
            <edge:EdgeStatusListItem
                Classes="compact right-rail strip"
                IsVisible="{Binding HasSelectedDevice}"
                Status="Info"
                StatusText="{Binding SelectedDevice.DeviceStateText}"
                Title="{Binding SelectedDeviceTitle}" />

            <sharedViews:EmptyStateView
                IsVisible="{Binding ShouldShowDeviceSelectionPrompt}"
                Message="{DynamicResource Navigation_DeviceSelection_SelectFromRightMessage}"
                Title="{DynamicResource Navigation_Hint_SelectDevice}" />

            <sharedViews:EmptyStateView
                IsVisible="{Binding !HasDevices}"
                Message="{DynamicResource Navigation_PlcTaskBinding_NoDevices}"
                Title="{DynamicResource Navigation_Title_PlcTaskBinding}" />
        </StackPanel>

        <edge:EdgeTablePanel
            Grid.Row="2"
            EmptyMessage="{DynamicResource Navigation_PlcTaskBinding_NoTasks}"
            EmptyTitle="{DynamicResource Navigation_Title_PlcTaskBinding}"
            IsEmpty="{Binding !SelectedDeviceTasks.Count}"
            IsVisible="{Binding HasSelectedDevice}"
            Margin="0,16,0,0"
            Title="{DynamicResource Navigation_Title_PlcTaskBinding}">
            <edge:EdgeDataGrid
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                IsReadOnly="False"
                ViewportMaxHeight="320"
                ItemsSource="{Binding SelectedDeviceTasks}">
                <edge:EdgeDataGrid.Columns>
                    <edge:EdgeCheckColumn Binding="{Binding Enabled}" Header="{DynamicResource Navigation_Column_Enable}" MinWidth="64" Width="64" />
                    <edge:EdgeTextColumn Binding="{Binding DisplayName}" Header="{DynamicResource Navigation_Column_TaskName}" IsReadOnly="True" MinWidth="200" Width="2*" />
                    <edge:EdgeTextColumn Binding="{Binding AvailabilityText}" Header="{DynamicResource Navigation_Column_TaskAvailability}" IsReadOnly="True" MinWidth="120" Width="120" />
                    <edge:EdgeTextColumn Binding="{Binding RuntimeStatusText}" Header="{DynamicResource Navigation_Column_RuntimeStatus}" IsReadOnly="True" MinWidth="120" Width="120" />
                    <edge:EdgeTextColumn Binding="{Binding NoteText}" Header="{DynamicResource Navigation_Column_Note}" IsReadOnly="True" MinWidth="200" Width="3*" />
                </edge:EdgeDataGrid.Columns>
            </edge:EdgeDataGrid>
        </edge:EdgeTablePanel>
    </Grid>
</UserControl>
