<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.PlcTaskBindingView.PlcTaskBindingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">
    <sharedViews:PageActionShell.HeaderContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Medium"
                Foreground="#E4E4E7"
                Text="{Binding ViewTitle}" />

            <ComboBox
                Grid.Column="1"
                materialDesign:HintAssist.Hint="{DynamicResource Navigation_Hint_SelectDevice}"
                DisplayMemberPath="DeviceName"
                FontSize="13"
                Foreground="#E4E4E7"
                ItemsSource="{Binding Devices}"
                SelectedItem="{Binding SelectedDevice}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            <TextBlock
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#A1A1AA"
                Text="{Binding SelectedDevice.DeviceStateText}" />
        </Grid>
    </sharedViews:PageActionShell.HeaderContent>

    <sharedViews:PageActionShell.ActionContent>
        <StackPanel Orientation="Horizontal">
            <Button
                Height="32"
                Margin="0,0,8,0"
                Padding="14,0"
                BorderBrush="#555"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="16" Height="16" Foreground="#E4E4E7" Kind="Refresh" />
                    <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="#E4E4E7" Text="{DynamicResource Navigation_Button_Refresh}" />
                </StackPanel>
            </Button>
            <Button
                Height="32"
                Padding="16,0"
                Background="#0F766E"
                BorderThickness="0"
                Command="{Binding SaveCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="16" Height="16" Foreground="White" Kind="ContentSave" />
                    <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="White" Text="{DynamicResource Navigation_Button_Save}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </sharedViews:PageActionShell.ActionContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            Foreground="#E4E4E7"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#333"
            ItemsSource="{Binding SelectedDeviceTasks}"
            RowBackground="#1E1E1E"
            RowHeight="42">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="80" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_Enable}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Enable" />
                <DataGridTextColumn Width="160" Binding="{Binding DisplayName}" Header="{DynamicResource Navigation_Column_TaskName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_TaskName" IsReadOnly="True" />
                <DataGridTextColumn Width="140" Binding="{Binding TaskTypeText}" Header="{DynamicResource Navigation_Column_TaskType}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_TaskType" IsReadOnly="True" />
                <DataGridTextColumn Width="110" Binding="{Binding SourceText}" Header="{DynamicResource Navigation_Column_TaskBindingSource}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_TaskBindingSource" IsReadOnly="True" />
                <DataGridTextColumn Width="1.5*" Binding="{Binding AvailabilityText}" Header="{DynamicResource Navigation_Column_TaskAvailability}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_TaskAvailability" IsReadOnly="True" />
                <DataGridTextColumn Width="2.8*" Binding="{Binding RequiredSignalsText}" Header="{DynamicResource Navigation_Column_RequiredSignals}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_RequiredSignals" IsReadOnly="True" />
                <DataGridTextColumn Width="1.4*" Binding="{Binding Key}" Header="{DynamicResource Navigation_Column_TaskKey}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_TaskKey" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock
            Grid.Row="1"
            Margin="0,12,0,0"
            FontSize="12"
            Foreground="#A1A1AA"
            Text="{Binding StatusMessage}" />
    </Grid>
</sharedViews:PageActionShell>
