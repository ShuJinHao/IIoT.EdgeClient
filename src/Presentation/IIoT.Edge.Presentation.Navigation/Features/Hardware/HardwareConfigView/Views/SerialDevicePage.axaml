<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfigView.SerialDevicePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:Avalonia.Controls"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared">

    <edge:EdgeTablePanel
        Margin="0,12,0,0"
        Title="{DynamicResource Navigation_Tab_SerialDevice}">
        <edge:EdgeTablePanel.ActionContent>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <edge:EdgeActionButton
                    Command="{Binding AddSerialDeviceCommand}"
                    Content="{DynamicResource Navigation_Button_Add}"
                    Icon="{StaticResource Edge.Icon.Add}"
                    Kind="Primary"
                    Size="Compact" />
                <edge:EdgeActionButton
                    Command="{Binding DeleteSerialDeviceCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=SerialGrid}"
                    Content="{DynamicResource Navigation_Button_Delete}"
                    Icon="{StaticResource Edge.Icon.Delete}"
                    Kind="Danger"
                    Size="Compact" />
            </StackPanel>
        </edge:EdgeTablePanel.ActionContent>

        <edge:EdgeDataGrid
            x:Name="SerialGrid"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            IsReadOnly="{Binding !CanEdit}"
            ItemsSource="{Binding SerialDevices}">
            <edge:EdgeDataGrid.Columns>
                <dg:DataGridTextColumn Binding="{Binding DeviceName}" Header="{DynamicResource Navigation_Column_DeviceName}" MinWidth="170" Width="170" />
                <dg:DataGridTextColumn Binding="{Binding DeviceType}" Header="{DynamicResource Navigation_Column_DeviceType}" MinWidth="120" Width="120" />
                <dg:DataGridTextColumn Binding="{Binding PortName}" Header="{DynamicResource Navigation_Column_PortName}" MinWidth="100" Width="100" />
                <dg:DataGridTextColumn Binding="{Binding BaudRate}" Header="{DynamicResource Navigation_Column_BaudRate}" MinWidth="100" Width="100" />
                <dg:DataGridTextColumn Binding="{Binding DataBits}" Header="{DynamicResource Navigation_Column_DataBits}" MinWidth="90" Width="90" />
                <dg:DataGridTemplateColumn Header="{DynamicResource Navigation_Column_StopBits}" MinWidth="100" Width="100">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StopBits}" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                    <dg:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <edge:EdgeFilterComboBox ItemsSource="{Binding DataContext.StopBitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding StopBits}" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellEditingTemplate>
                </dg:DataGridTemplateColumn>
                <dg:DataGridTemplateColumn Header="{DynamicResource Navigation_Column_Parity}" MinWidth="100" Width="100">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Parity}" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                    <dg:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <edge:EdgeFilterComboBox ItemsSource="{Binding DataContext.ParityOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Parity}" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellEditingTemplate>
                </dg:DataGridTemplateColumn>
                <dg:DataGridTextColumn Binding="{Binding SendCmd1}" Header="{DynamicResource Navigation_Column_Command1}" MinWidth="100" Width="100" />
                <dg:DataGridTextColumn Binding="{Binding SendCmd2}" Header="{DynamicResource Navigation_Column_Command2}" MinWidth="100" Width="100" />
                <dg:DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="{DynamicResource Navigation_Column_Enable}" MinWidth="80" Width="80" />
                <dg:DataGridTextColumn Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="180" Width="180" />
            </edge:EdgeDataGrid.Columns>
        </edge:EdgeDataGrid>
    </edge:EdgeTablePanel>
</UserControl>
