<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfigView.IoMappingPage"
    x:Name="IoMappingRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Tab_IoMapping}">
            <edge:EdgeSectionHeader.ActionContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing8}">
                    <Button
                        Padding="12,6"
                        Command="{Binding ApplyModuleTemplateCommand}"
                        ToolTip.Tip="{Binding ModuleTemplateHint}">
                        <TextBlock Text="{DynamicResource Navigation_Button_ApplyTemplate}" />
                    </Button>
                    <Button
                        Padding="12,6"
                        Command="{Binding OpenAddInteractionMappingDialogCommand}">
                        <TextBlock Text="{DynamicResource Navigation_Button_AddInteraction}" />
                    </Button>
                    <Button
                        Padding="12,6"
                        Command="{Binding OpenAddDataPointMappingDialogCommand}">
                        <TextBlock Text="{DynamicResource Navigation_Button_AddDataPoint}" />
                    </Button>
                    <Button
                        Padding="12,6"
                        Command="{Binding DeleteIoMappingCommand}">
                        <TextBlock Text="{DynamicResource Navigation_Button_Delete}" />
                    </Button>
                </StackPanel>
            </edge:EdgeSectionHeader.ActionContent>
        </edge:EdgeSectionHeader>

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="190,*">
            <edge:EdgeCard
                Margin="0,0,12,0"
                CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                <edge:EdgeCard.Header>
                    <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Tab_NetworkDevice}" />
                </edge:EdgeCard.Header>
                <Grid RowDefinitions="Auto,*">
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding NetworkDevices}"
                        SelectedItem="{Binding SelectedNetworkDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,6"
                                    Foreground="{DynamicResource Edge.Text.Primary}"
                                    Text="{Binding DeviceName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </edge:EdgeCard>

            <ScrollViewer
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <ItemsControl ItemsSource="{Binding IoMappingGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <edge:EdgeCard
                                    Margin="0,0,0,12"
                                    CardPadding="{DynamicResource Edge.Thickness.Card.Default}">
                                    <edge:EdgeCard.Header>
                                        <edge:EdgeSectionHeader Title="{Binding Title}" />
                                    </edge:EdgeCard.Header>
                                    <StackPanel Spacing="10">
                                        <DataGrid
                                            Classes="edge-grid"
                                            AutoGenerateColumns="False"
                                            CanUserReorderColumns="False"
                                            CanUserResizeColumns="True"
                                            CanUserSortColumns="False"
                                            IsReadOnly="{Binding !DataContext.CanEdit, ElementName=IoMappingRoot}"
                                            ItemsSource="{Binding Mappings}"
                                            SelectedItem="{Binding DataContext.SelectedIoMapping, ElementName=IoMappingRoot, Mode=TwoWay}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_PlcAddress}" Width="110" />
                                                <DataGridTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" Width="80" />
                                                <DataGridTextColumn Binding="{Binding BusinessGroup}" Header="{DynamicResource Navigation_Column_BusinessGroup}" IsReadOnly="True" Width="150" />
                                                <DataGridTextColumn Binding="{Binding SignalName}" Header="{DynamicResource Navigation_Column_SignalName}" Width="180" />
                                                <DataGridTemplateColumn Header="{DynamicResource Navigation_Column_DataType}" Width="120">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DataType}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding DataContext.IoDataTypes, ElementName=IoMappingRoot}" SelectedItem="{Binding DataType}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding Direction}" Header="{DynamicResource Navigation_Column_Direction}" IsReadOnly="True" Width="100" />
                                                <DataGridTextColumn Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </edge:EdgeCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <sharedViews:EmptyStateView
                        IsVisible="{Binding HasNoIoMappingGroups}"
                        Message="{DynamicResource Navigation_Empty_IoMappings}"
                        Title="{DynamicResource Navigation_Tab_IoMapping}" />
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.ColumnSpan="2"
                Background="{DynamicResource Edge.Brush.Overlay.Modal}"
                IsVisible="{Binding IsAddIoMappingDialogOpen}">
                <edge:EdgeCard
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CardPadding="{DynamicResource Edge.Thickness.20}">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Text.Primary}"
                            Text="{DynamicResource Navigation_Dialog_AddIoPoint}" />

                        <Grid Grid.Row="1" IsVisible="{Binding IsInteractionPairDialog}" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12" IsVisible="{Binding NewInteractionPair.IsStandardSource}">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_InteractionGroup}" />
                                <ComboBox ItemsSource="{Binding StandardInteractionGroups}" SelectedItem="{Binding SelectedStandardInteractionGroup}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_BusinessGroup}" />
                                <TextBox IsReadOnly="{Binding NewInteractionPair.IsStandardSource}" Text="{Binding NewInteractionPair.BusinessGroup}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Label_ReadSignal}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Label_WriteSignal}" />
                            <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,8,80">
                                <TextBox Grid.ColumnSpan="3" Margin="0,6,0,8" Text="{Binding NewInteractionPair.ReadSignalName}" />
                                <TextBox Grid.Row="1" Margin="0,0,0,8" Text="{Binding NewInteractionPair.ReadPlcAddress}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" IsEnabled="False" Text="{Binding NewInteractionPair.ReadAddressCount}" />
                                <ComboBox Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewInteractionPair.ReadDataType}" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,8,80">
                                <TextBox Grid.ColumnSpan="3" Margin="0,6,0,8" Text="{Binding NewInteractionPair.WriteSignalName}" />
                                <TextBox Grid.Row="1" Margin="0,0,0,8" Text="{Binding NewInteractionPair.WritePlcAddress}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" IsEnabled="False" Text="{Binding NewInteractionPair.WriteAddressCount}" />
                                <ComboBox Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewInteractionPair.WriteDataType}" />
                            </Grid>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Remark}" />
                                <TextBox Text="{Binding NewInteractionPair.Remark}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" IsVisible="{Binding IsDataPointDialog}" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12" IsVisible="{Binding NewIoMapping.IsStandardSource}">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_StandardSignal}" />
                                <ComboBox ItemsSource="{Binding FilteredStandardDataSignals}" SelectedItem="{Binding SelectedStandardIoSignal}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_IoCategory}" />
                                <ComboBox ItemsSource="{Binding IoDataPointCategories}" SelectedItem="{Binding NewIoMapping.Category}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Direction}" />
                                <ComboBox IsEnabled="False" ItemsSource="{Binding IoDirections}" SelectedItem="{Binding NewIoMapping.Direction}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_PlcAddress}" />
                                <TextBox Text="{Binding NewIoMapping.PlcAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Count}" />
                                <TextBox IsEnabled="{Binding NewIoMapping.IsAddressCountEditable}" Text="{Binding NewIoMapping.AddressCount}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_DataType}" />
                                <ComboBox IsEnabled="{Binding NewIoMapping.IsCustomSource}" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewIoMapping.DataType}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_BusinessGroup}" />
                                <TextBox IsReadOnly="True" Text="{Binding NewIoMapping.BusinessGroup}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_SignalName}" />
                                <TextBox IsEnabled="{Binding NewIoMapping.IsCustomSource}" Text="{Binding NewIoMapping.SignalName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Remark}" />
                                <TextBox Text="{Binding NewIoMapping.Remark}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <Button
                                Padding="14,8"
                                Command="{Binding CancelAddIoMappingDialogCommand}">
                                <TextBlock Text="{DynamicResource Navigation_Button_Cancel}" />
                            </Button>
                            <Button
                                Padding="14,8"
                                Command="{Binding ConfirmAddIoMappingCommand}">
                                <TextBlock Text="{DynamicResource Navigation_Button_ConfirmAddIoPoint}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </edge:EdgeCard>
            </Border>
        </Grid>
    </Grid>
</UserControl>
