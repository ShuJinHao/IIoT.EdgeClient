<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfigView.IoMappingPage"
    x:Name="IoMappingRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Tab_IoMapping}">
            <edge:EdgeSectionHeader.ActionContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing8}">
                    <edge:EdgeActionButton
                        Command="{Binding ApplyModuleTemplateCommand}"
                        Content="{DynamicResource Navigation_Button_ApplyTemplate}"
                        Icon="{StaticResource Edge.Icon.Check}"
                        Kind="Primary"
                        Size="Compact"
                        ToolTip.Tip="{Binding ModuleTemplateHint}" />
                    <edge:EdgeActionButton
                        Command="{Binding OpenAddInteractionMappingDialogCommand}"
                        Content="{DynamicResource Navigation_Button_AddInteraction}"
                        Icon="{StaticResource Edge.Icon.Add}"
                        Kind="Primary"
                        Size="Compact" />
                    <edge:EdgeActionButton
                        Command="{Binding OpenAddDataPointMappingDialogCommand}"
                        Content="{DynamicResource Navigation_Button_AddDataPoint}"
                        Icon="{StaticResource Edge.Icon.Add}"
                        Kind="Primary"
                        Size="Compact" />
                    <edge:EdgeActionButton
                        Command="{Binding DeleteIoMappingCommand}"
                        Content="{DynamicResource Navigation_Button_Delete}"
                        Icon="{StaticResource Edge.Icon.Delete}"
                        Kind="Danger"
                        Size="Compact" />
                </StackPanel>
            </edge:EdgeSectionHeader.ActionContent>
        </edge:EdgeSectionHeader>

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="190,*">
            <edge:EdgeCard
                Margin="0,0,12,0"
                CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                <edge:EdgeCard.Header>
                    <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Tab_NetworkDevice}" />
                </edge:EdgeCard.Header>
                <Grid RowDefinitions="Auto,*">
                    <edge:EdgeListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding NetworkDevices}"
                        SelectedItem="{Binding SelectedNetworkDevice}">
                        <edge:EdgeListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="4,6"
                                    Foreground="{DynamicResource Edge.Text.Primary}"
                                    Text="{Binding DeviceName}" />
                            </DataTemplate>
                        </edge:EdgeListBox.ItemTemplate>
                    </edge:EdgeListBox>
                </Grid>
            </edge:EdgeCard>

            <StackPanel
                Grid.Column="1"
                Spacing="12">
                    <ItemsControl ItemsSource="{Binding IoMappingGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <edge:EdgeTablePanel
                                    Margin="0,0,0,12"
                                    Title="{Binding Title}">
                                    <edge:EdgeDataGrid
                                        AutoGenerateColumns="False"
                                        CanUserReorderColumns="False"
                                        CanUserResizeColumns="True"
                                        CanUserSortColumns="False"
                                        IsReadOnly="{Binding !DataContext.CanEdit, ElementName=IoMappingRoot}"
                                        ItemsSource="{Binding Mappings}"
                                        SelectedItem="{Binding DataContext.SelectedIoMapping, ElementName=IoMappingRoot, Mode=TwoWay}">
                                        <edge:EdgeDataGrid.Columns>
                                            <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_PlcAddress}" MinWidth="120" Width="120" />
                                            <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                                            <edge:EdgeTextColumn Binding="{Binding BusinessGroup}" Header="{DynamicResource Navigation_Column_BusinessGroup}" IsReadOnly="True" MinWidth="150" Width="150" />
                                            <edge:EdgeTextColumn Binding="{Binding SignalName}" Header="{DynamicResource Navigation_Column_SignalName}" MinWidth="180" Width="180" />
                                            <edge:EdgeTemplateColumn Header="{DynamicResource Navigation_Column_DataType}" MinWidth="120" Width="120">
                                                <edge:EdgeTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataType}" />
                                                    </DataTemplate>
                                                </edge:EdgeTemplateColumn.CellTemplate>
                                                <edge:EdgeTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <edge:EdgeFilterComboBox ItemsSource="{Binding DataContext.IoDataTypes, ElementName=IoMappingRoot}" SelectedItem="{Binding DataType}" />
                                                    </DataTemplate>
                                                </edge:EdgeTemplateColumn.CellEditingTemplate>
                                            </edge:EdgeTemplateColumn>
                                            <edge:EdgeTextColumn Binding="{Binding Direction}" Header="{DynamicResource Navigation_Column_Direction}" IsReadOnly="True" MinWidth="100" Width="100" />
                                            <edge:EdgeTextColumn Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="220" Width="220" />
                                        </edge:EdgeDataGrid.Columns>
                                    </edge:EdgeDataGrid>
                                </edge:EdgeTablePanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <sharedViews:EmptyStateView
                        IsVisible="{Binding HasNoIoMappingGroups}"
                        Message="{DynamicResource Navigation_Empty_IoMappings}"
                        Title="{DynamicResource Navigation_Tab_IoMapping}" />
            </StackPanel>

            <Border
                Grid.ColumnSpan="2"
                Background="{DynamicResource Edge.Brush.Overlay.Modal}"
                IsVisible="{Binding IsAddIoMappingDialogOpen}">
                <edge:EdgeCard
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CardPadding="{DynamicResource Edge.Thickness.20}">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <TextBlock
                            Margin="0,0,0,16"
                            FontSize="{DynamicResource Edge.FontSize.SubData18}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Text.Primary}"
                            Text="{DynamicResource Navigation_Dialog_AddIoPoint}" />

                        <Grid Grid.Row="1" IsVisible="{Binding IsInteractionPairDialog}" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12" IsVisible="{Binding NewInteractionPair.IsStandardSource}">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_InteractionGroup}" />
                                <edge:EdgeFilterComboBox ItemsSource="{Binding StandardInteractionGroups}" SelectedItem="{Binding SelectedStandardInteractionGroup}">
                                    <edge:EdgeFilterComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </edge:EdgeFilterComboBox.ItemTemplate>
                                </edge:EdgeFilterComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_BusinessGroup}" />
                                <edge:EdgeTextBox IsReadOnly="{Binding NewInteractionPair.IsStandardSource}" Text="{Binding NewInteractionPair.BusinessGroup}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Label_ReadSignal}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{DynamicResource Navigation_Label_WriteSignal}" />
                            <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,8,80">
                                <edge:EdgeTextBox Grid.ColumnSpan="3" Margin="0,6,0,8" Text="{Binding NewInteractionPair.ReadSignalName}" />
                                <edge:EdgeTextBox Grid.Row="1" Margin="0,0,0,8" Text="{Binding NewInteractionPair.ReadPlcAddress}" />
                                <edge:EdgeTextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" IsEnabled="False" Text="{Binding NewInteractionPair.ReadAddressCount}" />
                                <edge:EdgeFilterComboBox Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewInteractionPair.ReadDataType}" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,8,80">
                                <edge:EdgeTextBox Grid.ColumnSpan="3" Margin="0,6,0,8" Text="{Binding NewInteractionPair.WriteSignalName}" />
                                <edge:EdgeTextBox Grid.Row="1" Margin="0,0,0,8" Text="{Binding NewInteractionPair.WritePlcAddress}" />
                                <edge:EdgeTextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,8" IsEnabled="False" Text="{Binding NewInteractionPair.WriteAddressCount}" />
                                <edge:EdgeFilterComboBox Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewInteractionPair.WriteDataType}" />
                            </Grid>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Remark}" />
                                <edge:EdgeTextBox Text="{Binding NewInteractionPair.Remark}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" IsVisible="{Binding IsDataPointDialog}" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12" IsVisible="{Binding NewIoMapping.IsStandardSource}">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_StandardSignal}" />
                                <edge:EdgeFilterComboBox ItemsSource="{Binding FilteredStandardDataSignals}" SelectedItem="{Binding SelectedStandardIoSignal}">
                                    <edge:EdgeFilterComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </edge:EdgeFilterComboBox.ItemTemplate>
                                </edge:EdgeFilterComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Label_IoCategory}" />
                                <edge:EdgeFilterComboBox ItemsSource="{Binding IoDataPointCategories}" SelectedItem="{Binding NewIoMapping.Category}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Direction}" />
                                <edge:EdgeFilterComboBox IsEnabled="False" ItemsSource="{Binding IoDirections}" SelectedItem="{Binding NewIoMapping.Direction}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_PlcAddress}" />
                                <edge:EdgeTextBox Text="{Binding NewIoMapping.PlcAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Count}" />
                                <edge:EdgeTextBox IsEnabled="{Binding NewIoMapping.IsAddressCountEditable}" Text="{Binding NewIoMapping.AddressCount}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_DataType}" />
                                <edge:EdgeFilterComboBox IsEnabled="{Binding NewIoMapping.IsCustomSource}" ItemsSource="{Binding IoDataTypes}" SelectedItem="{Binding NewIoMapping.DataType}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_BusinessGroup}" />
                                <edge:EdgeTextBox IsReadOnly="True" Text="{Binding NewIoMapping.BusinessGroup}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_SignalName}" />
                                <edge:EdgeTextBox IsEnabled="{Binding NewIoMapping.IsCustomSource}" Text="{Binding NewIoMapping.SignalName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Column_Remark}" />
                                <edge:EdgeTextBox Text="{Binding NewIoMapping.Remark}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <edge:EdgeActionButton
                                Command="{Binding CancelAddIoMappingDialogCommand}"
                                Content="{DynamicResource Navigation_Button_Cancel}"
                                Icon="{StaticResource Edge.Icon.Close}"
                                Kind="Secondary"
                                Size="Compact" />
                            <edge:EdgeActionButton
                                Command="{Binding ConfirmAddIoMappingCommand}"
                                Content="{DynamicResource Navigation_Button_ConfirmAddIoPoint}"
                                Icon="{StaticResource Edge.Icon.Check}"
                                Kind="Primary"
                                Size="Compact" />
                        </StackPanel>
                    </Grid>
                </edge:EdgeCard>
            </Border>
        </Grid>
    </Grid>
</UserControl>
