<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfigView.IoMappingPage"
    x:Name="IoMappingRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <UserControl.Resources>
        <DataTemplate x:Key="IoMappingDataPointTableTemplate">
            <edge:EdgeTablePanel
                Margin="0,0,0,12"
                Title="{Binding Title}">
                <edge:EdgeDataGrid
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding Mappings}"
                    SelectedItem="{Binding DataContext.SelectedIoMapping, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                    <edge:EdgeDataGrid.Columns>
                        <edge:EdgeTextColumn Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_PlcAddress}" MinWidth="120" Width="120" />
                        <edge:EdgeTextColumn Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" MinWidth="80" Width="80" />
                        <edge:EdgeTextColumn Binding="{Binding DataType}" Header="{DynamicResource Navigation_Column_DataType}" MinWidth="120" Width="120" />
                        <edge:EdgeTextColumn Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="220" Width="220" />
                    </edge:EdgeDataGrid.Columns>
                </edge:EdgeDataGrid>
            </edge:EdgeTablePanel>
        </DataTemplate>

        <DataTemplate x:Key="IoInteractionPairTableTemplate">
            <edge:EdgeTablePanel
                Margin="0,0,0,12"
                Title="{DynamicResource Navigation_IoMapping_TabInteraction}">
                <edge:EdgeDataGrid
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding InteractionIoMappingPairs}"
                    SelectedItem="{Binding SelectedInteractionPair, Mode=TwoWay}">
                    <edge:EdgeDataGrid.Columns>
                        <edge:EdgeTextColumn Binding="{Binding BusinessGroup}" Header="{DynamicResource Navigation_Column_InteractionItem}" MinWidth="150" Width="150" />
                        <edge:EdgeTextColumn Binding="{Binding ReadPlcAddress}" Header="{DynamicResource Navigation_Column_ReadPlcAddress}" MinWidth="120" Width="120" />
                        <edge:EdgeTextColumn Binding="{Binding ReadAddressCount}" Header="{DynamicResource Navigation_Column_ReadCount}" MinWidth="80" Width="80" />
                        <edge:EdgeTextColumn Binding="{Binding ReadDataType}" Header="{DynamicResource Navigation_Column_ReadDataType}" MinWidth="100" Width="100" />
                        <edge:EdgeTextColumn Binding="{Binding WritePlcAddress}" Header="{DynamicResource Navigation_Column_WritePlcAddress}" MinWidth="120" Width="120" />
                        <edge:EdgeTextColumn Binding="{Binding WriteAddressCount}" Header="{DynamicResource Navigation_Column_WriteCount}" MinWidth="80" Width="80" />
                        <edge:EdgeTextColumn Binding="{Binding WriteDataType}" Header="{DynamicResource Navigation_Column_WriteDataType}" MinWidth="100" Width="100" />
                        <edge:EdgeTextColumn Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" MinWidth="220" Width="220" />
                    </edge:EdgeDataGrid.Columns>
                </edge:EdgeDataGrid>
            </edge:EdgeTablePanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Tab_IoMapping}">
            <edge:EdgeSectionHeader.ActionContent>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing8}">
                    <edge:EdgeActionButton
                        Command="{Binding ApplyModuleTemplateCommand}"
                        Content="{DynamicResource Navigation_Button_ApplyTemplate}"
                        Icon="{StaticResource Edge.Icon.Sync}"
                        Kind="Primary"
                        Size="Compact"
                        ToolTip.Tip="{Binding ModuleTemplateHint}" />
                    <edge:EdgeActionButton
                        Command="{Binding OpenEditIoMappingDialogCommand}"
                        Content="{DynamicResource Navigation_Button_Edit}"
                        Icon="{StaticResource Edge.Icon.Write}"
                        Kind="Secondary"
                        Size="Compact" />
                </StackPanel>
            </edge:EdgeSectionHeader.ActionContent>
        </edge:EdgeSectionHeader>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnDefinitions="Auto,320,*">
            <TextBlock
                VerticalAlignment="Center"
                Classes="edge-text-form-label"
                Text="{DynamicResource Navigation_Tab_NetworkDevice}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,16,0"
                VerticalAlignment="Center"
                Classes="edge-text-page-caption"
                Text="{Binding SelectedNetworkDeviceDisplayName}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Edge.Text.Muted}"
                Text="{Binding ModuleTemplateHint}"
                TextWrapping="Wrap" />
        </Grid>

        <edge:EdgeTabControl Grid.Row="2" Margin="0,12,0,0">
            <TabItem Header="{DynamicResource Navigation_IoMapping_TabInteraction}">
                <edge:EdgeScrollHost Variant="Panel">
                    <StackPanel>
                        <ContentControl
                            Content="{Binding}"
                            ContentTemplate="{StaticResource IoInteractionPairTableTemplate}" />
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding HasNoInteractionIoMappingGroups}"
                            Message="{DynamicResource Navigation_Empty_IoInteractionRows}"
                            Title="{DynamicResource Navigation_IoMapping_TabInteraction}" />
                    </StackPanel>
                </edge:EdgeScrollHost>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_IoMapping_TabSingleRead}">
                <edge:EdgeScrollHost Variant="Panel">
                    <StackPanel>
                        <ItemsControl
                            ItemTemplate="{StaticResource IoMappingDataPointTableTemplate}"
                            ItemsSource="{Binding SingleReadIoMappingGroups}" />
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding HasNoSingleReadIoMappingGroups}"
                            Message="{DynamicResource Navigation_Empty_IoSingleReadSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabSingleRead}" />
                    </StackPanel>
                </edge:EdgeScrollHost>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_IoMapping_TabContinuousRead}">
                <edge:EdgeScrollHost Variant="Panel">
                    <StackPanel>
                        <ItemsControl
                            ItemTemplate="{StaticResource IoMappingDataPointTableTemplate}"
                            ItemsSource="{Binding ContinuousReadIoMappingGroups}" />
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding HasNoContinuousReadIoMappingGroups}"
                            Message="{DynamicResource Navigation_Empty_IoContinuousReadSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabContinuousRead}" />
                    </StackPanel>
                </edge:EdgeScrollHost>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_IoMapping_TabSingleWrite}">
                <edge:EdgeScrollHost Variant="Panel">
                    <StackPanel>
                        <ItemsControl
                            ItemTemplate="{StaticResource IoMappingDataPointTableTemplate}"
                            ItemsSource="{Binding SingleWriteIoMappingGroups}" />
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding HasNoSingleWriteIoMappingGroups}"
                            Message="{DynamicResource Navigation_Empty_IoSingleWriteSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabSingleWrite}" />
                    </StackPanel>
                </edge:EdgeScrollHost>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_IoMapping_TabContinuousWrite}">
                <edge:EdgeScrollHost Variant="Panel">
                    <StackPanel>
                        <ItemsControl
                            ItemTemplate="{StaticResource IoMappingDataPointTableTemplate}"
                            ItemsSource="{Binding ContinuousWriteIoMappingGroups}" />
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding HasNoContinuousWriteIoMappingGroups}"
                            Message="{DynamicResource Navigation_Empty_IoContinuousWriteSections}"
                            Title="{DynamicResource Navigation_IoMapping_TabContinuousWrite}" />
                    </StackPanel>
                </edge:EdgeScrollHost>
            </TabItem>
        </edge:EdgeTabControl>

        <Border
            Grid.RowSpan="3"
            Classes="edge-dialog-overlay"
            IsVisible="{Binding IsEditIoMappingDialogOpen}">
            <edge:EdgeDialogChrome
                Classes="inline-dialog hardware-form-dialog"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CloseCommand="{Binding CancelEditIoMappingDialogCommand}"
                CloseTopLevelOnClose="False"
                Title="{Binding IoMappingEditDialogTitle}">
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto"
                    ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                    RowSpacing="{DynamicResource Edge.Size.Spacing8}">
                    <Grid
                        Grid.ColumnSpan="2"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                        RowSpacing="{DynamicResource Edge.Size.Spacing8}"
                        IsVisible="{Binding IsEditingInteractionPair}">
                        <TextBlock
                            Classes="edge-text-form-label"
                            Text="{DynamicResource Navigation_Label_ReadSide}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="edge-text-form-label"
                            Text="{DynamicResource Navigation_Label_WriteSide}" />
                        <edge:EdgeFieldRow Classes="dialog-form" Grid.Row="1" Label="{DynamicResource Navigation_Column_PlcAddress}">
                            <edge:EdgeTextBox Text="{Binding EditingInteractionPair.ReadPlcAddress}" />
                        </edge:EdgeFieldRow>
                        <edge:EdgeFieldRow Classes="dialog-form" Grid.Row="1" Grid.Column="1" Label="{DynamicResource Navigation_Column_PlcAddress}">
                            <edge:EdgeTextBox Text="{Binding EditingInteractionPair.WritePlcAddress}" />
                        </edge:EdgeFieldRow>
                        <Grid
                            Grid.Row="2"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                            <edge:EdgeFieldRow Classes="dialog-form" Label="{DynamicResource Navigation_Column_Count}">
                                <edge:EdgeTextBox Text="{Binding EditingInteractionPair.ReadAddressCount}" />
                            </edge:EdgeFieldRow>
                            <edge:EdgeFieldRow Classes="dialog-form" Grid.Column="1" Label="{DynamicResource Navigation_Column_DataType}">
                                <edge:EdgeFilterComboBox
                                    ItemsSource="{Binding IoDataTypes}"
                                    SelectedItem="{Binding EditingInteractionPair.ReadDataType}" />
                            </edge:EdgeFieldRow>
                        </Grid>
                        <Grid
                            Grid.Row="2"
                            Grid.Column="1"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                            <edge:EdgeFieldRow Classes="dialog-form" Label="{DynamicResource Navigation_Column_Count}">
                                <edge:EdgeTextBox Text="{Binding EditingInteractionPair.WriteAddressCount}" />
                            </edge:EdgeFieldRow>
                            <edge:EdgeFieldRow Classes="dialog-form" Grid.Column="1" Label="{DynamicResource Navigation_Column_DataType}">
                                <edge:EdgeFilterComboBox
                                    ItemsSource="{Binding IoDataTypes}"
                                    SelectedItem="{Binding EditingInteractionPair.WriteDataType}" />
                            </edge:EdgeFieldRow>
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.ColumnSpan="2"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource Edge.Size.Spacing12}"
                        RowSpacing="{DynamicResource Edge.Size.Spacing8}"
                        IsVisible="{Binding IsEditingSingleIoMapping}">
                        <edge:EdgeFieldRow Classes="dialog-form" Label="{DynamicResource Navigation_Column_PlcAddress}">
                            <edge:EdgeTextBox Text="{Binding EditingIoMapping.PlcAddress}" />
                        </edge:EdgeFieldRow>
                        <edge:EdgeFieldRow Classes="dialog-form" Grid.Column="1" Label="{DynamicResource Navigation_Column_Count}">
                            <edge:EdgeTextBox Text="{Binding EditingIoMapping.AddressCount}" />
                        </edge:EdgeFieldRow>
                        <edge:EdgeFieldRow Classes="dialog-form" Grid.Row="1" Label="{DynamicResource Navigation_Column_DataType}">
                            <edge:EdgeFilterComboBox
                                ItemsSource="{Binding IoDataTypes}"
                                SelectedItem="{Binding EditingIoMapping.DataType}" />
                        </edge:EdgeFieldRow>
                    </Grid>

                    <edge:EdgeFieldRow Classes="dialog-form" Grid.Row="1" Grid.ColumnSpan="2" Label="{DynamicResource Navigation_Column_Remark}">
                        <Grid>
                            <edge:EdgeTextBox Text="{Binding EditingInteractionPair.Remark}" IsVisible="{Binding IsEditingInteractionPair}" />
                            <edge:EdgeTextBox Text="{Binding EditingIoMapping.Remark}" IsVisible="{Binding IsEditingSingleIoMapping}" />
                        </Grid>
                    </edge:EdgeFieldRow>
                </Grid>

                <edge:EdgeDialogChrome.FooterContent>
                    <StackPanel Classes="edge-dialog-actions">
                        <edge:EdgeActionButton
                            Command="{Binding CancelEditIoMappingDialogCommand}"
                            Content="{DynamicResource Navigation_Button_Cancel}"
                            Icon="{StaticResource Edge.Icon.Close}"
                            Kind="Secondary"
                            Size="Compact" />
                        <edge:EdgeActionButton
                            Command="{Binding ConfirmEditIoMappingCommand}"
                            Content="{DynamicResource Navigation_Button_Save}"
                            Icon="{StaticResource Edge.Icon.Save}"
                            Kind="Primary"
                            Size="Compact" />
                    </StackPanel>
                </edge:EdgeDialogChrome.FooterContent>
            </edge:EdgeDialogChrome>
        </Border>
    </Grid>
</UserControl>
