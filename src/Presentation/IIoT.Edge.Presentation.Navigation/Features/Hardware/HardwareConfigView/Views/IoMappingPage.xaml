<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfigView.IoMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <sharedViews:PageActionShell>

    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Foreground="#E4E4E7" Text="{DynamicResource Navigation_Tab_IoMapping}" />
    </sharedViews:PageActionShell.HeaderContent>

    <sharedViews:PageActionShell.ActionContent>
        <StackPanel Orientation="Horizontal">
            <Button
                Height="30"
                Margin="0,0,8,0"
                Padding="12,0"
                Command="{Binding ApplyModuleTemplateCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Kind="WrenchCog" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Navigation_Button_ApplyTemplate}" />
                </StackPanel>
            </Button>
            <Button
                Height="30"
                Margin="0,0,8,0"
                Padding="12,0"
                Command="{Binding AddReadIoMappingCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Kind="Plus" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Navigation_Button_AddReadPoint}" />
                </StackPanel>
            </Button>
            <Button
                Height="30"
                Margin="0,0,8,0"
                Padding="12,0"
                Command="{Binding AddWriteIoMappingCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Kind="Plus" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Navigation_Button_AddWritePoint}" />
                </StackPanel>
            </Button>
            <Button
                Height="30"
                Padding="12,0"
                Command="{Binding DeleteIoMappingCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=IoGrid}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Kind="Delete" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Navigation_Button_Delete}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </sharedViews:PageActionShell.ActionContent>

    <Grid Margin="16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,12,0"
            BorderBrush="#27272A"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    FontSize="12"
                    Foreground="#71717A"
                    Text="{DynamicResource Navigation_Tab_NetworkDevice}" />
                <ListBox
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding NetworkDevices}"
                    SelectedItem="{Binding SelectedNetworkDevice}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="4,6"
                                FontSize="13"
                                Foreground="#E4E4E7"
                                Text="{Binding DeviceName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid
                x:Name="IoGrid"
                Grid.Row="0"
                AlternatingRowBackground="#0F0F0F"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                FontSize="13"
                Foreground="#E4E4E7"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                IsReadOnly="{Binding CanEdit, Converter={StaticResource InverseBooleanConverter}}"
                ItemsSource="{Binding IoMappingsView}"
                RowBackground="Transparent">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,8,0,2"
                                    Padding="8,4"
                                    Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7" Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="120" Binding="{Binding Label}" Header="{DynamicResource Navigation_Column_Label}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Label" />
                    <DataGridTextColumn Width="100" Binding="{Binding PlcAddress}" Header="{DynamicResource Navigation_Column_PlcAddress}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_PlcAddress" />
                    <DataGridTextColumn Width="70" Binding="{Binding AddressCount}" Header="{DynamicResource Navigation_Column_Count}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Count" />
                    <DataGridTextColumn Width="110" Binding="{Binding Category}" Header="{DynamicResource Navigation_Column_Category}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Category" />
                    <DataGridTextColumn Width="110" Binding="{Binding GroupName}" Header="{DynamicResource Navigation_Column_Group}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Group" />
                    <DataGridTextColumn Width="90" Binding="{Binding DisplayRole}" Header="{DynamicResource Navigation_Column_DisplayRole}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DisplayRole" />
                    <DataGridTemplateColumn Width="90" Header="{DynamicResource Navigation_Column_DataType}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DataType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="4,0" VerticalAlignment="Center" Foreground="#E4E4E7" Text="{Binding DataType}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.Items>
                                        <sys:String>Bool</sys:String>
                                        <sys:String>Int16</sys:String>
                                        <sys:String>Int32</sys:String>
                                        <sys:String>Float</sys:String>
                                    </ComboBox.Items>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="80" Header="{DynamicResource Navigation_Column_Direction}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Direction">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="4,0" VerticalAlignment="Center" Foreground="#E4E4E7" Text="{Binding Direction}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.Items>
                                        <sys:String>Read</sys:String>
                                        <sys:String>Write</sys:String>
                                    </ComboBox.Items>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="60" Binding="{Binding SortOrder}" Header="{DynamicResource Navigation_Column_SortOrder}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_SortOrder" />
                    <DataGridTextColumn Width="*" Binding="{Binding Remark}" Header="{DynamicResource Navigation_Column_Remark}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Remark" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
    </sharedViews:PageActionShell>
</UserControl>
