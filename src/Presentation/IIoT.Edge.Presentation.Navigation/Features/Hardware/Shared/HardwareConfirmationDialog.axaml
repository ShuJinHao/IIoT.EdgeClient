<Window
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    Height="260"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <edge:EdgeDialogChrome
        Classes="confirmation-dialog"
        Title="{Binding DialogTitle}">
        <TextBlock
            Classes="confirmation-message"
            Text="{Binding Message}" />

        <edge:EdgeDialogChrome.FooterContent>
            <StackPanel Classes="confirmation-actions">
                <edge:EdgeActionButton
                    Click="OnCancelClick"
                    Content="{DynamicResource Navigation_Button_Cancel}"
                    Icon="{StaticResource Edge.Icon.Close}"
                    Kind="Secondary"
                    Size="Compact" />
                <edge:EdgeActionButton
                    Click="OnConfirmClick"
                    Content="{DynamicResource Navigation_Button_Confirm}"
                    Icon="{StaticResource Edge.Icon.Check}"
                    Kind="Primary"
                    Size="Compact" />
            </StackPanel>
        </edge:EdgeDialogChrome.FooterContent>
    </edge:EdgeDialogChrome>
</Window>
