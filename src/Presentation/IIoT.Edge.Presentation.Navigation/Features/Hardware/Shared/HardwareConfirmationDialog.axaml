<Window
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Hardware.HardwareConfirmationDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    Height="260"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <Border
        Padding="22"
        Background="{DynamicResource Edge.Surface.Main}">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Edge.Text.Primary}"
                Text="{Binding DialogTitle}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="1"
                Margin="0,16,0,18"
                Foreground="{DynamicResource Edge.Text.Primary}"
                Text="{Binding Message}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <edge:EdgeActionButton
                    Click="OnCancelClick"
                    Content="{DynamicResource Navigation_Button_Cancel}"
                    Icon="{StaticResource Edge.Icon.Close}"
                    Kind="Soft"
                    Size="Compact" />
                <edge:EdgeActionButton
                    Click="OnConfirmClick"
                    Content="{DynamicResource Navigation_Button_Confirm}"
                    Icon="{StaticResource Edge.Icon.Check}"
                    Kind="Primary"
                    Size="Compact" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
