<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Dashboard.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <edge:EdgeScrollHost>
        <StackPanel Margin="{DynamicResource Edge.Thickness.32}" Spacing="24">
            <edge:EdgeSectionHeader
                Title="{DynamicResource Navigation_Dashboard_Title}"
                Subtitle="{DynamicResource Navigation_Dashboard_Subtitle}">
                <edge:EdgeSectionHeader.ActionContent>
                    <edge:EdgeStatusChip Status="Info" Text="{Binding CurrentBatch}" />
                </edge:EdgeSectionHeader.ActionContent>
            </edge:EdgeSectionHeader>

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="20">
                <edge:EdgeMetricCard
                    MinHeight="260"
                    Description="{Binding RecentHourLabel}"
                    SummaryItems="{Binding OutputSummaryItems}"
                    Title="{DynamicResource Navigation_Dashboard_TodayOutput}"
                    Unit="{DynamicResource Navigation_DashboardPreview_UnitPiece}"
                    Value="{Binding TodayOutput}" />

                <edge:EdgeMetricCard
                    Grid.Column="1"
                    MinHeight="260"
                    SummaryItems="{Binding YieldSummaryItems}"
                    Title="{DynamicResource Navigation_Label_Yield}"
                    Value="{Binding TodayYield}" />

                <edge:EdgeMetricCard
                    Grid.Column="2"
                    MinHeight="260"
                    Title="{DynamicResource Navigation_Dashboard_DeviceOnline}"
                    Unit="{DynamicResource Navigation_Dashboard_DeviceUnit}"
                    Value="{Binding ConnectedDevices}" />
            </Grid>

            <edge:EdgeCard
                Surface="Card"
                PaddingMode="Spacious"
                Elevation="Card">
                <edge:EdgeCard.Header>
                    <edge:EdgeSectionHeader
                        Title="{DynamicResource Navigation_Dashboard_AlertList}"
                        Subtitle="{DynamicResource Navigation_Dashboard_NoStableAlertSource}" />
                </edge:EdgeCard.Header>

                <sharedViews:EmptyStateView
                    Margin="0,20,0,0"
                    Message="{DynamicResource Navigation_Dashboard_NoStableAlertSource}"
                    Title="{DynamicResource Navigation_Dashboard_NoAlertData}" />
            </edge:EdgeCard>
        </StackPanel>
    </edge:EdgeScrollHost>
</UserControl>
