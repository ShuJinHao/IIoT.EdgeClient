<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Production.Monitor.MonitorViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource Edge.Thickness.20}" Spacing="{DynamicResource Edge.Size.Spacing12}">
            <edge:EdgeSectionHeader
                Title="{Binding ViewTitle}"
                Subtitle="{Binding StatusMessage}" />

            <sharedViews:EmptyStateView
                IsVisible="{Binding IsDeviceTabsEmpty}"
                Message="{DynamicResource Navigation_Monitor_EmptyMessage}"
                Title="{DynamicResource Navigation_Monitor_EmptyTitle}" />

            <TabControl
                IsVisible="{Binding HasDeviceTabs}"
                ItemsSource="{Binding DeviceTabs}"
                SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="12,6" Text="{Binding DeviceName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,14,0,0" Spacing="{DynamicResource Edge.Size.Spacing12}">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                <edge:EdgeCard>
                                    <edge:EdgeCard.Header>
                                        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Monitor_DayShift}" />
                                    </edge:EdgeCard.Header>
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                                        <edge:EdgeKpiCard Title="{DynamicResource Navigation_Monitor_Total}" Value="{Binding DayShiftTotal}" />
                                        <edge:EdgeKpiCard Grid.Column="1" Title="{DynamicResource Navigation_Capacity_Good}" TrendStatus="Running" Value="{Binding DayShiftOk}" />
                                        <edge:EdgeKpiCard Grid.Column="2" Title="{DynamicResource Navigation_Capacity_Bad}" TrendStatus="Error" Value="{Binding DayShiftNg}" />
                                        <edge:EdgeKpiCard Grid.Column="3" Title="{DynamicResource Navigation_Monitor_Yield}" TrendStatus="Warning" Value="{Binding DayShiftYield}" />
                                    </Grid>
                                </edge:EdgeCard>

                                <edge:EdgeCard Grid.Column="1">
                                    <edge:EdgeCard.Header>
                                        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Monitor_NightShift}" />
                                    </edge:EdgeCard.Header>
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                                        <edge:EdgeKpiCard Title="{DynamicResource Navigation_Monitor_Total}" Value="{Binding NightShiftTotal}" />
                                        <edge:EdgeKpiCard Grid.Column="1" Title="{DynamicResource Navigation_Capacity_Good}" TrendStatus="Running" Value="{Binding NightShiftOk}" />
                                        <edge:EdgeKpiCard Grid.Column="2" Title="{DynamicResource Navigation_Capacity_Bad}" TrendStatus="Error" Value="{Binding NightShiftNg}" />
                                        <edge:EdgeKpiCard Grid.Column="3" Title="{DynamicResource Navigation_Monitor_Yield}" TrendStatus="Warning" Value="{Binding NightShiftYield}" />
                                    </Grid>
                                </edge:EdgeCard>

                                <edge:EdgeCard Grid.Column="2">
                                    <edge:EdgeCard.Header>
                                        <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Monitor_TodaySummary}" />
                                    </edge:EdgeCard.Header>
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                                        <edge:EdgeKpiCard Title="{DynamicResource Navigation_Monitor_Total}" Value="{Binding TotalAll}" />
                                        <edge:EdgeKpiCard Grid.Column="1" Title="{DynamicResource Navigation_Capacity_Good}" TrendStatus="Running" Value="{Binding OkAll}" />
                                        <edge:EdgeKpiCard Grid.Column="2" Title="{DynamicResource Navigation_Capacity_Bad}" TrendStatus="Error" Value="{Binding NgAll}" />
                                        <edge:EdgeKpiCard Grid.Column="3" Title="{DynamicResource Navigation_Monitor_Yield}" TrendStatus="Warning" Value="{Binding YieldAll}" />
                                    </Grid>
                                </edge:EdgeCard>
                            </Grid>

                            <edge:EdgeCard CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing8}">
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_StateMachinePrefix}" />
                                        <Run Text="{Binding StepSummary}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_DeviceDataPrefix}" />
                                        <Run Text="{Binding DeviceDataSummary}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_CloudSyncPrefix}" />
                                        <Run Text="{Binding CloudSyncStatus}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_MesSyncPrefix}" />
                                        <Run Text="{Binding MesSyncStatus}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_ContextPersistencePrefix}" />
                                        <Run Text="{Binding ContextPersistenceStatus}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource Navigation_Monitor_WipPrefix}" />
                                        <Run Text="{Binding CellCount}" />
                                        <Run Text="{DynamicResource Navigation_Monitor_WipSuffix}" />
                                    </TextBlock>
                                </StackPanel>
                            </edge:EdgeCard>

                            <edge:EdgeCard>
                                <DataGrid
                                    Classes="edge-grid"
                                    AutoGenerateColumns="True"
                                    CanUserReorderColumns="False"
                                    CanUserResizeColumns="True"
                                    CanUserSortColumns="False"
                                    GridLinesVisibility="Horizontal"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding CellRows}" />
                            </edge:EdgeCard>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
