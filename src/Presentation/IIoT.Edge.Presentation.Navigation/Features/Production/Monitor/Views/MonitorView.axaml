<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Production.Monitor.MonitorViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Margin="20,10,30,0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
            <edge:EdgeCard
                Height="44"
                Elevation="Flat"
                PaddingMode="None"
                Surface="Wash">
                <edge:EdgeSegmentedNav
                    ItemCommand="{Binding SelectTabCommand}"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                    SelectionMode="Single">
                    <edge:EdgeSegmentedNav.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </edge:EdgeSegmentedNav.ItemsPanel>
                    <edge:EdgeSegmentedNav.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                Text="{Binding Title}" />
                        </DataTemplate>
                    </edge:EdgeSegmentedNav.ItemTemplate>
                </edge:EdgeSegmentedNav>
            </edge:EdgeCard>

            <edge:EdgeFilterComboBox
                Grid.Column="1"
                MinWidth="180"
                MaxWidth="260"
                HorizontalAlignment="Right"
                ItemsSource="{Binding DeviceOptions}"
                MaxDropDownHeight="220"
                PlaceholderText="{DynamicResource Navigation_Monitor_SelectedPlcPlaceholder}"
                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                <edge:EdgeFilterComboBox.SelectionBoxItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            MaxWidth="220"
                            Text="{Binding}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </edge:EdgeFilterComboBox.SelectionBoxItemTemplate>
                <edge:EdgeFilterComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            MaxWidth="220"
                            Text="{Binding}"
                            TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </edge:EdgeFilterComboBox.ItemTemplate>
            </edge:EdgeFilterComboBox>
        </Grid>
        <edge:EdgeScrollHost
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,20" Spacing="{DynamicResource Edge.Size.Spacing12}">
                <edge:EdgeCard
                    MinHeight="120"
                    HorizontalAlignment="Stretch"
                    Elevation="Flat"
                    IsVisible="{Binding IsDevicesEmpty}"
                    PaddingMode="Normal"
                    Surface="Card">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{DynamicResource Edge.Size.Spacing4}">
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                            HorizontalAlignment="Center"
                            Text="{DynamicResource Navigation_Monitor_EmptyTitle}" />
                        <TextBlock
                            FontSize="{DynamicResource Edge.FontSize.Body}"
                            Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                            HorizontalAlignment="Center"
                            Text="{DynamicResource Navigation_Monitor_EmptyMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </edge:EdgeCard>
                <StackPanel
                    IsVisible="{Binding HasDevices}"
                    Spacing="{DynamicResource Edge.Size.Spacing12}">
                    <StackPanel
                        IsVisible="{Binding IsDeviceStatusTabSelected}"
                        Spacing="{DynamicResource Edge.Size.Spacing12}">
                        <edge:EdgeCard PaddingMode="Compact">
                            <edge:EdgeCard.Header>
                                <edge:EdgeSectionHeader
                                    Title="{DynamicResource Navigation_Monitor_CellDebugTitle}"
                                    Subtitle="{DynamicResource Navigation_Monitor_CellDebugSubtitle}" />
                            </edge:EdgeCard.Header>
                            <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                                <Grid ColumnDefinitions="300,*,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                                    <edge:EdgeTextBox
                                        MinHeight="38"
                                        PlaceholderText="{DynamicResource Navigation_Monitor_CellQueryWatermark}"
                                        Text="{Binding CellQueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}">
                                        <Run Text="{DynamicResource Navigation_Monitor_CellQueryMatchedPrefix}" />
                                        <Run Text="{Binding FilteredCellCount}" />
                                        <Run Text="{DynamicResource Navigation_Monitor_CellQueryMatchedMiddle}" />
                                        <Run Text="{Binding CellRowCount}" />
                                        <Run Text="{DynamicResource Navigation_Monitor_CellQueryMatchedSuffix}" />
                                    </TextBlock>
                                </Grid>

                                <StackPanel
                                    Grid.Row="1"
                                    Spacing="{DynamicResource Edge.Size.Spacing10}">
                                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}">
                                        <TextBlock
                                            FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                            Text="{DynamicResource Navigation_Monitor_CurrentCellsTableTitle}" />
                                        <Grid MinHeight="150">
                                            <edge:EdgeDataGrid
                                                AutoGenerateColumns="False"
                                                CanUserReorderColumns="False"
                                                CanUserResizeColumns="True"
                                                CanUserSortColumns="False"
                                                Density="Compact"
                                                GridLinesVisibility="Horizontal"
                                                HeadersVisibility="Column"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding CellDebugItems}"
                                                SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                                                ViewportMaxHeight="220">
                                                <edge:EdgeDataGrid.Columns>
                                                    <edge:EdgeTextColumn Binding="{Binding InternalKey}" Header="{DynamicResource Navigation_Monitor_ColumnInternalKey}" MinWidth="220" Width="2.2*" />
                                                    <edge:EdgeTextColumn Binding="{Binding DisplayLabel}" Header="{DynamicResource Navigation_Monitor_ColumnBusinessId}" MinWidth="150" Width="1.2*" />
                                                    <edge:EdgeTextColumn Binding="{Binding RuntimeStatusText}" Header="{DynamicResource Navigation_Monitor_ColumnRuntimeStatus}" MinWidth="120" Width="1*" />
                                                    <edge:EdgeTextColumn Binding="{Binding CompletedTimeText}" Header="{DynamicResource Navigation_Monitor_ColumnCompletedAt}" MinWidth="150" Width="1*" />
                                                </edge:EdgeDataGrid.Columns>
                                            </edge:EdgeDataGrid>
                                            <StackPanel
                                                MaxWidth="420"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsCellDebugEmpty}"
                                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                    Text="{DynamicResource Navigation_Monitor_CellDebugEmptyTitle}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                    Text="{DynamicResource Navigation_Monitor_CellDebugEmptyMessage}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}">
                                        <TextBlock
                                            FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                            Text="{DynamicResource Navigation_Monitor_CellFieldsTableTitle}" />
                                        <Grid MinHeight="260">
                                            <edge:EdgeDataGrid
                                                AutoGenerateColumns="False"
                                                CanUserReorderColumns="False"
                                                CanUserResizeColumns="True"
                                                CanUserSortColumns="False"
                                                Density="Compact"
                                                GridLinesVisibility="Horizontal"
                                                HeadersVisibility="Column"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding SelectedCellFieldRows}">
                                                <edge:EdgeDataGrid.Columns>
                                                    <edge:EdgeTextColumn Binding="{Binding Name}" Header="{DynamicResource Navigation_Monitor_ColumnFieldPath}" MinWidth="260" Width="1.1*" />
                                                    <edge:EdgeTemplateColumn Header="{DynamicResource Navigation_Monitor_ColumnValue}" MinWidth="420" Width="2.4*">
                                                        <edge:EdgeTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    Text="{Binding Value}"
                                                                    TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </edge:EdgeTemplateColumn.CellTemplate>
                                                    </edge:EdgeTemplateColumn>
                                                </edge:EdgeDataGrid.Columns>
                                            </edge:EdgeDataGrid>
                                            <StackPanel
                                                MaxWidth="420"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsSelectedCellEmpty}"
                                                Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                    Text="{DynamicResource Navigation_Monitor_SelectedCellEmptyTitle}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                    Text="{DynamicResource Navigation_Monitor_SelectedCellEmptyMessage}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </edge:EdgeCard>
                    </StackPanel>
                    <StackPanel
                        IsVisible="{Binding IsStateMachineTabSelected}"
                        Spacing="{DynamicResource Edge.Size.Spacing12}">
                        <edge:EdgeCard Classes="summary" PaddingMode="Compact">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock
                                    Classes="edge-summary-card-title"
                                    Text="{DynamicResource Navigation_Monitor_StatusSummary}" />

                                <ItemsControl
                                    Grid.Row="1"
                                    ItemsSource="{Binding StateMachineSummaryItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinWidth="152"
                                                Margin="0,0,6,6"
                                                Classes="edge-summary-card-row">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        Classes="edge-summary-card-label"
                                                        Text="{Binding Label}" />
                                                    <TextBlock
                                                        Classes="edge-summary-card-value"
                                                        Text="{Binding Value}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border
                                    Grid.Row="2"
                                    Classes="edge-summary-card-row"
                                    DataContext="{Binding LastErrorItem}">
                                    <Grid ColumnDefinitions="96,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing10}">
                                        <TextBlock
                                            Classes="edge-summary-card-label"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="edge-summary-card-value"
                                            Text="{Binding Value}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </edge:EdgeCard>
                        <edge:EdgeCard PaddingMode="Compact">
                            <edge:EdgeCard.Header>
                                <edge:EdgeSectionHeader
                                    Title="{DynamicResource Navigation_Monitor_StateMachineTasksTitle}"
                                    Subtitle="{DynamicResource Navigation_Monitor_StateMachineTasksSubtitle}" />
                            </edge:EdgeCard.Header>
                            <Grid MinHeight="84">
                                <StackPanel
                                    IsVisible="{Binding HasStateMachineTaskItems}"
                                    Spacing="0">
                                    <StackPanel
                                        IsVisible="{Binding HasStateMachineHeartbeatTaskItems}"
                                        Spacing="0">
                                        <Grid ColumnDefinitions="28,*" MinHeight="30">
                                            <Border
                                                Grid.Column="0"
                                                Width="1"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                Text="{DynamicResource Navigation_Monitor_StateMachineHeartbeatGroup}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding StateMachineHeartbeatTaskItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="28,*" MinHeight="58">
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="1"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                                        <edge:EdgeStatusDot
                                                            Grid.Column="0"
                                                            Margin="0,10,0,0"
                                                            VerticalAlignment="Top"
                                                            Size="10"
                                                            Status="{Binding VisualStatus}" />
                                                        <Grid
                                                            Grid.Column="1"
                                                            Margin="0,6,0,0"
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                                            <TextBlock
                                                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                                Text="{Binding DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <edge:EdgeStatusChip
                                                                Grid.Column="1"
                                                                Status="{Binding VisualStatus}"
                                                                Text="{Binding StepValueText}" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                                Text="{Binding StepText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Grid.ColumnSpan="2"
                                                                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                                Text="{Binding DetailText}"
                                                                TextWrapping="Wrap" />
                                                            <Border
                                                                Grid.Row="3"
                                                                Grid.ColumnSpan="2"
                                                                Height="1"
                                                                Margin="0,9,0,0"
                                                                Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel
                                        IsVisible="{Binding HasStateMachineRuntimeTaskItems}"
                                        Spacing="0">
                                        <Grid ColumnDefinitions="28,*" MinHeight="34">
                                            <Border
                                                Grid.Column="0"
                                                Width="1"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                Text="{DynamicResource Navigation_Monitor_StateMachineRuntimeGroup}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding StateMachineRuntimeTaskItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="0" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="28,*" MinHeight="58">
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="1"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                                        <edge:EdgeStatusDot
                                                            Grid.Column="0"
                                                            Margin="0,10,0,0"
                                                            VerticalAlignment="Top"
                                                            Size="10"
                                                            Status="{Binding VisualStatus}" />
                                                        <Grid
                                                            Grid.Column="1"
                                                            Margin="0,6,0,0"
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                                                            <TextBlock
                                                                FontSize="{DynamicResource Edge.FontSize.Body}"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                                Text="{Binding DisplayName}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <edge:EdgeStatusChip
                                                                Grid.Column="1"
                                                                Status="{Binding VisualStatus}"
                                                                Text="{Binding AvailabilityStatusText}" />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                                Text="{Binding StepText}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Grid.ColumnSpan="2"
                                                                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                                                                FontSize="{DynamicResource Edge.FontSize.Caption}"
                                                                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                                                Text="{Binding DetailText}"
                                                                TextWrapping="Wrap" />
                                                            <Border
                                                                Grid.Row="3"
                                                                Grid.ColumnSpan="2"
                                                                Height="1"
                                                                Margin="0,9,0,0"
                                                                Background="{DynamicResource Edge.Brush.Border.Subtle}" />
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    MaxWidth="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsStateMachineTaskItemsEmpty}"
                                    Spacing="{DynamicResource Edge.Size.Spacing6}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.BodyStrong}"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                        Text="{DynamicResource Navigation_Monitor_StateMachineTasksEmptyTitle}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{DynamicResource Navigation_Monitor_StateMachineTasksEmptyMessage}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </edge:EdgeCard>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </edge:EdgeScrollHost>
    </Grid>
</UserControl>
