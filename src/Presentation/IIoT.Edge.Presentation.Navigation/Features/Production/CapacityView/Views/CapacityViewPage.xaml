<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Production.CapacityView.CapacityViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">
    <sharedViews:PageActionShell.HeaderContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Medium"
                Foreground="#E4E4E7"
                Text="{DynamicResource Navigation_Title_CapacityQuery}" />

            <ComboBox
                Grid.Column="1"
                Width="200"
                Margin="0,0,8,0"
                materialDesign:HintAssist.Hint="{DynamicResource Navigation_Hint_SelectDevice}"
                DisplayMemberPath="."
                FontSize="13"
                Foreground="#E4E4E7"
                ItemsSource="{Binding DeviceNames}"
                SelectedItem="{Binding SelectedDeviceName}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}" />

            <ComboBox
                Grid.Column="2"
                Width="130"
                Margin="0,0,8,0"
                materialDesign:HintAssist.Hint="{DynamicResource Navigation_Hint_QueryDimension}"
                FontSize="13"
                Foreground="#E4E4E7"
                SelectedValue="{Binding SelectedQueryMode}"
                SelectedValuePath="Tag"
                Style="{StaticResource MaterialDesignOutlinedComboBox}">
                <ComboBoxItem Content="{DynamicResource Navigation_Capacity_ByDay}" Tag="Day" />
                <ComboBoxItem Content="{DynamicResource Navigation_Capacity_ByMonth}" Tag="Month" />
                <ComboBoxItem Content="{DynamicResource Navigation_Capacity_ByYear}" Tag="Year" />
            </ComboBox>

            <DatePicker
                Grid.Column="3"
                Margin="0,0,8,0"
                FontSize="12"
                SelectedDate="{Binding QueryDate}" />

            <Button
                Grid.Column="4"
                Height="32"
                Padding="16,0"
                BorderBrush="#555"
                Command="{Binding QueryCommand}"
                Content="{DynamicResource Navigation_Button_Query}"
                FontSize="12"
                Foreground="#E4E4E7"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
        </Grid>
    </sharedViews:PageActionShell.HeaderContent>

    <sharedViews:PageActionShell.ActionContent>
        <StackPanel Orientation="Horizontal">
            <Button
                Height="32"
                Padding="16,0"
                Background="#0F766E"
                BorderThickness="0"
                Command="{Binding ExportCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="16" Height="16" Foreground="White" Kind="FileExcel" />
                    <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="White" Text="{DynamicResource Navigation_Button_ExportExcel}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </sharedViews:PageActionShell.ActionContent>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="12"
            Foreground="#F59E0B"
            Text="{DynamicResource Navigation_Capacity_OfflineHint}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <UniformGrid Grid.Row="1" Margin="0,0,0,12" Columns="4">
            <Border Margin="0,0,8,0" Padding="16,12" Background="#1E1E1E" CornerRadius="8"><StackPanel><TextBlock FontSize="12" Foreground="#A1A1AA" Text="{DynamicResource Navigation_Capacity_TotalOutput}" /><TextBlock FontSize="28" FontWeight="Bold" Foreground="#E4E4E7" Text="{Binding PeriodTotal}" /></StackPanel></Border>
            <Border Margin="4,0" Padding="16,12" Background="#1E1E1E" CornerRadius="8"><StackPanel><TextBlock FontSize="12" Foreground="#A1A1AA" Text="{DynamicResource Navigation_Capacity_Good}" /><TextBlock FontSize="28" FontWeight="Bold" Foreground="#22C55E" Text="{Binding PeriodOk}" /></StackPanel></Border>
            <Border Margin="4,0" Padding="16,12" Background="#1E1E1E" CornerRadius="8"><StackPanel><TextBlock FontSize="12" Foreground="#A1A1AA" Text="{DynamicResource Navigation_Capacity_Bad}" /><TextBlock FontSize="28" FontWeight="Bold" Foreground="#EF4444" Text="{Binding PeriodNg}" /></StackPanel></Border>
            <Border Margin="8,0,0,0" Padding="16,12" Background="#1E1E1E" CornerRadius="8"><StackPanel><TextBlock FontSize="12" Foreground="#A1A1AA" Text="{DynamicResource Navigation_Capacity_AvgPerDay}" /><TextBlock FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Text="{Binding AvgDaily}" /></StackPanel></Border>
        </UniformGrid>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            BorderThickness="0"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            Foreground="#E4E4E7"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#333"
            IsReadOnly="True"
            ItemsSource="{Binding DailyRecords}"
            RowBackground="#1E1E1E"
            RowHeight="42">
            <DataGrid.Columns>
                <DataGridTextColumn Width="90" Binding="{Binding Date}" Header="{DynamicResource Navigation_Column_Date}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Date" />
                <DataGridTextColumn Width="100" Binding="{Binding DayOfWeek}" Header="{DynamicResource Navigation_Column_Weekday}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Weekday" />
                <DataGridTextColumn Width="90" Binding="{Binding Total}" Header="{DynamicResource Navigation_Column_Total}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Total" />
                <DataGridTextColumn Width="90" Binding="{Binding OkCount}" Header="{DynamicResource Navigation_Capacity_Good}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Capacity_Good" />
                <DataGridTextColumn Width="90" Binding="{Binding NgCount}" Header="{DynamicResource Navigation_Capacity_Bad}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Capacity_Bad" />
                <DataGridTextColumn Width="90" Binding="{Binding Yield}" Header="{DynamicResource Navigation_Column_Yield}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Yield" />
                <DataGridTextColumn Width="90" Binding="{Binding DayShiftTotal}" Header="{DynamicResource Navigation_Monitor_DayShift}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Monitor_DayShift" />
                <DataGridTextColumn Width="90" Binding="{Binding NightShiftTotal}" Header="{DynamicResource Navigation_Monitor_NightShift}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Monitor_NightShift" />
                <DataGridTextColumn Width="100" Binding="{Binding DateFull}" Header="{DynamicResource Navigation_Column_FullDate}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_FullDate" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="16" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
            <ItemsControl ItemsSource="{Binding ChartBars}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding ChartBars.Count}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="24" Margin="2,0">
                            <Border
                                Background="#22C55E"
                                CornerRadius="4,4,0,0"
                                Height="{Binding ChartHeight}"
                                Width="24" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="10"
                                Foreground="#A1A1AA"
                                Text="{Binding Label}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</sharedViews:PageActionShell>
