<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Production.CapacityView.CapacityViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Edge.Text.Primary}"
                        Text="{Binding ViewTitle}" />
                    <TextBlock
                        Foreground="{DynamicResource Edge.Text.Muted}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    MinWidth="118"
                    Padding="14,8"
                    VerticalAlignment="Top"
                    Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="M6,3 L16,3 L20,7 L20,21 L6,21 Z M15,3 L15,8 L20,8 M9,11 L17,11 M9,14 L17,14 M9,17 L14,17" />
                        <TextBlock Text="{DynamicResource Navigation_Button_ExportExcel}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8">
                <WrapPanel>
                    <ComboBox
                        Width="190"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding DeviceNames}"
                        PlaceholderText="{DynamicResource Navigation_Hint_SelectDevice}"
                        SelectedItem="{Binding SelectedDeviceName}" />
                    <ComboBox
                        Width="150"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding QueryModes}"
                        PlaceholderText="{DynamicResource Navigation_Hint_QueryDimension}"
                        SelectedItem="{Binding SelectedQueryModeOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DatePicker
                        Width="150"
                        Margin="0,0,12,0"
                        SelectedDate="{Binding QueryDate}" />
                    <Button
                        MinWidth="86"
                        Padding="16,8"
                        Command="{Binding QueryCommand}">
                        <TextBlock Text="{DynamicResource Navigation_Button_Query}" />
                    </Button>
                </WrapPanel>
            </Border>

            <Border
                Padding="12,8"
                Background="{DynamicResource Edge.Surface.Panel}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding !CanQueryCloud}">
                <TextBlock
                    Foreground="{DynamicResource Edge.Warning}"
                    Text="{DynamicResource Navigation_Capacity_OfflineHint}"
                    TextWrapping="Wrap" />
            </Border>

            <UniformGrid Columns="4" Rows="1">
                <Border Margin="0,0,8,0" Padding="14,12" Background="{DynamicResource Edge.Surface.Main}" BorderBrush="{DynamicResource Edge.Border.Subtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Capacity_TotalOutput}" />
                        <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding PeriodTotal}" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="14,12" Background="{DynamicResource Edge.Surface.Main}" BorderBrush="{DynamicResource Edge.Border.Subtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Capacity_Good}" />
                        <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Success}" Text="{Binding PeriodOk}" />
                    </StackPanel>
                </Border>
                <Border Margin="4,0" Padding="14,12" Background="{DynamicResource Edge.Surface.Main}" BorderBrush="{DynamicResource Edge.Border.Subtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Capacity_Bad}" />
                        <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Danger}" Text="{Binding PeriodNg}" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" Padding="14,12" Background="{DynamicResource Edge.Surface.Main}" BorderBrush="{DynamicResource Edge.Border.Subtle}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Muted}" Text="{DynamicResource Navigation_Capacity_AvgPerDay}" />
                        <TextBlock FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Warning}" Text="{Binding AvgDaily}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Main}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <DataGrid
                        Classes="edge-grid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        IsVisible="{Binding HasDailyRecords}"
                        ItemsSource="{Binding DailyRecords}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Date}" Header="{DynamicResource Navigation_Column_Date}" Width="90" />
                            <DataGridTextColumn Binding="{Binding DayOfWeek}" Header="{DynamicResource Navigation_Column_Weekday}" Width="90" />
                            <DataGridTextColumn Binding="{Binding Total}" Header="{DynamicResource Navigation_Column_Total}" Width="90" />
                            <DataGridTextColumn Binding="{Binding OkCount}" Header="{DynamicResource Navigation_Capacity_Good}" Width="90" />
                            <DataGridTextColumn Binding="{Binding NgCount}" Header="{DynamicResource Navigation_Capacity_Bad}" Width="90" />
                            <DataGridTextColumn Binding="{Binding Yield}" Header="{DynamicResource Navigation_Column_Yield}" Width="90" />
                            <DataGridTextColumn Binding="{Binding DayShiftTotal}" Header="{DynamicResource Navigation_Monitor_DayShift}" Width="100" />
                            <DataGridTextColumn Binding="{Binding NightShiftTotal}" Header="{DynamicResource Navigation_Monitor_NightShift}" Width="100" />
                            <DataGridTextColumn Binding="{Binding DateFull}" Header="{DynamicResource Navigation_Column_FullDate}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <sharedViews:EmptyStateView
                        IsVisible="{Binding IsDailyRecordsEmpty}"
                        Message="{DynamicResource Navigation_Capacity_EmptyMessage}"
                        Title="{DynamicResource Navigation_Capacity_EmptyTitle}" />
                </StackPanel>
            </Border>

            <Border
                Padding="14"
                Background="{DynamicResource Edge.Surface.Main}"
                BorderBrush="{DynamicResource Edge.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Edge.Text.Primary}"
                        Text="{DynamicResource Navigation_Capacity_ChartTitle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ChartBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="54" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Foreground="{DynamicResource Edge.Text.Muted}"
                                            Text="{Binding Value}"
                                            TextAlignment="Center" />
                                        <Border
                                            Width="28"
                                            Height="{Binding ChartHeight}"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource Edge.Success}"
                                            CornerRadius="6,6,0,0" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="10"
                                            Foreground="{DynamicResource Edge.Text.Muted}"
                                            Text="{Binding Label}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
