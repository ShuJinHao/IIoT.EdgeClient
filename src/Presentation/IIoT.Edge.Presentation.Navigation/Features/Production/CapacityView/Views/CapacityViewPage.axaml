<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Production.CapacityView.CapacityViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource Edge.Thickness.20}" Spacing="{DynamicResource Edge.Size.Spacing12}">
            <edge:EdgeSectionHeader
                Title="{Binding ViewTitle}"
                Subtitle="{Binding StatusMessage}">
                <edge:EdgeSectionHeader.ActionContent>
                    <Button
                        MinWidth="118"
                        Padding="{DynamicResource Edge.Thickness.8}"
                        Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing6}">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="M6,3 L16,3 L20,7 L20,21 L6,21 Z M15,3 L15,8 L20,8 M9,11 L17,11 M9,14 L17,14 M9,17 L14,17" />
                            <TextBlock Text="{DynamicResource Navigation_Button_ExportExcel}" />
                        </StackPanel>
                    </Button>
                </edge:EdgeSectionHeader.ActionContent>
            </edge:EdgeSectionHeader>

            <edge:EdgeCard CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                <WrapPanel>
                    <ComboBox
                        Width="190"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding DeviceNames}"
                        PlaceholderText="{DynamicResource Navigation_Hint_SelectDevice}"
                        SelectedItem="{Binding SelectedDeviceName}" />
                    <ComboBox
                        Width="150"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding QueryModes}"
                        PlaceholderText="{DynamicResource Navigation_Hint_QueryDimension}"
                        SelectedItem="{Binding SelectedQueryModeOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DatePicker
                        Width="150"
                        Margin="0,0,12,0"
                        SelectedDate="{Binding QueryDateOffset}" />
                    <Button
                        MinWidth="86"
                        Padding="16,8"
                        Command="{Binding QueryCommand}">
                        <TextBlock Text="{DynamicResource Navigation_Button_Query}" />
                    </Button>
                </WrapPanel>
            </edge:EdgeCard>

            <edge:EdgeStatusListItem
                IsVisible="{Binding !CanQueryCloud}"
                Status="Warning"
                StatusText="{DynamicResource Navigation_Capacity_OfflineHint}"
                Title="{DynamicResource Navigation_Capacity_OfflineHint}" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing12}">
                <edge:EdgeKpiCard
                    Title="{DynamicResource Navigation_Capacity_TotalOutput}"
                    TrendStatus="Info"
                    Value="{Binding PeriodTotal}" />
                <edge:EdgeKpiCard
                    Grid.Column="1"
                    Title="{DynamicResource Navigation_Capacity_Good}"
                    TrendStatus="Running"
                    Value="{Binding PeriodOk}" />
                <edge:EdgeKpiCard
                    Grid.Column="2"
                    Title="{DynamicResource Navigation_Capacity_Bad}"
                    TrendStatus="Error"
                    Value="{Binding PeriodNg}" />
                <edge:EdgeKpiCard
                    Grid.Column="3"
                    Title="{DynamicResource Navigation_Capacity_AvgPerDay}"
                    TrendStatus="Warning"
                    Value="{Binding AvgDaily}" />
            </Grid>

            <edge:EdgeCard>
                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing12}">
                    <DataGrid
                        Classes="edge-grid"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        IsVisible="{Binding HasDailyRecords}"
                        ItemsSource="{Binding DailyRecords}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Date}" Header="{DynamicResource Navigation_Column_Date}" Width="90" />
                            <DataGridTextColumn Binding="{Binding DayOfWeek}" Header="{DynamicResource Navigation_Column_Weekday}" Width="90" />
                            <DataGridTextColumn Binding="{Binding Total}" Header="{DynamicResource Navigation_Column_Total}" Width="90" />
                            <DataGridTextColumn Binding="{Binding OkCount}" Header="{DynamicResource Navigation_Capacity_Good}" Width="90" />
                            <DataGridTextColumn Binding="{Binding NgCount}" Header="{DynamicResource Navigation_Capacity_Bad}" Width="90" />
                            <DataGridTextColumn Binding="{Binding Yield}" Header="{DynamicResource Navigation_Column_Yield}" Width="90" />
                            <DataGridTextColumn Binding="{Binding DayShiftTotal}" Header="{DynamicResource Navigation_Monitor_DayShift}" Width="100" />
                            <DataGridTextColumn Binding="{Binding NightShiftTotal}" Header="{DynamicResource Navigation_Monitor_NightShift}" Width="100" />
                            <DataGridTextColumn Binding="{Binding DateFull}" Header="{DynamicResource Navigation_Column_FullDate}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <sharedViews:EmptyStateView
                        IsVisible="{Binding IsDailyRecordsEmpty}"
                        Message="{DynamicResource Navigation_Capacity_EmptyMessage}"
                        Title="{DynamicResource Navigation_Capacity_EmptyTitle}" />
                </StackPanel>
            </edge:EdgeCard>

            <edge:EdgeCard>
                <edge:EdgeCard.Header>
                    <edge:EdgeSectionHeader Title="{DynamicResource Navigation_Capacity_ChartTitle}" />
                </edge:EdgeCard.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ChartBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="54" Margin="0,0,8,0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{Binding Value}"
                                        TextAlignment="Center" />
                                    <Border
                                        Width="28"
                                        Height="{Binding ChartHeight}"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource Edge.Brush.Status.Running}"
                                        CornerRadius="{DynamicResource Edge.CornerRadius.Small}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="{DynamicResource Edge.FontSize.Caption}"
                                        Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                                        Text="{Binding Label}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </edge:EdgeCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
