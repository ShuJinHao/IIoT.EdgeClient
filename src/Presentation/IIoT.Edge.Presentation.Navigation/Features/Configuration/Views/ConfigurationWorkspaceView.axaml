<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Configuration.ConfigurationWorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">

    <Grid RowDefinitions="Auto,*">
        <edge:EdgeCard
            Margin="20,10,30,0"
            HorizontalAlignment="Left"
            Height="44"
            Elevation="Flat"
            IsVisible="{Binding HasTabs}"
            PaddingMode="None"
            Surface="Wash">
            <edge:EdgeSegmentedNav
                x:Name="ConfigurationTabsHost"
                ItemCommand="{Binding SelectTabCommand}"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                SelectionMode="Single">
                <edge:EdgeSegmentedNav.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </edge:EdgeSegmentedNav.ItemsPanel>
                <edge:EdgeSegmentedNav.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </edge:EdgeSegmentedNav.ItemTemplate>
            </edge:EdgeSegmentedNav>
        </edge:EdgeCard>

        <Grid Grid.Row="1">
            <ContentControl
                x:Name="ConfigurationContentHost"
                IsVisible="{Binding IsContentVisible}" />
            <sharedViews:EmptyStateView
                MaxWidth="480"
                Margin="20,40,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="{Binding IsPermissionBlocked}"
                Message="{Binding NoPermissionMessage}"
                Title="{Binding NoPermissionTitle}" />
            <sharedViews:EmptyStateView
                MaxWidth="480"
                Margin="20,40,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="{Binding !HasSelectedTab}"
                Message="{Binding EmptyMessage}"
                Title="{Binding EmptyTitle}" />
        </Grid>
    </Grid>
</UserControl>
