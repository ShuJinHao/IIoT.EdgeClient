<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Config.ParamView.ParamViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">

    <sharedViews:PageActionShell.Resources>
        <Style x:Key="ParamValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="CaretBrush" Value="#E4E4E7" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#0F766E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBool}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Background" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </sharedViews:PageActionShell.Resources>

    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Foreground="#E4E4E7" Text="{Binding ViewTitle}" />
    </sharedViews:PageActionShell.HeaderContent>
    <sharedViews:PageActionShell.ActionContent>
        <Button Height="32" Padding="16,0" HorizontalAlignment="Right" Background="#0F766E" BorderThickness="0" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="16" Height="16" Foreground="White" Kind="ContentSave" />
                <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="White" Text="{DynamicResource Navigation_Button_Save}" />
            </StackPanel>
        </Button>
    </sharedViews:PageActionShell.ActionContent>

    <TabControl Padding="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="{DynamicResource Navigation_Tab_MesParams}">
            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MesParamGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7" Text="{Binding ModuleDisplayName}" />
                                    </Border>
                                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" Foreground="#E4E4E7" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#333" IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding Params}" RowBackground="#1E1E1E" RowHeight="42">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="180" Header="{DynamicResource Navigation_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamName" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="220" Header="{DynamicResource Navigation_Column_ParamValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamValue">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,0">
                                                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="90" Binding="{Binding ValueKind}" Header="{DynamicResource Navigation_Column_ParamType}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamType" IsReadOnly="True" />
                                            <DataGridTextColumn Width="90" Binding="{Binding DefaultValue}" Header="{DynamicResource Navigation_Column_DefaultValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DefaultValue" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource Navigation_Tab_CloudParams}">
            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CloudParamGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7" Text="{Binding ModuleDisplayName}" />
                                    </Border>
                                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" Foreground="#E4E4E7" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#333" IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding Params}" RowBackground="#1E1E1E" RowHeight="42">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="180" Header="{DynamicResource Navigation_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamName" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="220" Header="{DynamicResource Navigation_Column_ParamValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamValue">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,0">
                                                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="90" Binding="{Binding ValueKind}" Header="{DynamicResource Navigation_Column_ParamType}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamType" IsReadOnly="True" />
                                            <DataGridTextColumn Width="90" Binding="{Binding DefaultValue}" Header="{DynamicResource Navigation_Column_DefaultValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DefaultValue" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource Navigation_Tab_PluginBusinessParams}">
            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding BusinessParamGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7" Text="{Binding ModuleDisplayName}" />
                                    </Border>
                                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" Foreground="#E4E4E7" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#333" IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding Params}" RowBackground="#1E1E1E" RowHeight="42">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="180" Header="{DynamicResource Navigation_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamName" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="220" Header="{DynamicResource Navigation_Column_ParamValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamValue">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="8,0">
                                                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Width="90" Binding="{Binding ValueKind}" Header="{DynamicResource Navigation_Column_ParamType}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamType" IsReadOnly="True" />
                                            <DataGridTextColumn Width="90" Binding="{Binding DefaultValue}" Header="{DynamicResource Navigation_Column_DefaultValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_DefaultValue" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</sharedViews:PageActionShell>
