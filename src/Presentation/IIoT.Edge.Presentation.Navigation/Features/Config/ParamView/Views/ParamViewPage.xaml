<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Presentation.Navigation.Features.Config.ParamView.ParamViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:local="clr-namespace:IIoT.Edge.Presentation.Navigation.Features.Config.ParamView"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">

    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Medium" Foreground="#E4E4E7" Text="{Binding ViewTitle}" />
    </sharedViews:PageActionShell.HeaderContent>
    <sharedViews:PageActionShell.ActionContent>
        <Button Height="32" Padding="16,0" HorizontalAlignment="Right" Background="#0F766E" BorderThickness="0" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="16" Height="16" Foreground="White" Kind="ContentSave" />
                <TextBlock Margin="6,0,0,0" FontSize="13" Foreground="White" Text="{DynamicResource Navigation_Button_Save}" />
            </StackPanel>
        </Button>
    </sharedViews:PageActionShell.ActionContent>

    <TabControl Padding="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="{DynamicResource Navigation_Tab_GeneralParams}">
            <Border Margin="16" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Height="28" Margin="0,0,8,0" Padding="12,0" BorderBrush="#22C55E" Command="{Binding DataContext.AddGeneralParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="{DynamicResource Navigation_Button_AddParam}" FontSize="12" Foreground="#22C55E" Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Height="28" Padding="12,0" BorderBrush="#EF4444" Command="{Binding DataContext.DeleteGeneralParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=GeneralParamGrid}" Content="{DynamicResource Navigation_Button_DeleteSelected}" FontSize="12" Foreground="#EF4444" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="GeneralParamGrid" Grid.Row="1" AlternatingRowBackground="#232326" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" Foreground="#E4E4E7" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#333" IsReadOnly="{Binding CanEdit, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding GeneralParams}" RowBackground="#1E1E1E" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Width="200" Header="{DynamicResource Navigation_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamName" ItemsSource="{Binding Source={x:Static local:ParamViewHelper.SystemConfigKeyNames}}" SelectedItemBinding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_ParamValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamValue">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="Foreground" Value="#E4E4E7" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="{DynamicResource Navigation_Tab_DeviceParams}">
            <Grid Margin="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                    <ListBox Background="Transparent" BorderThickness="0" Foreground="#E4E4E7" ItemsSource="{Binding DeviceParamGroups}" SelectedItem="{Binding SelectedGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="8,10" FontSize="13" Text="{Binding DeviceName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="12,0" Background="#27272A" CornerRadius="8,8,0,0">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Button Height="28" Margin="0,0,8,0" Padding="12,0" BorderBrush="#22C55E" Command="{Binding DataContext.AddDeviceParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="{DynamicResource Navigation_Button_AddParam}" FontSize="12" Foreground="#22C55E" Style="{StaticResource MaterialDesignOutlinedButton}" />
                                <Button Height="28" Padding="12,0" BorderBrush="#EF4444" Command="{Binding DataContext.DeleteDeviceParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedItem, ElementName=DeviceParamGrid}" Content="{DynamicResource Navigation_Button_DeleteSelected}" FontSize="12" Foreground="#EF4444" Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="DeviceParamGrid" Grid.Row="1" AlternatingRowBackground="#232326" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False" Foreground="#E4E4E7" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#333" IsReadOnly="{Binding CanEdit, Converter={StaticResource InverseBooleanConverter}}" ItemsSource="{Binding SelectedGroup.Params}" RowBackground="#1E1E1E">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Width="150" Header="{DynamicResource Navigation_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_ParamName" ItemsSource="{Binding Source={x:Static local:ParamViewHelper.DeviceParamKeyNames}}" SelectedItemBinding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Width="100" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_CurrentValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_CurrentValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#22C55E" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="60" Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_Unit}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Unit" />
                                <DataGridTextColumn Width="70" Binding="{Binding Min, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_Min}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Min" />
                                <DataGridTextColumn Width="70" Binding="{Binding Max, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="{DynamicResource Navigation_Column_Max}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Navigation_Column_Max" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</sharedViews:PageActionShell>
