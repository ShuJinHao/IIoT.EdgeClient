<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.HardwareConfig.Views.IoMappingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Border Classes="edge-toolbar-card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="section-title" Text="{DynamicResource Navigation_Tab_IoMapping}" />
          <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_PlcSignal}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <ComboBox Width="280"
                    ItemsSource="{Binding CandidateIoSignals}"
                    SelectedItem="{Binding SelectedCandidateIoSignal}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayText}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="chip" Command="{Binding OpenAddInteractionMappingDialogCommand}" Content="{DynamicResource Navigation_Button_AddInteraction}" />
          <Button Classes="chip" Command="{Binding OpenAddDataPointMappingDialogCommand}" Content="{DynamicResource Navigation_Button_AddDataPoint}" />
          <Button Classes="chip" Command="{Binding DeleteIoMappingCommand}" Content="{DynamicResource Navigation_Button_Delete}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="14">
      <Border Grid.Column="0" Classes="edge-side-list">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     Classes="caption"
                     Text="{DynamicResource Navigation_Tab_NetworkDevice}" />
          <ListBox ItemsSource="{Binding NetworkDevices}"
                   SelectedItem="{Binding SelectedNetworkDevice}"
                   BorderBrush="Transparent"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Padding="8,7" Text="{Binding DeviceName}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="edge-table-shell">
        <DataGrid AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="False"
                  ItemsSource="{Binding FilteredIoMappings}"
                  SelectedItem="{Binding SelectedIoMapping}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="160" Binding="{Binding SignalKey}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_TaskKey" />
            <DataGridTextColumn Width="120" Binding="{Binding PlcAddress}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcAddress" />
            <DataGridTextColumn Width="90" Binding="{Binding AddressCount}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Count" />
            <DataGridTextColumn Width="140" Binding="{Binding BusinessGroup}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_BusinessGroup" />
            <DataGridTextColumn Width="160" Binding="{Binding SignalName}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_SignalName" />
            <DataGridTextColumn Width="110" Binding="{Binding DataType}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DataType" />
            <DataGridTextColumn Width="100" Binding="{Binding Direction}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Direction" />
            <DataGridCheckBoxColumn Width="110" Binding="{Binding IsAddressCountEditable}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Editable" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
