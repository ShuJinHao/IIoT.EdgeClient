<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.HardwareConfig.Views.HardwareConfigPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:views="clr-namespace:IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.HardwareConfig.Views">
  <Border Classes="edge-page-panel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="5">
          <TextBlock Classes="page-title" Text="{Binding ViewTitle}" />
          <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}"
                     Text="{Binding FeedbackMessage}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="chip accent"
                VerticalAlignment="Center"
                MinWidth="92"
                Command="{Binding SaveCommand}"
                Content="{DynamicResource Navigation_Button_Save}" />
      </Grid>

      <UniformGrid Grid.Row="1" Columns="3">
        <Border Classes="edge-summary-card lime" Margin="0,0,10,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Tab_NetworkDevice}" />
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding NetworkDevices.Count}" />
            <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}"
                       Text="{DynamicResource Navigation_Column_IpAddress}" />
          </StackPanel>
        </Border>

        <Border Classes="edge-summary-card blue" Margin="0,0,10,0">
          <StackPanel Spacing="8">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Tab_SerialDevice}" />
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding SerialDevices.Count}" />
            <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}"
                       Text="{DynamicResource Navigation_Column_PortName}" />
          </StackPanel>
        </Border>

        <Border Classes="edge-summary-card mint">
          <StackPanel Spacing="8">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Tab_IoMapping}" />
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding FilteredIoMappings.Count}" />
            <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}"
                       Text="{DynamicResource Navigation_Column_PlcSignal}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <dialogHost:DialogHost Grid.Row="2" IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False">
        <dialogHost:DialogHost.DialogContent>
          <Border Width="460"
                  Classes="edge-card"
                  Padding="24">
            <StackPanel Spacing="14">
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Edge.Text.Primary}"
                         Text="{Binding DialogTitle}" />
              <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}"
                         Text="{Binding DialogMessage}"
                         TextWrapping="Wrap" />
              <TextBlock Foreground="{DynamicResource Edge.Text.Muted}"
                         FontSize="12"
                         Text="{Binding PendingOperationText}"
                         TextWrapping="Wrap" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding CloseDialogCommand}" Content="{DynamicResource Navigation_Button_Cancel}" />
                <Button Classes="accent" Command="{Binding ConfirmDialogCommand}" Content="{DynamicResource Navigation_Button_Confirm}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </dialogHost:DialogHost.DialogContent>

        <Border Classes="edge-table-card" Padding="16">
          <TabControl Classes="edge-tool-tabs" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{DynamicResource Navigation_Tab_NetworkDevice}">
              <views:NetworkDevicePage />
            </TabItem>
            <TabItem Header="{DynamicResource Navigation_Tab_SerialDevice}">
              <views:SerialDevicePage />
            </TabItem>
            <TabItem Header="{DynamicResource Navigation_Tab_IoMapping}">
              <views:IoMappingPage />
            </TabItem>
          </TabControl>
        </Border>
      </dialogHost:DialogHost>
    </Grid>
  </Border>
</UserControl>
