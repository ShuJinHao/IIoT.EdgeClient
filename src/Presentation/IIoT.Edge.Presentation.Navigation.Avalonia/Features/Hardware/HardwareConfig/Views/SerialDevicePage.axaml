<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.HardwareConfig.Views.SerialDevicePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Border Classes="edge-toolbar-card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="section-title" Text="{DynamicResource Navigation_Tab_SerialDevice}" />
          <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_PortName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="chip accent" Command="{Binding AddSerialDeviceCommand}" Content="{DynamicResource Navigation_Button_Add}" />
          <Button Classes="chip" Command="{Binding DeleteSerialDeviceCommand}" Content="{DynamicResource Navigation_Button_Delete}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="edge-table-shell">
      <DataGrid x:Name="SerialDeviceGrid"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                IsReadOnly="False"
                ItemsSource="{Binding SerialDevices}"
                SelectedItem="{Binding SelectedSerialDevice}">
        <DataGrid.Columns>
          <DataGridTextColumn Width="130" Binding="{Binding DeviceName}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DeviceName" />
          <DataGridTextColumn Width="110" Binding="{Binding DeviceType}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DeviceType" />
          <DataGridTextColumn Width="90" Binding="{Binding PortName}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PortName" />
          <DataGridTextColumn Width="95" Binding="{Binding BaudRate}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_BaudRate" />
          <DataGridTextColumn Width="90" Binding="{Binding DataBits}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DataBits" />
          <DataGridTextColumn Width="100" Binding="{Binding StopBits}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_StopBits" />
          <DataGridTextColumn Width="90" Binding="{Binding Parity}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Parity" />
          <DataGridTextColumn Width="110" Binding="{Binding SendCmd1}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Command1" />
          <DataGridTextColumn Width="110" Binding="{Binding SendCmd2}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Command2" />
          <DataGridCheckBoxColumn Width="80" Binding="{Binding IsEnabled}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Enable" />
          <DataGridTextColumn Width="*" Binding="{Binding Remark}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Remark" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
