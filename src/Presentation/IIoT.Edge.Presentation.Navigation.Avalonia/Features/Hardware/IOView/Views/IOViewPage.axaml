<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.IOView.IOViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Classes="edge-page-panel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,280,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding ViewTitle}" />
            <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ComboBox Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DeviceName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Classes="chip accent" VerticalAlignment="Center" Command="{Binding ManualReadCommand}" Content="{DynamicResource Navigation_Io_ManualRead}" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Classes="edge-card mint">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Classes="edge-dot" Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="caption" Text="{DynamicResource Navigation_Io_SnapshotSource}" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding SnapshotSourceText}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="edge-card blue">
            <StackPanel Spacing="5">
              <TextBlock Classes="caption" Text="{DynamicResource Navigation_Io_SnapshotRefreshTime}" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding SnapshotRefreshText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="edge-alert">
          <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding WriteGateStatusText}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="edge-table-card" IsVisible="{Binding HasInteractionRows}">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Margin="18,16,18,10" Classes="section-title" Text="{DynamicResource Navigation_Title_IoInteractionGroup}" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding InteractionRows}" AutoGenerateColumns="False" IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridTextColumn Width="120" Binding="{Binding BusinessGroup}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_InteractionItem" />
                <DataGridTextColumn Width="2*" Binding="{Binding PlcAddressSummary}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcSignal" />
                <DataGridTextColumn Width="100" Binding="{Binding PlcValueText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcValue" />
                <DataGridTextColumn Width="2*" Binding="{Binding HostReplyAddressText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_CurrentReply" />
                <DataGridTextColumn Width="100" Binding="{Binding HostReplyValueText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ReplyValue" />
                <DataGridTextColumn Width="110" Binding="{Binding LastWriteValueText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LastWriteValue" />
                <DataGridTextColumn Width="2*" Binding="{Binding LastWriteResultText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LastWriteResult" />
                <DataGridTextColumn Width="2*" Binding="{Binding LastPlcWriteTraceText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcWriteTrace" />
                <DataGridTemplateColumn Width="120" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_WriteValue">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding WriteValue}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="100" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Action">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Classes="chip accent" Command="{Binding WriteCommand}" Content="{DynamicResource Navigation_Button_Write}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding DataSections}" IsVisible="{Binding HasDataSections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="edge-table-card" Margin="0,0,0,14">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock Margin="18,16,18,10" Classes="section-title" Text="{Binding Title}" />
                  <DataGrid Grid.Row="1" ItemsSource="{Binding Signals}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Width="2*" Binding="{Binding SignalName}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Signal" />
                      <DataGridTextColumn Width="160" Binding="{Binding PlcAddress}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Address" />
                      <DataGridTextColumn Width="120" Binding="{Binding DataType}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DataType" />
                      <DataGridTextColumn Width="120" Binding="{Binding DisplayValue}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_CurrentValue" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ArraySections}" IsVisible="{Binding HasArraySections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="edge-form-section" Margin="0,0,0,14">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Classes="section-title" Text="{Binding Title}" />
                      <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding Summary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="chip" Command="{Binding ToggleExpandedCommand}" Content="{Binding ToggleText}" />
                  </Grid>
                  <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding IsExpanded}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Width="80" Binding="{Binding Index}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Index" />
                      <DataGridTemplateColumn Width="*" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_MatrixValues">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Values}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="edge-chip" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <TextBlock Foreground="{DynamicResource Edge.Text.Muted}" Text="{Binding ColumnName}" />
                                      <TextBlock Foreground="{DynamicResource Edge.Text.Primary}" FontWeight="SemiBold" Text="{Binding Value}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="edge-form-section" IsVisible="{Binding HasNoSignals}">
          <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}" Text="{DynamicResource Navigation_Io_NoSignals}" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
