<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Hardware.IOView.IOViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Background="#0F172A" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,280,Auto,*" RowDefinitions="Auto">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding ViewTitle}" />
          <ComboBox Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DeviceName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border Grid.Column="2" Width="10" Height="10" Margin="16,0,6,0" CornerRadius="5" Background="#EF4444" />
          <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#CBD5E1" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Button HorizontalAlignment="Left" Command="{Binding ManualReadCommand}" Content="{DynamicResource Navigation_Io_ManualRead}" />

        <Border Padding="10" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto">
            <TextBlock Grid.Column="0" Foreground="#94A3B8" Text="{DynamicResource Navigation_Io_SnapshotSource}" />
            <TextBlock Grid.Column="1" Margin="6,0,18,0" Foreground="#E2E8F0" Text="{Binding SnapshotSourceText}" />
            <TextBlock Grid.Column="2" Foreground="#94A3B8" Text="{DynamicResource Navigation_Io_SnapshotRefreshTime}" />
            <TextBlock Grid.Column="3" Margin="6,0,0,0" Foreground="#E2E8F0" Text="{Binding SnapshotRefreshText}" />
          </Grid>
        </Border>

        <Border Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" IsVisible="{Binding HasInteractionRows}">
          <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Navigation_Title_IoInteractionGroup}" />
            <DataGrid ItemsSource="{Binding InteractionRows}" AutoGenerateColumns="False" IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridTextColumn Width="120" Binding="{Binding BusinessGroup}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_InteractionItem" />
                <DataGridTextColumn Width="2*" Binding="{Binding PlcAddressSummary}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcSignal" />
                <DataGridTextColumn Width="100" Binding="{Binding PlcValueText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_PlcValue" />
                <DataGridTextColumn Width="2*" Binding="{Binding HostReplyAddressText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_CurrentReply" />
                <DataGridTextColumn Width="100" Binding="{Binding HostReplyValueText}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ReplyValue" />
                <DataGridTemplateColumn Width="120" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_WriteValue">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding WriteValue}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Action">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Command="{Binding WriteCommand}" Content="{DynamicResource Navigation_Button_Write}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding DataSections}" IsVisible="{Binding HasDataSections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,12" Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding Title}" />
                  <DataGrid ItemsSource="{Binding Signals}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Width="2*" Binding="{Binding SignalName}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Signal" />
                      <DataGridTextColumn Width="160" Binding="{Binding PlcAddress}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Address" />
                      <DataGridTextColumn Width="120" Binding="{Binding DataType}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DataType" />
                      <DataGridTextColumn Width="120" Binding="{Binding DisplayValue}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_CurrentValue" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ArraySections}" IsVisible="{Binding HasArraySections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,12" Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding Title}" />
                      <TextBlock Foreground="#CBD5E1" Text="{Binding Summary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleExpandedCommand}" Content="{Binding ToggleText}" />
                  </Grid>
                  <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding IsExpanded}">
                    <DataGrid.Columns>
                      <DataGridTextColumn Width="80" Binding="{Binding Index}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Index" />
                      <DataGridTemplateColumn Width="*" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_MatrixValues">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Values}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Margin="0,0,8,6" Padding="8,4" Background="#1E293B" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <TextBlock Foreground="#94A3B8" Text="{Binding ColumnName}" />
                                      <TextBlock Foreground="#F8FAFC" FontWeight="SemiBold" Text="{Binding Value}" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Foreground="#CBD5E1" Text="{DynamicResource Navigation_Io_NoSignals}" IsVisible="{Binding HasNoSignals}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
