<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Config.ParamView.ParamViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border x:Name="ParamPageRoot" Classes="edge-page-panel">
    <Grid RowDefinitions="Auto,*" RowSpacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="{Binding ViewTitle}" />
          <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Classes="chip accent" VerticalAlignment="Center" Command="{Binding SaveCommand}" Content="{DynamicResource Navigation_Button_Save}" />
      </Grid>

      <Border Grid.Row="1" Classes="edge-table-card" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <TextBlock Margin="6,4,6,0" Classes="section-title" Text="{DynamicResource Navigation_Menu_ParamConfig}" />
          <TabControl x:Name="ParamTabs" Grid.Row="1" Classes="edge-tool-tabs" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="{DynamicResource Navigation_Tab_MesParams}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MesParamGroupsHost" Spacing="14" IsEnabled="{Binding CanEdit}">
                <ItemsControl ItemsSource="{Binding MesParamGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,14" Classes="edge-form-section">
                        <StackPanel Spacing="12">
                          <TextBlock Classes="section-title" Text="{Binding ModuleDisplayName}" />
                          <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False" MinHeight="180">
                            <DataGrid.Columns>
                              <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                              <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <TextBox Text="{Binding Value}" />
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                              <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                              <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_Tab_CloudParams}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CloudParamGroupsHost" Spacing="14" IsEnabled="{Binding CanEdit}">
                <ItemsControl ItemsSource="{Binding CloudParamGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,14" Classes="edge-form-section">
                        <StackPanel Spacing="12">
                          <TextBlock Classes="section-title" Text="{Binding ModuleDisplayName}" />
                          <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False" MinHeight="180">
                            <DataGrid.Columns>
                              <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                              <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <TextBox Text="{Binding Value}" />
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                              <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                              <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Navigation_Tab_PluginBusinessParams}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BusinessParamGroupsHost" Spacing="14" IsEnabled="{Binding CanEdit}">
                <ItemsControl ItemsSource="{Binding BusinessParamGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,14" Classes="edge-form-section">
                        <StackPanel Spacing="12">
                          <TextBlock Classes="section-title" Text="{Binding ModuleDisplayName}" />
                          <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False" MinHeight="180">
                            <DataGrid.Columns>
                              <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                              <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <TextBox Text="{Binding Value}" />
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                              <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                              <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                              <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
