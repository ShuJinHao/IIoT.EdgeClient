<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Config.ParamView.ParamViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Background="#0F172A" Padding="18">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
        <StackPanel Spacing="4">
          <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding ViewTitle}" />
          <TextBlock Foreground="#CBD5E1" Text="{Binding FeedbackMessage}" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding SaveCommand}" Content="{DynamicResource Navigation_Button_Save}" />
      </Grid>

      <TabControl SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="{DynamicResource Navigation_Tab_MesParams}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
              <ItemsControl ItemsSource="{Binding MesParamGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="10">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding ModuleDisplayName}" />
                        <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False">
                          <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                            <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBox Text="{Binding Value}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                            <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                            <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource Navigation_Tab_CloudParams}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
              <ItemsControl ItemsSource="{Binding CloudParamGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="10">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding ModuleDisplayName}" />
                        <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False">
                          <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                            <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBox Text="{Binding Value}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                            <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                            <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource Navigation_Tab_PluginBusinessParams}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" IsEnabled="{Binding CanEdit}">
              <ItemsControl ItemsSource="{Binding BusinessParamGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,12" Padding="12" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                      <StackPanel Spacing="10">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding ModuleDisplayName}" />
                        <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="False">
                          <DataGrid.Columns>
                            <DataGridTextColumn Width="180" Binding="{Binding DisplayName}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
                            <DataGridTemplateColumn Width="180" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamValue">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBox Text="{Binding Value}" />
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100" Binding="{Binding ValueKind}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamType" />
                            <DataGridTextColumn Width="120" Binding="{Binding DefaultValue}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_DefaultValue" />
                            <DataGridTextColumn Width="90" Binding="{Binding Min}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Max}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
                            <DataGridTextColumn Width="90" Binding="{Binding Unit}" IsReadOnly="True" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Border>
</UserControl>
