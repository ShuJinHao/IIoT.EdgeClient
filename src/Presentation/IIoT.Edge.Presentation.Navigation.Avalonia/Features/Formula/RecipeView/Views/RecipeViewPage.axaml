<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Features.Formula.RecipeView.RecipeViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Classes="edge-page-panel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding ViewTitle}" />
            <TextBlock Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Classes="chip" VerticalAlignment="Center" Command="{Binding SyncCloudCommand}" Content="{DynamicResource Navigation_Button_SyncCloud}" />
          <Button Grid.Column="2" Classes="chip accent" VerticalAlignment="Center" Command="{Binding SwitchSourceCommand}" Content="{DynamicResource Navigation_Button_SwitchSource}" />
        </Grid>

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
          <Border Classes="edge-card mint">
            <StackPanel Spacing="5">
              <TextBlock Classes="caption" Text="{DynamicResource Navigation_Label_Source}" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding SourceLabel}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="edge-card blue">
            <StackPanel Spacing="5">
              <TextBlock Classes="caption" Text="{DynamicResource Navigation_Label_Version}" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding RecipeVersion}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="edge-card lime">
            <StackPanel Spacing="5">
              <TextBlock Classes="caption" Text="{DynamicResource Navigation_Label_Process}" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding ProcessName}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="edge-card violet">
            <StackPanel Spacing="5">
              <TextBlock Classes="caption" Text="{DynamicResource Navigation_Label_Update}" />
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Text.Primary}" Text="{Binding UpdatedAt}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="edge-table-card">
          <DataGrid ItemsSource="{Binding Params}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Width="2*" Binding="{Binding Name}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_ParamName" />
              <DataGridTextColumn Width="*" Binding="{Binding Min}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_LowerLimit" />
              <DataGridTextColumn Width="*" Binding="{Binding Max}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_UpperLimit" />
              <DataGridTextColumn Width="*" Binding="{Binding Unit}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Unit" />
              <DataGridTemplateColumn Width="100" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Action">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Classes="chip" Command="{Binding DeleteCommand}" Content="{DynamicResource Navigation_Button_Delete}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Border Classes="edge-form-section">
          <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="{DynamicResource Navigation_Label_EmergencyEdit}" />
            <Grid ColumnDefinitions="2*,*,*,*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" PlaceholderText="{DynamicResource Navigation_Hint_ParamName}" Text="{Binding EditKey}" />
              <TextBox Grid.Column="1" PlaceholderText="{DynamicResource Navigation_Hint_LowerLimit}" Text="{Binding EditMin}" />
              <TextBox Grid.Column="2" PlaceholderText="{DynamicResource Navigation_Hint_UpperLimit}" Text="{Binding EditMax}" />
              <TextBox Grid.Column="3" PlaceholderText="{DynamicResource Navigation_Hint_Unit}" Text="{Binding EditUnit}" />
              <Button Grid.Column="4" Classes="accent" Command="{Binding SaveLocalParamCommand}" Content="{DynamicResource Navigation_Button_Save}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
