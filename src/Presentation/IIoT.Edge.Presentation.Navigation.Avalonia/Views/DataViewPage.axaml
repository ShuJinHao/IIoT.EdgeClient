<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Views.DataViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Classes="edge-page-panel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="{DynamicResource Navigation_Menu_Data}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Yield}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding TodayYield}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Status.ErrorText}" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="chip" Command="{Binding QueryCommand}" Content="{DynamicResource Navigation_Button_Query}" />
          <Button Classes="chip accent" Command="{Binding ExportCommand}" Content="{DynamicResource Navigation_Button_Export}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
        <Border Classes="edge-card mint">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Total}" />
            <TextBlock Classes="kpi-value" Text="{Binding TodayTotal}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="edge-card blue">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Ok}" />
            <TextBlock Classes="kpi-value" Foreground="{DynamicResource Edge.Status.Success}" Text="{Binding TodayOk}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="edge-card lime">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Ng}" />
            <TextBlock Classes="kpi-value" Foreground="{DynamicResource Edge.Status.Error}" Text="{Binding TodayNg}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Classes="edge-table-card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="18,16,18,10" Classes="section-title" Text="{DynamicResource Navigation_Menu_Data}" />
          <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Width="120" Binding="{Binding Time}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Time" />
              <DataGridTextColumn Width="*" Binding="{Binding BatchNo}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_BatchNo" />
              <DataGridTextColumn Width="90" Binding="{Binding Total}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Total" />
              <DataGridTextColumn Width="90" Binding="{Binding Ok}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ok" />
              <DataGridTextColumn Width="90" Binding="{Binding Ng}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ng" />
              <DataGridTextColumn Width="100" Binding="{Binding Yield}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Yield" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
