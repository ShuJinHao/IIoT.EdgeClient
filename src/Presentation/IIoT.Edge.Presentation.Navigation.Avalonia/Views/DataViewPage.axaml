<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Views.DataViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border Background="#0F172A" Padding="18">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Navigation_Menu_Data}" />
        <Button Command="{Binding QueryCommand}" Content="{DynamicResource Navigation_Button_Query}" />
        <Button Command="{Binding ExportCommand}" Content="{DynamicResource Navigation_Button_Export}" />
        <TextBlock Foreground="#CBD5E1" VerticalAlignment="Center" Text="{Binding TodayYield, StringFormat='良率 {0}'}" />
        <TextBlock Foreground="#FCA5A5" VerticalAlignment="Center" Text="{Binding FeedbackMessage}" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
        <Border Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
          <StackPanel>
            <TextBlock Foreground="#94A3B8" Text="{DynamicResource Navigation_Column_Total}" />
            <TextBlock Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayTotal}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
          <StackPanel>
            <TextBlock Foreground="#94A3B8" Text="{DynamicResource Navigation_Column_Ok}" />
            <TextBlock Foreground="#BBF7D0" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayOk}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
          <StackPanel>
            <TextBlock Foreground="#94A3B8" Text="{DynamicResource Navigation_Column_Ng}" />
            <TextBlock Foreground="#FECACA" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayNg}" />
          </StackPanel>
        </Border>
      </Grid>

      <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Width="120" Binding="{Binding Time}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Time" />
          <DataGridTextColumn Width="*" Binding="{Binding BatchNo}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_BatchNo" />
          <DataGridTextColumn Width="90" Binding="{Binding Total}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Total" />
          <DataGridTextColumn Width="90" Binding="{Binding Ok}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ok" />
          <DataGridTextColumn Width="90" Binding="{Binding Ng}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ng" />
          <DataGridTextColumn Width="100" Binding="{Binding Yield}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Yield" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>
