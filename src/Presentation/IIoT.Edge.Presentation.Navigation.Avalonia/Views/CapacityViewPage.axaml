<UserControl
    x:Class="IIoT.Edge.Presentation.Navigation.Avalonia.Views.CapacityViewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:IIoT.Edge.UI.Avalonia.Localization;assembly=IIoT.Edge.UI.Avalonia">
  <Border x:Name="CapacityPageRoot" Classes="edge-page-panel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
      <Grid ColumnDefinitions="*" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="{DynamicResource Navigation_Menu_Capacity}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Yield}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Text.Secondary}" Text="{Binding PeriodYield}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource Edge.Status.ErrorText}" Text="{Binding FeedbackMessage}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border x:Name="CapacityToolbar" Grid.Row="1" Classes="edge-toolbar-card">
        <Grid ColumnDefinitions="Auto,180,Auto,120,*,Auto,Auto" ColumnSpacing="10">
          <TextBlock VerticalAlignment="Center" Classes="caption" Text="{DynamicResource Navigation_Column_DeviceName}" />
          <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding DeviceNames}" SelectedItem="{Binding SelectedDeviceName}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="caption" Text="{DynamicResource Navigation_Column_Time}" />
          <ComboBox Grid.Column="3" Width="120" ItemsSource="{Binding QueryModes}" SelectedItem="{Binding SelectedQueryMode}" />
          <Button Grid.Column="5" Classes="chip" Command="{Binding QueryCommand}" Content="{DynamicResource Navigation_Button_Query}" />
          <Button Grid.Column="6" Classes="chip accent" Command="{Binding ExportCommand}" Content="{DynamicResource Navigation_Button_Export}" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Classes="edge-card compact mint" MinHeight="92">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Total}" />
            <TextBlock Classes="kpi-value" Text="{Binding PeriodTotal}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="edge-card compact blue" MinHeight="92">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Ok}" />
            <TextBlock Classes="kpi-value" Foreground="{DynamicResource Edge.Status.Success}" Text="{Binding PeriodOk}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="edge-card compact lime" MinHeight="92">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Ng}" />
            <TextBlock Classes="kpi-value" Foreground="{DynamicResource Edge.Status.Error}" Text="{Binding PeriodNg}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="edge-card compact violet" MinHeight="92">
          <StackPanel Spacing="5">
            <TextBlock Classes="caption" Text="{DynamicResource Navigation_Column_Count}" />
            <TextBlock Classes="kpi-value" Text="{Binding AvgDaily}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Classes="edge-table-card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="18,16,18,10" Classes="section-title" Text="{DynamicResource Navigation_Menu_Capacity}" />
          <DataGrid x:Name="CapacityRecordsGrid" Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="320">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" Binding="{Binding Date}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Time" />
              <DataGridTextColumn Width="110" Binding="{Binding Total}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Total" />
              <DataGridTextColumn Width="110" Binding="{Binding OkCount}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ok" />
              <DataGridTextColumn Width="110" Binding="{Binding NgCount}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Ng" />
              <DataGridTextColumn Width="120" Binding="{Binding Yield}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Yield" />
              <DataGridTextColumn Width="120" Binding="{Binding DayShiftTotal}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Count" />
              <DataGridTextColumn Width="120" Binding="{Binding NightShiftTotal}" loc:LocalizedDataGrid.HeaderResourceKey="Navigation_Column_Status" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
