<UserControl
    x:Class="IIoT.Edge.Presentation.Shell.Avalonia.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Width="360" Background="#111827" CornerRadius="8" Padding="22">
    <StackPanel Spacing="14">
      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{DynamicResource Shell_Login_Title}" />
      <TextBlock Foreground="#94A3B8" Text="{Binding ModeTitle}" />
      <TextBox PlaceholderText="{DynamicResource Shell_Login_EmployeeNo}" Text="{Binding EmployeeNo}" IsVisible="{Binding IsCloudMode}" />
      <TextBox PlaceholderText="{DynamicResource Shell_Login_Password}" PasswordChar="*" Text="{Binding Password}" />
      <TextBlock Foreground="#FCA5A5" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <Button Command="{Binding SwitchModeCommand}" Content="{Binding SwitchModeText}" />
        <Button Grid.Column="1" Classes="accent" Command="{Binding LoginCommand}" Content="{DynamicResource Shell_Login_Submit}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
