<UserControl
    x:Class="IIoT.Edge.Presentation.Panels.Avalonia.Views.LogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="Transparent" Padding="0">
    <Border Classes="edge-right-panel chromeless">
      <DockPanel>
        <Grid DockPanel.Dock="Top" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" Margin="0,0,0,12">
          <StackPanel Spacing="3">
            <TextBlock Classes="section-title" Text="{DynamicResource Panels_Title_RuntimeLog}" />
            <TextBlock Classes="caption" Text="{DynamicResource Panels_Log_Hint}" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Classes="edge-log-metric">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="{DynamicResource Panels_Log_Total}" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Edge.Text.Primary}"
                           Text="{Binding TotalCount}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="edge-log-metric">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="{DynamicResource Panels_Log_Warning}" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Edge.Status.Warning}"
                           Text="{Binding WarningCount}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="edge-log-metric">
              <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="{DynamicResource Panels_Log_Error}" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Edge.Status.Error}"
                           Text="{Binding ErrorCount}" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel x:Name="LogActions"
                      Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Classes="chip" Command="{Binding RefreshCommand}" Content="{DynamicResource Shell_Action_Refresh}" />
            <Button Classes="chip" Command="{Binding ClearCommand}" Content="{DynamicResource Shell_Action_Clear}" />
          </StackPanel>
        </Grid>

        <Border Classes="edge-log-empty"
                IsVisible="{Binding IsLogEmpty}"
                Margin="0,0,0,12">
          <TextBlock Text="{DynamicResource Panels_Log_NoEntries}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Edge.Text.Secondary}" />
        </Border>

        <ListBox ItemsSource="{Binding Entries}"
                 Classes="edge-log-list"
                 Background="Transparent"
                 BorderBrush="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="edge-log-entry"
                      Classes.warning="{Binding IsWarning}"
                      Classes.error="{Binding IsError}"
                      Classes.debug="{Binding IsDebug}">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="edge-dot"
                            Classes.warning="{Binding IsWarning}"
                            Classes.error="{Binding IsError}"
                            Classes.debug="{Binding IsDebug}"
                            VerticalAlignment="Center" />
                    <Border Classes="edge-log-level"
                            Classes.warning="{Binding IsWarning}"
                            Classes.error="{Binding IsError}"
                            Classes.debug="{Binding IsDebug}"
                            VerticalAlignment="Center">
                      <TextBlock FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Edge.Text.Primary}"
                                 Text="{Binding Level}" />
                    </Border>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Edge.Text.Muted}"
                               Text="{Binding TimeText}" />
                  </StackPanel>
                  <TextBlock Foreground="{DynamicResource Edge.Text.Primary}"
                             Text="{Binding Message}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
