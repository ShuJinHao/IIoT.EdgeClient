<UserControl
    x:Class="IIoT.Edge.Presentation.Shell.Views.ShellContentPlaceholderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <Border Margin="12">
        <sharedViews:EmptyStateView
            Message="{Binding ContentMessage}"
            Title="{Binding ContentTitle}" />
    </Border>
</UserControl>
