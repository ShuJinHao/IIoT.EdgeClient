<Window
    x:Class="IIoT.Edge.Presentation.Shell.Views.ShellCloudLoginDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    Width="400"
    Height="320"
    Background="Transparent"
    CanResize="False"
    ExtendClientAreaToDecorationsHint="True"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterOwner">
    <edge:EdgeDialogChrome
        CloseTopLevelOnClose="True"
        Subtitle="{DynamicResource Shell_Login_CloudDescription}"
        Title="{DynamicResource Shell_Login_CloudTitle}">
        <Grid RowDefinitions="Auto,12,Auto,12,Auto,*,Auto">
            <TextBox
                x:Name="EmployeeNoInput"
                Grid.Row="0"
                Height="40"
                PlaceholderText="{DynamicResource Shell_Login_EmployeeNoHint}" />

            <TextBox
                x:Name="PasswordInput"
                Grid.Row="2"
                Height="40"
                PasswordChar="*"
                PlaceholderText="{DynamicResource Shell_Login_PasswordHint}" />

            <TextBlock
                x:Name="ErrorText"
                Grid.Row="4"
                MinHeight="18"
                FontSize="{DynamicResource Edge.FontSize.Caption}"
                Foreground="{DynamicResource Edge.Brush.Status.Error}"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="6"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{DynamicResource Edge.Size.Spacing8}">
                <Button
                    Classes="edge-soft-button"
                    Click="OnCancelClick"
                    Content="{DynamicResource Shell_Login_Cancel}" />
                <Button
                    x:Name="LoginButton"
                    Classes="edge-primary-button"
                    Click="OnLoginClick"
                    Content="{DynamicResource Shell_Login_Submit}" />
            </StackPanel>
        </Grid>
    </edge:EdgeDialogChrome>
</Window>
