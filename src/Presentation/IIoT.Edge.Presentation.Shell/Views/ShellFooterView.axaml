<UserControl
    x:Class="IIoT.Edge.Presentation.Shell.Views.ShellFooterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared">
    <Border
        Padding="{DynamicResource Edge.Thickness.Footer}"
        BorderBrush="{DynamicResource Edge.Border.Subtle}"
        BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
            <StackPanel
                Orientation="Horizontal"
                Spacing="{DynamicResource Edge.Size.Spacing6}">
                <edge:EdgeStatusDot
                    VerticalAlignment="Center"
                    Status="Running" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                    Text="{Binding SystemStatusText}" />
            </StackPanel>

            <TextBlock
                Grid.Column="2"
                Margin="{DynamicResource Edge.Thickness.FooterItem}"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                FontSize="{DynamicResource Edge.FontSize.Caption}"
                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                Text="{Binding VersionText}" />

            <TextBlock
                Grid.Column="3"
                Margin="{DynamicResource Edge.Thickness.FooterItem}"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                FontSize="{DynamicResource Edge.FontSize.Caption}"
                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                Text="{Binding EdgeIdText}" />

            <TextBlock
                Grid.Column="4"
                VerticalAlignment="Center"
                FontFamily="{DynamicResource Edge.FontFamily.Mono}"
                FontSize="{DynamicResource Edge.FontSize.Caption}"
                Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                Text="{Binding LocalTimeText}" />
        </Grid>
    </Border>
</UserControl>
