<UserControl
    x:Class="IIoT.Edge.Presentation.Shell.Views.ShellFooterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        BorderBrush="{DynamicResource Edge.Brush.Footer.Divider}"
        BorderThickness="0,1,0,0">
        <Grid
            Margin="20,0"
            VerticalAlignment="Center"
            ColumnDefinitions="Auto,*,Auto">
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                    Text="{DynamicResource Shell_Footer_Executing}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                    Text="{Binding FooterProgramName, FallbackValue=—, TargetNullValue=—}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Muted}"
                    Text="{DynamicResource Shell_Footer_RunTime}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                    Text="{Binding SoftwareRunDate, FallbackValue=—, TargetNullValue=—}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource Edge.FontSize.Caption}"
                    Foreground="{DynamicResource Edge.Brush.Text.Secondary}"
                    Text="{Binding FooterTimeAndDateText, FallbackValue=—, TargetNullValue=—}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
