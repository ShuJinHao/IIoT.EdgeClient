<UserControl
    x:Class="IIoT.Edge.Presentation.Shell.Features.Header.HeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Height="45"
    Background="Transparent">

    <Border
        Background="Transparent"
        BorderBrush="{DynamicResource MaterialDesignDivider}"
        BorderThickness="0,0,0,1"
        MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,0,0,0"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Text="{DynamicResource Shell_SystemTitle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <ComboBox
                    Width="96"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding SupportedLanguages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />

                <Separator
                    Width="1"
                    Height="18"
                    Margin="4,0"
                    Background="{DynamicResource MaterialDesignDivider}" />

                <Button
                    Command="{Binding WindowControlCommand}"
                    CommandParameter="Min"
                    Style="{StaticResource WindowControlBtnStyle}"
                    ToolTip="{DynamicResource Shell_Tooltip_Minimize}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowMinimize" />
                </Button>

                <Button
                    Command="{Binding WindowControlCommand}"
                    CommandParameter="Max"
                    Style="{StaticResource WindowControlBtnStyle}"
                    ToolTip="{DynamicResource Shell_Tooltip_MaximizeRestore}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="{Binding MaxRestoreIcon}" />
                </Button>

                <Button
                    Command="{Binding WindowControlCommand}"
                    CommandParameter="Close"
                    Style="{StaticResource WindowCloseBtnStyle}"
                    ToolTip="{DynamicResource Shell_Tooltip_Close}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowClose" />
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
