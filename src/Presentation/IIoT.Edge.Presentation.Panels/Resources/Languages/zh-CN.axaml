<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">
    <sys:String x:Key="Panels_Title_Equipment">设备运行</sys:String>
    <sys:String x:Key="Panels_Title_SystemLog">系统日志</sys:String>
    <sys:String x:Key="Panels_Subtitle_Equipment">真实设备、配方与产量状态</sys:String>
    <sys:String x:Key="Panels_Subtitle_SystemLog">实时运行日志</sys:String>
    <sys:String x:Key="Panels_Tab_HardwareStatus">硬件状态</sys:String>
    <sys:String x:Key="Panels_Tab_RecipeInfo">配方信息</sys:String>
    <sys:String x:Key="Panels_Tab_RealtimeData">实时数据</sys:String>
    <sys:String x:Key="Panels_Column_Connection">连接</sys:String>
    <sys:String x:Key="Panels_Column_Name">名称</sys:String>
    <sys:String x:Key="Panels_Column_AddressPort">地址/端口</sys:String>
    <sys:String x:Key="Panels_Column_Type">类型</sys:String>
    <sys:String x:Key="Panels_Column_ParamName">参数</sys:String>
    <sys:String x:Key="Panels_Column_CurrentValue">当前值</sys:String>
    <sys:String x:Key="Panels_Column_Min">最小值</sys:String>
    <sys:String x:Key="Panels_Column_Max">最大值</sys:String>
    <sys:String x:Key="Panels_Column_Unit">单位</sys:String>
    <sys:String x:Key="Panels_Column_Time">时间</sys:String>
    <sys:String x:Key="Panels_Column_Level">类型</sys:String>
    <sys:String x:Key="Panels_Column_Message">消息</sys:String>
    <sys:String x:Key="Panels_Label_LogDeviceFilter">设备号</sys:String>
    <sys:String x:Key="Panels_Filter_AllOrSummary">全部/汇总</sys:String>
    <sys:String x:Key="Panels_Label_Recipe">配方：</sys:String>
    <sys:String x:Key="Panels_Label_Version">版本：</sys:String>
    <sys:String x:Key="Panels_Label_Process">工序：</sys:String>
    <sys:String x:Key="Panels_Label_Status">状态：</sys:String>
    <sys:String x:Key="Panels_Label_EquipmentStatus">设备状态</sys:String>
    <sys:String x:Key="Panels_Status_Inactive">未激活</sys:String>
    <sys:String x:Key="Panels_Status_Active">已激活</sys:String>
    <sys:String x:Key="Panels_Status_Running">运行中</sys:String>
    <sys:String x:Key="Panels_Status_Connected">已连接</sys:String>
    <sys:String x:Key="Panels_Status_Disconnected">未连接</sys:String>
    <sys:String x:Key="Panels_Label_TodayOutput">今日产量</sys:String>
    <sys:String x:Key="Panels_Label_TodayYield">今日良率</sys:String>
    <sys:String x:Key="Panels_Label_NgCount">NG 数量</sys:String>
    <sys:String x:Key="Panels_Label_CurrentProgram">当前程序</sys:String>
    <sys:String x:Key="Panels_Label_CurrentBatch">当前批次</sys:String>
    <sys:String x:Key="Panels_Label_CurrentRecipe">当前配方</sys:String>
    <sys:String x:Key="Panels_Label_CurrentProcess">当前工序</sys:String>
    <sys:String x:Key="Panels_Label_MesPlanSelection">主批计划</sys:String>
    <sys:String x:Key="Panels_Label_TraceBatchNumber">追溯批次号</sys:String>
    <sys:String x:Key="Panels_Status_ProcessNotConfigured">未配置</sys:String>
    <sys:String x:Key="Panels_Status_ProcessAmbiguous">未确定</sys:String>
    <sys:String x:Key="Panels_Status_MesPlanRequired">待选择主批计划</sys:String>
    <sys:String x:Key="Panels_Status_MesPlanSelected">已选择</sys:String>
    <sys:String x:Key="Panels_Status_TraceBatchPending">待生成</sys:String>
    <sys:String x:Key="Panels_Status_TraceBatchNotGenerated">MES未生成</sys:String>
    <sys:String x:Key="Panels_Hint_SelectMainPlanBeforeProduction">MES 上传启用后，生产前需要选择主批计划。</sys:String>
    <sys:String x:Key="Panels_Button_SelectProductionPlan">选择主批计划</sys:String>
    <sys:String x:Key="Panels_Label_RealtimeStatus">实时状态</sys:String>
    <sys:String x:Key="Panels_Label_Output">产量</sys:String>
    <sys:String x:Key="Panels_Label_Yield">良率</sys:String>
    <sys:String x:Key="Panels_Label_NgShort">NG</sys:String>
    <sys:String x:Key="Panels_Button_Clear">清空</sys:String>
    <sys:String x:Key="Panels_Button_Refresh">刷新</sys:String>
    <sys:String x:Key="Panels_Button_Confirm">确定</sys:String>
    <sys:String x:Key="Panels_Button_Cancel">取消</sys:String>
    <sys:String x:Key="Panels_PlanDialog_Title">选择主批计划</sys:String>
    <sys:String x:Key="Panels_PlanDialog_Subtitle">从 MES 查询当前上位机可用的主批计划。</sys:String>
    <sys:String x:Key="Panels_PlanDialog_ErrorTitle">查询异常</sys:String>
    <sys:String x:Key="Panels_Plan_Column_MainPlan">主批计划号</sys:String>
    <sys:String x:Key="Panels_Plan_Column_WorkOrder">工单号</sys:String>
    <sys:String x:Key="Panels_Plan_Column_Product">产品</sys:String>
    <sys:String x:Key="Panels_Plan_Column_Status">状态</sys:String>
    <sys:String x:Key="Panels_Plan_Column_Quantity">计划数量</sys:String>
    <sys:String x:Key="Panels_Plan_Column_StartTime">开始时间</sys:String>
    <sys:String x:Key="Panels_Plan_Column_EndTime">结束时间</sys:String>
    <sys:String x:Key="Panels_Empty_NoProductionPlans_Title">暂无主批计划</sys:String>
    <sys:String x:Key="Panels_Empty_NoProductionPlans_Message">MES 当前没有返回可选择的主批计划。</sys:String>
    <sys:String x:Key="Panels_Empty_NoMainBatchPlanData">暂无主批计划数据</sys:String>
    <sys:String x:Key="Panels_Message_LoadingProductionPlans">正在查询 MES 主批计划...</sys:String>
    <sys:String x:Key="Panels_Error_PlanServiceMissing">当前模块没有提供主批计划查询能力。</sys:String>
    <sys:String x:Key="Panels_Error_MesUpperComputerNoMissing">MES 上位机编码未配置。</sys:String>
    <sys:String x:Key="Panels_Error_MesOperationCodeMissing">MES 工序编码未配置。</sys:String>
    <sys:String x:Key="Panels_Error_MesMainPlanCodeMissing">主批计划号缺失。</sys:String>
    <sys:String x:Key="Panels_Error_TraceBatchNumberMissing">MES 未返回追溯批次号。</sys:String>
    <sys:String x:Key="Panels_Error_TraceBatchTimeout">追溯批次号生成超时，请检查 MES 接口或当前主批计划。</sys:String>
    <sys:String x:Key="Panels_Error_LoadProductionPlansFailed">查询主批计划失败</sys:String>
    <sys:String x:Key="Panels_Error_SelectProductionPlanFailed">选择主批计划失败</sys:String>
    <sys:String x:Key="Panels_Empty_NoHardware_Title">暂无设备状态</sys:String>
    <sys:String x:Key="Panels_Empty_NoHardware_Message">当前没有可展示的真实硬件状态。</sys:String>
    <sys:String x:Key="Panels_Empty_NoRecipeParams_Title">暂无配方参数</sys:String>
    <sys:String x:Key="Panels_Empty_NoRecipeParams_Message">当前没有激活配方或参数明细。</sys:String>
    <sys:String x:Key="Panels_Empty_NoLog_Title">暂无运行日志</sys:String>
    <sys:String x:Key="Panels_Empty_NoLog_Message">系统启动后收到的真实日志会显示在这里。</sys:String>
</ResourceDictionary>
