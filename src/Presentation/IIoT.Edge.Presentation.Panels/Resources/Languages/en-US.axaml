    <sys:String x:Key="Panels_Filter_AllOrSummary">All / Summary</sys:String>
    <sys:String x:Key="Panels_Label_Recipe">Recipe: </sys:String>
    <sys:String x:Key="Panels_Label_Version">Version: </sys:String>
    <sys:String x:Key="Panels_Label_Process">Process: </sys:String>
    <sys:String x:Key="Panels_Label_Status">Status: </sys:String>
    <sys:String x:Key="Panels_Label_EquipmentStatus">Equipment Status</sys:String>
    <sys:String x:Key="Panels_Status_Inactive">Inactive</sys:String>
    <sys:String x:Key="Panels_Status_Active">Active</sys:String>
    <sys:String x:Key="Panels_Status_Running">Running</sys:String>
    <sys:String x:Key="Panels_Status_Connected">Connected</sys:String>
    <sys:String x:Key="Panels_Status_Disconnected">Disconnected</sys:String>
    <sys:String x:Key="Panels_Label_TodayOutput">Today Output</sys:String>
    <sys:String x:Key="Panels_Label_TodayYield">Today Yield</sys:String>
    <sys:String x:Key="Panels_Label_NgCount">NG Count</sys:String>
    <sys:String x:Key="Panels_Label_CurrentProgram">Current Program</sys:String>
    <sys:String x:Key="Panels_Label_CurrentBatch">Current Batch</sys:String>
    <sys:String x:Key="Panels_Label_CurrentRecipe">Current Recipe</sys:String>
    <sys:String x:Key="Panels_Label_CurrentProcess">Current Process</sys:String>
    <sys:String x:Key="Panels_Label_MesPlanSelection">Main Plan</sys:String>
    <sys:String x:Key="Panels_Label_TraceBatchNumber">Trace Batch No.</sys:String>
    <sys:String x:Key="Panels_Status_ProcessNotConfigured">Not configured</sys:String>
    <sys:String x:Key="Panels_Status_ProcessAmbiguous">Undetermined</sys:String>
    <sys:String x:Key="Panels_Status_MesPlanRequired">Main plan required</sys:String>
    <sys:String x:Key="Panels_Status_MesPlanSelected">Selected</sys:String>
    <sys:String x:Key="Panels_Status_TraceBatchPending">Pending</sys:String>
    <sys:String x:Key="Panels_Status_TraceBatchNotGenerated">Not generated by MES</sys:String>
    <sys:String x:Key="Panels_Hint_SelectMainPlanBeforeProduction">When MES upload is enabled, select a main plan before production.</sys:String>
    <sys:String x:Key="Panels_Button_SelectProductionPlan">Select Main Plan</sys:String>
    <sys:String x:Key="Panels_Label_RealtimeStatus">Realtime Status</sys:String>
    <sys:String x:Key="Panels_Label_Output">Output</sys:String>
    <sys:String x:Key="Panels_Label_Yield">Yield</sys:String>
    <sys:String x:Key="Panels_Label_NgShort">NG</sys:String>
    <sys:String x:Key="Panels_Button_Clear">Clear</sys:String>
    <sys:String x:Key="Panels_Button_Refresh">Refresh</sys:String>
    <sys:String x:Key="Panels_Button_Confirm">Confirm</sys:String>
    <sys:String x:Key="Panels_Button_Cancel">Cancel</sys:String>
    <sys:String x:Key="Panels_PlanDialog_Title">Select Main Plan</sys:String>
