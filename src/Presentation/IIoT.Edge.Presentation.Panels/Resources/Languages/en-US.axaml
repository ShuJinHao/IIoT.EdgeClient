    <sys:String x:Key="Panels_Plan_Column_Status">Status</sys:String>
    <sys:String x:Key="Panels_Plan_Column_Quantity">Plan Qty</sys:String>
    <sys:String x:Key="Panels_Plan_Column_StartTime">Start Time</sys:String>
    <sys:String x:Key="Panels_Plan_Column_EndTime">End Time</sys:String>
    <sys:String x:Key="Panels_Empty_NoProductionPlans_Title">No main plans</sys:String>
    <sys:String x:Key="Panels_Empty_NoProductionPlans_Message">MES did not return selectable main plans.</sys:String>
    <sys:String x:Key="Panels_Empty_NoMainBatchPlanData">No main batch plan data</sys:String>
    <sys:String x:Key="Panels_Message_LoadingProductionPlans">Querying MES main plans...</sys:String>
    <sys:String x:Key="Panels_Error_PlanServiceMissing">The current module does not provide main-plan query capability.</sys:String>
    <sys:String x:Key="Panels_Error_MesUpperComputerNoMissing">MES upper computer code is not configured.</sys:String>
    <sys:String x:Key="Panels_Error_MesOperationCodeMissing">MES operation code is not configured.</sys:String>
    <sys:String x:Key="Panels_Error_MesMainPlanCodeMissing">Main plan code is missing.</sys:String>
    <sys:String x:Key="Panels_Error_TraceBatchNumberMissing">MES did not return a trace batch number.</sys:String>
    <sys:String x:Key="Panels_Error_TraceBatchTimeout">Trace batch number generation timed out. Check the MES endpoint or selected main plan.</sys:String>
    <sys:String x:Key="Panels_Error_LoadProductionPlansFailed">Failed to query main plans</sys:String>
    <sys:String x:Key="Panels_Error_SelectProductionPlanFailed">Failed to select main plan</sys:String>
    <sys:String x:Key="Panels_Empty_NoHardware_Title">No equipment status</sys:String>
    <sys:String x:Key="Panels_Empty_NoHardware_Message">No live hardware status is available.</sys:String>
    <sys:String x:Key="Panels_Empty_NoRecipeParams_Title">No recipe parameters</sys:String>
    <sys:String x:Key="Panels_Empty_NoRecipeParams_Message">No active recipe or parameter details are available.</sys:String>
    <sys:String x:Key="Panels_Empty_NoLog_Title">No runtime logs</sys:String>
    <sys:String x:Key="Panels_Empty_NoLog_Message">Live logs received after startup will appear here.</sys:String>
