    <sys:String x:Key="Panels_PlanDialog_ErrorTitle">Query unavailable</sys:String>
    <sys:String x:Key="Panels_Plan_Column_MainPlan">Main Plan No.</sys:String>
    <sys:String x:Key="Panels_Plan_Column_WorkOrder">Work Order</sys:String>
