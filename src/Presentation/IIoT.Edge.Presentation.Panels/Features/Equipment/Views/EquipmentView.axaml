<UserControl
    x:Class="IIoT.Edge.Presentation.Panels.Features.Equipment.EquipmentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Views;assembly=IIoT.Edge.UI.Shared">
    <edge:EdgeCard CardPadding="{DynamicResource Edge.Thickness.Panel}">
        <edge:EdgeCard.Header>
            <edge:EdgeSectionHeader
                Title="{DynamicResource Panels_Title_Equipment}"
                Subtitle="{DynamicResource Panels_Subtitle_Equipment}">
                <edge:EdgeSectionHeader.ActionContent>
                    <edge:EdgeStatusChip Status="Info" Text="{Binding CurrentBatch}" />
                </edge:EdgeSectionHeader.ActionContent>
            </edge:EdgeSectionHeader>
        </edge:EdgeCard.Header>

        <TabControl
            FontSize="{DynamicResource Edge.FontSize.Body}"
            Padding="{DynamicResource Edge.Thickness.Zero}"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="{DynamicResource Edge.FontSize.Body}" Text="{DynamicResource Panels_Tab_HardwareStatus}" />
                </TabItem.Header>
                <Grid>
                    <ScrollViewer IsVisible="{Binding HasHardwareItems}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HardwareItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{DynamicResource Edge.Thickness.4}">
                                        <edge:EdgeStatusListItem
                                            Description="{Binding Address}"
                                            Detail="{Binding DeviceType}"
                                            IsVisible="{Binding IsConnected}"
                                            Status="Running"
                                            StatusText="{DynamicResource Panels_Status_Connected}"
                                            Title="{Binding Name}" />
                                        <edge:EdgeStatusListItem
                                            Description="{Binding Address}"
                                            Detail="{Binding DeviceType}"
                                            IsVisible="{Binding !IsConnected}"
                                            Status="Stopped"
                                            StatusText="{DynamicResource Panels_Status_Disconnected}"
                                            Title="{Binding Name}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <sharedViews:EmptyStateView
                        IsVisible="{Binding IsHardwareEmpty}"
                        Message="{DynamicResource Panels_Empty_NoHardware_Message}"
                        Title="{DynamicResource Panels_Empty_NoHardware_Title}" />
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="{DynamicResource Edge.FontSize.Body}" Text="{DynamicResource Panels_Tab_RecipeInfo}" />
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Edge.Size.Spacing10}">
                    <edge:EdgeCard CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                        <StackPanel Spacing="{DynamicResource Edge.Size.Spacing8}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Label_Recipe}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding RecipeName}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Label_Version}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding RecipeVersion}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Label_Process}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}">
                                <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Label_Status}" />
                                <Grid Grid.Column="1">
                                    <edge:EdgeStatusChip
                                        IsVisible="{Binding IsRecipeActive}"
                                        Status="Running"
                                        Text="{DynamicResource Panels_Status_Active}" />
                                    <edge:EdgeStatusChip
                                        IsVisible="{Binding !IsRecipeActive}"
                                        Status="Stopped"
                                        Text="{DynamicResource Panels_Status_Inactive}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </edge:EdgeCard>

                    <Grid Grid.Row="1">
                        <ScrollViewer IsVisible="{Binding HasRecipeParameters}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <edge:EdgeCard
                                            Margin="{DynamicResource Edge.Thickness.4}"
                                            CardPadding="{DynamicResource Edge.Thickness.Card.Compact}">
                                            <StackPanel Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                <TextBlock
                                                    FontSize="{DynamicResource Edge.FontSize.Body}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Edge.Brush.Text.Primary}"
                                                    Text="{Binding ParamName}"
                                                    TextWrapping="Wrap" />
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Edge.Size.Spacing8}" RowSpacing="{DynamicResource Edge.Size.Spacing4}">
                                                    <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Column_CurrentValue}" />
                                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding CurrentValue}" />
                                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Column_Min}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding MinValue}" />
                                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{DynamicResource Panels_Column_Max}" />
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Edge.Size.Spacing6}">
                                                        <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Primary}" Text="{Binding MaxValue}" />
                                                        <TextBlock Foreground="{DynamicResource Edge.Brush.Text.Muted}" Text="{Binding Unit}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </edge:EdgeCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <sharedViews:EmptyStateView
                            IsVisible="{Binding IsRecipeParametersEmpty}"
                            Message="{DynamicResource Panels_Empty_NoRecipeParams_Message}"
                            Title="{DynamicResource Panels_Empty_NoRecipeParams_Title}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock FontSize="{DynamicResource Edge.FontSize.Body}" Text="{DynamicResource Panels_Tab_RealtimeData}" />
                </TabItem.Header>
                <StackPanel Spacing="{DynamicResource Edge.Size.Spacing10}">
                    <edge:EdgeKpiCard
                        Title="{DynamicResource Panels_Label_TodayOutput}"
                        Value="{Binding TodayOutput}" />
                    <edge:EdgeKpiCard
                        Title="{DynamicResource Panels_Label_TodayYield}"
                        TrendStatus="Running"
                        Value="{Binding TodayYield}" />
                    <edge:EdgeKpiCard
                        Title="{DynamicResource Panels_Label_NgCount}"
                        TrendStatus="Error"
                        Value="{Binding NgCount}" />
                    <edge:EdgeStatusListItem
                        Description="{Binding CurrentBatch}"
                        Status="Info"
                        StatusText="{DynamicResource Panels_Label_CurrentBatch}"
                        Title="{DynamicResource Panels_Label_CurrentBatch}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </edge:EdgeCard>
</UserControl>
