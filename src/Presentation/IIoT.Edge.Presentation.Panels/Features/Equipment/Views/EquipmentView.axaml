<UserControl
    x:Class="IIoT.Edge.Presentation.Panels.Features.Equipment.EquipmentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:edge="clr-namespace:IIoT.Edge.UI.Shared.Avalonia.Controls;assembly=IIoT.Edge.UI.Shared">
    <edge:EdgeCard Classes="right-rail-equipment">
        <Grid
            Classes="edge-equipment-root"
            RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock
                Classes="edge-equipment-title"
                Text="{DynamicResource Panels_Title_Equipment}" />

            <Border
                Classes="edge-equipment-status-row"
                Grid.Row="1">
                <Grid
                    Classes="edge-equipment-status-grid"
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        Classes="edge-equipment-label"
                        Text="{DynamicResource Panels_Label_EquipmentStatus}" />
                    <Grid Grid.Column="1">
                        <StackPanel
                            Classes="edge-equipment-state"
                            IsVisible="{Binding IsRecipeActive}">
                            <edge:EdgeStatusDot
                                Classes="edge-equipment-status-dot"
                                Status="Running" />
                            <TextBlock
                                Classes="edge-equipment-state-text"
                                Text="{DynamicResource Panels_Status_Running}" />
                        </StackPanel>
                        <StackPanel
                            Classes="edge-equipment-state"
                            IsVisible="{Binding !IsRecipeActive}">
                            <edge:EdgeStatusDot
                                Classes="edge-equipment-status-dot"
                                Status="Offline" />
                            <TextBlock
                                Classes="edge-equipment-state-text"
                                Text="{DynamicResource Panels_Status_Inactive}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Classes="edge-equipment-plan-card"
                Grid.Row="2">
                <Grid
                    Classes="edge-equipment-plan-root"
                    RowDefinitions="Auto,Auto">
                    <Grid
                        Classes="edge-equipment-plan-header"
                        ColumnDefinitions="*,Auto">
                        <TextBlock
                            Classes="edge-equipment-label"
                            Text="{DynamicResource Panels_Label_MesPlanSelection}" />
                        <edge:EdgeActionButton
                            Grid.Column="1"
                            Classes="plan-action"
                            Command="{Binding SelectProductionPlanCommand}"
                            Icon="{StaticResource Edge.Icon.Plan}"
                            Kind="Secondary"
                            Role="RightRail"
                            Size="Compact"
                            Content="{DynamicResource Panels_Button_SelectProductionPlan}" />
                    </Grid>

                    <Grid
                        Classes="edge-equipment-plan-body"
                        Grid.Row="1">
                        <StackPanel
                            Classes="edge-equipment-plan-empty"
                            IsVisible="{Binding !HasSelectedProductionPlan}">
                            <TextBlock
                                Classes="edge-equipment-plan-title"
                                Text="{DynamicResource Panels_Status_MesPlanRequired}" />
                            <TextBlock
                                Classes="edge-equipment-plan-description"
                                Text="{DynamicResource Panels_Hint_SelectMainPlanBeforeProduction}" />
                        </StackPanel>

                        <Grid
                            Classes="edge-equipment-plan-selected"
                            IsVisible="{Binding HasSelectedProductionPlan}"
                            RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock
                                Classes="edge-equipment-plan-title"
                                Text="{Binding SelectedPlanCode}" />
                            <TextBlock
                                Classes="edge-equipment-plan-description"
                                Grid.Row="1"
                                Text="{Binding SelectedPlanProductSummary}" />
                            <Grid
                                Classes="edge-equipment-trace-row"
                                Grid.Row="2"
                                ColumnDefinitions="64,*">
                                <TextBlock
                                    Classes="edge-equipment-plan-key"
                                    Text="{DynamicResource Panels_Label_TraceBatchNumber}" />
                                <TextBlock
                                    Classes="edge-equipment-plan-value"
                                    Grid.Column="1"
                                    Text="{Binding TraceBatchNumber}" />
                            </Grid>
                            <TextBlock
                                Classes="edge-equipment-plan-error"
                                Grid.Row="3"
                                IsVisible="{Binding HasTraceBatchError}"
                                Text="{Binding TraceBatchError}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid
                Classes="edge-equipment-metrics"
                Grid.Row="3"
                ColumnDefinitions="*,*,*">
                <StackPanel Classes="edge-equipment-metric">
                    <TextBlock
                        Classes="edge-equipment-metric-value"
                        Text="{Binding TodayOutput}" />
                    <TextBlock
                        Classes="edge-equipment-metric-label"
                        Text="{DynamicResource Panels_Label_Output}" />
                </StackPanel>

                <StackPanel
                    Classes="edge-equipment-metric"
                    Grid.Column="1">
                    <TextBlock
                        Classes="edge-equipment-metric-value"
                        Text="{Binding TodayYield}" />
                    <TextBlock
                        Classes="edge-equipment-metric-label"
                        Text="{DynamicResource Panels_Label_Yield}" />
                </StackPanel>

                <StackPanel
                    Classes="edge-equipment-metric"
                    Grid.Column="2">
                    <TextBlock
                        Classes="edge-equipment-metric-value"
                        Text="{Binding NgCount}" />
                    <TextBlock
                        Classes="edge-equipment-metric-label"
                        Text="{DynamicResource Panels_Label_NgShort}" />
                </StackPanel>
            </Grid>
        </Grid>
    </edge:EdgeCard>
</UserControl>
