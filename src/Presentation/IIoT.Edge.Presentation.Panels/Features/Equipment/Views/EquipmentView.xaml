<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Presentation.Panels.Features.Equipment.EquipmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">

    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock
            FontSize="16"
            FontWeight="Medium"
            Foreground="#E4E4E7"
            Text="{DynamicResource Panels_Title_Equipment}" />
    </sharedViews:PageActionShell.HeaderContent>

    <TabControl Margin="8" Padding="0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="{DynamicResource Panels_Tab_HardwareStatus}">
            <DataGrid AlternatingRowBackground="#252525" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserReorderColumns="False" CanUserResizeRows="False" FontSize="12" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#27272A" IsReadOnly="True" ItemsSource="{Binding HardwareItems}" RowBackground="#1E1E1E">
                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#18181B" /><Setter Property="Foreground" Value="#71717A" /><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,4" /><Setter Property="BorderBrush" Value="#27272A" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style></DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#A1A1AA" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,4" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="50" Header="{DynamicResource Panels_Column_Status}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><Ellipse Width="10" Height="10" HorizontalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding StatusColor}" /></Ellipse.Fill></Ellipse></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="60" Header="{DynamicResource Panels_Column_Connection}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Connection"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock HorizontalAlignment="Center" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F44336" /><Setter Property="Text" Value="{DynamicResource Panels_Status_Disconnected}" /><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="#4CAF50" /><Setter Property="Text" Value="{DynamicResource Panels_Status_Connected}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{DynamicResource Panels_Column_Name}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Name" />
                    <DataGridTextColumn Width="120" Binding="{Binding Address}" Header="{DynamicResource Panels_Column_AddressPort}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_AddressPort" />
                    <DataGridTextColumn Width="60" Binding="{Binding DeviceType}" Header="{DynamicResource Panels_Column_Type}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Type" />
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="{DynamicResource Panels_Tab_RecipeInfo}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="8,6" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1"><WrapPanel><TextBlock Margin="0,0,4,0" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_Recipe}" /><TextBlock Margin="0,0,12,0" FontSize="11" Foreground="#E4E4E7" Text="{Binding RecipeName}" /><TextBlock Margin="0,0,4,0" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_Version}" /><TextBlock Margin="0,0,12,0" FontSize="11" Foreground="#E4E4E7" Text="{Binding RecipeVersion}" /><TextBlock Margin="0,0,4,0" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_Process}" /><TextBlock Margin="0,0,12,0" FontSize="11" Foreground="#E4E4E7" Text="{Binding ProcessName}" /><TextBlock Margin="0,0,4,0" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_Status}" /><TextBlock Margin="0,0,0,0" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource Panels_Status_Inactive}" /><Setter Property="Foreground" Value="#F44336" /><Style.Triggers><DataTrigger Binding="{Binding IsRecipeActive}" Value="True"><Setter Property="Text" Value="{DynamicResource Panels_Status_Active}" /><Setter Property="Foreground" Value="#4CAF50" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></WrapPanel></Border>
                <DataGrid Grid.Row="1" AlternatingRowBackground="#252525" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserReorderColumns="False" CanUserResizeRows="False" FontSize="12" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" IsReadOnly="True" ItemsSource="{Binding Parameters}" RowBackground="#1E1E1E">
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#18181B" /><Setter Property="Foreground" Value="#71717A" /><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,4" /><Setter Property="BorderBrush" Value="#27272A" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#A1A1AA" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,4" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding ParamName}" Header="{DynamicResource Panels_Column_ParamName}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_ParamName" />
                        <DataGridTextColumn Width="70" Binding="{Binding CurrentValue}" Header="{DynamicResource Panels_Column_CurrentValue}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_CurrentValue" />
                        <DataGridTextColumn Width="70" Binding="{Binding MinValue}" Header="{DynamicResource Panels_Column_Min}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Min" />
                        <DataGridTextColumn Width="70" Binding="{Binding MaxValue}" Header="{DynamicResource Panels_Column_Max}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Max" />
                        <DataGridTextColumn Width="50" Binding="{Binding Unit}" Header="{DynamicResource Panels_Column_Unit}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_Unit" />
                        <DataGridTextColumn Width="70" Binding="{Binding WarnLow}" Header="{DynamicResource Panels_Column_WarnLow}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_WarnLow" />
                        <DataGridTextColumn Width="70" Binding="{Binding WarnHigh}" Header="{DynamicResource Panels_Column_WarnHigh}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Panels_Column_WarnHigh" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="{DynamicResource Panels_Tab_RealtimeData}">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Margin="0,8,0,8" Columns="3" Rows="1">
                    <Border Margin="4" Padding="12,8" Background="#18181B" CornerRadius="6"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_TodayOutput}" /><StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#E4E4E7" Text="{Binding TodayOutput}" /><TextBlock Margin="2,0,0,3" VerticalAlignment="Bottom" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Unit_Count}" /></StackPanel></StackPanel></Border>
                    <Border Margin="4" Padding="12,8" Background="#18181B" CornerRadius="6"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_TodayYield}" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Text="{Binding TodayYield}" /></StackPanel></Border>
                    <Border Margin="4" Padding="12,8" Background="#18181B" CornerRadius="6"><StackPanel HorizontalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Label_NgCount}" /><StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal"><TextBlock FontSize="22" FontWeight="Bold" Foreground="#F44336" Text="{Binding NgCount}" /><TextBlock Margin="2,0,0,3" VerticalAlignment="Bottom" FontSize="11" Foreground="#71717A" Text="{DynamicResource Panels_Unit_Count}" /></StackPanel></StackPanel></Border>
                </UniformGrid>
                <Border Grid.Row="1" Margin="4,0,4,4" Padding="12,8" Background="#18181B" CornerRadius="6"><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#71717A" Text="{DynamicResource Panels_Label_CurrentBatch}" /><TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" Text="{Binding CurrentBatch}" /></StackPanel></Border>
            </Grid>
        </TabItem>
    </TabControl>
</sharedViews:PageActionShell>
