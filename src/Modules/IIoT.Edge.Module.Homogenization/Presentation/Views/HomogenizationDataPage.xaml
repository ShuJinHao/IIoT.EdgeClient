<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Module.Homogenization.Presentation.Views.HomogenizationDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    xmlns:uiLoc="clr-namespace:IIoT.Edge.UI.Shared.Localization;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">
    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock FontSize="16" FontWeight="Medium" Foreground="#E4E4E7" Text="{DynamicResource Homogenization_Title_Data}" />
    </sharedViews:PageActionShell.HeaderContent>

    <Border Margin="16"
            Background="#1E1E1E"
            BorderBrush="#333"
            BorderThickness="1"
            CornerRadius="8">
        <DataGrid AlternatingRowBackground="#232326"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  Foreground="#E4E4E7"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#333"
                  IsReadOnly="True"
                  ItemsSource="{Binding Records}"
                  RowBackground="#1E1E1E"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding TrayCode}" Header="{DynamicResource Homogenization_Column_TrayCode}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_TrayCode" />
                <DataGridTextColumn Width="150" Binding="{Binding InboundTime}" Header="{DynamicResource Homogenization_Column_InboundTime}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_InboundTime" />
                <DataGridTextColumn Width="150" Binding="{Binding OutboundTime}" Header="{DynamicResource Homogenization_Column_OutboundTime}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_OutboundTime" />
                <DataGridTextColumn Width="120" Binding="{Binding Status}" Header="{DynamicResource Homogenization_Column_Status}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_Status" />
                <DataGridTextColumn Width="100" Binding="{Binding StirringSpeed}" Header="{DynamicResource Homogenization_Column_StirringSpeed}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_StirringSpeed" />
                <DataGridTextColumn Width="100" Binding="{Binding Temperature}" Header="{DynamicResource Homogenization_Column_Temperature}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_Temperature" />
                <DataGridTextColumn Width="100" Binding="{Binding Vacuum}" Header="{DynamicResource Homogenization_Column_Vacuum}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_Vacuum" />
                <DataGridTextColumn Width="110" Binding="{Binding CntActual}" Header="{DynamicResource Homogenization_Column_CntActual}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_CntActual" />
                <DataGridTextColumn Width="110" Binding="{Binding NmpActual}" Header="{DynamicResource Homogenization_Column_NmpActual}" uiLoc:DataGridColumnLocalization.HeaderResourceKey="Homogenization_Column_NmpActual" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</sharedViews:PageActionShell>
