<sharedViews:PageActionShell
    x:Class="IIoT.Edge.Module.Homogenization.Presentation.Views.HomogenizationDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sharedViews="clr-namespace:IIoT.Edge.UI.Shared.Views;assembly=IIoT.Edge.UI.Shared"
    Background="Transparent">
    <sharedViews:PageActionShell.HeaderContent>
        <TextBlock FontSize="16" FontWeight="Medium" Foreground="#E4E4E7" Text="匀浆产品数据" />
    </sharedViews:PageActionShell.HeaderContent>

    <Border Margin="16"
            Background="#1E1E1E"
            BorderBrush="#333"
            BorderThickness="1"
            CornerRadius="8">
        <DataGrid AlternatingRowBackground="#232326"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  Foreground="#E4E4E7"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#333"
                  IsReadOnly="True"
                  ItemsSource="{Binding Records}"
                  RowBackground="#1E1E1E"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding TrayCode}" Header="托盘码" />
                <DataGridTextColumn Width="150" Binding="{Binding InboundTime}" Header="进站时间" />
                <DataGridTextColumn Width="150" Binding="{Binding OutboundTime}" Header="出料时间" />
                <DataGridTextColumn Width="120" Binding="{Binding Status}" Header="运行状态" />
                <DataGridTextColumn Width="100" Binding="{Binding StirringSpeed}" Header="搅拌转速" />
                <DataGridTextColumn Width="100" Binding="{Binding Temperature}" Header="温度" />
                <DataGridTextColumn Width="100" Binding="{Binding Vacuum}" Header="真空度" />
                <DataGridTextColumn Width="110" Binding="{Binding CntActual}" Header="CNT实际值" />
                <DataGridTextColumn Width="110" Binding="{Binding NmpActual}" Header="NMP实际值" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</sharedViews:PageActionShell>
