<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Homogenization_DisplayName">Homogenization</sys:String>
    <sys:String x:Key="Homogenization_Menu_Data">Data</sys:String>
    <sys:String x:Key="Homogenization_Title_Data">Homogenization Outbound Data</sys:String>
    <sys:String x:Key="Homogenization_Empty_Title">No outbound records</sys:String>
    <sys:String x:Key="Homogenization_Empty_OutboundRecords">No homogenization outbound records.</sys:String>
    <sys:String x:Key="Homogenization_RecordCountFormat">{0} outbound records.</sys:String>
    <sys:String x:Key="Homogenization_Error_PalletCodeRequired">Pallet code is required.</sys:String>
    <sys:String x:Key="Homogenization_Outbound_OverflowReceived">Outbound data received and persisted to overflow storage.</sys:String>
    <sys:String x:Key="Homogenization_Outbound_Received">Outbound data received.</sys:String>
    <sys:String x:Key="Homogenization_Outbound_PendingUpload">Outbound pending upload</sys:String>
    <sys:String x:Key="Homogenization_EquipmentStatus_Unknown">Unknown</sys:String>
    <sys:String x:Key="Homogenization_Validate_RequiredFormat">{0} must be greater than 0.</sys:String>
    <sys:String x:Key="Homogenization_Validate_StringRequiredFormat">{0} is required.</sys:String>
    <sys:String x:Key="Homogenization_Validate_MesSignTokenRequired">Homogenization MES sign token is required.</sys:String>
    <sys:String x:Key="Homogenization_Validate_PlcResetAndTriggerCannotEqual">PLC reset signal cannot equal trigger signal.</sys:String>
    <sys:String x:Key="Homogenization_Validate_MesItemMissingFormat">{0} is missing code configuration for {1}.</sys:String>
    <sys:String x:Key="Homogenization_Validate_MesItemCodeNameRequiredFormat">{0}.{1} code and name are required.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesEnabled_DisplayName">MES Upload Enabled</sys:String>
    <sys:String x:Key="Homogenization_Param_MesEnabled_Description">When disabled, MES heartbeat probing, MES business calls, and MES retry storage are skipped; local PLC, Excel, capacity, and UI updates continue.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesBaseUrl_DisplayName">MES Service URL</sys:String>
    <sys:String x:Key="Homogenization_Param_MesBaseUrl_Description">Base URL for MES inbound, outbound, recipe, equipment status, and realtime data calls.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesStationNo_DisplayName">MES Station No.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesStationNo_Description">Station number used by MES to identify this workstation in business requests.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesUpperComputerNo_DisplayName">MES Upper Computer No.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesUpperComputerNo_Description">upperComputerNo used to query MES main plans. Maintain it in parameter settings.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOperationCode_DisplayName">MES Operation Code</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOperationCode_Description">operationCode used to generate MES trace batch numbers, for example CG for positive-electrode glue making.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesHealthPath_DisplayName">MES Health Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesHealthPath_Description">Relative path for the MES health check endpoint. The current test environment uses /heath.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesInboundPath_DisplayName">MES Inbound Check Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesInboundPath_Description">Relative path for MES inbound validation.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOutboundPath_DisplayName">MES Outbound Upload Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOutboundPath_Description">Relative path for MES outbound data upload.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesRecipePath_DisplayName">MES Recipe Upload Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesRecipePath_Description">Relative path for MES recipe parameter upload.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesRealtimePath_DisplayName">MES Realtime Data Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesRealtimePath_Description">Relative path for MES realtime running data upload.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesEquipmentStatusPath_DisplayName">MES Equipment Status Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesEquipmentStatusPath_Description">Relative path for MES equipment status upload.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOrderPath_DisplayName">MES Main Order Query Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesOrderPath_Description">Relative path for querying MES main orders. This batch only parameterizes the path and does not consume the response.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesBatchNumberPath_DisplayName">MES Trace Batch Number Path</sys:String>
    <sys:String x:Key="Homogenization_Param_MesBatchNumberPath_Description">Relative path for generating MES trace batch numbers after a main plan is confirmed.</sys:String>
    <sys:String x:Key="Homogenization_Param_MesSignToken_DisplayName">MES Sign Token</sys:String>
    <sys:String x:Key="Homogenization_Param_MesSignToken_Description">Sign token used to generate MES request signatures.</sys:String>
    <sys:String x:Key="Homogenization_Param_CloudEnabled_DisplayName">Cloud Upload Enabled</sys:String>
    <sys:String x:Key="Homogenization_Param_CloudEnabled_Description">When disabled, only this plugin's production-data Cloud upload stops; system bootstrap, device logs, Cloud retry, and diagnostics are unaffected.</sys:String>
    <sys:String x:Key="Homogenization_Param_DuplicateTrayCheck_DisplayName">Duplicate Pallet Check Enabled</sys:String>
    <sys:String x:Key="Homogenization_Param_DuplicateTrayCheck_Description">When enabled, repeated pallet-code triggers in inbound or outbound stages are blocked.</sys:String>
    <sys:String x:Key="Homogenization_Column_TrayCode">Pallet Code</sys:String>
    <sys:String x:Key="Homogenization_Column_DeviceCode">Device Code</sys:String>
    <sys:String x:Key="Homogenization_Column_DeviceName">Device Name</sys:String>
    <sys:String x:Key="Homogenization_Column_InboundTime">Inbound Time</sys:String>
    <sys:String x:Key="Homogenization_Column_OutboundTime">Outbound Time</sys:String>
    <sys:String x:Key="Homogenization_Column_Status">Status</sys:String>
    <sys:String x:Key="Homogenization_Column_StirringSpeed">Stirring Speed (RPM)</sys:String>
    <sys:String x:Key="Homogenization_Column_Temperature">Temperature (C)</sys:String>
    <sys:String x:Key="Homogenization_Column_Vacuum">Vacuum (KPa)</sys:String>
    <sys:String x:Key="Homogenization_Column_CntActual">CNT Actual (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_CntTarget">CNT Target (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_CntTankAWeight">CNT Tank A (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_CntTankBWeight">CNT Tank B (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_NmpActual">NMP Actual (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_NmpTarget">NMP Target (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_GlueActual">Glue Actual (kg)</sys:String>
    <sys:String x:Key="Homogenization_Column_SetStirringTime">Set Stirring Time (min)</sys:String>
    <sys:String x:Key="Homogenization_Column_RemainingStirringTime">Remaining Stirring Time (min)</sys:String>
    <sys:String x:Key="Homogenization_Column_SetDispersionTime">Set Dispersion Time (min)</sys:String>
    <sys:String x:Key="Homogenization_Column_RemainingDispersionTime">Remaining Dispersion Time (min)</sys:String>
    <sys:String x:Key="Homogenization_Column_MainBatchPlan">Main Plan</sys:String>
    <sys:String x:Key="Homogenization_Column_BatchNumber">Trace Batch No.</sys:String>
</ResourceDictionary>
